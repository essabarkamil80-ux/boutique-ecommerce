{%- liquid
  assign s = section.settings
  assign revs = section.blocks | where: 'type', 'review'
  assign photos = section.blocks | where: 'type', 'photo'
  assign p = s.product | default: product
  assign rv = p.metafields.reviews.rating.value
  assign rating_num = 0
  assign rating_max = 5
  assign rcount = s.count
  if rv != blank
    assign rating_num = rv.rating | times: 1.0
    assign rating_max = rv.scale_max | default: 5
    assign rcount = p.metafields.reviews.rating_count.value
  elsif s.rating != blank
    assign rating_num = s.rating | times: 1.0
  endif
  assign rating_pct = rating_num | times: 100.0 | divided_by: rating_max
-%}
<section class="sf sf-rl" id="sf-rl-{{ section.id }}" data-per="{{ s.per_page }}">
  <div class="sf-rl__wrap">

    <div class="sf-rl__sum">
      <div class="sf-rl__score">
        <p class="sf-rl__num">
          <b>{% if rating_num > 0 %}{{ rating_num | round: 2 }}{% else %}—{% endif %}</b>
          <span class="sf-rate" aria-hidden="true"><span class="sf-rate__bg">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span><span class="sf-rate__fg" style="width: {{ rating_pct }}%">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span></span>
        </p>
        <p class="sf-rl__based">{% if rcount != blank %}{{ s.based_label | replace: '{count}', rcount }}{% else %}{{ s.no_reviews_label }}{% endif %}</p>
      </div>
      {%- for n in (1..2) -%}
        {%- assign kl = 'c' | append: n | append: '_label' -%}
        {%- assign kv = 'c' | append: n | append: '_value' -%}
        {%- assign ka = 'c' | append: n | append: '_a' -%}
        {%- assign km = 'c' | append: n | append: '_b' -%}
        {%- assign kz = 'c' | append: n | append: '_c' -%}
        {%- if s[kl] != blank -%}
          {%- assign cp = s[kv] | times: 20 -%}
          <div class="sf-rl__crit">
            <p>{{ s[kl] }}</p>
            <i class="sf-rl__track">{% if s[kv] > 0 %}<em style="left: {{ cp }}%"></em>{% endif %}</i>
            <span class="sf-rl__caps"><small>{{ s[ka] }}</small><small>{{ s[km] }}</small><small>{{ s[kz] }}</small></span>
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- if s.write_label != blank -%}
        <a class="sf-rl__write" href="{{ s.write_link | default: '/pages/contact' }}">{{ s.write_label }}</a>
      {%- endif -%}
    </div>

    {%- if photos.size > 0 -%}
      <div class="sf-rl__strip" data-strip>
        <ul>
          {%- for ph in photos -%}
            <li {{ ph.shopify_attributes }}>
              <span class="sf-rl__ph sf-media">
                {%- if ph.settings.image != blank -%}{{ ph.settings.image | image_url: width: 300 | image_tag: widths: '150, 300', sizes: '100px', alt: '', loading: 'lazy' }}{%- else -%}<span class="sf-rl__phe">{%- render 'sf-icon', name: 'camera' -%}</span>{%- endif -%}
                {%- if ph.settings.is_video and ph.settings.image != blank -%}<span class="sf-rl__phplay">{%- render 'sf-icon', name: 'play' -%}</span>{%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
        <button type="button" class="sf-rl__next" data-strip-next aria-label="Next">{%- render 'sf-icon', name: 'arrow-right' -%}</button>
      </div>
    {%- endif -%}

    <div class="sf-rl__bar">
      <div class="sf-rl__tools">
        <label class="sf-rl__sort"><select data-sort aria-label="{{ s.sort_label | escape }}">
          <option value="new">{{ s.sort_label }}: {{ s.sort_new }}</option>
          <option value="high">{{ s.sort_label }}: {{ s.sort_high }}</option>
          <option value="low">{{ s.sort_label }}: {{ s.sort_low }}</option>
        </select></label>
        <label class="sf-rl__search">{%- render 'sf-icon', name: 'search' -%}<input type="search" data-q placeholder="{{ s.search_label | escape }}" aria-label="{{ s.search_label | escape }}"></label>
      </div>
      <div class="sf-rl__tabs" role="tablist">
        <button type="button" role="tab" class="is-on" data-tab="r" aria-selected="true">{{ s.tab_reviews }}</button>
        <button type="button" role="tab" data-tab="q" aria-selected="false">{{ s.tab_questions }}</button>
      </div>
    </div>

    <div data-pane="r">
      <ul class="sf-rl__list" data-list>
        {%- for r in revs -%}
          {%- assign rs = r.settings -%}
          {%- assign rp = rs.rating | times: 20 -%}
          <li class="sf-rl__item" data-rating="{{ rs.rating }}" {{ r.shopify_attributes }}>
            <div class="sf-rl__who">
              <i class="sf-rl__av">{{ rs.name | slice: 0, 2 }}</i>
              {%- if rs.verified -%}<p class="sf-rl__ver">{%- render 'sf-icon', name: 'verified' -%}<small>{{ s.verified_label }}</small></p>{%- endif -%}
              <p class="sf-rl__name">{{ rs.name }}</p>
              {%- if rs.recommends -%}<p class="sf-rl__rec">{%- render 'sf-icon', name: 'heart' -%}<small>{{ s.recommends_label }}</small></p>{%- endif -%}
            </div>
            <div class="sf-rl__body">
              <span class="sf-rate sf-rl__stars" aria-label="{{ rs.rating }} / 5"><span class="sf-rate__bg">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span><span class="sf-rate__fg" style="width: {{ rp }}%">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span></span>
              <h3 class="sf-rl__t">{{ rs.title }}</h3>
              <p class="sf-rl__x">{{ rs.text }}</p>
              {%- if s.c1_label != blank or s.c2_label != blank -%}
                <div class="sf-rl__crits">
                  {%- for n in (1..2) -%}
                    {%- assign kl = 'c' | append: n | append: '_label' -%}
                    {%- assign kv = 'c' | append: n | append: '_value' -%}
                    {%- assign ka = 'c' | append: n | append: '_a' -%}
                    {%- assign km = 'c' | append: n | append: '_b' -%}
                    {%- assign kz = 'c' | append: n | append: '_c' -%}
                    {%- assign rcv = rs[kv] | times: 20 -%}
                    {%- if s[kl] != blank -%}
                      <div><p>{{ s[kl] }}</p><i class="sf-rl__track">{% if rs[kv] > 0 %}<em style="left: {{ rcv }}%"></em>{% endif %}</i><span class="sf-rl__caps"><small>{{ s[ka] }}</small><small>{{ s[km] }}</small><small>{{ s[kz] }}</small></span></div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
              {%- if rs.photo != blank -%}<span class="sf-rl__photo sf-media">{{ rs.photo | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '120px', alt: rs.title, loading: 'lazy' }}</span>{%- endif -%}
              <div class="sf-rl__foot">
                <p>{{ s.helpful_label }} <button type="button" data-vote>{{ s.yes_label }}</button><button type="button" data-vote>{{ s.no_label }}</button></p>
                <small>{{ rs.date }}</small>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <nav class="sf-rl__pager" data-pager aria-label="Reviews pages" hidden></nav>
    </div>
    <div data-pane="q" hidden><p class="sf-rl__noq">{{ s.no_questions }}</p></div>
  </div>
</section>
<script>
  (function () {
    var root = document.getElementById('sf-rl-{{ section.id }}'); if (!root || root.dataset.ready) return; root.dataset.ready = '1';
    var per = parseInt(root.dataset.per, 10) || 5, list = root.querySelector('[data-list]'), items = [].slice.call(list.children), orig = items.slice(), pager = root.querySelector('[data-pager]'), page = 1, query = '';
    function visible() { return items.filter(function (li) { return !query || li.textContent.toLowerCase().indexOf(query) > -1; }); }
    function render() {
      var vis = visible(), pages = Math.max(1, Math.ceil(vis.length / per)); if (page > pages) page = pages;
      items.forEach(function (li) { li.hidden = true; });
      vis.forEach(function (li, i) { li.hidden = Math.floor(i / per) + 1 !== page; });
      if (pages < 2) { pager.hidden = true; pager.innerHTML = ''; return; }
      var h = '<button type="button" data-go="' + (page - 1) + '" aria-label="Previous"' + (page === 1 ? ' disabled' : '') + '>‹</button>';
      for (var n = 1; n <= pages; n++) h += '<button type="button" data-go="' + n + '"' + (n === page ? ' class="is-on" aria-current="page"' : '') + '>' + n + '</button>';
      h += '<button type="button" data-go="' + (page + 1) + '" aria-label="Next"' + (page === pages ? ' disabled' : '') + '>›</button>';
      pager.innerHTML = h; pager.hidden = false;
    }
    pager.addEventListener('click', function (e) { var b = e.target.closest('[data-go]'); if (!b || b.disabled) return; page = parseInt(b.dataset.go, 10); render(); list.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    root.querySelector('[data-sort]').addEventListener('change', function () {
      var v = this.value, arr = orig.slice();
      if (v === 'high') arr.sort(function (a, b) { return b.dataset.rating - a.dataset.rating; });
      if (v === 'low') arr.sort(function (a, b) { return a.dataset.rating - b.dataset.rating; });
      items = arr; arr.forEach(function (li) { list.appendChild(li); }); page = 1; render();
    });
    root.querySelector('[data-q]').addEventListener('input', function () { query = this.value.trim().toLowerCase(); page = 1; render(); });
    root.querySelectorAll('[data-tab]').forEach(function (t) {
      t.addEventListener('click', function () {
        root.querySelectorAll('[data-tab]').forEach(function (x) { var on = x === t; x.classList.toggle('is-on', on); x.setAttribute('aria-selected', on); });
        root.querySelectorAll('[data-pane]').forEach(function (p) { p.hidden = p.dataset.pane !== t.dataset.tab; });
      });
    });
    root.querySelectorAll('[data-vote]').forEach(function (b) { b.addEventListener('click', function () { var on = b.classList.toggle('is-on'); b.parentNode.querySelectorAll('[data-vote]').forEach(function (o) { if (o !== b) o.classList.remove('is-on'); }); b.setAttribute('aria-pressed', on); }); });
    var strip = root.querySelector('[data-strip]'), nx = root.querySelector('[data-strip-next]');
    if (strip && nx) nx.addEventListener('click', function () { var u = strip.querySelector('ul'); u.scrollBy({ left: u.clientWidth * .8, behavior: 'smooth' }); });
    render();
  })();
</script>


{% schema %}
{
  "name": "SF · Avis (liste)",
  "tag": "section",
  "class": "sf-section-rl",
  "settings": [
    { "type": "paragraph", "content": "Squelette prêt à remplir : uniquement de vrais avis, avec l'accord des clientes. Note et nombre viennent du metafield reviews.rating s'il existe, sinon renseignez vos vraies valeurs." },
    { "type": "product", "id": "product", "label": "Produit (pour la note automatique)" },
    { "type": "text", "id": "rating", "label": "Note réelle (ex. 4.8)" },
    { "type": "text", "id": "count", "label": "Nombre d'avis réel" },
    { "type": "text", "id": "based_label", "label": "Texte sous la note ({count})", "default": "Based on {count} reviews" },
    { "type": "text", "id": "no_reviews_label", "label": "Texte sans avis", "default": "No reviews yet" },
    { "type": "header", "content": "Critères (curseurs)" },
    { "type": "text", "id": "c1_label", "label": "Critère 1", "default": "Fit" },
    { "type": "range", "id": "c1_value", "min": 0, "max": 5, "step": 0.1, "label": "Critère 1 : valeur réelle moyenne (0 = masqué)", "default": 0 },
    { "type": "text", "id": "c1_a", "label": "Critère 1 : gauche", "default": "Runs small" },
    { "type": "text", "id": "c1_b", "label": "Critère 1 : milieu", "default": "True to size" },
    { "type": "text", "id": "c1_c", "label": "Critère 1 : droite", "default": "Runs large" },
    { "type": "text", "id": "c2_label", "label": "Critère 2", "default": "Comfort" },
    { "type": "range", "id": "c2_value", "min": 0, "max": 5, "step": 0.1, "label": "Critère 2 : valeur réelle moyenne (0 = masqué)", "default": 0 },
    { "type": "text", "id": "c2_a", "label": "Critère 2 : gauche", "default": "Not comfortable" },
    { "type": "text", "id": "c2_b", "label": "Critère 2 : milieu", "default": "Comfortable" },
    { "type": "text", "id": "c2_c", "label": "Critère 2 : droite", "default": "Very comfortable" },
    { "type": "header", "content": "Textes de l'interface" },
    { "type": "text", "id": "write_label", "label": "Bouton « écrire un avis »", "default": "Write a review" },
    { "type": "url", "id": "write_link", "label": "Lien du bouton (vide = page contact ; mettez le formulaire de votre appli d'avis)" },
    { "type": "text", "id": "sort_label", "label": "Tri : libellé", "default": "Sort by" },
    { "type": "text", "id": "sort_new", "label": "Tri : récents", "default": "Most recent" },
    { "type": "text", "id": "sort_high", "label": "Tri : meilleures notes", "default": "Highest rating" },
    { "type": "text", "id": "sort_low", "label": "Tri : notes les plus basses", "default": "Lowest rating" },
    { "type": "text", "id": "search_label", "label": "Recherche", "default": "Search" },
    { "type": "text", "id": "tab_reviews", "label": "Onglet avis", "default": "Product reviews" },
    { "type": "text", "id": "tab_questions", "label": "Onglet questions", "default": "Questions" },
    { "type": "text", "id": "no_questions", "label": "Message sans question", "default": "No questions yet." },
    { "type": "text", "id": "verified_label", "label": "Libellé achat vérifié", "default": "Verified purchase" },
    { "type": "text", "id": "recommends_label", "label": "Libellé recommandation", "default": "Recommends this product" },
    { "type": "text", "id": "helpful_label", "label": "Question « utile ? »", "default": "Was this review helpful?" },
    { "type": "text", "id": "yes_label", "label": "Oui", "default": "Yes" },
    { "type": "text", "id": "no_label", "label": "Non", "default": "No" },
    { "type": "range", "id": "per_page", "min": 3, "max": 10, "step": 1, "label": "Avis par page", "default": 5 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo de la bande",
      "limit": 16,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo de cliente" },
        { "type": "checkbox", "id": "is_video", "label": "Afficher l'icône vidéo", "default": false }
      ]
    },
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "label": "Étoiles", "default": 0 },
        { "type": "text", "id": "name", "label": "Nom", "default": "Customer name" },
        { "type": "checkbox", "id": "verified", "label": "Achat vérifié (seulement si c'est réel)", "default": false },
        { "type": "checkbox", "id": "recommends", "label": "Recommande le produit", "default": false },
        { "type": "text", "id": "title", "label": "Titre de l'avis", "default": "Review title" },
        { "type": "textarea", "id": "text", "label": "Texte de l'avis", "default": "Paste a real customer review here." },
        { "type": "range", "id": "c1_value", "min": 0, "max": 5, "step": 0.1, "label": "Critère 1 (0 = pas de curseur)", "default": 0 },
        { "type": "range", "id": "c2_value", "min": 0, "max": 5, "step": 0.1, "label": "Critère 2 (0 = pas de curseur)", "default": 0 },
        { "type": "image_picker", "id": "photo", "label": "Photo (optionnelle)" },
        { "type": "text", "id": "date", "label": "Date (ex. il y a 3 jours)" }
      ]
    }
  ],
  "presets": [ { "name": "SF · Avis (liste)", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] } ]
}
{% endschema %}
