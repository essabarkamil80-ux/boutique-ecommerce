  #ce-{{ section.id }} .ce-faq__item:last-child { border-bottom: 0; }
  #ce-{{ section.id }} .ce-faq__item summary { list-style: none; cursor: pointer; padding: 16px 18px; font-size: 15px; font-weight: 600; display: flex; justify-content: space-between; align-items: center; gap: 14px; }
  #ce-{{ section.id }} .ce-faq__item summary::-webkit-details-marker { display: none; }
  #ce-{{ section.id }} .ce-faq__ico { font-size: 20px; color: var(--ce-acc); transition: transform .2s; flex: 0 0 auto; }
  #ce-{{ section.id }} .ce-faq__item[open] .ce-faq__ico { transform: rotate(45deg); }
  #ce-{{ section.id }} .ce-faq__ans { padding: 0 18px 18px; font-size: 14px; color: #55606a; line-height: 1.6; }

  /* Shades */
  #ce-{{ section.id }} .ce-shades { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  #ce-{{ section.id }} .ce-shade { margin: 0; }
  #ce-{{ section.id }} .ce-shade__media { position: relative; border-radius: 12px; overflow: hidden; aspect-ratio: 1/1; background: var(--ce-tint); }
  #ce-{{ section.id }} .ce-shade__media img { width: 100%; height: 100%; object-fit: cover; }
  #ce-{{ section.id }} .ce-shade__idx { position: absolute; top: 8px; left: 8px; width: 24px; height: 24px; border-radius: 50%; background: var(--ce-acc); color: #fff; font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  #ce-{{ section.id }} .ce-shade figcaption { text-align: center; margin-top: 8px; font-size: 13.5px; font-weight: 600; }
  #ce-{{ section.id }} .ce-shade__code { color: #9aa4ac; font-weight: 500; }

  /* Before/After grid */
  #ce-{{ section.id }} .ce-bagrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  #ce-{{ section.id }} .ce-bacell { border-radius: 10px; overflow: hidden; aspect-ratio: 1/1; background: var(--ce-tint); }
  #ce-{{ section.id }} .ce-bacell img { width: 100%; height: 100%; object-fit: cover; }

  /* Reviews wall */
  #ce-{{ section.id }} .ce-tp { display: flex; align-items: center; justify-content: center; gap: 8px; margin: -14px 0 24px; font-size: 13px; color: #6a747c; }
  #ce-{{ section.id }} .ce-wall { columns: 1; column-gap: 14px; }
  #ce-{{ section.id }} .ce-rev { break-inside: avoid; margin-bottom: 14px; border: 1px solid var(--ce-line); border-radius: 12px; overflow: hidden; background: #fff; }
  #ce-{{ section.id }} .ce-rev__img img { width: 100%; height: auto; display: block; }
  #ce-{{ section.id }} .ce-rev__body { padding: 14px 16px; }
  #ce-{{ section.id }} .ce-rev__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  #ce-{{ section.id }} .ce-rev__v { font-size: 11px; color: var(--ce-acc); font-weight: 600; }
  #ce-{{ section.id }} .ce-rev__title { font-size: 15px; margin: 0 0 5px; }
  #ce-{{ section.id }} .ce-rev__text { font-size: 13.5px; color: #4a545c; line-height: 1.55; margin: 0 0 10px; }
  #ce-{{ section.id }} .ce-rev__auth { font-size: 12.5px; font-weight: 600; color: #6a747c; }

  /* WhatsApp / support CTA */
  #ce-{{ section.id }} .ce-wa { background: linear-gradient(135deg, var(--ce-acc), var(--ce-acc-dark)); color: #fff; }
  #ce-{{ section.id }} .ce-wa__inner { max-width: 1100px; margin: 0 auto; padding: 40px 18px; display: grid; grid-template-columns: 1fr; gap: 22px; align-items: center; }
  #ce-{{ section.id }} .ce-wa__title { font-size: clamp(22px, 5vw, 30px); line-height: 1.2; margin: 0 0 10px; color: #fff; }
  #ce-{{ section.id }} .ce-wa__sub { font-size: 15px; opacity: .92; line-height: 1.5; margin: 0 0 20px; }
  #ce-{{ section.id }} .ce-wa__btns { display: flex; flex-wrap: wrap; gap: 10px; }
  #ce-{{ section.id }} .ce-wa__media { border-radius: var(--r); overflow: hidden; }

  /* Sticky */
  #ce-{{ section.id }} .ce-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; align-items: center; gap: 12px; padding: 10px 14px calc(10px + env(safe-area-inset-bottom)); background: rgba(255,255,255,.97); backdrop-filter: blur(8px); border-top: 1px solid var(--ce-line); box-shadow: 0 -4px 18px rgba(0,0,0,.06); }
  #ce-{{ section.id }} .ce-sticky__info { display: flex; flex-direction: column; line-height: 1.2; }
  #ce-{{ section.id }} .ce-sticky__name { font-size: 12px; color: #6a747c; }
