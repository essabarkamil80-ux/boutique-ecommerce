{%- if section.settings.text != blank or section.settings.pill != blank -%}
<div class="sf sf-ann" style="--ann-bg: {{ section.settings.bg }}; --ann-fg: {{ section.settings.fg }};">
  {%- if section.settings.link != blank -%}<a class="sf-ann__in" href="{{ section.settings.link }}">{%- else -%}<div class="sf-ann__in">{%- endif -%}
    {%- if section.settings.text != blank -%}<span class="sf-ann__txt">{{ section.settings.text }}</span>{%- endif -%}
    {%- if section.settings.pill != blank -%}<span class="sf-ann__pill">{{ section.settings.pill }}</span>{%- endif -%}
  {%- if section.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
</div>
{%- endif -%}

{% stylesheet %}
  .sf-ann { background: var(--ann-bg); color: var(--ann-fg); }
  .sf-ann__in { min-height: 40px; display: flex; align-items: center; justify-content: center; gap: 10px;
    padding: 6px 16px; text-align: center; }
  .sf-ann__txt { font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .sf-ann__pill { background: #fff; color: var(--ann-bg); font-size: 11.5px; font-weight: 700; line-height: 1;
    padding: 5px 9px; border-radius: 5px; white-space: nowrap; }
  @media (max-width: 749px) { .sf-ann__txt { font-size: 11px; } .sf-ann__pill { font-size: 10.5px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "SF · Barre d'annonce",
  "tag": "section",
  "class": "sf-section-ann",
  "settings": [
    { "type": "text", "id": "text", "label": "Texte", "default": "SELF-CARE MONTH OFFER" },
    { "type": "text", "id": "pill", "label": "Pastille", "default": "Save up to 70%" },
    { "type": "url", "id": "link", "label": "Lien" },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#6B2441" },
    { "type": "color", "id": "fg", "label": "Texte", "default": "#FFFFFF" }
  ],
  "presets": [ { "name": "SF · Barre d'annonce" } ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
