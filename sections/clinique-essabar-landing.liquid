{% comment %}theme-check-disable ImgWidthAndHeight,RemoteAsset,AssetUrlFilters,RemoteAssetUrl{% endcomment %}
{%- comment -%}
  Clinic Essabar — product landing reproducing the reference DTC structure (veneera-style).
  Layout & section order faithful to the reference; all copy is generic placeholder to be replaced.
  No filters are used inside if-conditions (Liquid forbids it).
{%- endcomment -%}

{%- assign prod = section.settings.product | default: product -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<section id="ce-{{ section.id }}" class="ce"
  style="--ce-acc: {{ section.settings.color_accent }}; --ce-acc-dark: {{ section.settings.color_accent_dark }}; --ce-ink: {{ section.settings.color_ink }}; --ce-bg: #ffffff; --ce-tint: #f2f5f4; --ce-line: #e4e9e8;">

  {%- comment -%} ============ 1. HERO / BUY BOX ============ {%- endcomment -%}
  <div class="ce-hero">
    <div class="ce-hero__media">
      {%- assign imgs = prod.images -%}
      <div class="ce-gallery" data-gallery>
        <div class="ce-gallery__thumbs">
          {%- if imgs.size > 0 -%}
            {%- for image in imgs limit: 7 -%}
              <button type="button" class="ce-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}">
                <img src="{{ image | image_url: width: 160 }}" alt="" width="70" height="70" loading="lazy">
              </button>
            {%- endfor -%}
          {%- else -%}
            <button type="button" class="ce-gallery__thumb is-active" data-thumb="0">{{ 'product-1' | placeholder_svg_tag: 'ce-ph' }}</button>
            <button type="button" class="ce-gallery__thumb" data-thumb="1">{{ 'product-2' | placeholder_svg_tag: 'ce-ph' }}</button>
            <button type="button" class="ce-gallery__thumb" data-thumb="2">{{ 'product-3' | placeholder_svg_tag: 'ce-ph' }}</button>
          {%- endif -%}
        </div>
        <div class="ce-gallery__main">
          {%- if imgs.size > 0 -%}
            {%- for image in imgs limit: 7 -%}
              <div class="ce-gallery__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}">
                <img src="{{ image | image_url: width: 1100 }}" alt="{{ image.alt | default: prod.title | escape }}" width="900" height="900" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="ce-gallery__slide is-active" data-slide="0">{{ 'product-1' | placeholder_svg_tag: 'ce-ph' }}</div>
            <div class="ce-gallery__slide" data-slide="1">{{ 'product-2' | placeholder_svg_tag: 'ce-ph' }}</div>
            <div class="ce-gallery__slide" data-slide="2">{{ 'product-3' | placeholder_svg_tag: 'ce-ph' }}</div>
          {%- endif -%}
          <div class="ce-gallery__slide ce-gallery__slide--variant" data-variant-slide hidden><img data-variant-img src="" alt="" width="900" height="900" loading="lazy"></div>
        </div>
      </div>
    </div>

    <div class="ce-hero__info">
      {%- if section.settings.hero_badge != blank -%}<span class="ce-badge">{{ section.settings.hero_badge }}</span>{%- endif -%}
      <h1 class="ce-title">{{ section.settings.hero_title }}</h1>
      <p class="ce-subtitle">{{ section.settings.hero_sub }}</p>

      <div class="ce-card">
      <div class="ce-pricerow">
        {%- if prod != blank -%}
          {%- if prod.compare_at_price > prod.price -%}<span class="ce-price__was">{{ prod.compare_at_price | money }}</span>{%- endif -%}
          <span class="ce-price__now">{{ prod.price | money }}</span>
        {%- else -%}
          <span class="ce-price__now">{{ section.settings.fallback_price }}</span>
        {%- endif -%}
      </div>
      {%- if section.settings.tax_note != blank -%}<p class="ce-taxnote">{{ section.settings.tax_note }}</p>{%- endif -%}

      {%- if section.settings.offer_enable -%}
      <div class="ce-offer">
        <div class="ce-offer__top">
          <span class="ce-offer__eyebrow">🎁 {{ section.settings.offer_eyebrow | default: 'Offre exclusive' }}</span>
          {%- if section.settings.offer_badge != blank -%}<span class="ce-offer__save">{{ section.settings.offer_badge }}</span>{%- endif -%}
        </div>
        {%- if section.settings.offer_title != blank -%}<div class="ce-offer__head">{{ section.settings.offer_title }}</div>{%- endif -%}
        <div class="ce-offer__viz">
          <div class="ce-offer__jaw">
            <span class="ce-offer__jaw-img">{%- if section.settings.offer_img_top != blank -%}<img src="{{ section.settings.offer_img_top | image_url: width: 240 }}" alt="Upper teeth veneers" loading="lazy">{%- else -%}<span class="ce-offer__jaw-ico">🦷</span>{%- endif -%}</span>
            <span class="ce-offer__jaw-lbl">Upper Teeth Veneers</span>
            <span class="ce-offer__jaw-state">You buy this</span>
          </div>
          <span class="ce-offer__plus">+</span>
          <div class="ce-offer__jaw ce-offer__jaw--free">
            <span class="ce-offer__jaw-img">{%- if section.settings.offer_img_bottom != blank -%}<img src="{{ section.settings.offer_img_bottom | image_url: width: 240 }}" alt="Lower teeth veneers" loading="lazy">{%- else -%}<span class="ce-offer__jaw-ico">🦷</span>{%- endif -%}</span>
            <span class="ce-offer__jaw-lbl">Lower Teeth Veneers</span>
            <span class="ce-offer__jaw-state ce-offer__jaw-state--free">🎁 Free</span>
          </div>
        </div>
        {%- if section.settings.offer_sub != blank -%}<div class="ce-offer__note">{{ section.settings.offer_sub }}</div>{%- endif -%}
        {%- if section.settings.offer_ebook != blank -%}<div class="ce-offer__bonus">{{ section.settings.offer_ebook }}</div>{%- endif -%}
      </div>
      {%- endif -%}

      <div class="ce-rating">
        <span class="ce-stars" role="img" aria-label="{{ section.settings.rating }}"><span class="ce-stars__bg">★★★★★</span><span class="ce-stars__fill" style="width: {{ section.settings.rating_value | default: 4.7 | times: 20 }}%">★★★★★</span></span>
        <span class="ce-rating__txt">{{ section.settings.rating }} · {{ section.settings.review_count }}</span>
      </div>

      {%- if section.settings.press_enable -%}
      <div class="ce-press">
        {%- if section.settings.press_title != blank -%}<span class="ce-press__label">{{ section.settings.press_title }}</span>{%- endif -%}
        <div class="ce-press__logos">
          {%- for i in (1..4) -%}
            {%- assign pn = 'press' | append: i | append: '_name' -%}
            {%- assign pi = 'press' | append: i | append: '_image' -%}
            {%- if section.settings[pi] != blank or section.settings[pn] != blank -%}
              <span class="ce-press__logo">{%- if section.settings[pi] != blank -%}<img src="{{ section.settings[pi] | image_url: width: 260 }}" alt="{{ section.settings[pn] | escape }}" loading="lazy">{%- else -%}<span class="ce-press__name">{{ section.settings[pn] }}</span>{%- endif -%}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      {%- endif -%}

      {%- comment -%} Variant options {%- endcomment -%}
      <div class="ce-buy" data-buy>
        {%- if prod != blank and prod.has_only_default_variant == false -%}
          <div class="ce-opts" data-variants='{{ prod.variants | json | escape }}'>
            {%- for opt in prod.options_with_values -%}
              <div class="ce-opt" data-opt-pos="{{ opt.position }}">
                <span class="ce-opt__label">{{ opt.name }} : <b data-opt-selected="{{ opt.position }}">{{ opt.selected_value }}</b></span>
                <div class="ce-opt__values">
                  {%- for val in opt.values -%}
                    <button type="button" class="ce-opt__val{% if val == opt.selected_value %} is-active{% endif %}" data-opt-value data-value="{{ val | escape }}">{{ val }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
          <input type="hidden" data-variant-input value="{{ prod.selected_or_first_available_variant.id }}">
        {%- elsif prod != blank -%}
          <input type="hidden" data-variant-input value="{{ prod.selected_or_first_available_variant.id }}">
        {%- endif -%}
        {%- if prod != blank -%}
        <script type="application/json" data-vdata>{"{%- for v in prod.variants -%}{{ v.id }}":{"p":{{ v.price | money | json }},"c":{% if v.compare_at_price and v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},"a":{{ v.available | json }},"img":{% if v.featured_image %}{{ v.featured_image | image_url: width: 1100 | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},"{%- endunless -%}{%- endfor -%}}</script>
        {%- endif -%}

        {%- comment -%} 4 simple steps (inside the buy box, like the reference) {%- endcomment -%}
        {%- assign steps = section.blocks | where: 'type', 'step' -%}
        {%- if steps.size > 0 -%}
          <div class="ce-steps-mini">
            <span class="ce-steps-mini__title">{{ section.settings.steps_title }}</span>
            <ol>
              {%- for block in steps -%}<li {{ block.shopify_attributes }}><span class="ce-steps-mini__num">{{ forloop.index }}</span><span class="ce-steps-mini__body"><b>{{ block.settings.title }}</b>{%- if block.settings.text != blank -%}<span class="ce-steps-mini__note">{{ block.settings.text }}</span>{%- endif -%}</span></li>{%- endfor -%}
            </ol>
          </div>
        {%- endif -%}

        <div class="ce-cta-row">
          <button type="button" class="ce-btn ce-btn--outline" data-addtocart>{{ section.settings.cta_cart | default: 'Add to Cart' }}</button>
          <button type="button" class="ce-btn ce-btn--primary" data-buynow>{{ section.settings.cta_add | default: 'Buy Now' }}</button>
        </div>
        <p class="ce-buymsg" data-buy-msg hidden role="alert"></p>

        <div class="ce-reassure">
          <span>🔒 Secure payment</span>
          <span>🚚 Fast shipping</span>
          <span>🛡️ 30-day guarantee</span>
        </div>
        <div class="ce-pay">
          <svg viewBox="0 0 40 26" role="img" aria-label="Visa"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><text x="20" y="17.4" text-anchor="middle" font-family="Georgia,'Times New Roman',serif" font-size="11" font-style="italic" font-weight="700" fill="#1434CB" letter-spacing="-.4">VISA</text></svg>
          <svg viewBox="0 0 40 26" role="img" aria-label="Mastercard"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><circle cx="16.6" cy="13" r="6.4" fill="#EB001B"/><circle cx="23.4" cy="13" r="6.4" fill="#F79E1B"/><path d="M20 8.1a6.4 6.4 0 0 1 0 9.8 6.4 6.4 0 0 1 0-9.8z" fill="#FF5F00"/></svg>
          <svg viewBox="0 0 40 26" role="img" aria-label="American Express"><rect width="40" height="26" rx="4" fill="#1F72CD"/><text x="20" y="16.2" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="6.3" font-weight="800" fill="#fff" letter-spacing=".2">AMEX</text></svg>
          <svg viewBox="0 0 40 26" role="img" aria-label="PayPal"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><text x="20" y="17" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="9.5" font-style="italic" font-weight="800"><tspan fill="#003087">Pay</tspan><tspan fill="#0079C1">Pal</tspan></text></svg>
          <svg viewBox="0 0 40 26" role="img" aria-label="Apple Pay"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><path d="M14.7 9.9c-.28.33-.73.59-1.18.55-.06-.45.16-.93.42-1.23.28-.34.77-.58 1.17-.6.05.47-.13.94-.41 1.28zm.4.64c-.65-.04-1.2.37-1.51.37-.31 0-.79-.35-1.3-.34-.67.01-1.29.39-1.63 1-.7 1.2-.18 2.98.5 3.96.33.48.73 1.02 1.25 1 .5-.02.69-.32 1.29-.32.6 0 .78.32 1.3.31.54-.01.88-.49 1.21-.97.38-.55.54-1.09.55-1.12-.01-.01-1.05-.41-1.06-1.6-.01-1 .81-1.48.85-1.51-.47-.69-1.19-.77-1.45-.79z" fill="#000"/><text x="26.5" y="16.6" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="8.5" font-weight="600" fill="#000">Pay</text></svg>
          <svg viewBox="0 0 40 26" role="img" aria-label="Google Pay"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><text x="15.5" y="16.6" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="9" font-weight="700" fill="#4285F4">G</text><text x="26" y="16.6" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="8.5" font-weight="600" fill="#5F6368">Pay</text></svg>
          <svg viewBox="0 0 40 26" role="img" aria-label="Klarna"><rect width="40" height="26" rx="4" fill="#FFB3C7"/><text x="20" y="17" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="8.5" font-weight="800" fill="#0A0B09" letter-spacing=".2">Klarna.</text></svg>
          <svg viewBox="0 0 40 26" role="img" aria-label="Shop Pay"><rect width="40" height="26" rx="4" fill="#5A31F4"/><text x="20" y="16.8" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="9.5" font-weight="800" fill="#fff" letter-spacing=".3">shop</text></svg>
        </div>
        {%- if section.settings.info_enable -%}
        <div class="ce-specs">
          {%- for i in (1..3) -%}
            {%- assign st = 'spec' | append: i | append: '_title' -%}
            {%- assign sb = 'spec' | append: i | append: '_text' -%}
            {%- if section.settings[st] != blank -%}
            <details class="ce-spec"{% if forloop.first %} open{% endif %}><summary>{{ section.settings[st] }}<span class="ce-spec__ico">+</span></summary><div class="ce-spec__body">{{ section.settings[sb] }}</div></details>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- endif -%}
      </div>
      </div>
    </div>
  </div>

  {%- comment -%} ============ 2. INNOVATION ============ {%- endcomment -%}
  {%- if section.settings.innov_enable -%}
  <div class="ce-band">
    <div class="ce-innov">
      <div class="ce-innov__media">
        {%- if section.settings.innov_image != blank -%}<img src="{{ section.settings.innov_image | image_url: width: 800 }}" alt="" loading="lazy">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}
      </div>
      <div class="ce-innov__body">
        <h2 class="ce-h2 ce-h2--left">{{ section.settings.innov_title }}</h2>
        <div class="ce-rte">{{ section.settings.innov_text }}</div>
        <button type="button" class="ce-btn ce-btn--primary" data-addcart>Buy now</button>
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ 3. (Production express retirée) ============ {%- endcomment -%}

  {%- comment -%} ============ 4. AVANT / PENDANT / APRÈS (tabs) ============ {%- endcomment -%}
  {%- if section.settings.tabs_enable -%}
  <div class="ce-band">
    <div class="ce-helps__head">
      {%- if section.settings.helps_logo != blank -%}<img class="ce-helps__logo" src="{{ section.settings.helps_logo | image_url: width: 500 }}" alt="{{ shop.name | escape }}">
      {%- elsif settings.logo != blank -%}<img class="ce-helps__logo" src="{{ settings.logo | image_url: width: 500 }}" alt="{{ shop.name | escape }}">
      {%- else -%}<span class="ce-helps__brand">{{ section.settings.brand_name }}</span>{%- endif -%}
      {%- if section.settings.helps_title != blank -%}<span class="ce-helps__tag">{{ section.settings.helps_title }}</span>{%- endif -%}
    </div>
    <div class="ce-helps__grid">
      <div class="ce-helps__cell">
        <span class="ce-helps__label">{{ section.settings.helps_label1 }}</span>
        <div class="ce-helps__img">{%- if section.settings.tab1_image != blank -%}<img src="{{ section.settings.tab1_image | image_url: width: 700 }}" alt="{{ section.settings.helps_label1 | escape }}" loading="lazy">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}</div>
      </div>
      <div class="ce-helps__cell">
        <span class="ce-helps__label">{{ section.settings.helps_label2 }}</span>
        <div class="ce-helps__img">{%- if section.settings.tab2_image != blank -%}<img src="{{ section.settings.tab2_image | image_url: width: 700 }}" alt="{{ section.settings.helps_label2 | escape }}" loading="lazy">{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}</div>
      </div>
      <div class="ce-helps__cell">
        <span class="ce-helps__label">{{ section.settings.helps_label3 }}</span>
        <div class="ce-helps__img">{%- if section.settings.tab3_image != blank -%}<img src="{{ section.settings.tab3_image | image_url: width: 700 }}" alt="{{ section.settings.helps_label3 | escape }}" loading="lazy">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}</div>
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ 5. UGC SELFIES ============ {%- endcomment -%}
  {%- assign ugcs = section.blocks | where: 'type', 'ugc' -%}
  {%- if ugcs.size > 0 -%}
  <div class="ce-band">
    <div class="ce-ugc__head">
      {%- if section.settings.ugc_badge != blank -%}<span class="ce-ugc__badge">{{ section.settings.ugc_badge }}</span>{%- endif -%}
      <h2 class="ce-ugc__title">{{ section.settings.ugc_title }}</h2>
      {%- if section.settings.ugc_sub != blank -%}<p class="ce-ugc__sub">{{ section.settings.ugc_sub }}</p>{%- endif -%}
    </div>
    <div class="ce-ugc">
      {%- for block in ugcs -%}
        <div class="ce-ugc__item" data-vid {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            <video class="ce-ugc__vid" {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 500 }}"{% endif %} preload="none" loop muted playsinline disablepictureinpicture>
              {%- for s in block.settings.video.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}
            </video>
            <button type="button" class="ce-ugc__play" data-vid-play aria-label="Lire">▶</button>
          {%- elsif block.settings.video_url != blank -%}
            <video class="ce-ugc__vid" {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 500 }}"{% endif %} preload="none" loop muted playsinline disablepictureinpicture>
              <source src="{{ block.settings.video_url }}" type="video/mp4">
            </video>
            <button type="button" class="ce-ugc__play" data-vid-play aria-label="Lire">▶</button>
          {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ 6. FAQ (Comande fréquent) ============ {%- endcomment -%}
  {%- assign faqs = section.blocks | where: 'type', 'faq' -%}
  {%- if faqs.size > 0 -%}
  <div class="ce-band ce-band--tint">
    <div class="ce-faq2">
      <div class="ce-faq2__head">{{ section.settings.faq_title }}</div>
      <div class="ce-faq2__body" data-faq>
        <div class="ce-faq2__list">
          {%- for block in faqs -%}
            <button type="button" class="ce-faq2__q{% if forloop.first %} is-active{% endif %}" data-faq-q="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ block.settings.question }}<span class="ce-faq2__qico">{% if forloop.first %}&rarr;{% else %}&darr;{% endif %}</span></button>
          {%- endfor -%}
        </div>
        <div class="ce-faq2__panes">
          {%- for block in faqs -%}
            <div class="ce-faq2__a{% if forloop.first %} is-active{% endif %}" data-faq-a="{{ forloop.index0 }}">{{ block.settings.answer }}</div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
  <script>
    (function(){
      var wrap = document.querySelector('#ce-{{ section.id }} [data-faq]');
      if (!wrap) return;
      var qs = wrap.querySelectorAll('[data-faq-q]');
      qs.forEach(function(btn){
        btn.addEventListener('click', function(){
          var i = btn.getAttribute('data-faq-q');
          qs.forEach(function(b){ b.classList.remove('is-active'); var ic = b.querySelector('.ce-faq2__qico'); if (ic) ic.innerHTML = '&darr;'; });
          wrap.querySelectorAll('[data-faq-a]').forEach(function(a){ a.classList.remove('is-active'); });
          btn.classList.add('is-active');
          var ic = btn.querySelector('.ce-faq2__qico'); if (ic) ic.innerHTML = '&rarr;';
          var pane = wrap.querySelector('[data-faq-a="' + i + '"]'); if (pane) pane.classList.add('is-active');
        });
      });
    })();
  </script>
  {%- endif -%}

  {%- comment -%} ============ 7. COMPARATEUR VARIANTE / COULEUR ============ {%- endcomment -%}
  {%- if section.settings.cmp_enable -%}
  <div class="ce-band ce-cmp">
    {%- if section.settings.shades_title != blank -%}<h2 class="ce-h2 ce-cmp__h">{{ section.settings.shades_title }}</h2>{%- endif -%}
    <div class="ce-cmp__top">
      <div class="ce-cmp__toggle">
        <span class="ce-cmp__lbl is-on" data-cmp-lbl="variant">{{ section.settings.var_label }}</span>
        <button type="button" class="ce-cmp__sw" role="switch" aria-checked="false" data-cmp-sw aria-label="Compare product and in-mouth color"><span class="ce-cmp__knob"></span></button>
        <span class="ce-cmp__lbl" data-cmp-lbl="color">{{ section.settings.col_label }}</span>
      </div>
    </div>
    <div class="ce-cmp__grid" data-cmp-grid>
      {%- for i in (1..3) -%}
        {%- assign sl = 'shade' | append: i | append: '_label' -%}
        {%- assign sv = 'shade' | append: i | append: '_variant' -%}
        {%- assign sc = 'shade' | append: i | append: '_color' -%}
        {%- if section.settings[sl] != blank -%}
          <figure class="ce-cmp__card">
            <div class="ce-cmp__media">
              <div class="ce-cmp__img ce-cmp__img--variant">{%- if section.settings[sv] != blank -%}<img src="{{ section.settings[sv] | image_url: width: 640 }}" alt="{{ section.settings[sl] | escape }} — device" loading="lazy">{%- else -%}{{ 'product-2' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}</div>
              <div class="ce-cmp__img ce-cmp__img--color">{%- if section.settings[sc] != blank -%}<img src="{{ section.settings[sc] | image_url: width: 640 }}" alt="{{ section.settings[sl] | escape }} — en bouche" loading="lazy">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}</div>
            </div>
            <figcaption>{{ section.settings[sl] }}</figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <script>
    (function(){
      var wrap = document.querySelector('#ce-{{ section.id }} .ce-cmp');
      if (!wrap) return;
      var grid = wrap.querySelector('[data-cmp-grid]');
      var sw = wrap.querySelector('[data-cmp-sw]');
      var lv = wrap.querySelector('[data-cmp-lbl="variant"]');
      var lc = wrap.querySelector('[data-cmp-lbl="color"]');
      if (!sw || !grid) return;
      sw.addEventListener('click', function(){
        var on = grid.classList.toggle('is-color');
        sw.setAttribute('aria-checked', on ? 'true' : 'false');
        if (lv) lv.classList.toggle('is-on', !on);
        if (lc) lc.classList.toggle('is-on', on);
      });
    })();
  </script>
  {%- endif -%}

  {%- comment -%} ============ 8. AVANT / APRÈS (cartes façon Veneera) ============ {%- endcomment -%}
  {%- assign bas = section.blocks | where: 'type', 'ba_photo' -%}
  {%- if bas.size > 0 -%}
  <div class="ce-band ce-band--tint">
    {%- if section.settings.ba_eyebrow != blank -%}<span class="ce-tag">{{ section.settings.ba_eyebrow }}</span>{%- endif -%}
    <h2 class="ce-h2">{{ section.settings.ba_title }}</h2>
    {%- if section.settings.ba_sub != blank -%}<p class="ce-basub">{{ section.settings.ba_sub }}</p>{%- endif -%}
    <div class="ce-barow">
      {%- for block in bas -%}
        <figure class="ce-bacard" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.caption | escape }}" loading="lazy">{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}
          {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ 9. REVIEWS WALL ============ {%- endcomment -%}
  {%- assign reviews = section.blocks | where: 'type', 'review' -%}
  {%- if reviews.size > 0 -%}
  <div class="ce-band">
    <h2 class="ce-h2">{{ section.settings.reviews_title }}</h2>
    <div class="ce-tp"><span class="ce-stars"><span class="ce-stars__bg">★★★★★</span><span class="ce-stars__fill" style="width: {{ section.settings.rating_value | default: 4.7 | times: 20 }}%">★★★★★</span></span><span class="ce-tp__txt">Rated {{ section.settings.rating }} by our customers</span></div>
    <div class="ce-wall">
      {%- for block in reviews -%}
        <article class="ce-rev" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}<div class="ce-rev__img"><img src="{{ block.settings.image | image_url: width: 500 }}" alt="" loading="lazy"></div>{%- endif -%}
          <div class="ce-rev__body">
            <div class="ce-rev__top"><span class="ce-stars ce-stars--sm">★★★★★</span></div>
            {%- if block.settings.title != blank -%}<h3 class="ce-rev__title">{{ block.settings.title }}</h3>{%- endif -%}
            <p class="ce-rev__text">{{ block.settings.text }}</p>
            <div class="ce-rev__auth">— {{ block.settings.author }}</div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ 10. WHATSAPP / SUPPORT CTA ============ {%- endcomment -%}
  {%- if section.settings.wa_enable -%}
  <div class="ce-wa">
    <div class="ce-wa__inner">
      <div class="ce-wa__txt">
        <h2 class="ce-wa__title">{{ section.settings.wa_title }}</h2>
        <p class="ce-wa__sub">{{ section.settings.wa_sub }}</p>
        <div class="ce-wa__btns">
          <button type="button" class="ce-btn ce-btn--white" data-addcart>{{ section.settings.wa_cta1 }}</button>
        </div>
      </div>
      <div class="ce-wa__media">
        {%- if section.settings.wa_image != blank -%}<img src="{{ section.settings.wa_image | image_url: width: 700 }}" alt="" loading="lazy">{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ 11. DESCRIPTION LONGUE (SEO) ============ {%- endcomment -%}
  {%- if section.settings.about_enable -%}
  <div class="ce-band ce-about">
    {%- if section.settings.about_title != blank -%}<h2 class="ce-h2">{{ section.settings.about_title }}</h2>{%- endif -%}
    {%- if section.settings.about_intro != blank -%}<div class="ce-about__p">{{ section.settings.about_intro }}</div>{%- endif -%}
    {%- for i in (1..4) -%}
      {%- assign ht = 'about_h' | append: i -%}
      {%- assign bt = 'about_t' | append: i -%}
      {%- if section.settings[ht] != blank -%}
        <h3 class="ce-about__h">{{ section.settings[ht] }}</h3>
        {%- if section.settings[bt] != blank -%}<div class="ce-about__p">{{ section.settings[bt] }}</div>{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- endif -%}

  {%- comment -%} ============ STICKY MOBILE BAR ============ {%- endcomment -%}
  <div class="ce-sticky" data-sticky hidden>
    <div class="ce-sticky__info">
      <span class="ce-sticky__name">{{ section.settings.sticky_name }}</span>
      <span class="ce-sticky__price">{% if prod != blank %}{{ prod.price | money }}{% else %}{{ section.settings.fallback_price }}{% endif %}</span>
    </div>
    <button type="button" class="ce-btn ce-btn--primary" data-addcart>{{ section.settings.cta_add }}</button>
  </div>
</section>

{%- style -%}
  #ce-{{ section.id }}.ce { --r: 14px; background: var(--ce-bg); color: var(--ce-ink); font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; overflow: hidden; }
  #ce-{{ section.id }} * { box-sizing: border-box; }
  #ce-{{ section.id }} h1, #ce-{{ section.id }} h2, #ce-{{ section.id }} h3 { font-family: 'Manrope', sans-serif; font-weight: 800; letter-spacing: -.02em; }
  #ce-{{ section.id }} img { max-width: 100%; display: block; }
  #ce-{{ section.id }} .ce-ph svg, #ce-{{ section.id }} .ce-ph { width: 100%; height: 100%; object-fit: cover; }

  /* Hero */
  #ce-{{ section.id }} .ce-hero { max-width: 1180px; margin: 0 auto; padding: 20px 18px 8px; display: grid; grid-template-columns: 1fr; gap: 22px; }
  #ce-{{ section.id }} .ce-gallery { display: flex; flex-direction: column-reverse; gap: 10px; }
  #ce-{{ section.id }} .ce-gallery__thumbs { display: flex; flex-direction: row; gap: 10px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
  #ce-{{ section.id }} .ce-gallery__thumbs::-webkit-scrollbar { display: none; }
  #ce-{{ section.id }} .ce-gallery__thumb { width: 76px; height: 76px; border-radius: 12px; overflow: hidden; border: 2px solid var(--ce-line); background: var(--ce-tint); cursor: pointer; padding: 0; flex: 0 0 auto; transition: .12s; }
  #ce-{{ section.id }} .ce-gallery__thumb.is-active { border-color: var(--ce-acc); box-shadow: 0 0 0 2px color-mix(in srgb, var(--ce-acc) 25%, transparent); }
  #ce-{{ section.id }} .ce-gallery__thumb img, #ce-{{ section.id }} .ce-gallery__thumb .ce-ph, #ce-{{ section.id }} .ce-gallery__thumb .ce-ph svg { width: 100%; height: 100%; object-fit: cover; }
  #ce-{{ section.id }} .ce-gallery__main { position: relative; overflow: hidden; background: transparent; aspect-ratio: 1/1; border-radius: 16px; }
  #ce-{{ section.id }} .ce-gallery__slide { position: absolute; inset: 0; opacity: 0; transition: opacity .25s; display: flex; align-items: center; justify-content: center; }
  #ce-{{ section.id }} .ce-gallery__slide.is-active { opacity: 1; }
  #ce-{{ section.id }} .ce-gallery__slide img, #ce-{{ section.id }} .ce-gallery__slide .ce-ph, #ce-{{ section.id }} .ce-gallery__slide .ce-ph svg { width: 100%; height: 100%; object-fit: contain; }

  #ce-{{ section.id }} .ce-badge { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .8px; text-transform: uppercase; color: var(--ce-acc); background: color-mix(in srgb, var(--ce-acc) 10%, #fff); padding: 5px 11px; border-radius: 6px; }
  #ce-{{ section.id }} .ce-title { font-size: clamp(20px, 3.4vw, 26px); font-weight: 700; line-height: 1.18; margin: 4px 0 5px; }
  #ce-{{ section.id }} .ce-subtitle { font-size: 13.5px; color: #55606a; line-height: 1.45; margin: 0 0 12px; }
  #ce-{{ section.id }} .ce-pricerow { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
  #ce-{{ section.id }} .ce-price__now { font-size: 26px; font-weight: 800; font-family: 'Manrope', sans-serif; color: var(--ce-acc); }
  #ce-{{ section.id }} .ce-price__was { font-size: 17px; color: #9aa4ac; text-decoration: line-through; }
  #ce-{{ section.id }} .ce-price__save { font-size: 12px; font-weight: 700; color: #fff; background: #e0555a; padding: 3px 9px; border-radius: 5px; }
  #ce-{{ section.id }} .ce-rating { display: flex; align-items: center; gap: 8px; margin-bottom: 18px; }
  #ce-{{ section.id }} .ce-stars { position: relative; display: inline-block; font-size: 15px; letter-spacing: 1px; line-height: 1; white-space: nowrap; color: #d8dee0; }
  #ce-{{ section.id }} .ce-stars__bg { color: #d8dee0; }
  #ce-{{ section.id }} .ce-stars__fill { position: absolute; left: 0; top: 0; overflow: hidden; white-space: nowrap; color: #f5a623; }
  #ce-{{ section.id }} .ce-stars--sm { font-size: 12px; }
  #ce-{{ section.id }} .ce-rating__txt { font-size: 12.5px; color: #6a747c; }

  /* Options */
  #ce-{{ section.id }} .ce-opt { margin-bottom: 16px; }
  #ce-{{ section.id }} .ce-opt__label { font-size: 13px; color: #55606a; }
  #ce-{{ section.id }} .ce-opt__label b { color: var(--ce-ink); }
  #ce-{{ section.id }} .ce-opt__values { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  #ce-{{ section.id }} .ce-opt__val { padding: 9px 15px; border: 1.5px solid var(--ce-line); background: #fff; border-radius: 9px; font-size: 13px; font-weight: 500; cursor: pointer; color: var(--ce-ink); transition: .12s; }
  #ce-{{ section.id }} .ce-opt__val.is-active { border-color: var(--ce-acc); background: color-mix(in srgb, var(--ce-acc) 8%, #fff); color: var(--ce-acc); font-weight: 700; }

  /* 4 steps mini */
  #ce-{{ section.id }} .ce-steps-mini { background: var(--ce-tint); border-radius: 12px; padding: 14px 16px; margin: 6px 0 16px; }
  #ce-{{ section.id }} .ce-steps-mini__title { display: block; font-weight: 800; font-family: 'Manrope', sans-serif; font-size: 14px; margin-bottom: 10px; }
  #ce-{{ section.id }} .ce-steps-mini ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  #ce-{{ section.id }} .ce-steps-mini li { display: flex; align-items: flex-start; gap: 10px; font-size: 13px; color: #3d474f; line-height: 1.35; }
  #ce-{{ section.id }} .ce-steps-mini__num { flex: 0 0 22px; width: 22px; height: 22px; border-radius: 50%; background: var(--ce-acc); color: #fff; font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-top: 1px; }
  #ce-{{ section.id }} .ce-steps-mini__body { display: flex; flex-direction: column; }
  #ce-{{ section.id }} .ce-steps-mini__body b { font-weight: 700; }
  #ce-{{ section.id }} .ce-steps-mini__note { font-size: 12px; color: #6a747c; line-height: 1.4; margin-top: 2px; }

  /* Buttons */
  #ce-{{ section.id }} .ce-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 15px; border: 0; border-radius: 10px; cursor: pointer; transition: transform .12s, background .15s; text-decoration: none; padding: 15px 26px; }
  #ce-{{ section.id }} .ce-btn--primary { background: var(--ce-acc); color: #fff; box-shadow: 0 8px 20px color-mix(in srgb, var(--ce-acc) 30%, transparent); }
  #ce-{{ section.id }} .ce-btn--primary:hover { background: var(--ce-acc-dark); transform: translateY(-1px); }
  #ce-{{ section.id }} .ce-btn--full { width: 100%; padding: 17px; font-size: 16px; }
  #ce-{{ section.id }} .ce-btn--outline { background: #fff; color: var(--ce-acc); box-shadow: inset 0 0 0 1.5px var(--ce-acc); }
  #ce-{{ section.id }} .ce-btn--outline:hover { background: var(--ce-tint); transform: translateY(-1px); }
  #ce-{{ section.id }} .ce-cta-row { display: flex; gap: 10px; }
  #ce-{{ section.id }} .ce-cta-row .ce-btn { flex: 1 1 0; min-width: 0; padding: 16px 14px; font-size: 15.5px; }
  #ce-{{ section.id }} .ce-btn--dark { background: var(--ce-ink); color: #fff; }
  #ce-{{ section.id }} .ce-btn--white { background: #fff; color: var(--ce-acc); }
  #ce-{{ section.id }} .ce-btn--ghost { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,.6); }

  #ce-{{ section.id }} .ce-buymsg { margin: 10px 0 0; font-size: 13px; font-weight: 600; color: #c0392b; }
  #ce-{{ section.id }} .ce-buymsg[hidden] { display: none; }
  #ce-{{ section.id }} .ce-reassure { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 14px; font-size: 12px; color: #6a747c; }
  #ce-{{ section.id }} .ce-pay { display: flex; gap: 6px; margin-top: 12px; flex-wrap: wrap; }
  #ce-{{ section.id }} .ce-pay svg { width: 38px; height: 25px; border-radius: 4px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }

  /* Bands */
  #ce-{{ section.id }} .ce-band { max-width: 1100px; margin: 0 auto; padding: 42px 18px; }
  #ce-{{ section.id }} .ce-band--tight { padding: 10px 18px 32px; }
  #ce-{{ section.id }} .ce-band--tint { max-width: 100%; background: var(--ce-tint); }
  #ce-{{ section.id }} .ce-band--tint > * { max-width: 1100px; margin-left: auto; margin-right: auto; }
  #ce-{{ section.id }} .ce-h2 { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: clamp(24px, 4vw, 34px); line-height: 1.12; letter-spacing: -.02em; color: var(--ce-ink); text-align: left; margin: 0 0 8px; }
  #ce-{{ section.id }} .ce-h2--left { text-align: left; }
  #ce-{{ section.id }} .ce-sub { text-align: left; color: #55606a; font-size: 15px; line-height: 1.5; max-width: 640px; margin: 0 0 24px; }
  #ce-{{ section.id }} .ce-tag { display: block; text-align: center; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--ce-acc); margin-bottom: 6px; }
  #ce-{{ section.id }} .ce-brandline { text-align: center; font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 20px; color: var(--ce-acc); margin-bottom: 18px; }
  #ce-{{ section.id }} .ce-rte { color: #4a545c; font-size: 15px; line-height: 1.6; margin-bottom: 20px; }
  #ce-{{ section.id }} .ce-rte p { margin: 0 0 12px; }

  /* Innovation */
  #ce-{{ section.id }} .ce-innov { display: grid; grid-template-columns: 1fr; gap: 22px; align-items: center; }
  #ce-{{ section.id }} .ce-innov__media { border-radius: var(--r); overflow: hidden; aspect-ratio: 4/3; background: var(--ce-tint); }
  #ce-{{ section.id }} .ce-innov__media img { width: 100%; height: 100%; object-fit: cover; }

  /* Buy box card (Veneera-style) */
  #ce-{{ section.id }} .ce-card { border: 1px solid var(--ce-line); border-radius: 16px; padding: 20px; background: #fff; box-shadow: 0 14px 34px -22px rgba(20,32,31,.22); }

  /* Helps — avant / snap-on / après (Veneera-style) */
  #ce-{{ section.id }} .ce-helps__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-bottom: 26px; }
  #ce-{{ section.id }} .ce-helps__logo { height: 34px; width: auto; }
  #ce-{{ section.id }} .ce-helps__brand { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 26px; color: var(--ce-acc-dark); }
  #ce-{{ section.id }} .ce-helps__tag { font-size: 21px; color: var(--ce-ink); font-weight: 500; }
  #ce-{{ section.id }} .ce-helps__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 1040px; margin: 0 auto; }
  #ce-{{ section.id }} .ce-helps__cell { margin: 0; text-align: center; }
  #ce-{{ section.id }} .ce-helps__label { display: inline-block; background: #e6f5f4; color: var(--ce-acc-dark); font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 13px; letter-spacing: 1px; text-transform: uppercase; padding: 8px 20px; border-radius: 10px; margin-bottom: 14px; }
  #ce-{{ section.id }} .ce-helps__img { position: relative; border-radius: 14px; overflow: hidden; aspect-ratio: 4/3; background: var(--ce-tint); }
  #ce-{{ section.id }} .ce-helps__img img, #ce-{{ section.id }} .ce-helps__img svg { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Mobile refinements */
  @media (max-width: 749px) {
    #ce-{{ section.id }} .ce-hero { padding: 14px 14px 0; gap: 16px; }
    #ce-{{ section.id }} .ce-gallery { gap: 12px; }
    #ce-{{ section.id }} .ce-gallery__main { border-radius: 14px; }
    #ce-{{ section.id }} .ce-gallery__thumbs { flex-wrap: wrap; overflow-x: visible; gap: 8px; }
    #ce-{{ section.id }} .ce-gallery__thumb { width: 58px; height: 58px; border-radius: 10px; }
    #ce-{{ section.id }} .ce-card { padding: 15px; }
    #ce-{{ section.id }} .ce-offer__head { font-size: 18px; }
    #ce-{{ section.id }} .ce-offer__jaw { padding: 10px 8px; }
    #ce-{{ section.id }} .ce-offer__jaw-img { width: 58px; height: 58px; }
    #ce-{{ section.id }} .ce-offer__jaw-lbl { font-size: 11.5px; }
    #ce-{{ section.id }} .ce-offer__jaw-ico { font-size: 21px; }
    #ce-{{ section.id }} .ce-helps__grid { gap: 8px; }
    #ce-{{ section.id }} .ce-helps__img { border-radius: 10px; }
    #ce-{{ section.id }} .ce-helps__label { font-size: 9.5px; padding: 5px 10px; margin-bottom: 8px; letter-spacing: .5px; }
    #ce-{{ section.id }} .ce-helps__head { gap: 8px; margin-bottom: 18px; }
    #ce-{{ section.id }} .ce-helps__logo { height: 26px; }
    #ce-{{ section.id }} .ce-helps__tag { font-size: 16px; }
  }

  /* Tax note */
  #ce-{{ section.id }} .ce-taxnote { font-size: 12px; color: #8a949c; margin: 0 0 12px; }
  /* Offer banner */
  #ce-{{ section.id }} .ce-offer { background: linear-gradient(135deg, var(--ce-acc-dark) 0%, var(--ce-acc) 100%); color: #fff; border-radius: 16px; padding: 15px 16px; margin: 4px 0 18px; box-shadow: 0 14px 30px -16px rgba(15,91,81,.75); }
  #ce-{{ section.id }} .ce-offer__top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 9px; }
  #ce-{{ section.id }} .ce-offer__eyebrow { font-size: 11px; font-weight: 800; letter-spacing: 1.3px; text-transform: uppercase; opacity: .96; }
  #ce-{{ section.id }} .ce-offer__save { background: #fff; color: var(--ce-acc-dark); font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 13px; padding: 5px 12px; border-radius: 999px; flex-shrink: 0; box-shadow: 0 3px 10px rgba(0,0,0,.16); }
  #ce-{{ section.id }} .ce-offer__head { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: clamp(17px, 2.6vw, 21px); line-height: 1.18; margin-bottom: 14px; text-align: center; }
  #ce-{{ section.id }} .ce-offer__viz { display: flex; align-items: stretch; justify-content: center; gap: 10px; }
  #ce-{{ section.id }} .ce-offer__jaw { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 5px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.24); border-radius: 14px; padding: 12px 10px; }
  #ce-{{ section.id }} .ce-offer__jaw--free { background: #fff; border-color: #fff; }
  #ce-{{ section.id }} .ce-offer__jaw-img { width: 68px; height: 68px; border-radius: 12px; overflow: hidden; background: #fff; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
  #ce-{{ section.id }} .ce-offer__jaw--free .ce-offer__jaw-img { background: #fff; }
  #ce-{{ section.id }} .ce-offer__jaw-img img { width: 100%; height: 100%; object-fit: contain; padding: 5px; display: block; }
  #ce-{{ section.id }} .ce-offer__bonus { display: block; text-align: center; margin-top: 9px; font-size: 12px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; opacity: .92; }
  #ce-{{ section.id }} .ce-offer__jaw-ico { font-size: 24px; line-height: 1; }
  #ce-{{ section.id }} .ce-offer__jaw-lbl { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 12.5px; letter-spacing: .2px; line-height: 1.15; margin-top: 2px; }
  #ce-{{ section.id }} .ce-offer__jaw-state { font-size: 11.5px; opacity: .9; white-space: nowrap; }
  #ce-{{ section.id }} .ce-offer__jaw--free .ce-offer__jaw-lbl { color: var(--ce-ink); }
  #ce-{{ section.id }} .ce-offer__jaw-state--free { color: var(--ce-acc-dark); font-weight: 800; opacity: 1; }
  #ce-{{ section.id }} .ce-offer__plus { align-self: center; font-weight: 800; font-size: 20px; opacity: .92; flex-shrink: 0; }
  #ce-{{ section.id }} .ce-offer__note { font-size: 12px; opacity: .93; line-height: 1.4; margin-top: 12px; text-align: center; }
