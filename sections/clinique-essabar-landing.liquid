  #ce-{{ section.id }} .ce-sticky .ce-btn { flex: 1; padding: 14px; }

  @media (min-width: 750px) {
    #ce-{{ section.id }} .ce-hero { grid-template-columns: 1.05fr 1fr; gap: 40px; padding: 36px 18px 20px; align-items: start; }
    #ce-{{ section.id }} .ce-hero__media { position: sticky; top: 20px; }
    #ce-{{ section.id }} .ce-innov { grid-template-columns: 1fr 1fr; gap: 40px; }
    #ce-{{ section.id }} .ce-ugc { grid-template-columns: repeat(4, 1fr); gap: 14px; }
    #ce-{{ section.id }} .ce-shades { gap: 18px; }
    #ce-{{ section.id }} .ce-bagrid { grid-template-columns: repeat(6, 1fr); gap: 12px; }
    #ce-{{ section.id }} .ce-wall { columns: 3; }
    #ce-{{ section.id }} .ce-wa__inner { grid-template-columns: 1.2fr 1fr; padding: 52px 18px; }
    #ce-{{ section.id }} .ce-sticky { display: none; }
  }
{%- endstyle -%}

<script>
  (function () {
    var root = document.getElementById('ce-{{ section.id }}');
    if (!root) return;

    var slides = root.querySelectorAll('[data-slide]');
    root.querySelectorAll('[data-thumb]').forEach(function (t) {
      t.addEventListener('click', function () {
        var i = t.getAttribute('data-thumb');
        slides.forEach(function (s) { s.classList.toggle('is-active', s.getAttribute('data-slide') === i); });
        root.querySelectorAll('[data-thumb]').forEach(function (x) { x.classList.toggle('is-active', x === t); });
      });
    });

    root.querySelectorAll('[data-tabs]').forEach(function (tabs) {
      tabs.querySelectorAll('[data-tab]').forEach(function (b) {
        b.addEventListener('click', function () {
          var i = b.getAttribute('data-tab');
          tabs.querySelectorAll('[data-tab]').forEach(function (x) { x.classList.toggle('is-active', x === b); });
          tabs.querySelectorAll('[data-pane]').forEach(function (p) { p.classList.toggle('is-active', p.getAttribute('data-pane') === i); });
        });
      });
    });

    var opts = root.querySelector('[data-variants]');
    var input = root.querySelector('[data-variant-input]');
    var variants = [];
    if (opts) { try { variants = JSON.parse(opts.getAttribute('data-variants')); } catch (e) {} }
    function resolve() {
      if (!opts || !variants.length) return;
      var sel = [];
      root.querySelectorAll('[data-opt-pos]').forEach(function (g) {
        var pos = parseInt(g.getAttribute('data-opt-pos'), 10);
        var active = g.querySelector('[data-opt-value].is-active');
        sel[pos - 1] = active ? active.getAttribute('data-value') : null;
        var lbl = root.querySelector('[data-opt-selected="' + pos + '"]');
        if (lbl && active) lbl.textContent = active.getAttribute('data-value');
      });
      var match = variants.filter(function (v) { return v.options.every(function (o, i) { return o === sel[i]; }); })[0];
      if (match && input) input.value = match.id;
    }
    root.querySelectorAll('[data-opt-value]').forEach(function (b) {
      b.addEventListener('click', function () {
        var g = b.closest('[data-opt-pos]');
        g.querySelectorAll('[data-opt-value]').forEach(function (x) { x.classList.remove('is-active'); });
        b.classList.add('is-active');
        resolve();
      });
    });
    resolve();

    function track(id, qty, res) {
      try {
        var it = (res && res.items && res.items[0]) || res || {};
        var val = (it.final_price ? it.final_price / 100 : 0) * qty;
        var cur = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD';
        if (typeof window.fbq === 'function') fbq('track', 'AddToCart', { content_ids: [String(id)], content_type: 'product', value: val, currency: cur });
        if (window.ttq && ttq.track) ttq.track('AddToCart', { content_id: String(id), value: val, currency: cur });
      } catch (e) {}
    }
    function addToCart(btn) {
      var id = input ? input.value : '';
      if (!id) { window.location = '/cart'; return; }
      var drawer = document.querySelector('cart-drawer');
      var original = btn ? btn.innerHTML : '';
      if (btn) { btn.disabled = true; btn.innerHTML = 'Ajout…'; }
      var body = { items: [{ id: Number(id), quantity: 1 }] };
      if (drawer) { body.sections = 'cart-drawer,cart-icon-bubble'; body.sections_url = window.location.pathname; }
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(body) })
        .then(function (r) { if (!r.ok) throw new Error('add'); return r.json(); })
        .then(function (res) {
          if (btn) { btn.disabled = false; btn.innerHTML = original; }
          track(id, 1, res);
          if (!drawer) { window.location = '/cart'; return; }
          try {
            if (res.sections && res.sections['cart-drawer']) {
              var ni = new DOMParser().parseFromString(res.sections['cart-drawer'], 'text/html').querySelector('#CartDrawer');
              var ci = document.querySelector('#CartDrawer');
              if (ni && ci) ci.innerHTML = ni.innerHTML;
            }
            if (res.sections && res.sections['cart-icon-bubble']) {
              var nb = new DOMParser().parseFromString(res.sections['cart-icon-bubble'], 'text/html');
              var newB = nb.querySelector('#cart-icon-bubble') || nb.querySelector('.shopify-section');
              var curB = document.getElementById('cart-icon-bubble');
              if (newB && curB) curB.innerHTML = newB.innerHTML;
            }
            var inner = drawer.querySelector('.drawer__inner'); if (inner) inner.classList.remove('is-empty');
            drawer.classList.remove('is-empty');
            if (typeof drawer.open === 'function') drawer.open();
            else { drawer.classList.add('animate', 'active'); document.body.classList.add('overflow-hidden'); }
          } catch (e) { window.location = '/cart'; }
        }).catch(function () { if (btn) { btn.disabled = false; btn.innerHTML = original; } window.location = '/cart'; });
    }
    root.querySelectorAll('[data-addcart]').forEach(function (b) { b.addEventListener('click', function () { addToCart(b); }); });

    var sticky = root.querySelector('[data-sticky]');
    var buy = root.querySelector('[data-buy]');
    if (sticky && buy && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { es.forEach(function (e) { sticky.hidden = e.isIntersecting; }); }, { rootMargin: '0px 0px -70% 0px' }).observe(buy);
    }

    root.querySelectorAll('[data-vid]').forEach(function (wrap) {
      var v = wrap.querySelector('video'); if (!v) return;
      function play() { v.muted = true; v.preload = 'auto'; var p = v.play(); if (p && p.catch) p.catch(function () {}); wrap.classList.add('is-playing'); }
      function pause() { v.pause(); wrap.classList.remove('is-playing'); }
      wrap.addEventListener('click', function () { if (v.paused) play(); else pause(); });
      if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { es.forEach(function (e) { e.isIntersecting ? play() : pause(); }); }, { threshold: 0.6 }).observe(wrap);
    });
  })();
</script>

