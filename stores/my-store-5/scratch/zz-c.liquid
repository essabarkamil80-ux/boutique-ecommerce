{% schema %}
{
  "name": "SF · Avis (liste)",
  "tag": "section",
  "class": "sf-section-rl",
  "settings": [
    { "type": "paragraph", "content": "Squelette prêt à remplir : uniquement de vrais avis, avec l'accord des clientes. Note et nombre viennent du metafield reviews.rating s'il existe, sinon renseignez vos vraies valeurs." },
    { "type": "product", "id": "product", "label": "Produit (pour la note automatique)" },
    { "type": "text", "id": "rating", "label": "Note réelle (ex. 4.8)" },
    { "type": "text", "id": "count", "label": "Nombre d'avis réel" },
    { "type": "text", "id": "based_label", "label": "Texte sous la note ({count})", "default": "Based on {count} reviews" },
    { "type": "text", "id": "no_reviews_label", "label": "Texte sans avis", "default": "No reviews yet" },
    { "type": "header", "content": "Critères (curseurs)" },
    { "type": "text", "id": "c1_label", "label": "Critère 1", "default": "Fit" },
    { "type": "range", "id": "c1_value", "min": 0, "max": 5, "step": 0.1, "label": "Critère 1 : valeur réelle moyenne (0 = masqué)", "default": 0 },
    { "type": "text", "id": "c1_a", "label": "Critère 1 : gauche", "default": "Runs small" },
    { "type": "text", "id": "c1_b", "label": "Critère 1 : milieu", "default": "True to size" },
    { "type": "text", "id": "c1_c", "label": "Critère 1 : droite", "default": "Runs large" },
    { "type": "text", "id": "c2_label", "label": "Critère 2", "default": "Comfort" },
    { "type": "range", "id": "c2_value", "min": 0, "max": 5, "step": 0.1, "label": "Critère 2 : valeur réelle moyenne (0 = masqué)", "default": 0 },
    { "type": "text", "id": "c2_a", "label": "Critère 2 : gauche", "default": "Not comfortable" },
    { "type": "text", "id": "c2_b", "label": "Critère 2 : milieu", "default": "Comfortable" },
    { "type": "text", "id": "c2_c", "label": "Critère 2 : droite", "default": "Very comfortable" },
    { "type": "header", "content": "Textes de l'interface" },
    { "type": "text", "id": "write_label", "label": "Bouton « écrire un avis »", "default": "Write a review" },
    { "type": "url", "id": "write_link", "label": "Lien du bouton (vide = page contact ; mettez le formulaire de votre appli d'avis)" },
    { "type": "text", "id": "sort_label", "label": "Tri : libellé", "default": "Sort by" },
    { "type": "text", "id": "sort_new", "label": "Tri : récents", "default": "Most recent" },
    { "type": "text", "id": "sort_high", "label": "Tri : meilleures notes", "default": "Highest rating" },
    { "type": "text", "id": "sort_low", "label": "Tri : notes les plus basses", "default": "Lowest rating" },
    { "type": "text", "id": "search_label", "label": "Recherche", "default": "Search" },
    { "type": "text", "id": "tab_reviews", "label": "Onglet avis", "default": "Product reviews" },
    { "type": "text", "id": "tab_questions", "label": "Onglet questions", "default": "Questions" },
    { "type": "text", "id": "no_questions", "label": "Message sans question", "default": "No questions yet." },
    { "type": "text", "id": "verified_label", "label": "Libellé achat vérifié", "default": "Verified purchase" },
    { "type": "text", "id": "recommends_label", "label": "Libellé recommandation", "default": "Recommends this product" },
    { "type": "text", "id": "helpful_label", "label": "Question « utile ? »", "default": "Was this review helpful?" },
    { "type": "text", "id": "yes_label", "label": "Oui", "default": "Yes" },
    { "type": "text", "id": "no_label", "label": "Non", "default": "No" },
    { "type": "range", "id": "per_page", "min": 3, "max": 10, "step": 1, "label": "Avis par page", "default": 5 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo de la bande",
      "limit": 16,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo de cliente" },
        { "type": "checkbox", "id": "is_video", "label": "Afficher l'icône vidéo", "default": false }
      ]
    },
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "label": "Étoiles", "default": 0 },
        { "type": "text", "id": "name", "label": "Nom", "default": "Customer name" },
        { "type": "checkbox", "id": "verified", "label": "Achat vérifié (seulement si c'est réel)", "default": false },
        { "type": "checkbox", "id": "recommends", "label": "Recommande le produit", "default": false },
        { "type": "text", "id": "title", "label": "Titre de l'avis", "default": "Review title" },
        { "type": "textarea", "id": "text", "label": "Texte de l'avis", "default": "Paste a real customer review here." },
        { "type": "range", "id": "c1_value", "min": 0, "max": 5, "step": 0.1, "label": "Critère 1 (0 = pas de curseur)", "default": 0 },
        { "type": "range", "id": "c2_value", "min": 0, "max": 5, "step": 0.1, "label": "Critère 2 (0 = pas de curseur)", "default": 0 },
        { "type": "image_picker", "id": "photo", "label": "Photo (optionnelle)" },
        { "type": "text", "id": "date", "label": "Date (ex. il y a 3 jours)" }
      ]
    }
  ],
  "presets": [ { "name": "SF · Avis (liste)", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] } ]
}
{% endschema %}
