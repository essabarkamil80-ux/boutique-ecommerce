  #ce-{{ section.id }} .ce-rev { break-inside: avoid; margin-bottom: 14px; border: 1px solid var(--ce-line); border-radius: 12px; overflow: hidden; background: #fff; }
  #ce-{{ section.id }} .ce-rev__img img { width: 100%; height: auto; display: block; }
  #ce-{{ section.id }} .ce-rev__body { padding: 14px 16px; }
  #ce-{{ section.id }} .ce-rev__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  #ce-{{ section.id }} .ce-rev__v { font-size: 11px; color: var(--ce-acc); font-weight: 600; }
  #ce-{{ section.id }} .ce-rev__title { font-size: 15px; margin: 0 0 5px; }
  #ce-{{ section.id }} .ce-rev__text { font-size: 13.5px; color: #4a545c; line-height: 1.55; margin: 0 0 10px; }
  #ce-{{ section.id }} .ce-rev__auth { font-size: 12.5px; font-weight: 600; color: #6a747c; }

  /* WhatsApp / support CTA */
  #ce-{{ section.id }} .ce-about { max-width: 900px; }
  #ce-{{ section.id }} .ce-about__h { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: clamp(18px, 3vw, 23px); color: var(--ce-ink); margin: 24px 0 8px; }
  #ce-{{ section.id }} .ce-about__p { font-size: 15px; color: #55606a; line-height: 1.65; }
  #ce-{{ section.id }} .ce-about__p p { margin: 0 0 10px; }

  #ce-{{ section.id }} .ce-wa { background: linear-gradient(120deg, #10a09b 0%, #34b3a8 48%, #cfe9de 100%); color: #fff; }
  #ce-{{ section.id }} .ce-wa__inner { max-width: 1100px; margin: 0 auto; padding: 40px 18px; display: grid; grid-template-columns: 1fr; gap: 22px; align-items: center; }
  #ce-{{ section.id }} .ce-wa__title { font-size: clamp(22px, 5vw, 30px); line-height: 1.2; margin: 0 0 10px; color: #fff; }
  #ce-{{ section.id }} .ce-wa__sub { font-size: 15px; opacity: .92; line-height: 1.5; margin: 0 0 20px; }
  #ce-{{ section.id }} .ce-wa__btns { display: flex; flex-wrap: wrap; gap: 10px; }
  #ce-{{ section.id }} .ce-wa__media { display: flex; align-items: center; justify-content: center; }
  #ce-{{ section.id }} .ce-wa__media img { width: 100%; max-width: none; height: auto; filter: drop-shadow(0 22px 40px rgba(0,0,0,.22)); }

  /* Sticky */
  #ce-{{ section.id }} .ce-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; align-items: center; gap: 12px; padding: 10px 14px calc(10px + env(safe-area-inset-bottom)); background: rgba(255,255,255,.97); backdrop-filter: blur(8px); border-top: 1px solid var(--ce-line); box-shadow: 0 -4px 18px rgba(0,0,0,.06); }
  #ce-{{ section.id }} .ce-sticky__info { display: flex; flex-direction: column; line-height: 1.2; }
  #ce-{{ section.id }} .ce-sticky__name { font-size: 12px; color: #6a747c; }
  #ce-{{ section.id }} .ce-sticky__price { font-size: 17px; font-weight: 800; color: var(--ce-acc); }
