<script>
  (function () {
    var root = document.getElementById('ce-{{ section.id }}');
    if (!root) return;

    /* Gallery */
    var slides = root.querySelectorAll('[data-slide]');
    root.querySelectorAll('[data-thumb]').forEach(function (t) {
      t.addEventListener('click', function () {
        var i = t.getAttribute('data-thumb');
        slides.forEach(function (s) { s.classList.toggle('is-active', s.getAttribute('data-slide') === i); });
        root.querySelectorAll('[data-thumb]').forEach(function (x) { x.classList.toggle('is-active', x === t); });
      });
    });

    /* Variant resolution */
    var opts = root.querySelector('[data-variants]');
    var input = root.querySelector('[data-variant-input]');
    var variants = [];
    if (opts) { try { variants = JSON.parse(opts.getAttribute('data-variants')); } catch (e) {} }
    function money(cents) {
      try { return (cents / 100).toLocaleString(undefined, { style: 'currency', currency: (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD' }); }
      catch (e) { return '$' + (cents / 100).toFixed(2); }
    }
    function resolve() {
      if (!opts || !variants.length) return;
      var sel = [];
      root.querySelectorAll('[data-opt-pos]').forEach(function (g) {
        var pos = parseInt(g.getAttribute('data-opt-pos'), 10);
        var active = g.querySelector('[data-opt-value].is-active');
        sel[pos - 1] = active ? active.getAttribute('data-value') : null;
        var lbl = root.querySelector('[data-opt-selected="' + pos + '"]');
        if (lbl && active) lbl.textContent = active.getAttribute('data-value');
      });
      var match = variants.filter(function (v) { return v.options.every(function (o, i) { return o === sel[i]; }); })[0];
      if (match) {
        if (input) input.value = match.id;
        var p = root.querySelector('[data-drawer-price]');
        if (p) p.textContent = money(match.price);
      }
    }
    root.querySelectorAll('[data-opt-value]').forEach(function (b) {
      b.addEventListener('click', function () {
        var g = b.closest('[data-opt-pos]');
        g.querySelectorAll('[data-opt-value]').forEach(function (x) { x.classList.remove('is-active'); });
        b.classList.add('is-active');
        resolve();
      });
    });
    resolve();

    /* Quantity */
    var qty = root.querySelector('[data-qty-input]');
    root.querySelector('[data-qty-minus]') && root.querySelector('[data-qty-minus]').addEventListener('click', function () { qty.value = Math.max(1, (parseInt(qty.value, 10) || 1) - 1); });
    root.querySelector('[data-qty-plus]') && root.querySelector('[data-qty-plus]').addEventListener('click', function () { qty.value = (parseInt(qty.value, 10) || 1) + 1; });

    /* Drawer */
    var drawer = root.querySelector('[data-drawer]');
    function openDrawer() { if (!drawer) return; drawer.hidden = false; requestAnimationFrame(function () { drawer.classList.add('is-open'); }); document.body.style.overflow = 'hidden'; }
    function closeDrawer() { if (!drawer) return; drawer.classList.remove('is-open'); document.body.style.overflow = ''; setTimeout(function () { drawer.hidden = true; }, 300); }
    root.querySelectorAll('[data-open-drawer]').forEach(function (b) { b.addEventListener('click', openDrawer); });
    root.querySelectorAll('[data-close-drawer]').forEach(function (b) { b.addEventListener('click', closeDrawer); });

    /* Checkout (buy now → direct to checkout) */
    var checkoutBtn = root.querySelector('[data-checkout]');
    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', function () {
        var id = input ? input.value : '';
        var q = qty ? (parseInt(qty.value, 10) || 1) : 1;
        if (!id) { window.location = '/cart'; return; }
        var original = checkoutBtn.innerHTML;
        checkoutBtn.disabled = true; checkoutBtn.innerHTML = 'Redirection…';
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: [{ id: Number(id), quantity: q }] })
        }).then(function (r) { if (!r.ok) throw new Error('add'); return r.json(); })
          .then(function (res) {
            try {
              var it = (res.items && res.items[0]) || res || {};
              var val = (it.final_price ? it.final_price / 100 : 0) * q;
              var cur = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD';
              if (typeof window.fbq === 'function') { fbq('track', 'AddToCart', { content_ids: [String(id)], content_type: 'product', value: val, currency: cur }); fbq('track', 'InitiateCheckout', { value: val, currency: cur }); }
              if (window.ttq && ttq.track) { ttq.track('InitiateCheckout', { value: val, currency: cur }); }
            } catch (e) {}
            window.location = '/checkout';
          }).catch(function () { checkoutBtn.disabled = false; checkoutBtn.innerHTML = original; window.location = '/cart'; });
      });
    }

    /* Sticky bar: show after hero scrolled past */
    var sticky = root.querySelector('[data-sticky]');
    var hero = root.querySelector('.ce-hero__info');
    if (sticky && hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { sticky.hidden = e.isIntersecting; });
      }, { rootMargin: '0px 0px -80% 0px' }).observe(hero);
    }
  })();
</script>

