  #wld-felispace-{{ section.id }} .wld-felispace-faq__icon { font-size: 22px; color: var(--wld-primary); flex-shrink: 0; transition: transform .2s; }
  #wld-felispace-{{ section.id }} .wld-felispace-faq__item.is-open .wld-felispace-faq__icon { transform: rotate(45deg); }
  #wld-felispace-{{ section.id }} .wld-felispace-faq__a { max-height: 0; overflow: hidden; transition: max-height .25s ease; }
