{% comment %}theme-check-disable ImgWidthAndHeight,RemoteAsset,AssetUrlFilters,RemoteAssetUrl{% endcomment %}
{%- comment -%} Clinique Essabar — homepage (reference DTC structure, own code + placeholders) {%- endcomment -%}
{%- assign prod = section.settings.product | default: product -%}
{%- if prod != blank -%}{%- assign purl = prod.url -%}{%- else -%}{%- assign purl = '/collections/all' -%}{%- endif -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<section id="ch-{{ section.id }}" class="ch" style="--ch-acc: {{ section.settings.color_accent }}; --ch-acc-dark: {{ section.settings.color_accent_dark }}; --ch-ink: {{ section.settings.color_ink }};">

  {%- comment -%} ===== 1. HERO (media on top, title below — veneera style) ===== {%- endcomment -%}
  <div class="ch-hero">
    <div class="ch-hero__media">
      {%- if section.settings.hero_video_url != blank -%}
        <video autoplay loop muted playsinline disablepictureinpicture {% if section.settings.hero_image != blank %}poster="{{ section.settings.hero_image | image_url: width: 1600 }}"{% endif %}>
          <source src="{{ section.settings.hero_video_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.hero_video != blank -%}
        {{ section.settings.hero_video | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false }}
      {%- elsif section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" alt="" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'ch-ph' }}
      {%- endif -%}
    </div>
    <div class="ch-hero__txt">
      {%- if section.settings.hero_badge != blank -%}<span class="ch-eyebrow">{{ section.settings.hero_badge }}</span>{%- endif -%}
      <h1 class="ch-hero__title">{{ section.settings.hero_title }}</h1>
      <p class="ch-hero__sub">{{ section.settings.hero_sub }}</p>
      {%- if section.settings.hero_cta != blank -%}<a href="{{ purl }}" class="ch-btn ch-hero__btn">{{ section.settings.hero_cta }}</a>{%- endif -%}
    </div>
  </div>

  {%- comment -%} ===== 2. PRODUCT / SHADE CARDS ===== {%- endcomment -%}
  {%- assign cards = section.blocks | where: 'type', 'card' -%}
  {%- if cards.size > 0 -%}
  <div class="ch-band">
    <div class="ch-cards">
      {%- for block in cards -%}
        <a class="ch-card" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ purl }}{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}<span class="ch-card__badge">{{ block.settings.badge }}</span>{%- endif -%}
          {%- if block.settings.award != blank -%}<span class="ch-card__award"><img src="{{ block.settings.award | image_url: width: 120 }}" alt="" loading="lazy"></span>{%- endif -%}
          <div class="ch-card__media">
            {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name | escape }}" loading="lazy">{%- else -%}{{ 'product-2' | placeholder_svg_tag: 'ch-ph' }}{%- endif -%}
          </div>
          <div class="ch-card__name">{{ block.settings.name }}</div>
          {%- if block.settings.subtitle != blank -%}<div class="ch-card__sub">{{ block.settings.subtitle }}</div>{%- endif -%}
          <div class="ch-card__price">
            {%- if block.settings.compare != blank -%}<span class="ch-card__was">{{ block.settings.compare }}</span>{%- endif -%}
            <span class="ch-card__now">{{ block.settings.price }}</span>
          </div>
          {%- if section.settings.card_taxes != blank -%}<div class="ch-card__taxes">{{ section.settings.card_taxes }}</div>{%- endif -%}
          <span class="ch-btn ch-btn--dark ch-btn--sm ch-card__cta">{{ section.settings.card_cta }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== 3. HOW IT WORKS ===== {%- endcomment -%}
  {%- assign steps = section.blocks | where: 'type', 'step' -%}
  {%- if steps.size > 0 -%}
  <div class="ch-band ch-band--tint">
    <span class="ch-eyebrow ch-eyebrow--center">{{ section.settings.steps_eyebrow }}</span>
    <h2 class="ch-h2">{{ section.settings.steps_title }}</h2>
    <p class="ch-sub">{{ section.settings.steps_sub }}</p>
    <div class="ch-how">
      <div class="ch-how__media">
        {%- if section.settings.steps_image != blank -%}<img src="{{ section.settings.steps_image | image_url: width: 1000 }}" alt="" loading="lazy">{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'ch-ph' }}{%- endif -%}
      </div>
      <div class="ch-how__steps">
        {%- for block in steps -%}
          <div class="ch-step" {{ block.shopify_attributes }}>
            <span class="ch-step__tag">Étape {{ forloop.index }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== 4. FACTS ICONS (line-art, veneera style) ===== {%- endcomment -%}
  {%- if section.settings.feat_enable -%}
  <div class="ch-band ch-band--tight">
    <div class="ch-brandline">{{ section.settings.feat_label }}</div>
    <div class="ch-facts">
      <span class="ch-fact" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.2c-2.4 0-3.3 1.1-4.8 1.1S4.3 3.6 4.3 6c0 2.9 1 4.8 1.5 8.2.4 2.4.8 5.3 2.2 5.3 1.2 0 1.4-2.9 2-4.8.3-1 .8-1.5 2-1.5s1.7.5 2 1.5c.6 1.9.8 4.8 2 4.8 1.4 0 1.8-2.9 2.2-5.3.5-3.4 1.5-5.3 1.5-8.2 0-2.4-1.4-1.7-2.9-1.7S14.4 3.2 12 3.2Z"/></svg></span>
      <span class="ch-fact" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.3L19.5 10l-5.6 1.7L12 17l-1.9-5.3L4.5 10l5.6-1.7L12 3Z"/><path d="M18 15l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7.7-2Z"/></svg></span>
      <span class="ch-fact" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9.5h.01M15 9.5h.01"/></svg></span>
      <span class="ch-fact" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6l7-3Z"/><path d="M9 12l2 2 4-4"/></svg></span>
      <span class="ch-fact" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.2s6 6.3 6 10.3A6 6 0 0 1 6 13.5C6 9.5 12 3.2 12 3.2Z"/></svg></span>
      <span class="ch-fact" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 6-13.2 14-13.2 0 8-5 14-13 14"/><path d="M5.5 18.5c3-4.2 6.2-6.5 10.5-8.3"/></svg></span>
      <span class="ch-fact" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.2"/><circle cx="12" cy="12" r="3.4"/><path d="M12 1.8v2.6M12 19.6v2.6M1.8 12h2.6M19.6 12h2.6"/></svg></span>
      <span class="ch-fact" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 2"/></svg></span>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== 5. WHY (accordion + media) ===== {%- endcomment -%}
  {%- assign whys = section.blocks | where: 'type', 'why' -%}
  {%- if whys.size > 0 -%}
  <div class="ch-band">
    <div class="ch-why">
      <div class="ch-why__panel">
        <div class="ch-why__head">{{ section.settings.why_title }}</div>
        {%- for block in whys -%}
          <details class="ch-why__item"{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.title }}<span class="ch-why__ico">⌄</span></summary>
            <div class="ch-why__body">{{ block.settings.text }}</div>
          </details>
        {%- endfor -%}
      </div>
      <div class="ch-why__media">
        {%- assign why_img = section.settings.why_image | default: section.settings.stats_image -%}
        {%- if why_img != blank -%}<img src="{{ why_img | image_url: width: 1000 }}" alt="" loading="lazy" width="1000" height="750">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ch-ph' }}{%- endif -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== 5b. FAQ (même design que la page produit) ===== {%- endcomment -%}
  {%- assign faqs = section.blocks | where: 'type', 'faq' -%}
  {%- if faqs.size > 0 -%}
  <div class="ch-band ch-band--tint">
    <div class="ch-faq2">
      <div class="ch-faq2__head">{{ section.settings.faq_title }}</div>
      <div class="ch-faq2__body" data-faq>
        <div class="ch-faq2__list">
          {%- for block in faqs -%}
            <button type="button" class="ch-faq2__q{% if forloop.first %} is-active{% endif %}" data-faq-q="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ block.settings.question }}<span class="ch-faq2__qico">{% if forloop.first %}&rarr;{% else %}&darr;{% endif %}</span></button>
          {%- endfor -%}
        </div>
        <div class="ch-faq2__panes">
          {%- for block in faqs -%}
            <div class="ch-faq2__a{% if forloop.first %} is-active{% endif %}" data-faq-a="{{ forloop.index0 }}">{{ block.settings.answer }}</div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
  <script>
    (function(){
      var wrap = document.querySelector('#ch-{{ section.id }} [data-faq]');
      if (!wrap) return;
      var qs = wrap.querySelectorAll('[data-faq-q]');
      qs.forEach(function(btn){
        btn.addEventListener('click', function(){
          var i = btn.getAttribute('data-faq-q');
          qs.forEach(function(b){ b.classList.remove('is-active'); var ic = b.querySelector('.ch-faq2__qico'); if (ic) ic.innerHTML = '&darr;'; });
          wrap.querySelectorAll('[data-faq-a]').forEach(function(a){ a.classList.remove('is-active'); });
          btn.classList.add('is-active');
          var ic = btn.querySelector('.ch-faq2__qico'); if (ic) ic.innerHTML = '&rarr;';
          var pane = wrap.querySelector('[data-faq-a="' + i + '"]'); if (pane) pane.classList.add('is-active');
        });
      });
    })();
  </script>
  {%- endif -%}

  {%- comment -%} ===== 6. STATS (carte façon Veneera) ===== {%- endcomment -%}
  {%- if section.settings.stats_enable -%}
  <div class="ch-band">
    <div class="ch-stats2">
      {%- if section.settings.stats_badge != blank -%}<img class="ch-stats2__badge" src="{{ section.settings.stats_badge | image_url: width: 180 }}" alt="" loading="lazy">{%- endif -%}
      <div class="ch-stats2__media">
        {%- assign simg = section.settings.stats_image | default: section.settings.why_image -%}
        {%- if simg != blank -%}<img src="{{ simg | image_url: width: 1000 }}" alt="" loading="lazy">{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'ch-ph' }}{%- endif -%}
      </div>
      <div class="ch-stats2__list">
        {%- assign rows = section.settings.stats_lines | newline_to_br | split: '<br />' -%}
        {%- for row in rows -%}
          {%- assign rt = row | strip -%}{%- if rt == blank -%}{%- continue -%}{%- endif -%}
          {%- assign parts = rt | split: '|' -%}
          {%- assign big = parts[0] | strip -%}
          {%- assign small = parts[1] | strip -%}
          <div class="ch-stats2__row"><span class="ch-stats2__big">{{ big }}</span>{%- if small != blank -%}<span class="ch-stats2__sep"></span><span class="ch-stats2__small">{{ small }}</span>{%- endif -%}</div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== 7. KIT CTA BAND ===== {%- endcomment -%}
  {%- if section.settings.kit_enable -%}
  <div class="ch-kit">
    <div class="ch-kit__inner">
      <div class="ch-kit__txt">
        <h2 class="ch-kit__title">{{ section.settings.kit_title }}</h2>
        <p class="ch-kit__sub">{{ section.settings.kit_text }}</p>
        <a href="{{ purl }}" class="ch-btn ch-btn--white">{{ section.settings.kit_cta }}</a>
      </div>
      <div class="ch-kit__media">
        {%- if section.settings.kit_image != blank -%}<img src="{{ section.settings.kit_image | image_url: width: 800 }}" alt="" loading="lazy">{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'ch-ph' }}{%- endif -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== 8. VIDÉOS CLIENTS (4 vidéos — même section que la page produit) ===== {%- endcomment -%}
  {%- assign ugcs = section.blocks | where: 'type', 'ugc' -%}
  {%- if ugcs.size > 0 -%}
  <div class="ch-band">
    <div class="ch-ugc__head">
      {%- if section.settings.ugc_badge != blank -%}<span class="ch-ugc__badge">{{ section.settings.ugc_badge }}</span>{%- endif -%}
      <h2 class="ch-ugc__title">{{ section.settings.ugc_title }}</h2>
      {%- if section.settings.ugc_sub != blank -%}<p class="ch-ugc__sub">{{ section.settings.ugc_sub }}</p>{%- endif -%}
    </div>
    <div class="ch-ugc">
      {%- for block in ugcs -%}
        <div class="ch-ugc__item" data-vid {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            <video class="ch-ugc__vid" {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 500 }}"{% endif %} preload="none" loop muted playsinline disablepictureinpicture>
              {%- for s in block.settings.video.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}
            </video>
            <button type="button" class="ch-ugc__play" data-vid-play aria-label="Lire">&#9658;</button>
          {%- elsif block.settings.video_url != blank -%}
            <video class="ch-ugc__vid" {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 500 }}"{% endif %} preload="none" loop muted playsinline disablepictureinpicture>
              <source src="{{ block.settings.video_url }}" type="video/mp4">
            </video>
            <button type="button" class="ch-ugc__play" data-vid-play aria-label="Lire">&#9658;</button>
          {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ch-ph' }}{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  <script>
    (function () {
      var root = document.getElementById('ch-{{ section.id }}');
      if (!root) return;
      root.querySelectorAll('[data-vid]').forEach(function (wrap) {
        var v = wrap.querySelector('video'); if (!v) return;
        function play() { v.muted = true; v.preload = 'auto'; var p = v.play(); if (p && p.catch) p.catch(function () {}); wrap.classList.add('is-playing'); }
        function pause() { v.pause(); wrap.classList.remove('is-playing'); }
        wrap.addEventListener('click', function () { if (v.paused) play(); else pause(); });
        if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { es.forEach(function (e) { e.isIntersecting ? play() : pause(); }); }, { threshold: 0.6 }).observe(wrap);
      });
    })();
  </script>
  {%- endif -%}
</section>

{%- style -%}
  #ch-{{ section.id }}.ch { --ch-mint: #e8f1f8; --ch-cardline: #d6e3f0; --ch-tint: #eef5f2; background: #fff; color: var(--ch-ink); font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; overflow: hidden; }
  #ch-{{ section.id }} * { box-sizing: border-box; }
  #ch-{{ section.id }} h1, #ch-{{ section.id }} h2, #ch-{{ section.id }} h3 { font-family: 'Manrope', sans-serif; font-weight: 800; letter-spacing: -.02em; }
  #ch-{{ section.id }} img { max-width: 100%; display: block; }
  #ch-{{ section.id }} .ch-ph, #ch-{{ section.id }} .ch-ph svg { width: 100%; height: 100%; object-fit: cover; }

  #ch-{{ section.id }} .ch-band { max-width: 1140px; margin: 0 auto; padding: 48px 18px; }
  #ch-{{ section.id }} .ch-band--tight { padding: 20px 18px 34px; }
  #ch-{{ section.id }} .ch-band--tint { max-width: 100%; background: var(--ch-tint); }
  #ch-{{ section.id }} .ch-band--tint > * { max-width: 1140px; margin-left: auto; margin-right: auto; }
  #ch-{{ section.id }} .ch-h2 { font-size: clamp(23px, 5vw, 32px); text-align: center; margin: 0 0 8px; line-height: 1.15; }
  #ch-{{ section.id }} .ch-sub { text-align: center; color: #6a747c; font-size: 15px; max-width: 620px; margin: 0 auto 26px; line-height: 1.55; }
  #ch-{{ section.id }} .ch-eyebrow { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--ch-acc); }
  #ch-{{ section.id }} .ch-eyebrow--center { display: block; text-align: center; margin-bottom: 6px; }
  #ch-{{ section.id }} .ch-brandline { text-align: center; font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 20px; color: var(--ch-acc); margin-bottom: 16px; }

  #ch-{{ section.id }} .ch-btn { display: inline-flex; align-items: center; justify-content: center; font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 15px; border: 0; border-radius: 10px; cursor: pointer; text-decoration: none; padding: 14px 26px; background: var(--ch-acc); color: #fff; transition: .15s; }
  #ch-{{ section.id }} .ch-btn:hover { background: var(--ch-acc-dark); transform: translateY(-1px); }
  #ch-{{ section.id }} .ch-btn--sm { padding: 10px 20px; font-size: 13.5px; }
  #ch-{{ section.id }} .ch-btn--white { background: #fff; color: var(--ch-acc); }
  #ch-{{ section.id }} .ch-btn--dark { background: var(--ch-ink); color: #fff; }
  #ch-{{ section.id }} .ch-btn--dark:hover { background: #000; }

  /* Hero — media on top, title centered below (veneera) */
  #ch-{{ section.id }} .ch-hero { padding: 18px 18px 0; max-width: 1140px; margin: 0 auto; }
  #ch-{{ section.id }} .ch-hero__media { width: 100%; aspect-ratio: 16/10; background: #e9ecef; overflow: hidden; border-radius: 18px; }
  #ch-{{ section.id }} .ch-hero__media img, #ch-{{ section.id }} .ch-hero__media video { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  #ch-{{ section.id }} .ch-hero__txt { text-align: center; padding: 28px 18px 8px; max-width: 720px; margin: 0 auto; }
  #ch-{{ section.id }} .ch-hero__txt .ch-eyebrow { margin-bottom: 10px; }
  #ch-{{ section.id }} .ch-hero__title { font-size: clamp(26px, 5.5vw, 40px); line-height: 1.12; margin: 0 0 12px; }
  #ch-{{ section.id }} .ch-hero__sub { font-size: clamp(15px, 2vw, 17px); color: #55606a; line-height: 1.5; margin: 0 0 18px; }
  #ch-{{ section.id }} .ch-hero__btn { padding: 14px 30px; }
  @media (max-width: 749px) { #ch-{{ section.id }} .ch-hero__media { aspect-ratio: 4/5; } }

  /* Cards — veneera style: mint card, centered badge pill, navy text, dark button */
  #ch-{{ section.id }} .ch-cards { display: grid; grid-template-columns: 1fr; gap: 22px; }
  #ch-{{ section.id }} .ch-card { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 20px 16px 22px; border: 1px solid rgba(18,41,58,.06); border-radius: 18px; background: {{ section.settings.card_bg | default: '#a8cee0' }}; text-decoration: none; color: var(--ch-ink); transition: .18s; }
  #ch-{{ section.id }} .ch-card:hover { box-shadow: 0 16px 36px rgba(18,41,58,.12); transform: translateY(-3px); }
  #ch-{{ section.id }} .ch-card__badge { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: linear-gradient(90deg, var(--ch-acc-dark), var(--ch-acc)); color: #fff; font-size: 12px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; padding: 7px 20px; border-radius: 9px; white-space: nowrap; box-shadow: 0 6px 16px rgba(18,41,58,.18); }
  #ch-{{ section.id }} .ch-card__award { position: absolute; top: 16px; right: 16px; width: 56px; z-index: 2; }
  #ch-{{ section.id }} .ch-card__award img { width: 100%; height: auto; }
  #ch-{{ section.id }} .ch-card__media { width: 100%; aspect-ratio: 1/1; overflow: hidden; border-radius: 12px; background: transparent; margin: 8px 0 14px; display: flex; align-items: center; justify-content: center; }
  #ch-{{ section.id }} .ch-card__media img { width: 100%; height: 100%; object-fit: cover; }
  #ch-{{ section.id }} .ch-card__media .ch-ph, #ch-{{ section.id }} .ch-card__media .ch-ph svg { width: 100%; height: 100%; object-fit: contain; }
  #ch-{{ section.id }} .ch-card__name { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 24px; color: var(--ch-ink); }
  #ch-{{ section.id }} .ch-card__sub { font-size: 13px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--ch-ink); opacity: .78; margin-top: 7px; font-weight: 600; }
  #ch-{{ section.id }} .ch-card__price { display: flex; gap: 10px; align-items: baseline; justify-content: center; margin: 16px 0 6px; }
  #ch-{{ section.id }} .ch-card__was { color: #8a97a0; text-decoration: line-through; font-size: 16px; }
  #ch-{{ section.id }} .ch-card__now { font-weight: 800; font-size: 21px; color: var(--ch-ink); }
  #ch-{{ section.id }} .ch-card__taxes { font-size: 12.5px; color: #7c8891; margin: 0 0 18px; }
  #ch-{{ section.id }} .ch-card__cta { width: 100%; padding: 14px; border-radius: 10px; }

  /* FAQ (identique à la page produit) */
  #ch-{{ section.id }} .ch-faq2 { max-width: 1100px; margin: 0 auto; }
  #ch-{{ section.id }} .ch-faq2__head { background: linear-gradient(120deg, var(--ch-acc), var(--ch-acc-dark)); color: #fff; font-family: 'Manrope', sans-serif; font-weight: 800; font-size: clamp(20px, 3vw, 28px); padding: 22px 26px; border-radius: 14px; }
  #ch-{{ section.id }} .ch-faq2__body { display: grid; grid-template-columns: 1fr; gap: 14px; margin-top: 16px; }
  #ch-{{ section.id }} .ch-faq2__list { display: flex; flex-direction: column; gap: 10px; }
  #ch-{{ section.id }} .ch-faq2__q { text-align: left; background: #fff; border: 1px solid #e4e9e8; border-radius: 12px; padding: 16px 18px; font-family: inherit; font-weight: 600; font-size: 15px; color: var(--ch-ink); cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; transition: .15s; }
  #ch-{{ section.id }} .ch-faq2__q:hover { border-color: var(--ch-acc); }
  #ch-{{ section.id }} .ch-faq2__q.is-active { background: var(--ch-acc); color: #fff; border-color: var(--ch-acc); }
  #ch-{{ section.id }} .ch-faq2__qico { flex: 0 0 auto; font-weight: 800; }
  #ch-{{ section.id }} .ch-faq2__panes { background: #fff; border: 1px solid #e4e9e8; border-radius: 14px; padding: 24px; }
  #ch-{{ section.id }} .ch-faq2__a { display: none; font-size: 15px; color: #3d474f; line-height: 1.65; }
  #ch-{{ section.id }} .ch-faq2__a.is-active { display: block; }
  #ch-{{ section.id }} .ch-faq2__a p { margin: 0 0 10px; }

  /* How it works — big media with step cards overlapping the bottom (veneera) */
  #ch-{{ section.id }} .ch-how { position: relative; }
  #ch-{{ section.id }} .ch-how__media { border-radius: 18px; overflow: hidden; aspect-ratio: 4/5; background: #e9ecef; }
  #ch-{{ section.id }} .ch-how__media img { width: 100%; height: 100%; object-fit: cover; }
  #ch-{{ section.id }} .ch-how__steps { display: grid; gap: 12px; margin: -34px 12px 0; position: relative; z-index: 2; }
  #ch-{{ section.id }} .ch-step { background: #fff; border: 1px solid #eaeeed; border-radius: 14px; padding: 18px 20px; box-shadow: 0 12px 30px rgba(0,0,0,.08); }
  #ch-{{ section.id }} .ch-step__tag { display: inline-block; background: var(--ch-acc); color: #fff; font-size: 11px; font-weight: 700; letter-spacing: .3px; padding: 4px 11px; border-radius: 6px; margin-bottom: 9px; }
  #ch-{{ section.id }} .ch-step h3 { font-size: 16px; margin: 0 0 5px; }
  #ch-{{ section.id }} .ch-step p { font-size: 13.5px; color: #6a747c; line-height: 1.5; margin: 0; }

  /* Facts — line-art icon row (veneera) */
  #ch-{{ section.id }} .ch-facts { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 18px 22px; }
  #ch-{{ section.id }} .ch-fact { color: var(--ch-acc); flex: 0 0 auto; }
  #ch-{{ section.id }} .ch-fact svg { width: 42px; height: 42px; display: block; }

  /* Why */
  #ch-{{ section.id }} .ch-why { display: grid; grid-template-columns: 1fr; gap: 22px; align-items: start; }
  #ch-{{ section.id }} .ch-why__head { background: var(--ch-acc); color: #fff; font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 17px; padding: 14px 18px; border-radius: 12px 12px 0 0; }
  #ch-{{ section.id }} .ch-why__panel { border: 1px solid #e4e9e8; border-radius: 12px; overflow: hidden; }
  #ch-{{ section.id }} .ch-why__item { border-top: 1px solid #e4e9e8; }
  #ch-{{ section.id }} .ch-why__item summary { list-style: none; cursor: pointer; padding: 14px 18px; font-size: 14.5px; font-weight: 600; display: flex; justify-content: space-between; align-items: center; }
  #ch-{{ section.id }} .ch-why__item summary::-webkit-details-marker { display: none; }
  #ch-{{ section.id }} .ch-why__ico { color: var(--ch-acc); transition: transform .2s; }
  #ch-{{ section.id }} .ch-why__item[open] .ch-why__ico { transform: rotate(180deg); }
  #ch-{{ section.id }} .ch-why__body { padding: 0 18px 16px; font-size: 13.5px; color: #55606a; line-height: 1.55; }
  #ch-{{ section.id }} .ch-why__media { border-radius: 16px; overflow: hidden; aspect-ratio: 4/3; background: #e9ecef; }
  #ch-{{ section.id }} .ch-why__media img { width: 100%; height: 100%; object-fit: cover; }

  /* Stats — carte veneera */
  #ch-{{ section.id }} .ch-stats2 { position: relative; display: grid; grid-template-columns: 1fr; background: linear-gradient(135deg, #d8ebe4, #cbe4dc); border-radius: 22px; overflow: hidden; }
  #ch-{{ section.id }} .ch-stats2__media { position: relative; aspect-ratio: 5/4; background: #cfe4dd; }
  #ch-{{ section.id }} .ch-stats2__media img, #ch-{{ section.id }} .ch-stats2__media .ch-ph, #ch-{{ section.id }} .ch-stats2__media .ch-ph svg { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  #ch-{{ section.id }} .ch-stats2__badge { position: absolute; top: 16px; left: 16px; width: 62px; height: auto; z-index: 3; }
  #ch-{{ section.id }} .ch-stats2__list { display: flex; flex-direction: column; gap: 12px; padding: 20px; justify-content: center; }
  #ch-{{ section.id }} .ch-stats2__row { display: flex; align-items: center; gap: 16px; background: rgba(255,255,255,.4); border-radius: 16px; padding: 14px 18px; }
  #ch-{{ section.id }} .ch-stats2__big { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: clamp(26px, 6vw, 42px); color: var(--ch-ink); line-height: 1; white-space: nowrap; }
  #ch-{{ section.id }} .ch-stats2__sep { align-self: stretch; width: 1px; background: rgba(18,41,58,.22); flex: 0 0 auto; }
  #ch-{{ section.id }} .ch-stats2__small { font-size: 14px; color: #3d5560; line-height: 1.25; }
  #ch-{{ section.id }} .ch-stat { margin-bottom: 14px; }

  /* Kit */
  #ch-{{ section.id }} .ch-kit { background: linear-gradient(120deg, var(--ch-acc), var(--ch-acc-dark)); color: #fff; }
  #ch-{{ section.id }} .ch-kit__inner { max-width: 1140px; margin: 0 auto; padding: 40px 18px; display: grid; grid-template-columns: 1fr; gap: 20px; align-items: center; }
  #ch-{{ section.id }} .ch-kit__title { font-size: clamp(22px, 5vw, 30px); color: #fff; margin: 0 0 10px; line-height: 1.2; }
  #ch-{{ section.id }} .ch-kit__sub { font-size: 15px; opacity: .92; line-height: 1.55; margin: 0 0 20px; }
  #ch-{{ section.id }} .ch-kit__media { border-radius: 16px; overflow: hidden; }

  /* Social */
  #ch-{{ section.id }} .ch-ugc__head { text-align: center; max-width: 720px; margin: 0 auto 18px; }
  #ch-{{ section.id }} .ch-ugc__badge { display: inline-block; background: linear-gradient(90deg, #8b5cf6, #ec4899); color: #fff; font-family: 'Manrope', sans-serif; font-size: 11px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; padding: 6px 12px; border-radius: 8px; margin-bottom: 12px; }
  #ch-{{ section.id }} .ch-ugc__title { font-size: clamp(23px, 5vw, 32px); margin: 0 0 8px; line-height: 1.15; }
  #ch-{{ section.id }} .ch-ugc__sub { color: #6a747c; font-size: 15px; margin: 0; }
  #ch-{{ section.id }} .ch-ugc { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  #ch-{{ section.id }} .ch-ugc__item { position: relative; border-radius: 14px; overflow: hidden; aspect-ratio: 9/16; background: #e9ecef; cursor: pointer; }
  #ch-{{ section.id }} .ch-ugc__vid { width: 100%; height: 100%; object-fit: cover; }
  #ch-{{ section.id }} .ch-ugc__item .ch-ph, #ch-{{ section.id }} .ch-ugc__item .ch-ph svg { width: 100%; height: 100%; object-fit: cover; }
  #ch-{{ section.id }} .ch-ugc__play { position: absolute; inset: 0; margin: auto; width: 50px; height: 50px; border-radius: 50%; border: 0; background: rgba(255,255,255,.92); color: var(--ch-ink); font-size: 15px; padding-left: 3px; cursor: pointer; }
  #ch-{{ section.id }} .ch-ugc__item.is-playing .ch-ugc__play { display: none; }

  @media (min-width: 750px) {
    #ch-{{ section.id }} .ch-hero__media { aspect-ratio: 16/9; }
    #ch-{{ section.id }} .ch-cards { grid-template-columns: repeat(3, 1fr); gap: 22px; }
    #ch-{{ section.id }} .ch-how__media { aspect-ratio: 16/7; }
    #ch-{{ section.id }} .ch-how__steps { grid-template-columns: repeat(3, 1fr); gap: 18px; margin: -70px 28px 0; }
    #ch-{{ section.id }} .ch-facts { gap: 22px 40px; }
    #ch-{{ section.id }} .ch-fact svg { width: 48px; height: 48px; }
    #ch-{{ section.id }} .ch-why { grid-template-columns: 1fr 1fr; gap: 40px; }
    #ch-{{ section.id }} .ch-faq2__body { grid-template-columns: 0.85fr 1.15fr; align-items: start; }
    #ch-{{ section.id }} .ch-kit__inner { grid-template-columns: 1.2fr 1fr; padding: 52px 18px; }
    #ch-{{ section.id }} .ch-ugc { grid-template-columns: repeat(4, 1fr); gap: 14px; }
    #ch-{{ section.id }} .ch-stats2 { grid-template-columns: 1.1fr 1fr; min-height: 420px; }
    #ch-{{ section.id }} .ch-stats2__media { aspect-ratio: auto; height: 100%; }
    #ch-{{ section.id }} .ch-stats2__list { padding: 34px 32px; gap: 16px; }
  }
{%- endstyle -%}

