{%- comment -%}
  Clinique Essabar — Premium clip-on veneers product landing (mobile-first, high-conversion)
  Funnel: "Acheter" → options drawer → "Continuer" → direct to checkout.
  All content is editable in the theme editor. Placeholders included where assets are missing.
{%- endcomment -%}

{%- assign prod = section.settings.product | default: product -%}
{%- assign acc = section.settings.color_accent -%}
{%- assign ink = section.settings.color_ink -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<section id="ce-{{ section.id }}" class="ce"
  style="--ce-acc: {{ acc }}; --ce-ink: {{ ink }}; --ce-bg: {{ section.settings.color_bg }}; --ce-tint: {{ section.settings.color_tint }}; --ce-line: {{ section.settings.color_line }};">

  {%- comment -%} ============ TRUST STRIP ============ {%- endcomment -%}
  <div class="ce-strip">
    <div class="ce-strip__track">
      <span>✓ Sur-mesure sans dentiste</span><i>·</i>
      <span>🚚 Livraison offerte &amp; suivie</span><i>·</i>
      <span>🛡️ Garantie satisfait ou remboursé 30 jours</span><i>·</i>
      <span>🔒 Paiement sécurisé</span><i>·</i>
      <span>✓ Sur-mesure sans dentiste</span><i>·</i>
      <span>🚚 Livraison offerte &amp; suivie</span><i>·</i>
      <span>🛡️ Garantie 30 jours</span><i>·</i>
      <span>🔒 Paiement sécurisé</span><i>·</i>
    </div>
  </div>

  {%- comment -%} ============ HERO / BUY BOX ============ {%- endcomment -%}
  <div class="ce-hero">
    <div class="ce-hero__media">
      {%- assign imgs = prod.images -%}
      <div class="ce-gallery" data-gallery>
        <div class="ce-gallery__main">
          {%- if imgs.size > 0 -%}
            {%- for image in imgs limit: 6 -%}
              <div class="ce-gallery__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}">
                <img src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | default: prod.title | escape }}" width="1000" height="1000" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="ce-gallery__slide is-active" data-slide="0">{{ 'product-1' | placeholder_svg_tag: 'ce-ph' }}</div>
            <div class="ce-gallery__slide" data-slide="1">{{ 'product-2' | placeholder_svg_tag: 'ce-ph' }}</div>
          {%- endif -%}
        </div>
        <div class="ce-gallery__thumbs">
          {%- if imgs.size > 0 -%}
            {%- for image in imgs limit: 6 -%}
              <button type="button" class="ce-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ forloop.index0 }}" aria-label="Voir l'image {{ forloop.index }}">
                <img src="{{ image | image_url: width: 200 }}" alt="" width="80" height="80" loading="lazy">
              </button>
            {%- endfor -%}
          {%- else -%}
            <button type="button" class="ce-gallery__thumb is-active" data-thumb="0">{{ 'product-1' | placeholder_svg_tag: 'ce-ph' }}</button>
            <button type="button" class="ce-gallery__thumb" data-thumb="1">{{ 'product-2' | placeholder_svg_tag: 'ce-ph' }}</button>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="ce-hero__info">
      <span class="ce-eyebrow">{{ section.settings.brand_name }}</span>
      <h1 class="ce-title">{{ section.settings.hero_title }}</h1>

      <div class="ce-rating">
        <span class="ce-stars">★★★★★</span>
        <span class="ce-rating__txt">{{ section.settings.rating }} · {{ section.settings.review_count }}</span>
      </div>

      <p class="ce-lede">{{ section.settings.hero_sub }}</p>

      {%- if section.settings.usp_list != blank -%}
        <ul class="ce-usp">
          {%- assign usps = section.settings.usp_list | newline_to_br | split: '<br />' -%}
          {%- for u in usps -%}{%- assign ut = u | strip -%}{%- if ut != blank -%}<li>{{ ut }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="ce-price">
        {%- if prod != blank -%}
          <span class="ce-price__now">{{ prod.price | money }}</span>
          {%- if prod.compare_at_price > prod.price -%}
            <span class="ce-price__was">{{ prod.compare_at_price | money }}</span>
            {%- assign save = prod.compare_at_price | minus: prod.price -%}
            <span class="ce-price__save">Économisez {{ save | money }}</span>
          {%- endif -%}
        {%- else -%}
          <span class="ce-price__now">{{ section.settings.fallback_price }}</span>
        {%- endif -%}
      </div>
      <div class="ce-price__note">{{ section.settings.price_note }}</div>

      <button type="button" class="ce-btn ce-btn--primary ce-btn--lg" data-open-drawer>
        {{ section.settings.cta_buy }}
      </button>

      <div class="ce-reassure">
        <span>🔒 {{ section.settings.reassure_1 }}</span>
        <span>🚚 {{ section.settings.reassure_2 }}</span>
        <span>🛡️ {{ section.settings.reassure_3 }}</span>
      </div>

      <div class="ce-pay">
        <svg viewBox="0 0 40 26"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><text x="20" y="17.5" text-anchor="middle" font-family="Arial" font-size="11" font-style="italic" font-weight="800" fill="#1434CB">VISA</text></svg>
        <svg viewBox="0 0 40 26"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><circle cx="16.5" cy="13" r="7" fill="#eb001b"/><circle cx="23.5" cy="13" r="7" fill="#f79e1b"/></svg>
        <svg viewBox="0 0 40 26"><rect width="40" height="26" rx="4" fill="#1F72CD"/><rect x="4" y="9.5" width="32" height="7" rx="1" fill="#fff"/><text x="20" y="15" text-anchor="middle" font-family="Arial" font-size="6" font-weight="800" fill="#1F72CD">AMEX</text></svg>
        <svg viewBox="0 0 40 26"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><text x="20" y="17" text-anchor="middle" font-family="Arial" font-size="10" font-style="italic" font-weight="800"><tspan fill="#003087">Pay</tspan><tspan fill="#009cde">Pal</tspan></text></svg>
        <svg viewBox="0 0 40 26"><rect width="40" height="26" rx="4" fill="#000"/><text x="20" y="17" text-anchor="middle" font-family="Arial" font-size="9" font-weight="600" fill="#fff">Pay</text></svg>
      </div>
    </div>
  </div>

  {%- comment -%} ============ PRESS / AS SEEN IN ============ {%- endcomment -%}
  {%- if section.settings.press_title != blank -%}
  <div class="ce-press">
    <span class="ce-press__label">{{ section.settings.press_title }}</span>
    <div class="ce-press__row">
      {%- for i in (1..5) -%}
        {%- assign key = 'press_logo_' | append: i -%}
        {%- if section.settings[key] != blank -%}
          <img src="{{ section.settings[key] | image_url: width: 240 }}" alt="" loading="lazy" height="26">
        {%- else -%}
          <span class="ce-press__ph">LOGO</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ HOW IT WORKS ============ {%- endcomment -%}
  {%- assign steps = section.blocks | where: 'type', 'step' -%}
  {%- if steps.size > 0 -%}
  <div class="ce-band">
    <h2 class="ce-h2">{{ section.settings.steps_title }}</h2>
    <p class="ce-sub">{{ section.settings.steps_sub }}</p>
    <div class="ce-steps">
      {%- for block in steps -%}
        <div class="ce-step" {{ block.shopify_attributes }}>
          <span class="ce-step__num">{{ forloop.index }}</span>
          <div class="ce-step__body">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ BEFORE / AFTER ============ {%- endcomment -%}
  {%- if section.settings.ba_enable -%}
  <div class="ce-band ce-band--tint">
    <h2 class="ce-h2">{{ section.settings.ba_title }}</h2>
    <p class="ce-sub">{{ section.settings.ba_sub }}</p>
    <div class="ce-ba">
      <figure class="ce-ba__col">
        <div class="ce-ba__media">
          {%- if section.settings.ba_before != blank -%}<img src="{{ section.settings.ba_before | image_url: width: 800 }}" alt="Avant" loading="lazy">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}
          <span class="ce-ba__tag ce-ba__tag--before">Avant</span>
        </div>
      </figure>
      <figure class="ce-ba__col">
        <div class="ce-ba__media">
          {%- if section.settings.ba_after != blank -%}<img src="{{ section.settings.ba_after | image_url: width: 800 }}" alt="Après" loading="lazy">{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}
          <span class="ce-ba__tag ce-ba__tag--after">Après</span>
        </div>
      </figure>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ BENEFITS ============ {%- endcomment -%}
  {%- assign benefits = section.blocks | where: 'type', 'benefit' -%}
  {%- if benefits.size > 0 -%}
  <div class="ce-band">
    <h2 class="ce-h2">{{ section.settings.benefits_title }}</h2>
    <div class="ce-benefits">
      {%- for block in benefits -%}
        <div class="ce-benefit" {{ block.shopify_attributes }}>
          <span class="ce-benefit__ico">{{ block.settings.icon }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
    <button type="button" class="ce-btn ce-btn--primary ce-btn--center" data-open-drawer>{{ section.settings.cta_buy }}</button>
  </div>
  {%- endif -%}

  {%- comment -%} ============ COMPARISON ============ {%- endcomment -%}
  {%- if section.settings.cmp_enable -%}
  <div class="ce-band ce-band--tint">
    <h2 class="ce-h2">{{ section.settings.cmp_title }}</h2>
    <div class="ce-cmp">
      <table class="ce-cmp__table">
        <thead>
          <tr>
            <th class="ce-cmp__feat"></th>
            <th class="ce-cmp__ours">{{ section.settings.cmp_ours }}</th>
            <th>{{ section.settings.cmp_them1 }}</th>
            <th>{{ section.settings.cmp_them2 }}</th>
          </tr>
        </thead>
        <tbody>
          {%- assign rows = section.settings.cmp_rows | newline_to_br | split: '<br />' -%}
          {%- for row in rows -%}
            {%- assign rt = row | strip -%}{%- if rt == blank -%}{%- continue -%}{%- endif -%}
            {%- assign cells = rt | split: '|' -%}
            <tr>
              <td class="ce-cmp__feat">{{ cells[0] | strip }}</td>
              <td class="ce-cmp__ours">{% if cells[1] and cells[1] | strip == 'x' %}<span class="ce-x">✕</span>{% else %}<span class="ce-check">✓</span>{% if cells[1] %} {{ cells[1] | strip }}{% endif %}{% endif %}</td>
              <td>{% if cells[2] and cells[2] | strip == '✓' %}<span class="ce-check ce-check--mute">✓</span>{% else %}<span class="ce-x">✕</span>{% if cells[2] %} {{ cells[2] | strip }}{% endif %}{% endif %}</td>
              <td>{% if cells[3] and cells[3] | strip == '✓' %}<span class="ce-check ce-check--mute">✓</span>{% else %}<span class="ce-x">✕</span>{% if cells[3] %} {{ cells[3] | strip }}{% endif %}{% endif %}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ REVIEWS ============ {%- endcomment -%}
  {%- assign reviews = section.blocks | where: 'type', 'review' -%}
  {%- if reviews.size > 0 -%}
  <div class="ce-band">
    <h2 class="ce-h2">{{ section.settings.reviews_title }}</h2>
    <div class="ce-tp">
      <span class="ce-stars">★★★★★</span>
      <span class="ce-tp__txt">{{ section.settings.reviews_sub }}</span>
    </div>
    <div class="ce-reviews">
      {%- for block in reviews -%}
        <article class="ce-review" {{ block.shopify_attributes }}>
          <div class="ce-review__top">
            <span class="ce-stars ce-stars--sm">★★★★★</span>
            <span class="ce-review__verified">✓ Achat vérifié</span>
          </div>
          {%- if block.settings.title != blank -%}<h3 class="ce-review__title">{{ block.settings.title }}</h3>{%- endif -%}
          <p class="ce-review__text">{{ block.settings.text }}</p>
          <div class="ce-review__author">
            {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 80 }}" alt="" width="36" height="36" loading="lazy">{%- else -%}<span class="ce-review__avatar">{{ block.settings.author | slice: 0 }}</span>{%- endif -%}
            <span>{{ block.settings.author }}</span>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ GUARANTEE ============ {%- endcomment -%}
  {%- if section.settings.guarantee_enable -%}
  <div class="ce-band">
    <div class="ce-guarantee">
      <span class="ce-guarantee__badge">🛡️</span>
      <h2 class="ce-h2">{{ section.settings.guarantee_title }}</h2>
      <p class="ce-sub">{{ section.settings.guarantee_text }}</p>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ FAQ ============ {%- endcomment -%}
  {%- assign faqs = section.blocks | where: 'type', 'faq' -%}
  {%- if faqs.size > 0 -%}
  <div class="ce-band ce-band--tint">
    <h2 class="ce-h2">{{ section.settings.faq_title }}</h2>
    <div class="ce-faq">
      {%- for block in faqs -%}
        <details class="ce-faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span class="ce-faq__ico">+</span></summary>
          <div class="ce-faq__ans">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ FINAL CTA ============ {%- endcomment -%}
  <div class="ce-final">
    <h2 class="ce-final__title">{{ section.settings.final_title }}</h2>
    <p class="ce-final__sub">{{ section.settings.final_sub }}</p>
    <button type="button" class="ce-btn ce-btn--primary ce-btn--lg" data-open-drawer>{{ section.settings.cta_buy }}</button>
    <div class="ce-reassure ce-reassure--center">
      <span>🔒 {{ section.settings.reassure_1 }}</span>
      <span>🛡️ {{ section.settings.reassure_3 }}</span>
    </div>
  </div>

  {%- comment -%} ============ STICKY MOBILE BAR ============ {%- endcomment -%}
  <div class="ce-sticky" data-sticky hidden>
    <div class="ce-sticky__info">
      <span class="ce-sticky__name">{{ section.settings.sticky_name }}</span>
      <span class="ce-sticky__price">{% if prod != blank %}{{ prod.price | money }}{% else %}{{ section.settings.fallback_price }}{% endif %}</span>
    </div>
    <button type="button" class="ce-btn ce-btn--primary" data-open-drawer>{{ section.settings.cta_buy }}</button>
  </div>

  {%- comment -%} ============ OPTION DRAWER (FUNNEL) ============ {%- endcomment -%}
  <div class="ce-drawer" data-drawer hidden>
    <div class="ce-drawer__overlay" data-close-drawer></div>
    <div class="ce-drawer__panel" role="dialog" aria-label="Choisir vos options">
      <div class="ce-drawer__head">
        <span class="ce-drawer__title">{{ section.settings.drawer_title }}</span>
        <button type="button" class="ce-drawer__close" data-close-drawer aria-label="Fermer">✕</button>
      </div>

      <div class="ce-drawer__product">
        {%- if imgs.size > 0 -%}<img src="{{ imgs[0] | image_url: width: 160 }}" alt="" width="60" height="60">{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}
        <div>
          <span class="ce-drawer__pname">{{ prod.title | default: section.settings.hero_title }}</span>
          <span class="ce-drawer__pprice" data-drawer-price>{% if prod != blank %}{{ prod.price | money }}{% else %}{{ section.settings.fallback_price }}{% endif %}</span>
        </div>
      </div>

      {%- if prod != blank and prod.has_only_default_variant == false -%}
        <div class="ce-opts" data-variants='{{ prod.variants | json | escape }}'>
          {%- for opt in prod.options_with_values -%}
            <div class="ce-opt" data-opt-pos="{{ opt.position }}">
              <span class="ce-opt__label">{{ opt.name }} : <b data-opt-selected="{{ opt.position }}">{{ opt.selected_value }}</b></span>
              <div class="ce-opt__values">
                {%- for val in opt.values -%}
                  <button type="button" class="ce-opt__val{% if val == opt.selected_value %} is-active{% endif %}" data-opt-value data-value="{{ val | escape }}">{{ val }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
        <input type="hidden" data-variant-input value="{{ prod.selected_or_first_available_variant.id }}">
      {%- elsif prod != blank -%}
        <input type="hidden" data-variant-input value="{{ prod.selected_or_first_available_variant.id }}">
      {%- endif -%}

      <div class="ce-qty">
        <span class="ce-qty__label">Quantité</span>
        <div class="ce-qty__ctrl">
          <button type="button" data-qty-minus aria-label="Moins">−</button>
          <input type="number" value="1" min="1" data-qty-input inputmode="numeric" aria-label="Quantité">
          <button type="button" data-qty-plus aria-label="Plus">+</button>
        </div>
      </div>

      <button type="button" class="ce-btn ce-btn--primary ce-btn--lg ce-btn--full" data-checkout>
        {{ section.settings.cta_continue }}
      </button>
      <div class="ce-drawer__trust">
        <span>🔒 {{ section.settings.reassure_1 }}</span><i>·</i><span>🛡️ {{ section.settings.reassure_3 }}</span>
      </div>
      <div class="ce-pay ce-pay--drawer">
        <svg viewBox="0 0 40 26"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><text x="20" y="17.5" text-anchor="middle" font-family="Arial" font-size="11" font-style="italic" font-weight="800" fill="#1434CB">VISA</text></svg>
        <svg viewBox="0 0 40 26"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><circle cx="16.5" cy="13" r="7" fill="#eb001b"/><circle cx="23.5" cy="13" r="7" fill="#f79e1b"/></svg>
        <svg viewBox="0 0 40 26"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><text x="20" y="17" text-anchor="middle" font-family="Arial" font-size="10" font-style="italic" font-weight="800"><tspan fill="#003087">Pay</tspan><tspan fill="#009cde">Pal</tspan></text></svg>
      </div>
    </div>
  </div>
</section>

{%- style -%}
  #ce-{{ section.id }}.ce { --ce-radius: 16px; background: var(--ce-bg); color: var(--ce-ink); font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; overflow: hidden; }
  #ce-{{ section.id }} * { box-sizing: border-box; }
  #ce-{{ section.id }} h1, #ce-{{ section.id }} h2, #ce-{{ section.id }} h3 { font-family: 'Fraunces', Georgia, serif; font-weight: 500; letter-spacing: -.01em; }
  #ce-{{ section.id }} img { max-width: 100%; display: block; }
  #ce-{{ section.id }} .ce-ph svg, #ce-{{ section.id }} .ce-ph { width: 100%; height: 100%; object-fit: cover; }

  /* Trust strip */
  #ce-{{ section.id }} .ce-strip { background: var(--ce-ink); color: #fff; overflow: hidden; }
  #ce-{{ section.id }} .ce-strip__track { display: flex; gap: 18px; align-items: center; white-space: nowrap; padding: 9px 0; font-size: 12px; animation: ce-marquee 26s linear infinite; }
  #ce-{{ section.id }} .ce-strip i { opacity: .4; }
  @keyframes ce-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* Hero */
  #ce-{{ section.id }} .ce-hero { max-width: 1160px; margin: 0 auto; padding: 22px 20px 8px; display: grid; grid-template-columns: 1fr; gap: 22px; }
  #ce-{{ section.id }} .ce-gallery__main { position: relative; border-radius: var(--ce-radius); overflow: hidden; background: var(--ce-tint); aspect-ratio: 1/1; }
  #ce-{{ section.id }} .ce-gallery__slide { position: absolute; inset: 0; opacity: 0; transition: opacity .3s; }
  #ce-{{ section.id }} .ce-gallery__slide.is-active { opacity: 1; }
  #ce-{{ section.id }} .ce-gallery__slide img { width: 100%; height: 100%; object-fit: cover; }
  #ce-{{ section.id }} .ce-gallery__thumbs { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; scrollbar-width: none; }
  #ce-{{ section.id }} .ce-gallery__thumbs::-webkit-scrollbar { display: none; }
  #ce-{{ section.id }} .ce-gallery__thumb { flex: 0 0 62px; width: 62px; height: 62px; border-radius: 11px; overflow: hidden; border: 1.5px solid var(--ce-line); background: var(--ce-tint); cursor: pointer; padding: 0; }
  #ce-{{ section.id }} .ce-gallery__thumb.is-active { border-color: var(--ce-acc); }
  #ce-{{ section.id }} .ce-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }

  #ce-{{ section.id }} .ce-eyebrow { display: inline-block; font-size: 11px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: var(--ce-acc); }
  #ce-{{ section.id }} .ce-title { font-size: clamp(28px, 6.5vw, 40px); line-height: 1.08; margin: 8px 0 12px; }
  #ce-{{ section.id }} .ce-rating { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  #ce-{{ section.id }} .ce-stars { color: #e8b400; letter-spacing: 1px; font-size: 15px; }
  #ce-{{ section.id }} .ce-stars--sm { font-size: 13px; }
  #ce-{{ section.id }} .ce-rating__txt { font-size: 13px; color: var(--ce-ink); opacity: .7; }
  #ce-{{ section.id }} .ce-lede { font-size: 15.5px; line-height: 1.6; color: #4a4f55; margin: 0 0 16px; }
  #ce-{{ section.id }} .ce-usp { list-style: none; padding: 0; margin: 0 0 20px; display: grid; gap: 9px; }
  #ce-{{ section.id }} .ce-usp li { position: relative; padding-left: 27px; font-size: 14.5px; line-height: 1.4; color: #2c3036; }
