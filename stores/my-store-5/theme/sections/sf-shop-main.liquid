{% stylesheet %}
  .sf-shop { background: #fff; padding: 24px 0 56px; }
  .sf-shop__empty { padding: 40px 0; text-align: center; color: #8b8280; }
  .sf-shop__wrap { max-width: calc(1328px + 2 * clamp(16px, 3.9vw, 56px)); margin: 0 auto; padding-inline: clamp(16px, 3.9vw, 56px); }
  .sf-shop__grid { display: grid; grid-template-columns: minmax(0, 732fr) minmax(0, 542fr); column-gap: clamp(24px, 3.75vw, 54px); align-items: start; }
  .sf-shop__gal, .sf-shop__buy { min-width: 0; }

  /* galerie : miniatures sous l'image (comme la reference) ou a gauche */
  .sf-shop__gal { position: sticky; top: 20px; }
  .sf-shop__thumbs { display: flex; gap: 8px; padding: 2px; overflow-x: auto; scrollbar-width: none; position: relative; }
  .sf-shop__thumbs::-webkit-scrollbar { display: none; }
  .sf-shop__thumbs li { flex: 0 0 auto; width: clamp(64px, 7.6vw, 110px); }
  .sf-shop__thumb { display: block; width: 100%; aspect-ratio: 1; padding: 0; border: 2px solid transparent; background: #F7F5F3; overflow: hidden; }
  .sf-shop__thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .sf-shop__thumb.is-active { border-color: var(--sf-ink); }
  .sf-shop__gal--below.has-thumbs { display: flex; flex-direction: column; }
  .sf-shop__gal--below .sf-shop__aside { order: 2; margin-top: 10px; }
  .sf-shop__gal--left.has-thumbs { display: grid; grid-template-columns: clamp(60px, 5.6vw, 80px) 1fr; gap: 10px; }
  .sf-shop__gal--left .sf-shop__aside { position: relative; min-height: 0; }
  .sf-shop__gal--left .sf-shop__thumbs { position: absolute; inset: 0; flex-direction: column; overflow-x: hidden; overflow-y: auto; }
  .sf-shop__gal--left .sf-shop__thumbs li { width: auto; }
  .sf-shop__stage { aspect-ratio: 1 / 1; background: #F7F5F3; }
  .sf-shop__stage img, .sf-shop__stage > svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sf-shop__zoom { position: absolute; right: 16px; bottom: 16px; z-index: 2; width: 48px; height: 48px; display: grid; place-items: center; border-radius: 50%; background: #fff; box-shadow: 0 1px 4px rgba(0, 0, 0, .12); color: var(--sf-ink); }
  .sf-shop__zoom svg { width: 22px; height: 22px; }
  .sf-shop__soldbadge { position: absolute; left: 16px; bottom: 16px; z-index: 2; padding: 11px 20px; border-radius: 4px; background: var(--sf-ink); color: #fff; font-size: 14px; letter-spacing: .04em; }
  .sf-shop__soldbadge[hidden], .sf-shop__soldpill[hidden], .sf-shop__badge[hidden] { display: none; }

  /* titre, note, prix */
  .sf-shop__label { font-size: 15px; letter-spacing: .02em; color: #8b8280; }
  .sf-shop__title { margin-top: 6px; font-family: var(--sf-serif); font-weight: 400; font-size: clamp(30px, 3.4vw, 48px); line-height: 1.06; letter-spacing: -.015em; color: var(--sf-ink); }
  .sf-shop__rate { display: flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 13px; color: #8b8280; }
  .sf-shop__rate .sf-rate { font-size: 20px; }
  .sf-shop__rate .sf-rate__fg { color: var(--sf-ink); }
  .sf-shop__price { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .sf-shop__price b { font-size: 26px; font-weight: 700; color: var(--sf-plum); }
  .sf-shop__price s { font-size: 16px; color: #8b8280; } .sf-shop__price s:empty { display: none; }
  .sf-shop__badge { padding: 4px 9px; border-radius: 3px; background: var(--sf-ink); color: #fff; font-size: 12px; font-weight: 700; }
  .sf-shop__soldpill { padding: 8px 18px; border-radius: 4px; background: var(--sf-ink); color: #fff; font-size: 14px; letter-spacing: .04em; }
  .sf-shop__pnote { margin-top: 8px; font-size: 13px; letter-spacing: .01em; color: #8b8280; }

  /* formulaire et options */
  .sf-shop__form { margin: 0; }
  .sf-shop__opt { margin: 20px 0 0; padding: 0; border: 0; min-width: 0; }
  .sf-shop__opt legend { padding: 0; margin-bottom: 10px; font-size: 15px; color: #6f6664; }
  .sf-shop__opt legend b { color: var(--sf-ink); font-weight: 700; }
  .sf-shop__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .sf-shop__grp { margin: 18px 0 10px; font-size: 17px; color: var(--sf-ink); } .sf-shop__grp b { font-weight: 700; }
  .sf-shop__fit { margin-top: 20px; font-size: 14px; color: #6f6664; }
  .sf-shop__sw { display: flex; flex-wrap: wrap; gap: 6px 8px; }
  .sf-sw { position: relative; width: 46px; height: 46px; padding: 0; border-radius: 50%; border: 1.5px solid transparent; display: grid; place-items: center; }
  .sf-sw i { width: 38px; height: 38px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .15); }
  .sf-sw:hover { border-color: #cfc4bf; }
  .sf-sw.is-active { border-color: var(--sf-ink); }
  .sf-sw.is-soldout::after { content: ''; position: absolute; left: 50%; top: 5px; bottom: 5px; width: 1.5px; background: var(--sf-ink); transform: rotate(45deg); opacity: .65; }
  .sf-shop__sizes { display: flex; flex-wrap: wrap; gap: 8px; }
  .sf-size { min-width: 66px; height: 42px; padding: 0 14px; border: 1px solid #DDD3CE; background: #fff; font-size: 13.5px; font-weight: 600; color: var(--sf-ink); transition: background .15s, color .15s, border-color .15s; }
  .sf-size:hover { border-color: var(--sf-ink); }
  .sf-size.is-active { background: var(--sf-plum); border-color: var(--sf-plum); color: #fff; }
  .sf-size.is-soldout { color: #a89f9b; text-decoration: line-through; }
  .sf-shop__sizelink { display: flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 12px; color: #6f6664; }
  .sf-shop__sizelink svg { width: 16px; height: 16px; } .sf-shop__sizelink a { text-decoration: underline; text-underline-offset: 3px; font-weight: 600; color: var(--sf-ink); }

  /* quantite */
  .sf-shop__qty { display: inline-flex; align-items: center; margin-top: 18px; border: 1px solid #DDD3CE; border-radius: 4px; }
  .sf-shop__qty button { width: 44px; height: 44px; display: grid; place-items: center; font-size: 18px; color: var(--sf-ink); transition: background .12s; }
  .sf-shop__qty button:hover { background: #F7F5F3; }
  .sf-shop__qty input { width: 50px; height: 44px; text-align: center; border: 0; border-left: 1px solid #DDD3CE; border-right: 1px solid #DDD3CE; font-size: 14px; font-weight: 600; color: var(--sf-ink); background: transparent; -moz-appearance: textfield; }
  .sf-shop__qty input::-webkit-outer-spin-button, .sf-shop__qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  /* bouton d'ajout au panier */
  .sf-shop__atc { display: flex; align-items: center; justify-content: center; gap: 14px; width: 100%; height: 56px; margin-top: 14px; border-radius: 4px; background: var(--sf-plum); color: #fff;
    font-size: 14px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; transition: filter .15s; }
  .sf-shop__atc:hover:not(:disabled) { filter: brightness(1.12); }
  .sf-shop__atc:focus-visible { outline: 2px solid var(--sf-indigo); outline-offset: 3px; }
  .sf-shop__atc:disabled { background: #b59aa5; cursor: not-allowed; }
  .sf-shop__sep { width: 1px; height: 18px; background: rgba(255, 255, 255, .45); }
  .sf-shop__atc.is-loading { position: relative; color: transparent; pointer-events: none; }
  .sf-shop__atc.is-loading > * { visibility: hidden; }
  .sf-shop__atc.is-loading::after { content: ''; position: absolute; width: 22px; height: 22px; border-radius: 50%; border: 2.5px solid rgba(255, 255, 255, .4); border-top-color: #fff; animation: sfSpin .7s linear infinite; }
  @keyframes sfSpin { to { transform: rotate(360deg); } }
  .sf-shop__err { margin-top: 8px; font-size: 12.5px; color: #B0173A; }
  .sf-shop__note { display: flex; align-items: center; justify-content: center; gap: 7px; margin-top: 10px; font-size: 11.5px; color: #6f6664; }
  .sf-shop__note svg { width: 14px; height: 14px; }

  /* livraison (ligne centree) */
  .sf-shop__ship { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 22px; color: #3f3735; }
  .sf-shop__ship svg { width: 26px; height: 26px; flex: 0 0 auto; }
  .sf-shop__ship p { font-size: 15.5px; letter-spacing: .01em; }

  /* bundle (offre a lots) */
  .sf-shop__atc--bundle { margin-top: 14px; height: 54px; }
  .sf-dot { display: inline-block; width: 15px; height: 15px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .18); flex: 0 0 auto; }
  .sf-offer { margin-top: 28px; padding: 16px 14px 14px; border: 1px solid #EEE5E0; border-radius: 14px; background: #fff; box-shadow: 0 6px 22px -16px rgba(19, 7, 46, .25); }
  .sf-offer__head { display: flex; flex-direction: column; align-items: center; gap: 4px; margin-bottom: 14px; }
  .sf-offer__ttl { display: flex; align-items: center; gap: 8px; width: 100%; font-family: var(--sf-serif); font-size: 21px; line-height: 1.1; color: var(--sf-plum); white-space: nowrap; }
  .sf-offer__ttl::before, .sf-offer__ttl::after { content: ''; flex: 1; height: 1px; background: #E8DDD8; }
  .sf-offer__ttl em { font-style: italic; }
  .sf-offer__ttl b { font-family: var(--sf-sans); font-weight: 800; letter-spacing: .06em; font-size: 16px; }
  .sf-offer__timer { display: inline-flex; align-items: center; gap: 7px; font-size: 11.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--sf-plum); }
  .sf-offer__timer[hidden], .sf-offer__sub[hidden] { display: none; }
  .sf-offer__timer svg { width: 14px; height: 14px; } .sf-offer__timer b { font-variant-numeric: tabular-nums; letter-spacing: .06em; }
  .sf-offer__sub { font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: #8b8280; }
  .sf-tier { position: relative; margin-top: 12px; padding: 16px 16px 0; border: 1.5px solid #E7DEDA; border-radius: 12px; background: #FAF7F5; overflow: hidden; }
  .sf-offer__head + .sf-tier { margin-top: 0; }
  .sf-tier.is-selected { border: 2px solid var(--sf-plum); padding: 15px 15px 0; background: #FBF3EE; }
  .sf-tier__badge { position: absolute; top: 0; right: 16px; padding: 6px 10px; border-radius: 0 0 6px 6px; background: var(--sf-plum); color: #fff; font-size: 10px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; line-height: 1; }
  .sf-tier__badge + .sf-tier__top { padding-top: 8px; }
  .sf-tier__top { display: grid; grid-template-columns: 24px 1fr auto auto; gap: 8px 12px; align-items: center; cursor: pointer; padding-bottom: 16px; }
  .sf-tier__radio { position: absolute; opacity: 0; pointer-events: none; }
  .sf-tier__mark { width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid #C9BDB8; background: #fff; display: grid; place-items: center; }
  .sf-tier.is-selected .sf-tier__mark { border-color: var(--sf-plum); }
  .sf-tier.is-selected .sf-tier__mark::after { content: ''; width: 13px; height: 13px; border-radius: 50%; background: var(--sf-plum); }
  .sf-tier__radio:focus-visible + .sf-tier__mark { outline: 2px solid var(--sf-indigo); outline-offset: 2px; }
  .sf-tier__txt { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .sf-tier__name { font-size: 15.5px; font-weight: 700; line-height: 1.25; color: var(--sf-ink); }
  .sf-tier__save { font-size: 14px; font-weight: 700; font-style: italic; color: var(--sf-plum); }
  .sf-tier__save:empty { display: none; }
  .sf-tier__note { font-size: 12.5px; font-style: italic; color: #6f6664; }
  .sf-tier__pill { padding: 6px 10px; border-radius: 8px; background: #F3DCE3; color: var(--sf-plum); font-size: 12px; font-weight: 600; white-space: nowrap; }
  .sf-tier__pill[hidden] { display: none; }
  .sf-tier__price { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; white-space: nowrap; }
  .sf-tier__price b { font-size: 18px; font-weight: 700; color: var(--sf-ink); }
  .sf-tier__price s { font-size: 13.5px; font-weight: 600; color: #9a9290; } .sf-tier__price s:empty { display: none; }
  .sf-tier__opts { display: none; padding: 0 0 16px 36px; }
  .sf-tier.is-selected .sf-tier__opts { display: block; }
  .sf-tier__optlabel { margin-bottom: 8px; font-size: 13px; font-weight: 500; color: #6f6664; }
  .sf-tier__opts .sf-row + .sf-row { margin-top: 8px; }
  .sf-row { display: flex; align-items: center; gap: 8px; }
  .sf-row__img { flex: 0 0 auto; width: 46px; height: 58px; border-radius: 6px; overflow: hidden; background: #EEF0F1; }
  .sf-row__img img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .sf-sel { position: relative; display: flex; align-items: center; flex: 1 1 0; min-width: 0; max-width: 220px; height: 44px; border: 1px solid #E2D8D3; border-radius: 8px; background: #fff; }
  .sf-sel .sf-dot { position: absolute; left: 11px; width: 15px; height: 15px; pointer-events: none; }
  .sf-sel select { width: 100%; height: 100%; padding: 0 28px 0 14px; border: 0; background: transparent; font: inherit; font-size: 14px; color: var(--sf-ink); appearance: none; -webkit-appearance: none; cursor: pointer;
    background-image: linear-gradient(45deg, transparent 50%, #6f6664 50%), linear-gradient(135deg, #6f6664 50%, transparent 50%); background-position: calc(100% - 16px) 19px, calc(100% - 11px) 19px; background-size: 5px 5px; background-repeat: no-repeat; }
  .sf-sel--color select { padding-left: 34px; }
  .sf-row .sf-sel { flex: 0 1 158px; } .sf-row .sf-sel--size, .sf-row .sf-sel:not(.sf-sel--color) { flex: 0 0 84px; }
  .sf-sel .sf-dot { box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .12); }
  .sf-tier__perks { margin: 0 -16px; background: #E9E4E1; color: #3f3735; }
  .sf-tier.is-selected .sf-tier__perks { margin: 0 -15px; background: var(--sf-plum); color: #fff; }
  .sf-perk { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 8px 16px; font-size: 14px; }
  .sf-perk + .sf-perk { border-top: 1px solid rgba(63, 55, 53, .14); }
  .sf-tier.is-selected .sf-perk + .sf-perk { border-top-color: rgba(255, 255, 255, .22); }
  .sf-perk__img { flex: 0 0 auto; width: 44px; height: 44px; border-radius: 6px; overflow: hidden; display: grid; place-items: center; background: rgba(255, 255, 255, .55); color: var(--sf-plum); }
  .sf-perk__img img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .sf-perk__img svg { width: 24px; height: 24px; }
  .sf-perk__img--ico { background: none; width: 30px; } .sf-perk__img--ico svg { width: 26px; height: 26px; }
  .sf-tier.is-selected .sf-perk__img { background: rgba(255, 255, 255, .14); color: #F4C9D6; }
  .sf-perk__txt { flex: 1 1 auto; min-width: 0; font-weight: 700; line-height: 1.25; }
  .sf-perk__val { flex: 0 0 auto; margin-left: auto; font-size: 13.5px; font-weight: 600; opacity: .75; }
  .sf-perk .sf-sel { flex: 0 0 auto; width: 132px; height: 38px; margin-left: auto; color: var(--sf-ink); }
  .sf-perk .sf-sel + .sf-perk__val { margin-left: 0; }
  .sf-tier:not(.is-selected) .sf-perk .sf-sel { display: none; }
  .sf-tier.is-out .sf-tier__price b { color: #9a9290; }

  /* carte d'avantages : 2 colonnes, icones au trait */
  .sf-shop__usps { display: grid; grid-template-columns: 1fr 1fr; gap: 30px 22px; margin-top: 30px; padding: 28px 24px; border: 1px solid #EFEAE7; border-radius: 4px; background: #fff; }
  .sf-shop__usp { display: flex; align-items: center; gap: 16px; min-width: 0; }
  .sf-shop__uico { flex: 0 0 auto; width: 44px; height: 44px; display: grid; place-items: center; color: var(--sf-ink); }
  .sf-shop__uico svg { width: 42px; height: 42px; stroke-width: 1.1; }
  .sf-shop__usp > b { font-size: 15px; font-weight: 600; letter-spacing: .02em; line-height: 1.4; color: var(--sf-ink); }

  /* accordeons : icone a gauche, "+" a droite */
  .sf-shop__accs { margin-top: 30px; border-top: 1px solid #ECE6E3; }
  .sf-shop__acc { border-bottom: 1px solid #ECE6E3; }
  .sf-shop__acc summary { display: flex; align-items: center; gap: 16px; padding: 22px 0; cursor: pointer; list-style: none; }
  .sf-shop__acc summary::-webkit-details-marker { display: none; }
  .sf-shop__aico { flex: 0 0 auto; width: 32px; height: 32px; display: grid; place-items: center; color: var(--sf-ink); }
  .sf-shop__aico svg { width: 30px; height: 30px; }
  .sf-shop__acc summary > b { flex: 1; font-size: 18px; font-weight: 400; letter-spacing: .02em; color: var(--sf-ink); }
  .sf-shop__plus { position: relative; flex: 0 0 auto; width: 14px; height: 14px; }
  .sf-shop__plus::before, .sf-shop__plus::after { content: ''; position: absolute; background: var(--sf-ink); }
  .sf-shop__plus::before { left: 0; right: 0; top: 6.5px; height: 1.5px; }
  .sf-shop__plus::after { top: 0; bottom: 0; left: 6.5px; width: 1.5px; }
  .sf-shop__acc[open] .sf-shop__plus::after { display: none; }
  .sf-shop__fbody { padding: 0 0 20px 48px; font-size: 14.5px; line-height: 1.65; color: #4d4543; }
  .sf-shop__fbody p + p { margin-top: 8px; } .sf-shop__fbody ul { margin-top: 8px; padding-left: 0; }

  /* lightbox */
  .sf-shop__lb { position: fixed; inset: 0; z-index: 300; display: grid; place-items: center; padding: 24px; background: rgba(19, 7, 46, .85); cursor: zoom-out; }
  .sf-shop__lb[hidden] { display: none; }
  .sf-shop__lb img { max-width: min(92vw, 1100px); max-height: 90vh; object-fit: contain; background: #fff; }
  .sf-shop__lbx { position: absolute; top: 16px; right: 16px; width: 40px; height: 40px; border-radius: 50%; background: #fff; display: grid; place-items: center; }
  .sf-shop__lbx svg { width: 16px; height: 16px; }

  /* mobile */
  @media (max-width: 989px) {
    .sf-shop__grid { grid-template-columns: minmax(0, 1fr); row-gap: 24px; }
    .sf-shop__gal { position: static; }
    .sf-shop__gal--left.has-thumbs { display: flex; flex-direction: column; gap: 0; }
    .sf-shop__gal--left .sf-shop__aside { order: 2; margin-top: 8px; position: static; }
    .sf-shop__gal--left .sf-shop__thumbs { position: relative; inset: auto; flex-direction: row; overflow-y: hidden; overflow-x: auto; }
    .sf-shop__gal--left .sf-shop__thumbs li { width: 64px; }
  }
  @media (max-width: 749px) {
    .sf-shop { padding-top: 0; }
    .sf-shop__wrap { padding-inline: 0; }
    .sf-shop__buy { padding-inline: 16px; }
    .sf-shop__aside { padding-inline: 16px; }
    .sf-shop__zoom { width: 40px; height: 40px; }
    .sf-shop__usps { padding: 22px 16px; gap: 24px 14px; }
    .sf-shop__uico { width: 36px; height: 36px; } .sf-shop__uico svg { width: 34px; height: 34px; }
    .sf-shop__usp { gap: 12px; } .sf-shop__usp > b { font-size: 13.5px; }
    .sf-shop__acc summary > b { font-size: 16.5px; }
    .sf-shop__fbody { padding-left: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SF · Fiche boutique",
  "tag": "section",
  "class": "sf-section-shop",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit (vide = produit de la page)" },
    { "type": "text", "id": "label", "label": "Petite ligne au-dessus du titre" },
    { "type": "select", "id": "thumbs_pos", "label": "Miniatures de la galerie", "default": "below", "options": [
      { "value": "below", "label": "Sous l'image" }, { "value": "left", "label": "À gauche de l'image" }
    ] },
    { "type": "header", "content": "Pastilles de couleur en deux rangées" },
    { "type": "text", "id": "group1_title", "label": "Titre de la 1re rangée", "default": "Classic" },
    { "type": "text", "id": "group1_values", "label": "Couleurs de la 1re rangée (virgules)", "info": "Les autres couleurs vont dans la 2e rangée. Vide = une seule rangée." },
    { "type": "text", "id": "group2_title", "label": "Titre de la 2e rangée (suivi du nom)", "default": "Color" },
    { "type": "header", "content": "Avis (affichés seulement si réels)" },
    { "type": "text", "id": "rating_manual", "label": "Note réelle (ex. 4.8) — sinon metafield" },
    { "type": "text", "id": "rating_count", "label": "Nombre d'avis réel (ex. 120)" },
    { "type": "header", "content": "Prix et tailles" },
    { "type": "text", "id": "price_note", "label": "Ligne sous le prix" },
    { "type": "text", "id": "fit_note", "label": "Ligne au-dessus des tailles (ex. coupe normale)" },
    { "type": "text", "id": "size_link_label", "label": "Lien guide des tailles : texte", "default": "Size guide" },
    { "type": "url", "id": "size_link", "label": "Lien guide des tailles : URL (vide = masqué)" },
    { "type": "header", "content": "Bouton d'achat" },
    { "type": "text", "id": "atc_label", "label": "Texte", "default": "Add to cart" },
    { "type": "text", "id": "sold_label", "label": "Texte si épuisé", "default": "Sold out" },
    { "type": "text", "id": "adding_label", "label": "Texte pendant l'ajout", "default": "Adding…" },
    { "type": "text", "id": "atc_note", "label": "Ligne sous le bouton", "default": "Secure checkout" },
    { "type": "header", "content": "Livraison" },
    { "type": "text", "id": "ship_text", "label": "Ligne livraison (sous le bouton)", "default": "Free shipping on every order" },
    { "type": "header", "content": "Bundle (offre à lots)" },
    { "type": "paragraph", "content": "Chaque lot ajoute au panier le nombre de pièces indiqué, au prix normal du produit. Pour une vraie remise (ex. 2e à -50 %), créez-la dans Shopify (Réductions, automatique) : le prix affiché ici est le prix avant remise." },
    { "type": "text", "id": "offer_title_1", "label": "Titre (italique)", "default": "Self-care" },
    { "type": "text", "id": "offer_title_2", "label": "Titre (gras)", "default": "MONTH" },
    { "type": "text", "id": "offer_sub", "label": "Sous-titre", "default": "Choose your bundle" },
    { "type": "range", "id": "default_tier", "min": 1, "max": 3, "step": 1, "label": "Lot sélectionné par défaut", "default": 2 },
    { "type": "text", "id": "bundle_atc_label", "label": "Texte du bouton du bundle", "default": "Add bundle to cart" },
    { "type": "text", "id": "offer_ship", "label": "Bandeau livraison (lots où c'est coché)", "default": "FREE Shipping" },
    { "type": "text", "id": "gift_text", "label": "Cadeau offert (lots où c'est coché)" },
    { "type": "image_picker", "id": "gift_image", "label": "Photo du cadeau" },
    { "type": "text", "id": "gift_colors", "label": "Couleurs du cadeau, séparées par des virgules" },
    { "type": "text", "id": "gift_value", "label": "Valeur barrée du cadeau (laisser vide si inconnue)" },
    { "type": "text", "id": "save_label", "label": "Texte d'économie ({amount} = montant)", "default": "You save {amount}" },
    { "type": "text", "id": "timer_end", "label": "Fin de l'offre (AAAA-MM-JJ HH:MM, vide = pas de compte à rebours)", "info": "Indiquez uniquement une vraie date de fin d'offre : le compte à rebours disparaît à cette date." },
    { "type": "text", "id": "timer_label", "label": "Texte du compte à rebours", "default": "Offer ends in" },
    { "type": "text", "id": "perpiece_label", "label": "Pastille prix par pièce ({amount})", "default": "Only {amount} per piece" },
    { "type": "checkbox", "id": "per_piece", "label": "Choisir couleur / taille pièce par pièce", "default": true }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Avantage",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "check", "options": [
          { "value": "check", "label": "Coche" }, { "value": "bra-lift", "label": "Soutien-gorge qui lifte" }, { "value": "bra-neck", "label": "Décolleté" },
          { "value": "bra-fit", "label": "Ajustement parfait" }, { "value": "seamless", "label": "Sans couture" }, { "value": "bra-comfort", "label": "Confort" },
          { "value": "soft", "label": "Matière douce" }, { "value": "no-marks", "label": "Sans marques" }, { "value": "pads", "label": "Coques amovibles" },
          { "value": "hook", "label": "Rallonge d'agrafes" }, { "value": "sparkle", "label": "Étincelle" }, { "value": "texture", "label": "Texture" },
          { "value": "comfort", "label": "Cœur" }, { "value": "truck", "label": "Livraison" }, { "value": "shield", "label": "Bouclier" },
          { "value": "ruler", "label": "Mètre" }, { "value": "heart", "label": "Cœur plein" }, { "value": "feather", "label": "Plume" }, { "value": "lock", "label": "Cadenas" }
        ] },
        { "type": "text", "id": "text", "label": "Texte", "default": "Benefit" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordéon",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "tape", "options": [
          { "value": "tape", "label": "Mètre ruban" }, { "value": "layers", "label": "Matière" }, { "value": "hanger", "label": "Cintre" },
          { "value": "truckline", "label": "Livraison" }, { "value": "feather", "label": "Plume" }, { "value": "sparkle", "label": "Étincelle" },
          { "value": "shield", "label": "Bouclier" }, { "value": "heart", "label": "Cœur" }
        ] },
        { "type": "text", "id": "title", "label": "Titre", "default": "Details" },
        { "type": "checkbox", "id": "use_description", "label": "Afficher la description du produit", "default": false },
        { "type": "richtext", "id": "content", "label": "Contenu" }
      ]
    },
    {
