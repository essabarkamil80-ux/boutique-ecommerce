    #ce-{{ section.id }} .ce-barow { overflow: visible; }
    #ce-{{ section.id }} .ce-bacard { flex: 1 1 0; min-width: 0; max-width: none; }
    #ce-{{ section.id }} .ce-wall { columns: 3; }
