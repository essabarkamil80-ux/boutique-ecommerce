  .sf-size__unit button.is-on { background: #fff; color: var(--sf-plum); box-shadow: 0 1px 3px rgba(0, 0, 0, .1); }
  .sf-size__list li { display: flex; justify-content: space-between; padding: 10px 0; border-top: 1px solid #F0E6E1; font-size: 14px; color: #5f5654; }
