{%- comment -%}
  Fiche produit "boutique" : galerie (miniatures verticales a gauche + zoom) et achat (prix, pastilles de couleur,
  tailles, selecteur de quantite, bouton, livraison, avantages, accordeons, "shop the look").
  Fonctionne sur une page : choisir le produit dans les reglages ; sur un modele produit il prend le produit courant.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = s.product | default: product
  assign cur = p.selected_or_first_available_variant
  assign color_pos = 0
  assign size_pos = 0
  for opt in p.options_with_values
    assign on = opt.name | downcase
    if on == 'color' or on == 'colour' or on == 'couleur' or on == 'colore' or on == 'farbe'
      assign color_pos = opt.position
    endif
    if on == 'size' or on == 'taille' or on == 'taglia' or on == 'talla' or on == 'größe'
      assign size_pos = opt.position
    endif
  endfor
  assign rv = p.metafields.reviews.rating.value
  assign rating_max = 5
  assign rating_num = 0
  if rv != blank
    assign rating_num = rv.rating | times: 1.0
    assign rating_max = rv.scale_max | default: 5
  elsif s.rating_manual != blank
    assign rating_num = s.rating_manual | times: 1.0
  endif
  assign rating_pct = rating_num | times: 100.0 | divided_by: rating_max
  assign fm = p.featured_media
  assign main_alt = p.title
  assign save_pct = 0
  if cur.compare_at_price > cur.price
    assign save_pct = cur.compare_at_price | minus: cur.price | times: 100.0 | divided_by: cur.compare_at_price | round
  endif
-%}
{%- if p == blank -%}
  {%- if request.design_mode -%}<section class="sf sf-shop"><div class="sf-wrap"><p class="sf-shop__empty">Choisissez un produit dans les réglages de cette section.</p></div></section>{%- endif -%}
{%- else -%}
<section class="sf sf-shop" id="sf-shop-{{ section.id }}" data-sf-shop>
  <div class="sf-shop__wrap">
    <div class="sf-shop__grid">

      {%- comment -%} ---------------- galerie (miniatures a gauche, image principale a droite) ---------------- {%- endcomment -%}
      <div class="sf-shop__gal{% if p.media.size > 1 %} has-thumbs{% endif %}">
        {%- if p.media.size > 1 -%}
          <div class="sf-shop__aside">
            <ul class="sf-shop__thumbs" data-sf-thumbs>
              {%- for m in p.media -%}
                {%- if m.media_type == 'image' -%}
                  {%- capture big -%}{{ m | image_url: width: 1400 }}{%- endcapture -%}
                  <li><button type="button" class="sf-shop__thumb{% if m.id == fm.id %} is-active{% endif %}" data-sf-thumb data-media="{{ m.id }}" data-src="{{ big }}" data-alt="{{ m.alt | default: p.title | escape }}" aria-label="Image {{ forloop.index }}">
                    {{ m | image_url: width: 220 | image_tag: width: 80, height: 80, alt: '', loading: 'lazy' }}
                  </button></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        <div class="sf-shop__stage sf-media">
          {%- if fm != blank -%}
            {%- if fm.alt != blank -%}{%- assign main_alt = fm.alt -%}{%- endif -%}
            {{ fm | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 600px, 100vw', alt: main_alt, loading: 'eager', fetchpriority: 'high' }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'sf-ph' }}
          {%- endif -%}
          {%- if fm != blank -%}<button type="button" class="sf-shop__zoom" data-sf-zoom aria-label="Zoom">{%- render 'sf-icon', name: 'search' -%}</button>{%- endif -%}
        </div>
      </div>

      {%- comment -%} ---------------- achat ---------------- {%- endcomment -%}
      <div class="sf-shop__buy">
        {%- if s.label != blank -%}<p class="sf-shop__label">{{ s.label }}</p>{%- endif -%}
        <h1 class="sf-shop__title">{{ p.title }}</h1>
        {%- if rating_num > 0 -%}
          <div class="sf-shop__rate">
            <span class="sf-rate" aria-label="{{ rating_num | round: 1 }} / {{ rating_max }}"><span class="sf-rate__bg">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span><span class="sf-rate__fg" style="width: {{ rating_pct }}%">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span></span>
            <span>{{ rating_num | round: 1 }}{% if s.rating_count != blank %} ({{ s.rating_count }}){% endif %}</span>
          </div>
        {%- endif -%}
        <div class="sf-shop__price">
          <b data-price>{{ cur.price | money }}</b>
          <s data-compare>{% if cur.compare_at_price > cur.price %}{{ cur.compare_at_price | money }}{% endif %}</s>
          <span class="sf-shop__badge" data-badge{% if save_pct == 0 %} hidden{% endif %}>-{{ save_pct }}%</span>
        </div>
        {%- if s.price_note != blank -%}<p class="sf-shop__pnote">{{ s.price_note }}</p>{%- endif -%}

        {%- form 'product', p, id: 'sf-shop-form', class: 'sf-shop__form' -%}
          <input type="hidden" name="id" value="{{ cur.id }}" data-sf-id>
          {%- unless p.has_only_default_variant -%}
            {%- assign g1 = s.group1_values | downcase | split: ',' -%}
            {%- for opt in p.options_with_values -%}
              {%- assign is_col = false -%}
              {%- if opt.position == color_pos -%}{%- assign is_col = true -%}{%- endif -%}
              {%- assign row1 = '' -%}
              {%- assign row2 = '' -%}
              {%- if is_col -%}
                {%- for ov in opt.values -%}
                  {%- capture swhtml -%}<button type="button" class="sf-sw{% if ov.selected %} is-active{% endif %}" data-val="{{ ov | escape }}" aria-label="{{ ov | escape }}" title="{{ ov | escape }}" aria-pressed="{{ ov.selected }}"><i style="background: {% render 'sf-swatch', value: ov, swatch: ov.swatch.color %}{% if ov.swatch.image != blank %} url('{{ ov.swatch.image | image_url: width: 90 }}') center / cover{% endif %}"></i></button>{%- endcapture -%}
                  {%- assign in1 = false -%}
                  {%- assign ovn = ov | downcase | strip -%}
                  {%- for g in g1 -%}{%- assign gt = g | strip -%}{%- if gt == ovn -%}{%- assign in1 = true -%}{%- endif -%}{%- endfor -%}
                  {%- if in1 -%}{%- assign row1 = row1 | append: swhtml -%}{%- else -%}{%- assign row2 = row2 | append: swhtml -%}{%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- assign grouped = false -%}
              {%- if row1 != blank and row2 != blank -%}{%- assign grouped = true -%}{%- endif -%}
              <fieldset class="sf-shop__opt" data-sf-opt="{{ opt.position }}">
                {%- if grouped -%}
                  <legend class="sf-shop__sr">{{ opt.name }}</legend>
                  <p class="sf-shop__grp">{{ s.group1_title }}</p>
                  <div class="sf-shop__sw">{{ row1 }}</div>
                  <p class="sf-shop__grp">{{ s.group2_title }}: <b data-sf-optval>{{ cur.options[forloop.index0] }}</b></p>
                  <div class="sf-shop__sw">{{ row2 }}</div>
                {%- else -%}
                  <legend>{{ opt.name }}: <b data-sf-optval>{{ cur.options[forloop.index0] }}</b></legend>
                  {%- if is_col -%}
                    <div class="sf-shop__sw">{{ row1 }}{{ row2 }}</div>
                  {%- else -%}
                    <div class="sf-shop__sizes">
                      {%- for ov in opt.values -%}
                        <button type="button" class="sf-size{% if ov.selected %} is-active{% endif %}" data-val="{{ ov | escape }}" aria-pressed="{{ ov.selected }}">{{ ov }}</button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}
          {%- if s.size_link_label != blank and s.size_link != blank -%}
            <p class="sf-shop__sizelink">{%- render 'sf-icon', name: 'ruler' -%}<a href="{{ s.size_link }}">{{ s.size_link_label }}</a></p>
          {%- endif -%}

          <div class="sf-shop__qty">
            <button type="button" data-qty-minus aria-label="Decrease quantity">&minus;</button>
            <input type="number" name="quantity" value="1" min="1" max="99" data-qty-input aria-label="Quantity">
            <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
          </div>

          <button type="submit" name="add" class="sf-shop__atc" data-sf-atc{% if cur.available == false %} disabled{% endif %}>
            <span data-atc-label>{% if cur.available %}{{ s.atc_label }}{% else %}{{ s.sold_label }}{% endif %}</span>
          </button>
          <p class="sf-shop__err" role="alert" data-sf-err hidden></p>
          {%- if s.atc_note != blank -%}<p class="sf-shop__note">{%- render 'sf-icon', name: 'lock' -%}{{ s.atc_note }}</p>{%- endif -%}
        {%- endform -%}

        {%- if s.ship_text != blank -%}
          <div class="sf-shop__ship">
            <span>{%- render 'sf-icon', name: 'truckline' -%}</span>
            <p>{{ s.ship_text }}</p>
          </div>
        {%- endif -%}

        {%- comment -%} Avantages + accordeons dans une liste unifiee {%- endcomment -%}
        {%- assign usps = section.blocks | where: 'type', 'usp' -%}
        {%- assign accs = section.blocks | where: 'type', 'accordion' -%}
        {%- if usps.size > 0 or accs.size > 0 -%}
          <div class="sf-shop__features">
            {%- for u in usps -%}
              <div class="sf-shop__feat" {{ u.shopify_attributes }}>
                <span>{%- render 'sf-icon', name: u.settings.icon -%}</span>
                <b>{{ u.settings.text }}</b>
              </div>
            {%- endfor -%}
            {%- for a in accs -%}
              <details class="sf-shop__feat sf-shop__feat--exp" {{ a.shopify_attributes }}>
                <summary>
                  <span class="sf-shop__featico">{%- render 'sf-icon', name: a.settings.icon -%}</span>
                  <b>{{ a.settings.title }}</b>
                  {%- render 'sf-icon', name: 'chevron' -%}
                </summary>
                <div class="sf-shop__fbody">{%- if a.settings.use_description and p.description != blank -%}{{ p.description }}{%- else -%}{{ a.settings.content }}{%- endif -%}</div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} Shop the look {%- endcomment -%}
        {%- assign looks = section.blocks | where: 'type', 'look' -%}
        {%- assign look_items = 0 -%}
        {%- for l in looks -%}{%- if l.settings.product != blank -%}{%- assign look_items = look_items | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- if look_items > 0 or request.design_mode and looks.size > 0 -%}
          <div class="sf-shop__look">
            <h2 class="sf-shop__h">{{ s.look_title }}</h2>
            <ul class="sf-shop__looks">
              {%- for l in looks -%}
                {%- assign lp = l.settings.product -%}
                {%- if lp != blank -%}
                  <li {{ l.shopify_attributes }}>
                    <a class="sf-look__img sf-media" href="{{ lp.url }}">
                      {%- if lp.featured_media != blank -%}{{ lp.featured_media | image_url: width: 500 | image_tag: widths: '250, 400, 500', sizes: '260px', alt: lp.title, loading: 'lazy' }}{%- else -%}{{ 'product-apparel-2' | placeholder_svg_tag: 'sf-ph' }}{%- endif -%}
                      <span class="sf-look__plus" aria-hidden="true">{%- render 'sf-icon', name: 'plus' -%}</span>
                    </a>
                    <a class="sf-look__t" href="{{ lp.url }}">{{ lp.title }}</a>
                    <p class="sf-look__p"><b>{{ lp.price | money }}</b>{% if lp.compare_at_price > lp.price %} <s>{{ lp.compare_at_price | money }}</s>{% endif %}</p>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="sf-shop__lb" data-sf-lb hidden><button type="button" class="sf-shop__lbx" data-sf-lb-close aria-label="Close">{%- render 'sf-icon', name: 'close' -%}</button><img alt="" data-sf-lb-img></div>

  <script type="application/json" data-sf-data>
  {
    "current": {{ cur.id }},
    "currency": {{ cart.currency.iso_code | json }},
    "locale": {{ request.locale.iso_code | json }},
    "cartAdd": {{ routes.cart_add_url | json }},
    "labels": { "add": {{ s.atc_label | json }}, "sold": {{ s.sold_label | json }}, "adding": {{ s.adding_label | json }}, "in": {{ s.in_stock_text | json }} },
    "variants": [
      {%- for v in p.variants -%}
        {%- assign dot = '#cbbfb8' -%}
        {%- if color_pos > 0 -%}
          {%- assign ci = color_pos | minus: 1 -%}
          {%- capture dot -%}{% render 'sf-swatch', value: v.options[ci] %}{%- endcapture -%}
        {%- endif -%}
        {
          "id": {{ v.id }}, "options": {{ v.options | json }}, "price": {{ v.price }}, "compare": {{ v.compare_at_price | default: 0 }},
          "available": {{ v.available }}, "media": {{ v.featured_media.id | default: 0 }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
</section>

<script>
  (function () {
    var root = document.getElementById('sf-shop-{{ section.id }}');
    if (!root || root.dataset.ready) return; root.dataset.ready = '1';
    var D = JSON.parse(root.querySelector('[data-sf-data]').textContent), V = D.variants;
    var $ = function (s, r) { return (r || root).querySelector(s); }, $$ = function (s, r) { return Array.prototype.slice.call((r || root).querySelectorAll(s)); };
    var fmt; try { fmt = new Intl.NumberFormat(D.locale || undefined, { style: 'currency', currency: D.currency || 'EUR' }); } catch (e) { fmt = new Intl.NumberFormat(undefined, { style: 'currency', currency: 'EUR' }); }
    function money(c) { return fmt.format(c / 100); }
    var cur = V.filter(function (v) { return v.id === D.current; })[0] || V[0], SEL = cur.options.slice();

    /* galerie + zoom */
    var main = $('.sf-shop__stage img'), thumbs = $$('[data-sf-thumb]'), idx = 0, lb = $('[data-sf-lb]'), lbImg = $('[data-sf-lb-img]');
    function showThumb(i) {
      if (!thumbs.length) return; idx = (i + thumbs.length) % thumbs.length; var t = thumbs[idx];
      thumbs.forEach(function (x) { x.classList.toggle('is-active', x === t); });
      if (main) { main.removeAttribute('srcset'); main.removeAttribute('sizes'); main.src = t.dataset.src; main.alt = t.dataset.alt || ''; }
      if (t.parentNode && t.parentNode.scrollIntoView) t.parentNode.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
    }
    thumbs.forEach(function (t, i) { t.addEventListener('click', function () { showThumb(i); }); });
    var z = $('[data-sf-zoom]');
    if (z && lb) {
      z.addEventListener('click', function () { lbImg.src = main.currentSrc || main.src; lb.hidden = false; document.documentElement.style.overflow = 'hidden'; });
      function closeLb() { lb.hidden = true; document.documentElement.style.overflow = ''; }
      lb.addEventListener('click', closeLb);
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !lb.hidden) closeLb(); });
    }

    /* quantite */
    var qtyInput = $('[data-qty-input]'), qtyMinus = $('[data-qty-minus]'), qtyPlus = $('[data-qty-plus]');
    if (qtyMinus) qtyMinus.addEventListener('click', function () { var v = parseInt(qtyInput.value, 10) || 1; qtyInput.value = Math.max(1, v - 1); });
    if (qtyPlus) qtyPlus.addEventListener('click', function () { var v = parseInt(qtyInput.value, 10) || 1; qtyInput.value = Math.min(99, v + 1); });

    /* variantes */
    var fieldsets = $$('[data-sf-opt]'), idInput = $('[data-sf-id]'), atc = $('[data-sf-atc]'), err = $('[data-sf-err]');
    function find(o) { return V.filter(function (v) { return o.every(function (x, i) { return x === null || v.options[i] === x; }); })[0]; }
    function draw() {
      cur = find(SEL) || cur; idInput.value = cur.id;
      fieldsets.forEach(function (f, fi) {
        $$('[data-val]', f).forEach(function (b) {
          var t = SEL.slice(); t[fi] = b.dataset.val; var v = find(t), on = b.dataset.val === SEL[fi];
          b.classList.toggle('is-active', on); b.classList.toggle('is-soldout', !v || !v.available); b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        var l = $('[data-sf-optval]', f); if (l) l.textContent = SEL[fi];
      });
      $('[data-price]').textContent = money(cur.price);
      var has = cur.compare > cur.price; $('[data-compare]').textContent = has ? money(cur.compare) : '';
      var bd = $('[data-badge]'); bd.hidden = !has; if (has) bd.textContent = '-' + Math.round((cur.compare - cur.price) * 100 / cur.compare) + '%';
      atc.disabled = !cur.available; $('[data-atc-label]').textContent = cur.available ? D.labels.add : D.labels.sold;
      if (cur.media) { var k = thumbs.findIndex(function (t) { return t.dataset.media == cur.media; }); if (k > -1) showThumb(k); }
    }
    fieldsets.forEach(function (f, fi) {
      $$('[data-val]', f).forEach(function (b) { b.addEventListener('click', function () {
        SEL[fi] = b.dataset.val; draw();
        if (window.history && history.replaceState) { try { var u = new URL(location.href); u.searchParams.set('variant', cur.id); history.replaceState(null, '', u); } catch (e) {} }
      }); });
    });

    /* ajout au panier */
    var busy = false;
    function showErr(m) { err.textContent = m; err.hidden = !m; }
    function add(e) {
      e.preventDefault(); if (busy || atc.disabled) return;
      busy = true; atc.classList.add('is-loading'); atc.setAttribute('aria-busy', 'true'); showErr('');
      var qty = qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;
      var items = [{ id: cur.id, quantity: qty }], secIds = $$('cart-items-component', document).map(function (c) { return c.dataset.sectionId; }).filter(Boolean), Evt = null, deferred = null;
      $('[data-atc-label]').textContent = D.labels.adding;
      import('@shopify/events').then(function (m) { Evt = m.CartLinesUpdateEvent; }).catch(function () {}).then(function () {
        if (Evt && Evt.createPromise) {
          deferred = Evt.createPromise();
          document.dispatchEvent(new Evt({ action: 'add', context: 'product', lines: items.map(function (i) { return { merchandiseId: String(i.id), quantity: i.quantity }; }), promise: deferred.promise }));
        }
        return fetch(D.cartAdd, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: items, sections: secIds.join(',') }) });
      }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok && !j.status, j: j }; }); })
        .then(function (res) {
          if (!res.ok) { var m = res.j.description || res.j.message || 'Could not add to cart.'; showErr(m); if (deferred) deferred.reject(new Error(m)); return; }
          return fetch('/cart.js', { credentials: 'same-origin', headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (cart) {
            document.dispatchEvent(new CustomEvent('sf:cart', { detail: cart }));
            if (deferred) deferred.resolve({ cart: Evt.createCartFromAjaxResponse(cart), detail: { items: cart.items, source: 'sf-shop', sourceId: root.id, itemCount: qty, productId: '{{ p.id }}', sections: res.j.sections, didError: false } });
            var d = document.getElementById('cart-drawer');
            if (d && typeof d.open === 'function') { if (!d.isOpen) d.open(); } else { location.href = '/cart'; }
          });
        })
        .catch(function (x) { showErr('Something went wrong. Please try again.'); if (deferred) deferred.reject(x); })
        .then(function () { busy = false; atc.classList.remove('is-loading'); atc.removeAttribute('aria-busy'); draw(); });
    }
    root.querySelector('form').addEventListener('submit', add);
    draw();
  })();
</script>
{%- endif -%}

{% stylesheet %}
  .sf-shop { background: #fff; padding: 24px 0 56px; }
  .sf-shop__empty { padding: 40px 0; text-align: center; color: #8b8280; }
  .sf-shop__wrap { max-width: calc(1328px + 2 * clamp(16px, 3.9vw, 56px)); margin: 0 auto; padding-inline: clamp(16px, 3.9vw, 56px); }
  .sf-shop__grid { display: grid; grid-template-columns: minmax(0, 732fr) minmax(0, 542fr); column-gap: clamp(24px, 3.75vw, 54px); align-items: start; }
  .sf-shop__gal, .sf-shop__buy { min-width: 0; }

  /* galerie : miniatures verticales a gauche, image principale a droite */
  .sf-shop__gal { position: sticky; top: 20px; }
  .sf-shop__gal.has-thumbs { display: grid; grid-template-columns: clamp(60px, 5.6vw, 80px) 1fr; gap: 10px; }
  .sf-shop__aside { min-height: 0; overflow-y: auto; scrollbar-width: none; }
  .sf-shop__aside::-webkit-scrollbar { display: none; }
  .sf-shop__thumbs { display: flex; flex-direction: column; gap: 8px; padding: 2px; }
  .sf-shop__thumbs li { flex: 0 0 auto; }
  .sf-shop__thumb { display: block; width: 100%; aspect-ratio: 1; padding: 0; border: 2px solid transparent; background: #F7F5F3; overflow: hidden; }
  .sf-shop__thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .sf-shop__thumb.is-active { border-color: var(--sf-ink); }
  .sf-shop__stage { aspect-ratio: 1 / 1; background: #F7F5F3; }
  .sf-shop__stage img, .sf-shop__stage > svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sf-shop__zoom { position: absolute; right: 16px; bottom: 16px; z-index: 2; width: 36px; height: 36px; display: grid; place-items: center; color: var(--sf-ink); }
  .sf-shop__zoom svg { width: 20px; height: 20px; }

  /* infos produit */
  .sf-shop__label { font-size: 12px; color: #8b8280; }
  .sf-shop__title { margin-top: 6px; font-family: var(--sf-serif); font-weight: 400; font-size: clamp(28px, 3.1vw, 44px); line-height: 1.08; letter-spacing: -.015em; color: var(--sf-ink); }
  .sf-shop__rate { display: flex; align-items: center; gap: 8px; margin-top: 12px; font-size: 12.5px; color: #8b8280; }
  .sf-shop__rate .sf-rate { font-size: 16px; }
  .sf-shop__price { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .sf-shop__price b { font-size: 22px; font-weight: 700; color: var(--sf-plum); }
  .sf-shop__price s { font-size: 14px; color: #8b8280; } .sf-shop__price s:empty { display: none; }
  .sf-shop__badge { padding: 3px 8px; border-radius: 3px; background: var(--sf-ink); color: #fff; font-size: 11px; font-weight: 700; } .sf-shop__badge[hidden] { display: none; }
  .sf-shop__pnote { margin-top: 6px; font-size: 11.5px; color: #8b8280; }

  /* formulaire et options */
  .sf-shop__form { margin: 0; }
  .sf-shop__opt { margin: 20px 0 0; padding: 0; border: 0; min-width: 0; }
  .sf-shop__opt legend { padding: 0; margin-bottom: 10px; font-size: 13px; color: #6f6664; }
  .sf-shop__opt legend b { color: var(--sf-ink); font-weight: 700; }
  .sf-shop__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .sf-shop__grp { margin: 18px 0 10px; font-size: 15px; color: var(--sf-ink); } .sf-shop__grp b { font-weight: 400; }
  .sf-shop__sw { display: flex; flex-wrap: wrap; gap: 6px 8px; }
  .sf-sw { position: relative; width: 46px; height: 46px; padding: 0; border-radius: 50%; border: 1.5px solid transparent; display: grid; place-items: center; }
  .sf-sw i { width: 38px; height: 38px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .15); }
  .sf-sw:hover { border-color: #cfc4bf; }
  .sf-sw.is-active { border-color: var(--sf-ink); }
  .sf-sw.is-soldout::after { content: ''; position: absolute; left: 50%; top: 5px; bottom: 5px; width: 1.5px; background: var(--sf-ink); transform: rotate(45deg); opacity: .65; }
  .sf-shop__sizes { display: flex; flex-wrap: wrap; gap: 8px; }
  .sf-size { min-width: 66px; height: 42px; padding: 0 14px; border: 1px solid #DDD3CE; background: #fff; font-size: 13.5px; font-weight: 600; color: var(--sf-ink); transition: background .15s, color .15s, border-color .15s; }
  .sf-size:hover { border-color: var(--sf-ink); }
  .sf-size.is-active { background: var(--sf-plum); border-color: var(--sf-plum); color: #fff; }
  .sf-size.is-soldout { color: #a89f9b; text-decoration: line-through; }
  .sf-shop__sizelink { display: flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 12px; color: #6f6664; }
  .sf-shop__sizelink svg { width: 16px; height: 16px; } .sf-shop__sizelink a { text-decoration: underline; text-underline-offset: 3px; font-weight: 600; color: var(--sf-ink); }

  /* selecteur de quantite */
  .sf-shop__qty { display: inline-flex; align-items: center; margin-top: 18px; border: 1px solid #DDD3CE; border-radius: 4px; }
  .sf-shop__qty button { width: 44px; height: 44px; display: grid; place-items: center; font-size: 18px; color: var(--sf-ink); transition: background .12s; }
  .sf-shop__qty button:hover { background: #F7F5F3; }
  .sf-shop__qty input { width: 50px; height: 44px; text-align: center; border: 0; border-left: 1px solid #DDD3CE; border-right: 1px solid #DDD3CE; font-size: 14px; font-weight: 600; color: var(--sf-ink); background: transparent; -moz-appearance: textfield; }
  .sf-shop__qty input::-webkit-outer-spin-button, .sf-shop__qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  /* bouton d'ajout au panier */
  .sf-shop__atc { display: flex; align-items: center; justify-content: center; width: 100%; height: 54px; margin-top: 14px; border-radius: 4px; background: var(--sf-plum); color: #fff;
    font-size: 14px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; transition: filter .15s; }
  .sf-shop__atc:hover:not(:disabled) { filter: brightness(1.12); }
  .sf-shop__atc:focus-visible { outline: 2px solid var(--sf-indigo); outline-offset: 3px; }
  .sf-shop__atc:disabled { background: #b59aa5; cursor: not-allowed; }
  .sf-shop__atc.is-loading { position: relative; color: transparent; pointer-events: none; }
  .sf-shop__atc.is-loading > * { visibility: hidden; }
  .sf-shop__atc.is-loading::after { content: ''; position: absolute; width: 22px; height: 22px; border-radius: 50%; border: 2.5px solid rgba(255, 255, 255, .4); border-top-color: #fff; animation: sfSpin .7s linear infinite; }
  @keyframes sfSpin { to { transform: rotate(360deg); } }
  .sf-shop__err { margin-top: 8px; font-size: 12.5px; color: #B0173A; }
  .sf-shop__note { display: flex; align-items: center; justify-content: center; gap: 7px; margin-top: 10px; font-size: 11.5px; color: #6f6664; }
  .sf-shop__note svg { width: 14px; height: 14px; }

  /* livraison gratuite */
  .sf-shop__ship { display: flex; align-items: center; gap: 10px; margin-top: 16px; padding: 14px 0; border-top: 1px solid #F0E9E5; border-bottom: 1px solid #F0E9E5; }
  .sf-shop__ship span { flex: 0 0 auto; width: 24px; height: 24px; display: grid; place-items: center; color: var(--sf-plum); }
  .sf-shop__ship span svg { width: 22px; height: 22px; }
  .sf-shop__ship p { font-size: 13.5px; font-weight: 600; color: var(--sf-ink); }

  /* avantages + accordeons (liste unifiee) */
  .sf-shop__features { margin-top: 4px; }
  .sf-shop__feat { display: flex; align-items: center; gap: 12px; padding: 13px 0; border-bottom: 1px solid #F0E9E5; }
  .sf-shop__feat > span, .sf-shop__featico { flex: 0 0 auto; width: 22px; height: 22px; display: grid; place-items: center; color: var(--sf-plum); }
  .sf-shop__feat svg { width: 20px; height: 20px; }
  .sf-shop__feat > b { font-size: 13.5px; font-weight: 600; line-height: 1.3; color: var(--sf-ink); flex: 1; }
  .sf-shop__feat--exp { border-bottom: 1px solid #F0E9E5; }
  .sf-shop__feat--exp summary { display: flex; align-items: center; gap: 12px; padding: 13px 0; cursor: pointer; list-style: none; }
  .sf-shop__feat--exp summary::-webkit-details-marker { display: none; }
  .sf-shop__feat--exp summary > b { flex: 1; font-size: 13.5px; font-weight: 600; color: var(--sf-ink); }
  .sf-shop__feat--exp summary > svg { width: 15px; height: 15px; color: #6f6664; transition: transform .2s; flex: 0 0 auto; }
  .sf-shop__feat--exp[open] summary > svg { transform: rotate(180deg); }
  .sf-shop__fbody { padding: 0 0 14px 34px; font-size: 13.5px; line-height: 1.6; color: #4d4543; }
  .sf-shop__fbody p + p { margin-top: 8px; } .sf-shop__fbody ul { margin-top: 8px; padding-left: 0; }

  /* shop the look */
  .sf-shop__look { margin-top: 28px; }
  .sf-shop__h { font-family: var(--sf-sans); font-size: 13px; font-weight: 600; letter-spacing: 0; color: #6f6664; }
  .sf-shop__looks { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 12px; }
  .sf-look__img { display: block; aspect-ratio: 4 / 5; background: #F1EFED; }
  .sf-look__img img, .sf-look__img > svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sf-look__plus { position: absolute; right: 10px; bottom: 10px; width: 30px; height: 30px; display: grid; place-items: center; background: var(--sf-ink); color: #fff; }
  .sf-look__plus svg { width: 14px; height: 14px; }
  .sf-look__t { display: block; margin-top: 8px; font-size: 13px; color: var(--sf-ink); }
  .sf-look__p { margin-top: 2px; font-size: 13px; } .sf-look__p b { color: var(--sf-plum); } .sf-look__p s { color: #9a9290; font-size: 12px; }

  /* lightbox */
  .sf-shop__lb { position: fixed; inset: 0; z-index: 300; display: grid; place-items: center; padding: 24px; background: rgba(19, 7, 46, .85); cursor: zoom-out; }
  .sf-shop__lb[hidden] { display: none; }
  .sf-shop__lb img { max-width: min(92vw, 1100px); max-height: 90vh; object-fit: contain; background: #fff; }
  .sf-shop__lbx { position: absolute; top: 16px; right: 16px; width: 40px; height: 40px; border-radius: 50%; background: #fff; display: grid; place-items: center; }
  .sf-shop__lbx svg { width: 16px; height: 16px; }

  /* mobile */
  @media (max-width: 989px) {
    .sf-shop__grid { grid-template-columns: minmax(0, 1fr); row-gap: 24px; }
    .sf-shop__gal { position: static; }
    .sf-shop__gal.has-thumbs { grid-template-columns: 1fr; gap: 0; }
    .sf-shop__aside { order: 1; margin-top: 8px; overflow-y: hidden; }
    .sf-shop__thumbs { flex-direction: row; overflow-x: auto; scrollbar-width: none; }
    .sf-shop__thumbs::-webkit-scrollbar { display: none; }
  }
  @media (max-width: 749px) {
    .sf-shop { padding-top: 0; }
    .sf-shop__wrap { padding-inline: 0; }
    .sf-shop__buy { padding-inline: 16px; }
    .sf-shop__aside { padding-inline: 16px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SF · Fiche boutique",
  "tag": "section",
  "class": "sf-section-shop",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit (vide = produit de la page)" },
    { "type": "text", "id": "label", "label": "Petite ligne au-dessus du titre" },
    { "type": "header", "content": "Pastilles de couleur en deux rangées" },
    { "type": "text", "id": "group1_title", "label": "Titre de la 1re rangée", "default": "Classic" },
    { "type": "text", "id": "group1_values", "label": "Couleurs de la 1re rangée (virgules)", "info": "Les autres couleurs vont dans la 2e rangée. Vide = une seule rangée." },
    { "type": "text", "id": "group2_title", "label": "Titre de la 2e rangée (suivi du nom)", "default": "Color" },
    { "type": "header", "content": "Avis (affichés seulement si réels)" },
    { "type": "text", "id": "rating_manual", "label": "Note réelle (ex. 4.8) — sinon metafield" },
    { "type": "text", "id": "rating_count", "label": "Nombre d'avis réel (ex. 120)" },
    { "type": "header", "content": "Prix" },
    { "type": "text", "id": "price_note", "label": "Ligne sous le prix" },
    { "type": "text", "id": "in_stock_text", "label": "Texte si disponible", "default": "In stock" },
    { "type": "text", "id": "size_link_label", "label": "Lien guide des tailles : texte", "default": "Size guide" },
    { "type": "url", "id": "size_link", "label": "Lien guide des tailles : URL (vide = masqué)" },
    { "type": "header", "content": "Bouton d'achat" },
    { "type": "text", "id": "atc_label", "label": "Texte", "default": "Add to cart" },
    { "type": "text", "id": "sold_label", "label": "Texte si épuisé", "default": "Sold out" },
    { "type": "text", "id": "adding_label", "label": "Texte pendant l'ajout", "default": "Adding…" },
    { "type": "text", "id": "atc_note", "label": "Ligne sous le bouton", "default": "Secure checkout" },
    { "type": "header", "content": "Livraison" },
    { "type": "text", "id": "ship_text", "label": "Ligne livraison gratuite", "default": "Free shipping on every order" },
    { "type": "header", "content": "Shop the look" },
    { "type": "text", "id": "look_title", "label": "Titre", "default": "Shop the look" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Shop the look",
      "limit": 4,
      "settings": [ { "type": "product", "id": "product", "label": "Produit complémentaire" } ]
    },
    {
      "type": "usp",
      "name": "Avantage",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "check", "options": [
          { "value": "check", "label": "Coche" }, { "value": "sparkle", "label": "Étincelle" }, { "value": "texture", "label": "Texture" },
          { "value": "comfort", "label": "Confort" }, { "value": "truck", "label": "Livraison" },
          { "value": "shield", "label": "Bouclier" }, { "value": "ruler", "label": "Mètre" },
          { "value": "heart", "label": "Cœur" }, { "value": "feather", "label": "Plume" }, { "value": "lock", "label": "Cadenas" }
        ] },
        { "type": "text", "id": "text", "label": "Texte", "default": "Benefit" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordéon",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "ruler", "options": [
          { "value": "ruler", "label": "Mètre" }, { "value": "feather", "label": "Plume" }, { "value": "sparkle", "label": "Étincelle" },
          { "value": "truck", "label": "Livraison" }, { "value": "shield", "label": "Bouclier" }, { "value": "heart", "label": "Cœur" }
        ] },
        { "type": "text", "id": "title", "label": "Titre", "default": "Details" },
        { "type": "checkbox", "id": "use_description", "label": "Afficher la description du produit", "default": false },
        { "type": "richtext", "id": "content", "label": "Contenu" }
      ]
    }
  ],
  "presets": [ { "name": "SF · Fiche boutique" } ]
}
{% endschema %}
