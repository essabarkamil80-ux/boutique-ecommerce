<script>
  (function () {
    var root = document.getElementById('ce-{{ section.id }}');
    if (!root) return;

    var slides = root.querySelectorAll('[data-slide]');
    var vSlide = root.querySelector('[data-variant-slide]');
    var vImg = root.querySelector('[data-variant-img]');
    root.querySelectorAll('[data-thumb]').forEach(function (t) {
      t.addEventListener('click', function () {
        var i = t.getAttribute('data-thumb');
        if (vSlide) { vSlide.classList.remove('is-active'); vSlide.hidden = true; }
        slides.forEach(function (s) { s.classList.toggle('is-active', s.getAttribute('data-slide') === i); });
        root.querySelectorAll('[data-thumb]').forEach(function (x) { x.classList.toggle('is-active', x === t); });
      });
    });

    root.querySelectorAll('[data-tabs]').forEach(function (tabs) {
      tabs.querySelectorAll('[data-tab]').forEach(function (b) {
        b.addEventListener('click', function () {
          var i = b.getAttribute('data-tab');
          tabs.querySelectorAll('[data-tab]').forEach(function (x) { x.classList.toggle('is-active', x === b); });
          tabs.querySelectorAll('[data-pane]').forEach(function (p) { p.classList.toggle('is-active', p.getAttribute('data-pane') === i); });
        });
      });
    });

    var opts = root.querySelector('[data-variants]');
    var input = root.querySelector('[data-variant-input]');
    var variants = [];
    if (opts) { try { variants = JSON.parse(opts.getAttribute('data-variants')); } catch (e) {} }
    var vdataEl = root.querySelector('[data-vdata]');
    var vdata = {};
    if (vdataEl) { try { vdata = JSON.parse(vdataEl.textContent); } catch (e) {} }
    var priceNow = root.querySelector('.ce-price__now');
    var pricerow = root.querySelector('.ce-pricerow');
    function applyVariant(match, updateUrl) {
      if (!match) return;
      if (input) input.value = match.id;
      if (updateUrl) { try { var u = new URL(window.location.href); u.searchParams.set('variant', match.id); history.replaceState({}, '', u.toString()); } catch (e) {} }
      var d = vdata[match.id];
      if (d) {
        if (priceNow && d.p) priceNow.textContent = d.p;
        if (pricerow) {
          var was = pricerow.querySelector('.ce-price__was');
          if (d.c) {
            if (!was && priceNow) { was = document.createElement('span'); was.className = 'ce-price__was'; pricerow.insertBefore(was, priceNow); }
            if (was) { was.textContent = d.c; was.style.display = ''; }
          } else if (was) { was.style.display = 'none'; }
        }
        if (vSlide && vImg) {
          if (d.img) { vImg.src = d.img; vImg.alt = match.name || ''; slides.forEach(function (s) { s.classList.remove('is-active'); }); vSlide.hidden = false; vSlide.classList.add('is-active'); }
          else { vSlide.hidden = true; vSlide.classList.remove('is-active'); if (!root.querySelector('[data-slide].is-active')) { var s0 = root.querySelector('[data-slide="0"]'); if (s0) s0.classList.add('is-active'); } }
        }
      }
    }
    function resolve(updateUrl) {
      if (!opts || !variants.length) return;
      var sel = [];
      root.querySelectorAll('[data-opt-pos]').forEach(function (g) {
        var pos = parseInt(g.getAttribute('data-opt-pos'), 10);
        var active = g.querySelector('[data-opt-value].is-active');
        sel[pos - 1] = active ? active.getAttribute('data-value') : null;
        var lbl = root.querySelector('[data-opt-selected="' + pos + '"]');
        if (lbl && active) lbl.textContent = active.getAttribute('data-value');
      });
      var match = variants.filter(function (v) { return v.options.every(function (o, i) { return o === sel[i]; }); })[0];
      applyVariant(match, updateUrl);
    }
    root.querySelectorAll('[data-opt-value]').forEach(function (b) {
      b.addEventListener('click', function () {
        var g = b.closest('[data-opt-pos]');
        g.querySelectorAll('[data-opt-value]').forEach(function (x) { x.classList.remove('is-active'); });
        b.classList.add('is-active');
        resolve(true);
      });
    });
    resolve(false);

    function track(id, qty, res) {
      try {
        var it = (res && res.items && res.items[0]) || res || {};
        var val = (it.final_price ? it.final_price / 100 : 0) * qty;
        var cur = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD';
        if (typeof window.fbq === 'function') fbq('track', 'AddToCart', { content_ids: [String(id)], content_type: 'product', value: val, currency: cur });
        if (window.ttq && ttq.track) ttq.track('AddToCart', { content_id: String(id), value: val, currency: cur });
      } catch (e) {}
    }
    var buyMsg = root.querySelector('[data-buy-msg]');
    function showBuyMsg(t) { if (buyMsg) { buyMsg.textContent = t; buyMsg.hidden = false; } }
    function clearBuyMsg() { if (buyMsg) { buyMsg.hidden = true; buyMsg.textContent = ''; } }
    function goCheckout() {
      var base = (window.Shopify && Shopify.routes && Shopify.routes.root) ? Shopify.routes.root : '/';
      window.location.href = base + 'checkout';
    }
    function goCart() {
      var base = (window.Shopify && Shopify.routes && Shopify.routes.root) ? Shopify.routes.root : '/';
      window.location.href = base + 'cart';
    }
    function addItem(btn, mode) {
      clearBuyMsg();
      var id = input ? input.value : '';
      if (!id) { showBuyMsg('Please select an option to continue.'); return; }
      var qtyEl = root.querySelector('[data-qty]');
      var qty = qtyEl ? (parseInt(qtyEl.value, 10) || 1) : 1;
      var original = btn ? btn.innerHTML : '';
      if (btn) { btn.disabled = true; btn.setAttribute('aria-busy', 'true'); btn.innerHTML = (mode === 'cart' ? 'Adding…' : 'Redirecting…'); }
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: [{ id: Number(id), quantity: qty }] }) })
        .then(function (r) { if (!r.ok) { return r.json().then(function (e) { throw e; }); } return r.json(); })
        .then(function (res) {
          track(id, qty, res);
          if (mode === 'cart') { goCart(); } else { goCheckout(); }
        })
        .catch(function (err) {
          if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); btn.innerHTML = original; }
          showBuyMsg((err && err.description) ? err.description : 'Something went wrong. Please try again.');
        });
    }
    root.querySelectorAll('[data-addtocart]').forEach(function (b) { b.addEventListener('click', function () { addItem(b, 'cart'); }); });
    root.querySelectorAll('[data-buynow]').forEach(function (b) { b.addEventListener('click', function () { addItem(b, 'checkout'); }); });
    root.querySelectorAll('[data-addcart]').forEach(function (b) { b.addEventListener('click', function () { addItem(b, 'checkout'); }); });

    var sticky = root.querySelector('[data-sticky]');
    var buy = root.querySelector('[data-buy]');
    if (sticky && buy && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { es.forEach(function (e) { sticky.hidden = e.isIntersecting; }); }, { rootMargin: '0px 0px -70% 0px' }).observe(buy);
    }

    root.querySelectorAll('[data-vid]').forEach(function (wrap) {
      var v = wrap.querySelector('video'); if (!v) return;
