  .sf-res__panel[hidden] { display: none; }
  .sf-res__pics { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; border-radius: 10px 10px 0 0; overflow: hidden; }
  .sf-res__tabs[hidden] { display: none; }
  .sf-res__pics--one { grid-template-columns: 1fr; gap: 0; }
  .sf-res__pic { aspect-ratio: 249 / 452; background: #ECE4E0; }
