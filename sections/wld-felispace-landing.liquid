  /* GUARANTEE (premium) */
  #wld-felispace-{{ section.id }} .fs-guarantee { position: relative; min-height: 560px; display: flex; align-items: center; overflow: hidden; background: #141414; }
  #wld-felispace-{{ section.id }} .fs-guarantee__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  #wld-felispace-{{ section.id }} .fs-guarantee__overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgba(0,0,0,.74) 0%, rgba(0,0,0,.5) 45%, rgba(0,0,0,.25) 100%); }
  #wld-felispace-{{ section.id }} .fs-guarantee__inner { position: relative; z-index: 2; max-width: 1140px; margin: 0 auto; padding: 70px 24px; width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 40px; }
  #wld-felispace-{{ section.id }} .fs-guarantee__content { max-width: 560px; color: #fff; }
  #wld-felispace-{{ section.id }} .fs-guarantee__title { font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: clamp(32px, 5vw, 56px); line-height: 1.02; color: #fff; margin: 0 0 12px; }
  #wld-felispace-{{ section.id }} .fs-guarantee__sub { font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: clamp(16px, 2vw, 20px); color: #ededed; margin: 0 0 24px; }
  #wld-felispace-{{ section.id }} .fs-guarantee__list { list-style: none; padding: 0; margin: 0 0 30px; display: flex; flex-direction: column; gap: 13px; }
  #wld-felispace-{{ section.id }} .fs-guarantee__list li { position: relative; padding-left: 34px; font-size: 16px; font-weight: 600; color: #fff; line-height: 1.4; }
  #wld-felispace-{{ section.id }} .fs-guarantee__list li::before { content: "✓"; position: absolute; left: 0; top: 0; width: 23px; height: 23px; border-radius: 50%; background: var(--wld-primary); color: #fff; font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  #wld-felispace-{{ section.id }} .fs-guarantee__cta { display: inline-block; background: var(--wld-primary); color: #fff; font-family: 'Montserrat', sans-serif; font-weight: 800; text-transform: uppercase; font-size: 16px; letter-spacing: .3px; padding: 17px 40px; border-radius: 999px; box-shadow: 0 8px 24px rgba(0,0,0,.35); transition: .18s; }
  #wld-felispace-{{ section.id }} .fs-guarantee__cta:hover { filter: brightness(1.1); transform: translateY(-2px); }
  #wld-felispace-{{ section.id }} .fs-guarantee__trust { margin: 15px 0 0; font-size: 14px; color: #dcdcdc; font-weight: 600; }
  #wld-felispace-{{ section.id }} .fs-guarantee__trust strong { color: #fff; }
  #wld-felispace-{{ section.id }} .fs-guarantee__badge-wrap { flex-shrink: 0; opacity: 0; transform: scale(.85); transition: opacity .6s ease, transform .6s cubic-bezier(.2,.9,.3,1.35); }
  #wld-felispace-{{ section.id }} .fs-guarantee__badge-wrap.is-in { opacity: 1; transform: scale(1); }
  #wld-felispace-{{ section.id }} .fs-guarantee__badge { width: 214px; height: 214px; border-radius: 50%; background: rgba(255,255,255,.12); border: 3px solid var(--wld-primary); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: #fff; box-shadow: 0 12px 44px rgba(0,0,0,.45); animation: fs-float 4.5s ease-in-out infinite; }
  #wld-felispace-{{ section.id }} .fs-guarantee__badge-wrap:hover .fs-guarantee__badge { border-color: #fff; box-shadow: 0 16px 54px rgba(0,0,0,.55); }
  #wld-felispace-{{ section.id }} .fs-guarantee__badge-big { font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 40px; line-height: 1; }
  #wld-felispace-{{ section.id }} .fs-guarantee__badge-mid { font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; margin-top: 7px; max-width: 140px; line-height: 1.25; }
  #wld-felispace-{{ section.id }} .fs-guarantee__badge-sub { font-size: 11px; opacity: .82; margin-top: 6px; }
  @keyframes fs-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }
  @media (max-width: 780px) {
    #wld-felispace-{{ section.id }} .fs-guarantee__inner { flex-direction: column-reverse; text-align: center; gap: 28px; padding: 54px 20px; }
    #wld-felispace-{{ section.id }} .fs-guarantee__content { max-width: 100%; }
    #wld-felispace-{{ section.id }} .fs-guarantee__list { align-items: flex-start; max-width: 320px; margin-left: auto; margin-right: auto; text-align: left; }
    #wld-felispace-{{ section.id }} .fs-guarantee__badge { width: 168px; height: 168px; }
    #wld-felispace-{{ section.id }} .fs-guarantee__badge-big { font-size: 32px; }
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    #wld-felispace-{{ section.id }} .wld-felispace-hero { grid-template-columns: 1fr; gap: 18px; padding: 20px 16px; }
    #wld-felispace-{{ section.id }} .wld-felispace-bullets li { white-space: normal; font-size: 14.5px; }
    #wld-felispace-{{ section.id }} .wld-felispace-hero__media { position: static; }
    #wld-felispace-{{ section.id }} .wld-felispace-hero__media img { max-width: 440px; margin: 0 auto; }
    #wld-felispace-{{ section.id }} .wld-felispace-why { grid-template-columns: 1fr; }
    #wld-felispace-{{ section.id }} .wld-felispace-why__media { order: -1; }
    #wld-felispace-{{ section.id }} .wld-felispace-benefits { grid-template-columns: 1fr; }
    #wld-felispace-{{ section.id }} .wld-felispace-videos { max-width: 760px; }
    #wld-felispace-{{ section.id }} .wld-felispace-revcard { flex: 0 0 calc((100% - 22px) / 2); }
  }
  @media (max-width: 540px) {
    #wld-felispace-{{ section.id }} .wld-felispace-band { padding: 40px 16px; }
    #wld-felispace-{{ section.id }} .wld-felispace-bundles { grid-template-columns: 1fr; }
    #wld-felispace-{{ section.id }} .wld-felispace-revcard { flex: 0 0 86%; }
    #wld-felispace-{{ section.id }} .wld-felispace-videos { grid-template-columns: 1fr 1fr; gap: 12px; }
    #wld-felispace-{{ section.id }} .wld-felispace-vid__play { width: 48px; height: 48px; font-size: 18px; }
    #wld-felispace-{{ section.id }} .wld-felispace-trust-strip { gap: 16px; }
    #wld-felispace-{{ section.id }} .wld-felispace-trust { width: 45%; font-size: 12px; }
    #wld-felispace-{{ section.id }} .wld-felispace-tier { padding: 14px 12px 14px 12px; gap: 4px 10px; }
    #wld-felispace-{{ section.id }} .wld-felispace-tier__title { font-size: 16px; }
    #wld-felispace-{{ section.id }} .wld-felispace-tier__price { font-size: 20px; }
    #wld-felispace-{{ section.id }} .wld-felispace-tier__item { font-size: 12.5px; }
  }
</style>

<script>
  (function () {
    function fxAddToCart(form, dest, btn) {
      if (!form) return;
      var idEl = form.querySelector('[data-variant-input]');
      var qtyEl = form.querySelector('[data-qty-input]');
      var id = idEl ? idEl.value : '';
      var qty = qtyEl ? parseInt(qtyEl.value || '1', 10) : 1;
      if (!id) { window.location = '/cart'; return; }
      var original = btn ? btn.innerHTML : '';
      if (btn) { btn.disabled = true; btn.innerHTML = 'Adding…'; }
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(id), quantity: qty }] })
      }).then(function (r) {
        if (!r.ok) { throw new Error('add failed'); }
        return r.json();
      }).then(function () {
        window.location = dest;
      }).catch(function () {
        if (btn) { btn.disabled = false; btn.innerHTML = original; }
        form.submit();
      });
    }

    function initFelispace(root) {
      if (!root) return;

      var sizeKeyword = (root.getAttribute('data-size-keyword') || '').trim().toLowerCase();
      var sizeUplift = parseFloat(root.getAttribute('data-size-uplift') || '0') || 0;

      function formatPrice(base, factor) {
        var m = base.match(/^(\D*?)([\d]+(?:[.,][\d]+)?)(.*)$/);
        if (!m) { return base; }
        var num = parseFloat(m[2].replace(',', '.'));
        if (isNaN(num)) { return base; }
        return m[1] + Math.round(num * factor) + m[3];
      }

      function applySizePricing() {
        var active = false;
        if (sizeKeyword) {
          root.querySelectorAll('[data-opt-value].is-active').forEach(function (b) {
            if ((b.getAttribute('data-value') || '').toLowerCase().indexOf(sizeKeyword) > -1) { active = true; }
          });
        }
        var factor = active ? (1 + sizeUplift / 100) : 1;
        root.querySelectorAll('[data-price]').forEach(function (el) {
          if (!el.hasAttribute('data-base')) { el.setAttribute('data-base', el.textContent.trim()); }
          el.textContent = formatPrice(el.getAttribute('data-base'), factor);
        });
      }

      root.querySelectorAll('[data-buyform]').forEach(function (form) {
        var dataEl = form.querySelector('[data-variants-json]');
        if (!dataEl) { return; }
        var variants;
        try { variants = JSON.parse(dataEl.textContent); } catch (e) { return; }
        var input = form.querySelector('[data-variant-input]');
        function resolve() {
          var sel = [];
          form.querySelectorAll('[data-option-position]').forEach(function (grp) {
            var pos = parseInt(grp.getAttribute('data-option-position'), 10);
            var active = grp.querySelector('[data-opt-value].is-active');
            sel[pos - 1] = active ? active.getAttribute('data-value') : null;
            var lbl = form.querySelector('[data-opt-selected="' + pos + '"]');
            if (lbl && active) { lbl.textContent = active.getAttribute('data-value'); }
          });
          if (!sel.length) { return; }
          var match = variants.filter(function (v) {
            return v.options.every(function (o, i) { return o === sel[i]; });
          })[0];
          if (match && input) { input.value = match.id; }
        }
        form.querySelectorAll('[data-opt-value]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var grp = btn.closest('[data-option-position]');
            grp.querySelectorAll('[data-opt-value]').forEach(function (b) { b.classList.remove('is-active'); });
            btn.classList.add('is-active');
            resolve();
            applySizePricing();
          });
        });
        resolve();
      });

      applySizePricing();

      root.querySelectorAll('[data-tier-group]').forEach(function (group) {
        var form = group.closest('[data-buyform]');
        var qty = form ? form.querySelector('[data-qty-input]') : null;
        group.querySelectorAll('[data-tier]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            group.querySelectorAll('[data-tier]').forEach(function (b) { b.classList.remove('is-active'); });
            btn.classList.add('is-active');
            if (qty && btn.dataset.qty) { qty.value = btn.dataset.qty; }
          });
        });
        var active = group.querySelector('[data-tier].is-active');
        if (active && qty && active.dataset.qty) { qty.value = active.dataset.qty; }
      });

      root.querySelectorAll('[data-buynow]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          fxAddToCart(btn.closest('[data-buyform]'), '/checkout', btn);
        });
      });

      root.querySelectorAll('[data-buyform]').forEach(function (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          fxAddToCart(form, '/cart', form.querySelector('[data-addcart]'));
        });
      });

      root.querySelectorAll('[data-vid-play]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var wrap = btn.closest('[data-vid]');
          var video = wrap ? wrap.querySelector('video') : null;
          if (!video) { return; }
          video.preload = 'auto';
          video.play();
          wrap.classList.add('is-playing');
        });
      });

      if ('IntersectionObserver' in window) {
        var vio = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            var wrap = e.target, video = wrap.querySelector('video');
            if (!video) { return; }
            if (e.isIntersecting) {
              video.muted = true; video.preload = 'auto';
              var pr = video.play(); if (pr && pr.catch) { pr.catch(function () {}); }
              wrap.classList.add('is-playing');
            } else { video.pause(); }
          });
        }, { threshold: 0.5 });
        root.querySelectorAll('[data-vid]').forEach(function (w) { if (w.querySelector('video')) { vio.observe(w); } });
      }

      if ('IntersectionObserver' in window) {
        var bio = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); bio.unobserve(e.target); } });
        }, { threshold: 0.35 });
        root.querySelectorAll('[data-fs-badge]').forEach(function (b) { bio.observe(b); });
      } else {
        root.querySelectorAll('[data-fs-badge]').forEach(function (b) { b.classList.add('is-in'); });
      }

      root.querySelectorAll('[data-gallery]').forEach(function (g) {
        var mainImg = g.querySelector('[data-gallery-main]');
        var thumbs = g.querySelectorAll('[data-gallery-thumb]');
        if (!mainImg || !thumbs.length) { return; }
        thumbs.forEach(function (t) {
          t.addEventListener('click', function () {
            var full = t.getAttribute('data-full');
            if (full) { mainImg.src = full; }
            thumbs.forEach(function (x) { x.classList.remove('is-active'); });
            t.classList.add('is-active');
          });
        });
      });

      root.querySelectorAll('[data-revslider]').forEach(function (sl) {
        var track = sl.querySelector('[data-revtrack]');
        var dotsWrap = sl.querySelector('[data-revdots]');
        if (!track) { return; }
        var storeKey = 'felispace-reviews-' + (root.id || 'x');

        function esc(s) {
          return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
        function buildCard(r) {
          var art = document.createElement('article');
          art.className = 'wld-felispace-revcard wld-felispace-revcard--user';
          if (r.id) { art.setAttribute('data-rev-id', r.id); }
          var rt = Math.max(1, Math.min(5, parseInt(r.rating, 10) || 5));
          var stars = new Array(rt + 1).join('★');
          var media;
          if (r.img) {
            media = '<div class="wld-felispace-revcard__media"><img src="' + esc(r.img) + '" alt="" loading="lazy"></div>';
          } else {
            var initial = (r.name || '🐾').trim().charAt(0).toUpperCase() || '🐾';
            media = '<div class="wld-felispace-revcard__media wld-felispace-revcard__media--avatar"><span>' + esc(initial) + '</span></div>';
          }
          art.innerHTML = media +
            '<button type="button" class="wld-felispace-revcard__del" data-revdel aria-label="Delete this review" title="Delete (visible to you only)">×</button>' +
            '<div class="wld-felispace-revcard__body">' +
              '<div class="wld-felispace-revcard__stars">' + stars + '</div>' +
              '<h4 class="wld-felispace-revcard__title">' + esc(r.title) + '</h4>' +
              '<p class="wld-felispace-revcard__text">' + esc(r.text) + '</p>' +
              '<span class="wld-felispace-revcard__author">' + esc(r.name) + ' — Verified Customer</span>' +
            '</div>';
          return art;
        }
        function loadSaved() { try { return JSON.parse(localStorage.getItem(storeKey) || '[]'); } catch (e) { return []; } }
        function saveAll(arr) { try { localStorage.setItem(storeKey, JSON.stringify(arr)); } catch (e) {} }
        function newId() { return 'r' + (window.Date ? Date.now() : 0) + '_' + Math.floor((window.Math ? Math.random() : 0) * 1e6); }

        // Inject the visitor's previously published reviews (newest first).
        var saved = loadSaved();
        var idsAdded = false;
        saved.forEach(function (r) { if (!r.id) { r.id = newId(); idsAdded = true; } });
        if (idsAdded) { saveAll(saved); }
        for (var s = saved.length - 1; s >= 0; s--) { track.insertBefore(buildCard(saved[s]), track.firstChild); }

        // Delete a self-published review (these cards live only in this browser).
        track.addEventListener('click', function (e) {
          var del = e.target && e.target.closest ? e.target.closest('[data-revdel]') : null;
          if (!del) { return; }
          var card = del.closest('.wld-felispace-revcard');
          if (!card) { return; }
          var id = card.getAttribute('data-rev-id');
          saveAll(loadSaved().filter(function (r) { return String(r.id) !== String(id); }));
          card.parentNode.removeChild(card);
          rebuildDots();
        });

        function step() {
          var c = track.querySelector('.wld-felispace-revcard');
          if (!c) { return 320; }
          return c.getBoundingClientRect().width + 22;
        }
        var dots = [];
        function rebuildDots() {
          dotsWrap.innerHTML = ''; dots = [];
          var cards = track.querySelectorAll('.wld-felispace-revcard');
          cards.forEach(function (c, i) {
            var d = document.createElement('button');
            d.type = 'button'; d.className = 'wld-felispace-revdot'; if (i === 0) { d.classList.add('is-active'); }
            d.addEventListener('click', function () { track.scrollTo({ left: step() * i, behavior: 'smooth' }); });
            dotsWrap.appendChild(d); dots.push(d);
          });
        }
        function setActive() {
          var idx = Math.round(track.scrollLeft / step());
          dots.forEach(function (d, i) { d.classList.toggle('is-active', i === idx); });
        }
        track.addEventListener('scroll', function () { window.requestAnimationFrame(setActive); });
        var prev = sl.querySelector('[data-revprev]'), next = sl.querySelector('[data-revnext]');
        if (prev) { prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); }); }
        if (next) { next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); }); }
        rebuildDots();

        // ---- Write a review ----
        var writeBtn = sl.querySelector('[data-revwrite]');
        var modal = sl.parentElement.querySelector('[data-revmodal]');
        if (writeBtn && modal) {
          var form = modal.querySelector('[data-revform]');
          var starsWrap = modal.querySelector('[data-revstars]');
          var photoInput = modal.querySelector('[data-revphoto]');
          var photoLabel = modal.querySelector('[data-revphoto-label]');
          var preview = modal.querySelector('[data-revpreview]');
          var curRating = 5, photoData = '';

          var starBtns = [];
          for (var st = 1; st <= 5; st++) {
            (function (val) {
              var b = document.createElement('button');
              b.type = 'button'; b.className = 'wld-felispace-revstar-in is-on'; b.textContent = '★';
              b.setAttribute('aria-label', val + ' star' + (val > 1 ? 's' : ''));
              b.addEventListener('click', function () {
                curRating = val;
                starBtns.forEach(function (sb, i) { sb.classList.toggle('is-on', i < val); });
              });
              starsWrap.appendChild(b); starBtns.push(b);
            })(st);
          }

          function openModal() { modal.hidden = false; document.body.style.overflow = 'hidden'; }
          function closeModal() { modal.hidden = true; document.body.style.overflow = ''; }
          writeBtn.addEventListener('click', openModal);
          modal.querySelectorAll('[data-revclose]').forEach(function (x) { x.addEventListener('click', closeModal); });
          document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) { closeModal(); } });

          photoInput.addEventListener('change', function () {
            var f = photoInput.files && photoInput.files[0];
            if (!f) { return; }
            var rd = new FileReader();
            rd.onload = function (e) {
              photoData = e.target.result; preview.src = photoData; preview.hidden = false;
              photoLabel.textContent = '✅ Photo added — tap to change';
            };
            rd.readAsDataURL(f);
          });

          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var r = {
              id: newId(),
              rating: curRating,
              title: (form.title.value || '').trim(),
              name: (form.name.value || '').trim(),
              text: (form.text.value || '').trim(),
              img: photoData
            };
            if (!r.title || !r.name || !r.text) {
              form.querySelectorAll('[required]').forEach(function (fld) {
                fld.classList.toggle('is-invalid', !String(fld.value || '').trim());
              });
              return;
            }
            var arr = loadSaved(); arr.unshift(r); saveAll(arr);
            track.insertBefore(buildCard(r), track.firstChild);
            rebuildDots();
            track.scrollTo({ left: 0, behavior: 'smooth' });
            form.reset();
            form.querySelectorAll('.is-invalid').forEach(function (fld) { fld.classList.remove('is-invalid'); });
            photoData = ''; preview.hidden = true; photoLabel.textContent = '📷 Add a photo (optional)';
            curRating = 5; starBtns.forEach(function (sb) { sb.classList.add('is-on'); });
            closeModal();
          });
        }
      });

      root.querySelectorAll('[data-faq-q]').forEach(function (q) {
        q.addEventListener('click', function () {
          var item = q.parentElement;
          var ans = item.querySelector('.wld-felispace-faq__a');
          var open = item.classList.toggle('is-open');
          ans.style.maxHeight = open ? ans.scrollHeight + 'px' : null;
        });
      });

      root.querySelectorAll('[data-cmp]').forEach(function (cmp) {
        var tabs = cmp.querySelectorAll('[data-cmp-tab]');
        var panels = cmp.querySelectorAll('[data-cmp-panel]');
        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            var id = tab.getAttribute('data-cmp-tab');
            tabs.forEach(function (t) { t.classList.toggle('is-active', t === tab); });
            panels.forEach(function (p) { p.classList.toggle('is-active', p.getAttribute('data-cmp-panel') === id); });
          });
        });
      });
    }

    var SECTION_ID = {{ section.id | json }};
    function boot() { initFelispace(document.getElementById('wld-felispace-' + SECTION_ID)); }

    if (document.readyState !== 'loading') { boot(); }
    else { document.addEventListener('DOMContentLoaded', boot); }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === SECTION_ID) {
        initFelispace(document.getElementById('wld-felispace-' + SECTION_ID));
      }
    });
  })();
</script>

