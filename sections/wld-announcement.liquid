{%- comment -%} Felispace announcement bar with evergreen countdown {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">

<div class="wld-annc" id="wld-annc-{{ section.id }}" style="--annc-bg: {{ section.settings.bg_color }}; --annc-fg: {{ section.settings.text_color }}; --annc-accent: {{ section.settings.accent_color }};">
  {%- if section.settings.link != blank -%}<a class="wld-annc__link" href="{{ section.settings.link }}">{%- endif -%}
  <div class="wld-annc__inner">
    <div class="wld-annc__msg">
      <span class="wld-annc__title">{{ section.settings.message }}</span>
      {%- if section.settings.subtext != blank -%}<span class="wld-annc__sub">{{ section.settings.subtext }}</span>{%- endif -%}
    </div>
    {%- if section.settings.show_timer -%}
    <div class="wld-annc__timer" data-annc-timer data-hours="{{ section.settings.timer_hours }}">
      <div class="wld-annc__unit"><span data-h>00</span><small>{{ section.settings.label_h }}</small></div>
      <span class="wld-annc__colon">:</span>
      <div class="wld-annc__unit"><span data-m>00</span><small>{{ section.settings.label_m }}</small></div>
      <span class="wld-annc__colon">:</span>
      <div class="wld-annc__unit"><span data-s>00</span><small>{{ section.settings.label_s }}</small></div>
    </div>
    {%- endif -%}
  </div>
  {%- if section.settings.link != blank -%}</a>{%- endif -%}
</div>

<style>
  #wld-annc-{{ section.id }} { background: var(--annc-bg); color: var(--annc-fg); font-family: 'Montserrat', sans-serif; }
  #wld-annc-{{ section.id }} .wld-annc__link { display: block; color: inherit; text-decoration: none; }
  #wld-annc-{{ section.id }} .wld-annc__inner { max-width: 1400px; margin: 0 auto; padding: 9px 20px; display: flex; align-items: center; justify-content: center; gap: 22px; flex-wrap: wrap; text-align: center; }
  #wld-annc-{{ section.id }} .wld-annc__msg { display: flex; flex-direction: column; line-height: 1.15; }
  #wld-annc-{{ section.id }} .wld-annc__title { font-weight: 800; font-size: 14.5px; letter-spacing: .2px; }
  #wld-annc-{{ section.id }} .wld-annc__sub { font-weight: 600; font-size: 11.5px; opacity: .9; margin-top: 2px; }
  #wld-annc-{{ section.id }} .wld-annc__timer { display: flex; align-items: center; gap: 6px; }
  #wld-annc-{{ section.id }} .wld-annc__unit { display: flex; flex-direction: column; align-items: center; min-width: 30px; }
  #wld-annc-{{ section.id }} .wld-annc__unit span { font-weight: 800; font-size: 17px; line-height: 1; font-variant-numeric: tabular-nums; }
  #wld-annc-{{ section.id }} .wld-annc__unit small { font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; opacity: .85; margin-top: 2px; }
  #wld-annc-{{ section.id }} .wld-annc__colon { font-weight: 800; font-size: 16px; margin-top: -8px; }
  @media (max-width: 600px) {
    #wld-annc-{{ section.id }} .wld-annc__inner { gap: 14px; padding: 8px 14px; }
    #wld-annc-{{ section.id }} .wld-annc__title { font-size: 13px; }
    #wld-annc-{{ section.id }} .wld-annc__unit span { font-size: 15px; }
  }
</style>

<script>
  (function () {
    var el = document.getElementById('wld-annc-{{ section.id }}');
    if (!el) return;
    var t = el.querySelector('[data-annc-timer]');
    if (!t) return;
    var hours = parseFloat(t.getAttribute('data-hours')) || 12;
    var key = 'wld_annc_end_{{ section.id }}';
    function store(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
    function read(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
    var end = parseInt(read(key), 10);
    var now = Date.now();
    if (!end || isNaN(end) || end < now) { end = now + hours * 3600 * 1000; store(key, end); }
    var hEl = t.querySelector('[data-h]'), mEl = t.querySelector('[data-m]'), sEl = t.querySelector('[data-s]');
    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function tick() {
      var diff = end - Date.now();
      if (diff <= 0) { end = Date.now() + hours * 3600 * 1000; store(key, end); diff = end - Date.now(); }
      var totalSec = Math.floor(diff / 1000);
      hEl.textContent = pad(Math.floor(totalSec / 3600));
      mEl.textContent = pad(Math.floor((totalSec % 3600) / 60));
      sEl.textContent = pad(totalSec % 60);
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>

{% schema %}
{
  "name": "WLD — Announcement timer",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "message", "label": "Message", "default": "🎁 FREE shipping + 30% OFF all caves + free gifts" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Limited-time offer" },
    { "type": "url", "id": "link", "label": "Link (optional)" },
    { "type": "header", "content": "⏱️ Countdown" },
    { "type": "checkbox", "id": "show_timer", "label": "Show countdown", "default": true },
    { "type": "text", "id": "timer_hours", "label": "Countdown length (hours, resets per visitor)", "default": "12" },
    { "type": "text", "id": "label_h", "label": "Hours label", "default": "Hrs" },
    { "type": "text", "id": "label_m", "label": "Minutes label", "default": "Mins" },
    { "type": "text", "id": "label_s", "label": "Seconds label", "default": "Secs" },
    { "type": "header", "content": "🎨 Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1f6f43" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#d6f0bd" }
  ]
}
{% endschema %}
