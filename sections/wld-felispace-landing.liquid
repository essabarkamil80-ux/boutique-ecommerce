{%- comment -%} Felispace Landing — CRO buy box v2 {%- endcomment -%}
{%- assign wld_product = section.settings.product | default: product -%}
{%- assign wld_v1 = wld_product.variants[0] -%}
{%- assign wld_default_variant = wld_product.selected_or_first_available_variant | default: wld_v1 -%}

{%- assign wld_gifts = section.settings.bundle_gifts | newline_to_br | split: '<br />' -%}
{%- capture wld_tiers -%}
<div class="wld-felispace-tiers" data-tier-group>
  {%- comment -%} ---- TIER 1 ---- {%- endcomment -%}
  <button type="button" class="wld-felispace-tier" data-tier data-qty="1">
    {%- if section.settings.tier1_badge != blank -%}<span class="wld-felispace-tier__badge">{{ section.settings.tier1_badge }}</span>{%- endif -%}
    <span class="wld-felispace-tier__radio"></span>
    <span class="wld-felispace-tier__main">
      <span class="wld-felispace-tier__title">{{ section.settings.tier1_title }}</span>
      {%- if section.settings.tier1_sub != blank -%}<span class="wld-felispace-tier__sub">{{ section.settings.tier1_sub }}</span>{%- endif -%}
      <ul class="wld-felispace-tier__items">
        {%- assign il1 = section.settings.tier1_items | newline_to_br | split: '<br />' -%}
        {%- for i in il1 -%}{%- assign ii = i | strip -%}{%- if ii != blank -%}<li class="wld-felispace-tier__item"><span class="wld-felispace-tier__check">✓</span><span>{{ ii }}</span></li>{%- endif -%}{%- endfor -%}
        {%- for g in wld_gifts -%}{%- assign gg = g | strip -%}{%- if gg != blank -%}<li class="wld-felispace-tier__item is-gift"><span class="wld-felispace-tier__check">🎁</span><span>{{ gg }}</span></li>{%- endif -%}{%- endfor -%}
      </ul>
    </span>
    <span class="wld-felispace-tier__pricing">
      <span class="wld-felispace-tier__price" data-price>{{ section.settings.tier1_price }}</span>
      {%- if section.settings.tier1_compare != blank -%}<span class="wld-felispace-tier__compare" data-price>{{ section.settings.tier1_compare }}</span>{%- endif -%}
      {%- if section.settings.tier1_save != blank -%}<span class="wld-felispace-tier__savepill" data-price>{{ section.settings.tier1_save }}</span>{%- endif -%}
    </span>
  </button>

  {%- comment -%} ---- TIER 2 ---- {%- endcomment -%}
  <button type="button" class="wld-felispace-tier is-active" data-tier data-qty="2">
    {%- if section.settings.tier2_badge != blank -%}<span class="wld-felispace-tier__badge">{{ section.settings.tier2_badge }}</span>{%- endif -%}
    <span class="wld-felispace-tier__radio"></span>
    <span class="wld-felispace-tier__main">
      <span class="wld-felispace-tier__title">{{ section.settings.tier2_title }}</span>
      {%- if section.settings.tier2_sub != blank -%}<span class="wld-felispace-tier__sub">{{ section.settings.tier2_sub }}</span>{%- endif -%}
      <ul class="wld-felispace-tier__items">
        {%- assign il2 = section.settings.tier2_items | newline_to_br | split: '<br />' -%}
        {%- for i in il2 -%}{%- assign ii = i | strip -%}{%- if ii != blank -%}<li class="wld-felispace-tier__item"><span class="wld-felispace-tier__check">✓</span><span>{{ ii }}</span></li>{%- endif -%}{%- endfor -%}
        {%- for g in wld_gifts -%}{%- assign gg = g | strip -%}{%- if gg != blank -%}<li class="wld-felispace-tier__item is-gift"><span class="wld-felispace-tier__check">🎁</span><span>{{ gg }}</span></li>{%- endif -%}{%- endfor -%}
      </ul>
    </span>
    <span class="wld-felispace-tier__pricing">
      <span class="wld-felispace-tier__price" data-price>{{ section.settings.tier2_price }}</span>
      {%- if section.settings.tier2_compare != blank -%}<span class="wld-felispace-tier__compare" data-price>{{ section.settings.tier2_compare }}</span>{%- endif -%}
      {%- if section.settings.tier2_save != blank -%}<span class="wld-felispace-tier__savepill" data-price>{{ section.settings.tier2_save }}</span>{%- endif -%}
    </span>
  </button>

  {%- comment -%} ---- TIER 3 ---- {%- endcomment -%}
  <button type="button" class="wld-felispace-tier wld-felispace-tier--feature" data-tier data-qty="3">
    {%- if section.settings.tier3_badge != blank -%}<span class="wld-felispace-tier__badge wld-felispace-tier__badge--gold">{{ section.settings.tier3_badge }}</span>{%- endif -%}
    <span class="wld-felispace-tier__radio"></span>
    <span class="wld-felispace-tier__main">
      <span class="wld-felispace-tier__title">{{ section.settings.tier3_title }}</span>
      {%- if section.settings.tier3_sub != blank -%}<span class="wld-felispace-tier__sub">{{ section.settings.tier3_sub }}</span>{%- endif -%}
      <ul class="wld-felispace-tier__items">
        {%- assign il3 = section.settings.tier3_items | newline_to_br | split: '<br />' -%}
        {%- for i in il3 -%}{%- assign ii = i | strip -%}{%- if ii != blank -%}<li class="wld-felispace-tier__item"><span class="wld-felispace-tier__check">✓</span><span>{{ ii }}</span></li>{%- endif -%}{%- endfor -%}
        {%- for g in wld_gifts -%}{%- assign gg = g | strip -%}{%- if gg != blank -%}<li class="wld-felispace-tier__item is-gift"><span class="wld-felispace-tier__check">🎁</span><span>{{ gg }}</span></li>{%- endif -%}{%- endfor -%}
      </ul>
    </span>
    <span class="wld-felispace-tier__pricing">
      <span class="wld-felispace-tier__price" data-price>{{ section.settings.tier3_price }}</span>
      {%- if section.settings.tier3_compare != blank -%}<span class="wld-felispace-tier__compare" data-price>{{ section.settings.tier3_compare }}</span>{%- endif -%}
      {%- if section.settings.tier3_save != blank -%}<span class="wld-felispace-tier__savepill" data-price>{{ section.settings.tier3_save }}</span>{%- endif -%}
    </span>
  </button>
</div>
{%- endcapture -%}

{%- capture wld_shipbar -%}
  {%- if section.settings.show_ship_bar -%}
  {%- assign ship_secs = section.settings.ship_days | times: 86400 -%}
  {%- assign ship_date = 'now' | date: '%s' | plus: ship_secs | date: '%a, %B %-d' -%}
  <div class="wld-felispace-shipbar">
    <span class="wld-felispace-shipbar__left"><span class="wld-felispace-shipbar__dot"></span>{{ section.settings.ship_label }} <strong>{{ ship_date }}</strong></span>
    <span class="wld-felispace-shipbar__right">🚚 {{ section.settings.ship_free_text }}</span>
  </div>
  {%- endif -%}
{%- endcapture -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{%- if section.settings.main_font_link != blank -%}
<link href="{{ section.settings.main_font_link }}" rel="stylesheet">
{%- endif -%}
{%- if section.settings.video_font_link != blank -%}
<link href="{{ section.settings.video_font_link }}" rel="stylesheet">
{%- endif -%}
{%- if section.settings.buy_font_link != blank -%}
<link href="{{ section.settings.buy_font_link }}" rel="stylesheet">
{%- endif -%}

<section
  id="wld-felispace-{{ section.id }}"
  class="wld-felispace"
  data-section-id="{{ section.id }}"
  data-size-keyword="{{ section.settings.bigger_size_keyword | escape }}"
  data-size-uplift="{{ section.settings.bigger_size_uplift }}"
  style="--wld-primary: {{ section.settings.color_primary }}; --wld-accent: {{ section.settings.color_accent }}; --wld-accent2: {{ section.settings.color_accent2 }}; --wld-heading: {{ section.settings.color_heading }}; --wld-olive: {{ section.settings.color_olive }}; --wld-cream: {{ section.settings.color_cream }}; --wld-dark: {{ section.settings.color_dark }}; --wld-add: {{ section.settings.color_add }};{% if section.settings.main_font_family != blank %} --wld-font: {{ section.settings.main_font_family }};{% endif %}{% if section.settings.video_font_family != blank %} --wld-video-font: {{ section.settings.video_font_family }};{% endif %}{% if section.settings.buy_font_family != blank %} --wld-buy-font: {{ section.settings.buy_font_family }};{% endif %}">

  {%- if wld_product == blank -%}
    <div class="wld-felispace-no-product vel-no-product-notice">
      ⚠️ No product selected. Open the theme editor → section settings → choose the Felispace Cave product to activate the cart.
    </div>
  {%- endif -%}

  {% comment %} ========================= HERO ========================= {% endcomment %}
  <div class="wld-felispace-hero">
    <div class="wld-felispace-hero__media">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 900 }}" alt="{{ section.settings.product_title | escape }}" loading="eager" width="900" height="900">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'wld-felispace-placeholder' }}
      {%- endif -%}
    </div>

    <div class="wld-felispace-hero__info">
      {%- if section.settings.show_trustpilot -%}
      <div class="wld-felispace-trustpilot wld-felispace-trustpilot--top">
        {%- if section.settings.trustpilot_image != blank -%}
          <img src="{{ section.settings.trustpilot_image | image_url: width: 420 }}" alt="Trustpilot rating" width="200" loading="lazy">
        {%- else -%}
          <span class="wld-felispace-tp__score">{{ section.settings.trustpilot_score }}</span>
          <span class="wld-felispace-tp__stars" aria-hidden="true">
            {%- for i in (1..5) -%}<span class="wld-felispace-tp__star">★</span>{%- endfor -%}
          </span>
          <span class="wld-felispace-tp__brand"><span class="wld-felispace-tp__brandstar">★</span>Trustpilot</span>
        {%- endif -%}
        {%- if section.settings.trustpilot_count != blank -%}<span class="wld-felispace-tp__count">{{ section.settings.trustpilot_count }}</span>{%- endif -%}
      </div>
      {%- else -%}
      <div class="wld-felispace-microproof">
        <span class="wld-felispace-stars">★★★★★</span>
        <strong>{{ section.settings.rating_score }}/5</strong>
        <span class="wld-felispace-microproof__sep">·</span>
        <span>{{ section.settings.rating_count }}</span>
        <span class="wld-felispace-microproof__sep">·</span>
        <span class="wld-felispace-microproof__cust">{{ section.settings.micro_customers }}</span>
      </div>
      {%- endif -%}

      <h1 class="wld-felispace-hero__title">{{ section.settings.product_title }}</h1>

      {%- if section.settings.benefit_intro != blank -%}
        <p class="wld-felispace-hero__intro">{{ section.settings.benefit_intro }}</p>
      {%- endif -%}

      <ul class="wld-felispace-bullets">
        {%- if section.settings.bullet_1 != blank -%}<li>{{ section.settings.bullet_1 }}</li>{%- endif -%}
        {%- if section.settings.bullet_2 != blank -%}<li>{{ section.settings.bullet_2 }}</li>{%- endif -%}
        {%- if section.settings.bullet_3 != blank -%}<li>{{ section.settings.bullet_3 }}</li>{%- endif -%}
        {%- if section.settings.bullet_4 != blank -%}<li>{{ section.settings.bullet_4 }}</li>{%- endif -%}
        {%- if section.settings.bullet_5 != blank -%}<li>{{ section.settings.bullet_5 }}</li>{%- endif -%}
      </ul>

      {%- if wld_product != blank -%}
      <form method="post" action="/cart/add" id="wld-felispace-buybox-{{ section.id }}" class="wld-felispace-buyform" data-buyform>
        <input type="hidden" name="id" value="{{ wld_default_variant.id }}" data-variant-input>
        <input type="hidden" name="quantity" value="2" data-qty-input>

        {%- if section.settings.urgency_stock != blank or section.settings.urgency_demand != blank -%}
        <div class="wld-felispace-urgency">
          {%- if section.settings.urgency_stock != blank -%}<span class="wld-felispace-urgency__item">⚡ {{ section.settings.urgency_stock }}</span>{%- endif -%}
          {%- if section.settings.urgency_demand != blank -%}<span class="wld-felispace-urgency__item wld-felispace-urgency__hot">🔥 {{ section.settings.urgency_demand }}</span>{%- endif -%}
        </div>
        {%- endif -%}

        {%- for opt in wld_product.options_with_values -%}
          {%- unless opt.name == 'Title' and opt.values.size == 1 -%}
          {%- assign opt_name = opt.name | downcase -%}
          {%- assign is_color = false -%}
          {%- if opt_name contains 'colour' or opt_name contains 'color' or opt_name contains 'couleur' -%}{%- assign is_color = true -%}{%- endif -%}
          <div class="wld-felispace-field wld-felispace-field--sep">
            <label class="wld-felispace-field__label wld-felispace-field__label--bundle">Choose {{ opt.name }} <span class="wld-felispace-opt-selected" data-opt-selected="{{ opt.position }}">{{ opt.selected_value }}</span></label>
            {%- if is_color -%}
              {%- assign color_idx = opt.position | minus: 1 -%}
              <div class="wld-felispace-swatches" data-option-position="{{ opt.position }}">
                {%- for val in opt.values -%}
                  {%- assign cn = val | downcase -%}
                  {%- assign cdot = '#cccccc' -%}
                  {%- if cn contains 'black' or cn contains 'void' or cn contains 'noir' -%}{%- assign cdot = '#1a1a1a' -%}
                  {%- elsif cn contains 'charcoal' or cn contains 'grey' or cn contains 'gray' or cn contains 'gris' -%}{%- assign cdot = '#8a8a8a' -%}
                  {%- elsif cn contains 'pink' or cn contains 'rose' -%}{%- assign cdot = '#e89ab0' -%}
                  {%- elsif cn contains 'blue' or cn contains 'bleu' or cn contains 'sky' -%}{%- assign cdot = '#7fb0d6' -%}
                  {%- elsif cn contains 'white' or cn contains 'snow' or cn contains 'blanc' -%}{%- assign cdot = '#eeeeee' -%}
                  {%- elsif cn contains 'beige' or cn contains 'sand' -%}{%- assign cdot = '#d8c4a0' -%}
                  {%- elsif cn contains 'green' or cn contains 'sage' -%}{%- assign cdot = '#9cbf8f' -%}
                  {%- elsif cn contains 'ginger' or cn contains 'orange' -%}{%- assign cdot = '#d98a4a' -%}
                  {%- endif -%}
                  {%- assign img_key = 'color_img_' | append: forloop.index -%}
                  {%- assign custom_img = section.settings[img_key] -%}
                  {%- assign swatch_img = blank -%}
                  {%- if custom_img != blank -%}
                    {%- assign swatch_img = custom_img -%}
                  {%- else -%}
                    {%- for v in wld_product.variants -%}
                      {%- if v.options[color_idx] == val and v.image != blank -%}{%- assign swatch_img = v.image -%}{%- break -%}{%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                  <button type="button" class="wld-felispace-swatch{% if swatch_img != blank %} has-img{% endif %}{% if val == opt.selected_value %} is-active{% endif %}" data-opt-value data-position="{{ opt.position }}" data-value="{{ val | escape }}" aria-label="{{ val | escape }}" title="{{ val | escape }}">
                    {%- if swatch_img != blank -%}
                      <img src="{{ swatch_img | image_url: width: 180 }}" alt="{{ val | escape }}" width="90" height="90" loading="lazy">
                    {%- else -%}
                      <span class="wld-felispace-swatch__dot" style="background: {{ cdot }};"></span>
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="wld-felispace-optrow" data-option-position="{{ opt.position }}">
                {%- for val in opt.values -%}
                  <button type="button" class="wld-felispace-pill2{% if val == opt.selected_value %} is-active{% endif %}" data-opt-value data-position="{{ opt.position }}" data-value="{{ val | escape }}">{{ val }}</button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
          {%- endunless -%}
        {%- endfor -%}

        <script type="application/json" data-variants-json>
          [
          {%- for v in wld_product.variants -%}
            {"id": {{ v.id }}, "options": {{ v.options | json }}, "available": {{ v.available }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
          ]
        </script>

        <div class="wld-felispace-field wld-felispace-field--sep">
          <label class="wld-felispace-field__label wld-felispace-field__label--bundle">{{ section.settings.bundle_label }}</label>
          {{ wld_tiers }}
        </div>

        <button type="button" class="wld-felispace-cta wld-felispace-cta--buynow" data-buynow>{{ section.settings.buy_now_text }}</button>
        <button type="submit" class="wld-felispace-cta wld-felispace-cta--secondary" data-addcart>{{ section.settings.cta_text }}</button>

        {{ wld_shipbar }}

        <p class="wld-felispace-moneyback">🛡️ {{ section.settings.moneyback_text }}</p>

        <div class="wld-felispace-trust4">
          {%- if section.settings.badge_1 != blank -%}<div class="wld-felispace-trust4__item">{{ section.settings.badge_1 }}</div>{%- endif -%}
          {%- if section.settings.badge_2 != blank -%}<div class="wld-felispace-trust4__item">{{ section.settings.badge_2 }}</div>{%- endif -%}
          {%- if section.settings.badge_3 != blank -%}<div class="wld-felispace-trust4__item">{{ section.settings.badge_3 }}</div>{%- endif -%}
          {%- if section.settings.badge_4 != blank -%}<div class="wld-felispace-trust4__item">{{ section.settings.badge_4 }}</div>{%- endif -%}
        </div>

        {%- assign hv_count = 0 -%}
        {%- for block in section.blocks -%}{%- if block.type == 'hero_video' -%}{%- assign hv_count = hv_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- if hv_count > 0 -%}
        <div class="wld-felispace-herovids">
          {%- if section.settings.hero_video_title != blank -%}<p class="wld-felispace-herovids__title">{{ section.settings.hero_video_title }}</p>{%- endif -%}
          <div class="wld-felispace-herovids__row">
            {%- for block in section.blocks -%}
              {%- if block.type == 'hero_video' -%}
                <div class="wld-felispace-vid wld-felispace-vid--mini" data-vid {{ block.shopify_attributes }}>
                  {%- if block.settings.video != blank -%}
                    <video class="wld-felispace-vid__player" {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 400 }}"{% elsif block.settings.video.preview_image %}poster="{{ block.settings.video.preview_image | image_url: width: 400 }}"{% endif %} preload="none" loop muted playsinline controls>
                      {%- for source in block.settings.video.sources -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endfor -%}
                    </video>
                    <button type="button" class="wld-felispace-vid__play" aria-label="Play video" data-vid-play>▶</button>
                  {%- elsif block.settings.video_url != blank -%}
                    <video class="wld-felispace-vid__player" {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 400 }}"{% endif %} preload="none" loop muted playsinline controls>
                      <source src="{{ block.settings.video_url }}" type="video/mp4">
                    </video>
                    <button type="button" class="wld-felispace-vid__play" aria-label="Play video" data-vid-play>▶</button>
                  {%- elsif block.settings.poster != blank -%}
                    <img src="{{ block.settings.poster | image_url: width: 400 }}" alt="" loading="lazy" width="400" height="560">
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'wld-felispace-placeholder' }}
                  {%- endif -%}
                  {%- if block.settings.caption != blank -%}<span class="wld-felispace-vid__cap">{{ block.settings.caption }}</span>{%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}
      </form>
      {%- else -%}
        <button type="button" class="wld-felispace-cta is-disabled" disabled>{{ section.settings.cta_text }}</button>
      {%- endif -%}

      {%- if section.settings.show_iconrow -%}
      <div class="wld-felispace-iconrow">
        <div class="wld-felispace-iconrow__item"><span class="wld-felispace-iconrow__ico">{{ section.settings.icon_1_emoji }}</span><span class="wld-felispace-iconrow__txt">{{ section.settings.icon_1_text }}</span></div>
        <div class="wld-felispace-iconrow__item"><span class="wld-felispace-iconrow__ico">{{ section.settings.icon_2_emoji }}</span><span class="wld-felispace-iconrow__txt">{{ section.settings.icon_2_text }}</span></div>
        <div class="wld-felispace-iconrow__item"><span class="wld-felispace-iconrow__ico">{{ section.settings.icon_3_emoji }}</span><span class="wld-felispace-iconrow__txt">{{ section.settings.icon_3_text }}</span></div>
      </div>
      {%- endif -%}

      {%- assign acc_count = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'bb_accordion' -%}{%- assign acc_count = acc_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if acc_count > 0 -%}
      <div class="wld-felispace-bbacc" data-faq>
        {%- for block in section.blocks -%}
          {%- if block.type == 'bb_accordion' -%}
            <div class="wld-felispace-faq__item" {{ block.shopify_attributes }}>
              <button type="button" class="wld-felispace-faq__q" data-faq-q>{{ block.settings.title }}<span class="wld-felispace-faq__icon">+</span></button>
              <div class="wld-felispace-faq__a">{{ block.settings.content }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
  </div>

  {% comment %} ============ SOCIAL PROOF + VIDÉOS ============ {% endcomment %}
  <div class="wld-felispace-band wld-felispace-band--cream">
    <h2 class="wld-felispace-h2 wld-felispace-h2--video">{{ section.settings.social_title }}</h2>
    <p class="wld-felispace-sub">{{ section.settings.social_sub }}</p>

    {%- assign vid_count = 0 -%}
    {%- for block in section.blocks -%}{%- if block.type == 'video' -%}{%- assign vid_count = vid_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if vid_count > 0 -%}
      <div class="wld-felispace-videos">
        {%- for block in section.blocks -%}
          {%- if block.type == 'video' -%}
            <div class="wld-felispace-vid" data-vid {{ block.shopify_attributes }}>
              {%- if block.settings.video != blank -%}
                {%- assign vposter = block.settings.poster -%}
                <video
                  class="wld-felispace-vid__player"
                  {% if vposter != blank %}poster="{{ vposter | image_url: width: 720 }}"{% elsif block.settings.video.preview_image %}poster="{{ block.settings.video.preview_image | image_url: width: 720 }}"{% endif %}
                  preload="none"
                  loop muted playsinline controls
                  {% for source in block.settings.video.sources %}{% if source.format == 'mp4' %}{% endif %}{% endfor %}>
                  {%- for source in block.settings.video.sources -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endfor -%}
                </video>
                <button type="button" class="wld-felispace-vid__play" aria-label="Play video" data-vid-play>▶</button>
              {%- elsif block.settings.video_url != blank -%}
                <video class="wld-felispace-vid__player" {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 720 }}"{% endif %} preload="none" loop muted playsinline controls>
                  <source src="{{ block.settings.video_url }}" type="video/mp4">
                </video>
                <button type="button" class="wld-felispace-vid__play" aria-label="Play video" data-vid-play>▶</button>
              {%- elsif block.settings.poster != blank -%}
                <img src="{{ block.settings.poster | image_url: width: 600 }}" alt="" loading="lazy" width="600" height="840">
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'wld-felispace-placeholder' }}
              {%- endif -%}
              {%- if block.settings.caption != blank -%}<span class="wld-felispace-vid__cap">{{ block.settings.caption }}</span>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="wld-felispace-trust-strip">
      <div class="wld-felispace-trust"><span>🚚</span>{{ section.settings.trust_1 }}</div>
      <div class="wld-felispace-trust"><span>✅</span>{{ section.settings.trust_2 }}</div>
      <div class="wld-felispace-trust"><span>🔒</span>{{ section.settings.trust_3 }}</div>
      <div class="wld-felispace-trust"><span>🐾</span>{{ section.settings.trust_4 }}</div>
    </div>
  </div>

  {% comment %} ================= WHY CHOOSE ================= {% endcomment %}
  <div class="wld-felispace-band wld-felispace-band--accent">
    <h2 class="wld-felispace-h2">{{ section.settings.why_title }}</h2>
    <div class="wld-felispace-why">
      <div class="wld-felispace-why__col">
        <div class="wld-felispace-why__item"><span class="wld-felispace-why__ico">🛡️</span><div><h3>{{ section.settings.why_1_title }}</h3><p>{{ section.settings.why_1_text }}</p></div></div>
        <div class="wld-felispace-why__item"><span class="wld-felispace-why__ico">🌿</span><div><h3>{{ section.settings.why_2_title }}</h3><p>{{ section.settings.why_2_text }}</p></div></div>
      </div>
      <div class="wld-felispace-why__media">
        {%- if section.settings.why_image != blank -%}
          <img src="{{ section.settings.why_image | image_url: width: 700 }}" alt="" loading="lazy" width="700" height="700">
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'wld-felispace-placeholder' }}
        {%- endif -%}
      </div>
      <div class="wld-felispace-why__col">
        <div class="wld-felispace-why__item"><span class="wld-felispace-why__ico">💪</span><div><h3>{{ section.settings.why_3_title }}</h3><p>{{ section.settings.why_3_text }}</p></div></div>
        <div class="wld-felispace-why__item"><span class="wld-felispace-why__ico">🧼</span><div><h3>{{ section.settings.why_4_title }}</h3><p>{{ section.settings.why_4_text }}</p></div></div>
      </div>
    </div>
  </div>

  {% comment %} ================= REVIEWS (slider — Cattasaurus) ================= {% endcomment %}
  <div class="wld-felispace-band wld-felispace-band--dark">
    <h2 class="wld-felispace-h2 wld-felispace-h2--light">{{ section.settings.reviews_title }}</h2>
    {%- assign rev_count = 0 -%}
    {%- for b in section.blocks -%}{%- if b.type == 'review' -%}{%- assign rev_count = rev_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- assign rev_half = rev_count | plus: 1 | divided_by: 2 -%}
    <div class="wld-felispace-revslider" data-revslider>
      {%- assign rc = 0 -%}
      <div class="wld-felispace-revtrack" data-revtrack>
        {%- for block in section.blocks -%}{%- if block.type == 'review' -%}{%- assign rc = rc | plus: 1 -%}{%- if rc <= rev_half -%}
          <article class="wld-felispace-revcard" {{ block.shopify_attributes }}>
            <div class="wld-felispace-revcard__media">{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 640 }}" alt="" loading="lazy" width="420" height="300">{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'wld-felispace-placeholder' }}{%- endif -%}</div>
            <div class="wld-felispace-revcard__body">
              <div class="wld-felispace-revcard__stars">{% for s in (1..block.settings.rating) %}★{% endfor %}</div>
              <h4 class="wld-felispace-revcard__title">{{ block.settings.title }}</h4>
              <p class="wld-felispace-revcard__text">{{ block.settings.text }}</p>
              <span class="wld-felispace-revcard__author">{{ block.settings.author }}</span>
            </div>
          </article>
        {%- endif -%}{%- endif -%}{%- endfor -%}
      </div>

      {%- if wld_product != blank -%}
        <a href="#wld-felispace-buybox-{{ section.id }}" class="wld-felispace-cta wld-felispace-cta--inline wld-felispace-cta--reviews">{{ section.settings.shop_now_text }}</a>
      {%- endif -%}

      {%- if rev_count > rev_half -%}
      {%- assign rc2 = 0 -%}
      <div class="wld-felispace-revtrack" data-revtrack>
        {%- for block in section.blocks -%}{%- if block.type == 'review' -%}{%- assign rc2 = rc2 | plus: 1 -%}{%- if rc2 > rev_half -%}
          <article class="wld-felispace-revcard" {{ block.shopify_attributes }}>
            <div class="wld-felispace-revcard__media">{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 640 }}" alt="" loading="lazy" width="420" height="300">{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'wld-felispace-placeholder' }}{%- endif -%}</div>
            <div class="wld-felispace-revcard__body">
              <div class="wld-felispace-revcard__stars">{% for s in (1..block.settings.rating) %}★{% endfor %}</div>
              <h4 class="wld-felispace-revcard__title">{{ block.settings.title }}</h4>
              <p class="wld-felispace-revcard__text">{{ block.settings.text }}</p>
              <span class="wld-felispace-revcard__author">{{ block.settings.author }}</span>
            </div>
          </article>
        {%- endif -%}{%- endif -%}{%- endfor -%}
      </div>
      {%- endif -%}

      <div class="wld-felispace-revnav">
        <button type="button" class="wld-felispace-revarrow" data-revprev aria-label="Previous">←</button>
        <div class="wld-felispace-revdots" data-revdots></div>
        <button type="button" class="wld-felispace-revarrow" data-revnext aria-label="Next">→</button>
      </div>
      {%- if section.settings.review_cta_text != blank -%}
        <a href="{{ section.settings.review_cta_link | default: '#' }}" class="wld-felispace-revwrite">✍️ {{ section.settings.review_cta_text }}</a>
      {%- endif -%}
    </div>
  </div>

  {% comment %} ================= HOW WE COMPARE (premium) ================= {% endcomment %}
  <div class="wld-felispace-band wld-felispace-band--cream">
    <h2 class="wld-felispace-h2">{{ section.settings.compare_title }}</h2>
    {%- assign vs_count = 0 -%}
    {%- for b in section.blocks -%}{%- if b.type == 'vs' -%}{%- assign vs_count = vs_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if vs_count > 0 -%}
    <div class="wld-felispace-cmp" data-cmp>
      <div class="wld-felispace-cmp__tabs" data-cmp-tabs>
        {%- assign ti = 0 -%}
        {%- for block in section.blocks -%}{%- if block.type == 'vs' -%}{%- assign ti = ti | plus: 1 -%}
          <button type="button" class="wld-felispace-cmp__tab{% if ti == 1 %} is-active{% endif %}" data-cmp-tab="{{ ti }}">{{ block.settings.tab_label }}</button>
        {%- endif -%}{%- endfor -%}
      </div>
      {%- assign pi = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'vs' -%}{%- assign pi = pi | plus: 1 -%}
      <div class="wld-felispace-cmp__panel{% if pi == 1 %} is-active{% endif %}" data-cmp-panel="{{ pi }}" {{ block.shopify_attributes }}>
        <div class="wld-felispace-cmp__grid">
          <div class="wld-felispace-cmp__col wld-felispace-cmp__col--ours">
            <div class="wld-felispace-cmp__head">
              {%- if section.settings.compare_ours_image != blank -%}<img src="{{ section.settings.compare_ours_image | image_url: width: 320 }}" alt="" loading="lazy" width="160" height="160">{%- else -%}<div class="wld-felispace-cmp__ph">🐾</div>{%- endif -%}
              <span class="wld-felispace-cmp__label">{{ section.settings.compare_ours_label }}</span>
            </div>
            {%- assign ours = block.settings.ours_rows | newline_to_br | split: '<br />' -%}
            {%- for r in ours -%}{%- assign rr = r | strip -%}{%- if rr != blank -%}{%- assign p = rr | split: '|' -%}
              <div class="wld-felispace-cmp__row"><span class="wld-felispace-cmp__ic wld-felispace-cmp__ic--yes">✓</span><div class="wld-felispace-cmp__txt"><strong>{{ p[0] | strip }}</strong>{%- if p[1] -%}<span>{{ p[1] | strip }}</span>{%- endif -%}</div></div>
            {%- endif -%}{%- endfor -%}
          </div>
          <div class="wld-felispace-cmp__col wld-felispace-cmp__col--them">
            <div class="wld-felispace-cmp__head">
              {%- if block.settings.them_image != blank -%}<img src="{{ block.settings.them_image | image_url: width: 320 }}" alt="" loading="lazy" width="160" height="160">{%- else -%}<div class="wld-felispace-cmp__ph wld-felispace-cmp__ph--them">✕</div>{%- endif -%}
              <span class="wld-felispace-cmp__label">{{ block.settings.them_label }}</span>
            </div>
            {%- assign them = block.settings.them_rows | newline_to_br | split: '<br />' -%}
            {%- for r in them -%}{%- assign rr = r | strip -%}{%- if rr != blank -%}{%- assign p = rr | split: '|' -%}
              <div class="wld-felispace-cmp__row"><span class="wld-felispace-cmp__ic wld-felispace-cmp__ic--no">✕</span><div class="wld-felispace-cmp__txt"><strong>{{ p[0] | strip }}</strong>{%- if p[1] -%}<span>{{ p[1] | strip }}</span>{%- endif -%}</div></div>
            {%- endif -%}{%- endfor -%}
          </div>
        </div>
      </div>
      {%- endif -%}{%- endfor -%}
      {%- if wld_product != blank -%}<a href="#wld-felispace-buybox-{{ section.id }}" class="wld-felispace-cta wld-felispace-cta--inline">{{ section.settings.shop_now_text }}</a>{%- endif -%}
    </div>
    {%- endif -%}
  </div>

  {% comment %} ================= SCROLLING IMAGE STRIP (TikTok wall) ================= {% endcomment %}
  {%- assign strip_count = 0 -%}
  {%- for b in section.blocks -%}{%- if b.type == 'strip_img' -%}{%- assign strip_count = strip_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
  {%- if strip_count > 0 -%}
  <div class="wld-felispace-band">
    <h2 class="wld-felispace-h2">{{ section.settings.strip_title }}</h2>
    <div class="wld-felispace-strip" data-strip>
      <div class="wld-felispace-strip__track">
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}{%- if block.type == 'strip_img' -%}
            <div class="wld-felispace-strip__item"{% if i == 1 %} {{ block.shopify_attributes }}{% endif %}>
              {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 440 }}" alt="" loading="lazy" width="220" height="390">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'wld-felispace-placeholder' }}{%- endif -%}
            </div>
          {%- endif -%}{%- endfor -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.strip_badge != blank -%}<div class="wld-felispace-strip__badge">{{ section.settings.strip_badge }}</div>{%- endif -%}
    </div>
    {%- if section.settings.strip_foot != blank -%}<p class="wld-felispace-strip__foot">{{ section.settings.strip_foot }}</p>{%- endif -%}
  </div>
  {%- endif -%}

  {% comment %} ================= FAQ ================= {% endcomment %}
  <div class="wld-felispace-band wld-felispace-band--cream">
    <h2 class="wld-felispace-h2">{{ section.settings.faq_title }}</h2>
    <div class="wld-felispace-faq" data-faq>
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
          <div class="wld-felispace-faq__item" {{ block.shopify_attributes }}>
            <button type="button" class="wld-felispace-faq__q" data-faq-q>{{ block.settings.question }}<span class="wld-felispace-faq__icon">+</span></button>
            <div class="wld-felispace-faq__a"><p>{{ block.settings.answer }}</p></div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {% comment %} ================= GUARANTEE (premium reassurance) ================= {% endcomment %}
  <div class="fs-guarantee">
    {%- if section.settings.guar_bg != blank -%}
      <img class="fs-guarantee__bg" src="{{ section.settings.guar_bg | image_url: width: 2200 }}" alt="" loading="lazy" width="2200" height="1100">
    {%- endif -%}
    <span class="fs-guarantee__overlay"></span>
    <div class="fs-guarantee__inner">
      <div class="fs-guarantee__content">
        <h2 class="fs-guarantee__title">{{ section.settings.guar_title }}</h2>
        {%- if section.settings.guar_subtitle != blank -%}<p class="fs-guarantee__sub">{{ section.settings.guar_subtitle }}</p>{%- endif -%}
        <ul class="fs-guarantee__list">
          {%- if section.settings.guar_b1 != blank -%}<li>{{ section.settings.guar_b1 }}</li>{%- endif -%}
          {%- if section.settings.guar_b2 != blank -%}<li>{{ section.settings.guar_b2 }}</li>{%- endif -%}
          {%- if section.settings.guar_b3 != blank -%}<li>{{ section.settings.guar_b3 }}</li>{%- endif -%}
        </ul>
        {%- if wld_product != blank -%}<a href="#wld-felispace-buybox-{{ section.id }}" class="fs-guarantee__cta">{{ section.settings.guar_cta }}</a>{%- endif -%}
        {%- if section.settings.guar_trust_count != blank -%}<p class="fs-guarantee__trust">👥 {{ section.settings.guar_trust_pre }} <strong>{{ section.settings.guar_trust_count }}</strong> {{ section.settings.guar_trust_suffix }}</p>{%- endif -%}
      </div>
      <div class="fs-guarantee__badge-wrap" data-fs-badge>
        <div class="fs-guarantee__badge">
          <span class="fs-guarantee__badge-big">{{ section.settings.guar_badge_big }}</span>
          <span class="fs-guarantee__badge-mid">{{ section.settings.guar_badge_mid }}</span>
          <span class="fs-guarantee__badge-sub">{{ section.settings.guar_badge_sub }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #wld-felispace-{{ section.id }}.wld-felispace { font-family: var(--wld-font, 'Montserrat', sans-serif); color: #141414; line-height: 1.55; }
  #wld-felispace-{{ section.id }} * { box-sizing: border-box; }
  #wld-felispace-{{ section.id }} h1, #wld-felispace-{{ section.id }} h2, #wld-felispace-{{ section.id }} h3, #wld-felispace-{{ section.id }} h4 { font-family: var(--wld-font, 'Montserrat', sans-serif); font-weight: 800; margin: 0 0 .4em; }
  #wld-felispace-{{ section.id }} img { max-width: 100%; height: auto; display: block; }

  #wld-felispace-{{ section.id }} .wld-felispace-no-product { background: #fff4d6; border: 1px solid #e7c65a; color: #6b5200; padding: 14px 18px; border-radius: 10px; margin: 0 auto 24px; max-width: 1100px; font-size: 14px; text-align: center; }

  /* HERO */
  #wld-felispace-{{ section.id }} .wld-felispace-hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: 42px; max-width: 1360px; margin: 0 auto; padding: 34px 28px; align-items: start; }
  #wld-felispace-{{ section.id }} .wld-felispace-hero__media { position: sticky; top: 20px; align-self: start; }
  #wld-felispace-{{ section.id }} .wld-felispace-hero__media img { border-radius: 18px; }
  #wld-felispace-{{ section.id }} .wld-felispace-rating { display: flex; align-items: center; gap: 8px; font-size: 14px; color: #444; margin-bottom: 10px; flex-wrap: wrap; }
  #wld-felispace-{{ section.id }} .wld-felispace-stars { color: var(--wld-primary); letter-spacing: 1px; }
  #wld-felispace-{{ section.id }} .wld-felispace-rating__count { color: #777; }
  #wld-felispace-{{ section.id }} .wld-felispace-hero__title { font-size: clamp(26px, 3.4vw, 42px); line-height: 1.0; letter-spacing: -.5px; margin: 0 0 10px; color: var(--wld-olive); }
  #wld-felispace-{{ section.id }} .wld-felispace-bullets { list-style: none; padding: 0; margin: 0 0 14px; }
  #wld-felispace-{{ section.id }} .wld-felispace-bullets li { position: relative; padding-left: 26px; margin-bottom: 7px; font-size: 15px; line-height: 1.35; }
  #wld-felispace-{{ section.id }} .wld-felispace-bullets li::before { content: "✓"; position: absolute; left: 0; color: var(--wld-primary); font-weight: 700; }

  #wld-felispace-{{ section.id }} .wld-felispace-buyform,
  #wld-felispace-{{ section.id }} .wld-felispace-buybox { font-family: var(--wld-buy-font, var(--wld-font, 'Montserrat', sans-serif)); }
  #wld-felispace-{{ section.id }} .wld-felispace-buyform :not(h1):not(h2):not(h3):not(h4),
  #wld-felispace-{{ section.id }} .wld-felispace-buybox :not(h1):not(h2):not(h3):not(h4) { font-family: var(--wld-buy-font, var(--wld-font, 'Montserrat', sans-serif)); }
  #wld-felispace-{{ section.id }} .wld-felispace-card { border: 1px solid #e4e3dd; border-radius: 16px; padding: 22px; background: #fff; box-shadow: 0 6px 24px rgba(0,0,0,.05); }
  #wld-felispace-{{ section.id }} .wld-felispace-field { margin-bottom: 14px; }
  #wld-felispace-{{ section.id }} .wld-felispace-field--sep { border-top: 1px solid #ececec; padding-top: 14px; margin-top: 2px; }
  #wld-felispace-{{ section.id }} .wld-felispace-field__head { display: flex; justify-content: space-between; align-items: center; }
  #wld-felispace-{{ section.id }} .wld-felispace-field__label { display: block; font-weight: 700; font-size: 14px; margin-bottom: 8px; }
  #wld-felispace-{{ section.id }} .wld-felispace-sizechart { font-size: 12px; color: var(--wld-primary); text-decoration: underline; cursor: pointer; }
  #wld-felispace-{{ section.id }} .wld-felispace-options { display: flex; gap: 10px; flex-wrap: wrap; }
  #wld-felispace-{{ section.id }} .wld-felispace-pill { flex: 1; min-width: 120px; padding: 12px 14px; border: 1.5px solid #d9d9d9; background: #fff; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px; transition: .15s; }
  #wld-felispace-{{ section.id }} .wld-felispace-pill.is-active { border-color: var(--wld-primary); background: var(--wld-accent2); }

  #wld-felispace-{{ section.id }} .wld-felispace-bundles { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  #wld-felispace-{{ section.id }} .wld-felispace-bundle { display: flex; align-items: center; gap: 10px; padding: 14px; border: 1.5px solid #d9d9d9; border-radius: 12px; background: #fff; cursor: pointer; text-align: left; transition: .15s; }
  #wld-felispace-{{ section.id }} .wld-felispace-bundle.is-active { border-color: var(--wld-primary); background: var(--wld-accent2); box-shadow: 0 0 0 1.5px var(--wld-primary) inset; }
  #wld-felispace-{{ section.id }} .wld-felispace-bundle__radio { width: 18px; height: 18px; border-radius: 50%; border: 2px solid #c2c2c2; flex-shrink: 0; position: relative; }
  #wld-felispace-{{ section.id }} .wld-felispace-bundle.is-active .wld-felispace-bundle__radio { border-color: var(--wld-primary); }
  #wld-felispace-{{ section.id }} .wld-felispace-bundle.is-active .wld-felispace-bundle__radio::after { content: ""; position: absolute; inset: 3px; border-radius: 50%; background: var(--wld-primary); }
  #wld-felispace-{{ section.id }} .wld-felispace-bundle__txt { display: flex; flex-direction: column; gap: 2px; }
  #wld-felispace-{{ section.id }} .wld-felispace-bundle__title { font-weight: 700; font-size: 14px; }
  #wld-felispace-{{ section.id }} .wld-felispace-bundle__price { font-size: 12px; color: var(--wld-primary); font-weight: 600; }

  #wld-felispace-{{ section.id }} .wld-felispace-colors { display: flex; flex-direction: column; gap: 8px; }
  #wld-felispace-{{ section.id }} .wld-felispace-color { display: flex; align-items: center; gap: 12px; padding: 8px 12px; border: 1.5px solid #e2e2e2; border-radius: 10px; background: #fff; cursor: pointer; font-size: 14px; }
  #wld-felispace-{{ section.id }} .wld-felispace-color.is-active { border-color: var(--wld-primary); }
  #wld-felispace-{{ section.id }} .wld-felispace-color__swatch { width: 40px; height: 40px; border-radius: 50%; overflow: hidden; background: #eee; flex-shrink: 0; }
  #wld-felispace-{{ section.id }} .wld-felispace-color__name { font-weight: 600; flex: 1; }
  #wld-felispace-{{ section.id }} .wld-felispace-color__add { font-size: 12px; font-weight: 700; color: #fff; background: var(--wld-add); padding: 5px 12px; border-radius: 999px; }

  #wld-felispace-{{ section.id }} .wld-felispace-cta { display: block; width: 100%; padding: 15px 24px; background: var(--wld-primary); color: #fff; border: 0; border-radius: 999px; font-family: var(--wld-buy-font, var(--wld-font, 'Montserrat', sans-serif)); font-weight: 700; font-size: 16px; cursor: pointer; text-align: center; text-decoration: none; transition: .15s; margin-top: 4px; }
