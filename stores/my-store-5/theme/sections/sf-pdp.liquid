  .sf-res__bars em::after { content: ''; position: absolute; right: -5px; top: -3px; width: 10px; height: 10px; border-radius: 50%; background: var(--sf-green); }
  .sf-res__bars b { font-size: 11.5px; font-weight: 400; text-align: right; color: #6f6664; }
  /* fenetre "See in your size" */
  .sf-size { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; padding: 20px; }
  .sf-size[hidden] { display: none; }
  .sf-size__overlay { position: absolute; inset: 0; background: rgba(19, 7, 46, .38); -webkit-backdrop-filter: blur(7px); backdrop-filter: blur(7px); opacity: 0; transition: opacity .2s; }
  .sf-size.is-open .sf-size__overlay { opacity: 1; }
  .sf-size__modal { position: relative; width: min(880px, 100%); max-height: min(92vh, 760px); overflow: auto; border-radius: 20px; background: #fff; box-shadow: 0 30px 80px -20px rgba(19, 7, 46, .5); outline: 0;
    opacity: 0; transform: translateY(12px) scale(.985); transition: opacity .2s, transform .2s; }
  .sf-size.is-open .sf-size__modal { opacity: 1; transform: none; }
  .sf-size__head { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px 16px; border-bottom: 1px solid #F0E9E5; }
