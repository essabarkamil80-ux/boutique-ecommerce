  /* bouton d'achat */
  .sf-atc { display: flex; align-items: center; justify-content: center; gap: 14px; width: 100%; height: 60px; margin-top: 16px; padding: 0 20px; border-radius: 10px; background: var(--sf-plum); color: #fff;
    font-size: 15px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; transition: filter .15s, transform .15s; }
