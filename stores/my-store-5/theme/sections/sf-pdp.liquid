  @media (max-width: 989px) {
    .sf-pdp__grid { grid-template-columns: 1fr; row-gap: 24px; }
    .sf-pdp__gal { position: static; }
  }
  @media (max-width: 749px) {
    .sf-pdp { padding: 0 0 44px; }
    .sf-pdp__grid { padding-inline: 0; }
    .sf-pdp__gal { margin-inline: calc(-1 * var(--sf-gutter)); }
    .sf-pdp__stage { border-radius: 0; aspect-ratio: 1 / 1; }
    .sf-pdp__thumbs { padding-inline: 16px; }
    .sf-pdp__thumb { width: 62px; }
    .sf-offer { padding: 14px 10px 12px; }
    .sf-tier { padding: 12px 10px 0; }
    .sf-tier__top { grid-template-columns: 22px 1fr auto; gap: 10px; }
    .sf-tier__rows { padding-left: 32px; }
    .sf-tier__perks { margin: 0 -10px; } .sf-tier.is-selected .sf-tier__perks { margin: 0 -9px; }
    .sf-perk { padding: 8px 10px; gap: 10px; font-size: 13px; }
    .sf-perk .sf-sel { width: 112px; }
    .sf-atc { height: 58px; font-size: 14px; gap: 10px; }
    .sf-res__label { font-size: 15px; }
    .sf-tier__top { grid-template-columns: 24px 1fr auto; }
    .sf-tier__pill { grid-column: 2 / -1; justify-self: start; }
    .sf-tier__opts { padding-left: 0; }
    .sf-sel { max-width: none; }
    .sf-size { padding: 0; align-items: end; }
    .sf-size__modal { width: 100%; max-height: 94vh; border-radius: 20px 20px 0 0; }
    .sf-size__body { grid-template-columns: 1fr; gap: 18px; padding: 16px 16px 22px; }
    .sf-size__pic { aspect-ratio: 4 / 3.4; }
    .sf-size__head { padding: 16px 16px 14px; }
    .sf-res__tab small { display: none; }
    .sf-pdp__help { flex-wrap: wrap; }
  }
{% endstylesheet %}

