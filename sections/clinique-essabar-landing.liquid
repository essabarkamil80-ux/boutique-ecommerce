  #ce-{{ section.id }} .ce-ugc__play { position: absolute; inset: 0; margin: auto; width: 50px; height: 50px; border-radius: 50%; border: 0; background: rgba(255,255,255,.92); color: var(--ce-ink); font-size: 15px; padding-left: 3px; cursor: pointer; }
