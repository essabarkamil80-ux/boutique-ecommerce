{%- comment -%} Felispace Home — premium DTC homepage (Infinity Hoop structure, Felispace green) {%- endcomment -%}
{%- assign hp = section.settings.product | default: product -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<section
  id="wld-home-{{ section.id }}"
  class="wld-home"
  style="--g: {{ section.settings.color_primary }}; --g-soft: {{ section.settings.color_accent }}; --g-tint: {{ section.settings.color_accent2 }}; --cream: {{ section.settings.color_cream }}; --dark: {{ section.settings.color_dark }};">

  {%- comment -%} ===================== HERO ===================== {%- endcomment -%}
  <div class="wld-home-hero">
    {%- if section.settings.hero_image != blank -%}
      <img class="wld-home-hero__bg" src="{{ section.settings.hero_image | image_url: width: 2000 }}" alt="" loading="eager" width="2000" height="1000">
    {%- endif -%}
    <div class="wld-home-hero__inner">
      <div class="wld-home-hero__tp">
        <span class="wld-home-tp__label">{{ section.settings.hero_tp_label }}</span>
        <span class="wld-home-tp__stars">★★★★★</span>
        <span class="wld-home-tp__brand">Trustpilot</span>
      </div>
      <h1 class="wld-home-hero__title">{{ section.settings.hero_title }}</h1>
      {%- if section.settings.hero_sub != blank -%}<p class="wld-home-hero__sub">{{ section.settings.hero_sub }}</p>{%- endif -%}
      {%- if section.settings.hero_offer != blank -%}<div class="wld-home-hero__offer">{{ section.settings.hero_offer }}</div>{%- endif -%}
      {%- if hp != blank -%}
        <a href="{{ hp.url | default: '#' }}" class="wld-home-btn wld-home-btn--hero">{{ section.settings.hero_cta }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ===================== COLLECTION (4 variants) ===================== {%- endcomment -%}
  {%- if hp != blank -%}
  <div class="wld-home-band">
    <h2 class="wld-home-h2">{{ section.settings.shop_title }}</h2>
    {%- assign color_opt = null -%}
    {%- for opt in hp.options_with_values -%}
      {%- assign on = opt.name | downcase -%}
      {%- if on contains 'colour' or on contains 'color' or on contains 'couleur' -%}{%- assign color_opt = opt -%}{%- endif -%}
    {%- endfor -%}
    <div class="wld-home-cards">
      {%- if color_opt -%}
        {%- assign cidx = color_opt.position | minus: 1 -%}
        {%- for val in color_opt.values -%}
          {%- assign cvar = null -%}
          {%- for v in hp.variants -%}
            {%- if v.options[cidx] == val -%}{%- assign cvar = v -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
          {%- assign ckey = 'card_img_' | append: forloop.index -%}
          {%- assign cimg = section.settings[ckey] -%}
          <a class="wld-home-card" href="{{ hp.url }}{% if cvar %}?variant={{ cvar.id }}{% endif %}">
            <div class="wld-home-card__media">
              {%- if cimg != blank -%}
                <img src="{{ cimg | image_url: width: 600 }}" alt="{{ val | escape }}" loading="lazy" width="400" height="400">
              {%- elsif cvar and cvar.image != blank -%}
                <img src="{{ cvar.image | image_url: width: 600 }}" alt="{{ val | escape }}" loading="lazy" width="400" height="400">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'wld-home-ph' }}
              {%- endif -%}
            </div>
            <div class="wld-home-card__name">{{ section.settings.card_name_prefix }} — {{ val }}</div>
            <div class="wld-home-card__rating">★★★★★ <span>({{ section.settings.card_reviews }})</span></div>
            {%- if cvar -%}<div class="wld-home-card__price">{{ cvar.price | money }}</div>{%- endif -%}
            <span class="wld-home-btn wld-home-btn--sm">{{ section.settings.card_cta }}</span>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===================== TRANSFORMATION (video + benefits) ===================== {%- endcomment -%}
  <div class="wld-home-band wld-home-band--tint">
    <h2 class="wld-home-h2">{{ section.settings.tr_title }}</h2>
    <p class="wld-home-sub">{{ section.settings.tr_sub }}</p>
    <div class="wld-home-tr">
      <div class="wld-home-tr__media" data-vid>
        {%- if section.settings.tr_video != blank -%}
          <video class="wld-home-vid" {% if section.settings.tr_poster != blank %}poster="{{ section.settings.tr_poster | image_url: width: 900 }}"{% endif %} preload="none" loop muted playsinline controls>
            {%- for s in section.settings.tr_video.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}
          </video>
          <button type="button" class="wld-home-play" data-vid-play aria-label="Play">▶</button>
        {%- elsif section.settings.tr_video_url != blank -%}
          <video class="wld-home-vid" {% if section.settings.tr_poster != blank %}poster="{{ section.settings.tr_poster | image_url: width: 900 }}"{% endif %} preload="none" loop muted playsinline controls>
            <source src="{{ section.settings.tr_video_url }}" type="video/mp4">
          </video>
          <button type="button" class="wld-home-play" data-vid-play aria-label="Play">▶</button>
        {%- elsif section.settings.tr_poster != blank -%}
          <img src="{{ section.settings.tr_poster | image_url: width: 900 }}" alt="" loading="lazy" width="700" height="480">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'wld-home-ph' }}
        {%- endif -%}
      </div>
      <div class="wld-home-tr__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <div class="wld-home-brow" {{ block.shopify_attributes }}>
              <span class="wld-home-brow__ico">{{ block.settings.icon }}</span>
              <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    {%- if hp != blank -%}<a href="{{ hp.url }}" class="wld-home-btn wld-home-btn--center">{{ section.settings.tr_cta }}</a>{%- endif -%}
  </div>

  {%- comment -%} ===================== REVIEWS ===================== {%- endcomment -%}
  <div class="wld-home-band">
    <h2 class="wld-home-h2">{{ section.settings.rev_title }}</h2>
    <div class="wld-home-tp wld-home-tp--center">
      <span class="wld-home-tp__stars">★★★★★</span><span class="wld-home-tp__brand">Trustpilot</span>
    </div>
    <div class="wld-home-reviews">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <article class="wld-home-review" {{ block.shopify_attributes }}>
            <div class="wld-home-review__media">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 500 }}" alt="" loading="lazy" width="300" height="360">
              {%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'wld-home-ph' }}{%- endif -%}
            </div>
            <div class="wld-home-review__stars">★★★★★</div>
            <h4 class="wld-home-review__title">{{ block.settings.title }}</h4>
            <p class="wld-home-review__text">{{ block.settings.text }}</p>
            <span class="wld-home-review__author">{{ block.settings.author }}</span>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ===================== STORY (dark, oversized) ===================== {%- endcomment -%}
  <div class="wld-home-story">
    {%- if section.settings.story_image != blank -%}
      <img class="wld-home-story__bg" src="{{ section.settings.story_image | image_url: width: 1800 }}" alt="" loading="lazy" width="1800" height="900">
    {%- endif -%}
    <div class="wld-home-story__inner">
      <span class="wld-home-eyebrow">{{ section.settings.story_eyebrow }}</span>
      <h2 class="wld-home-story__title">{{ section.settings.story_title }}</h2>
      <p class="wld-home-story__text">{{ section.settings.story_text }}</p>
      {%- if hp != blank -%}<a href="{{ hp.url }}" class="wld-home-btn wld-home-btn--light">{{ section.settings.story_cta }}</a>{%- endif -%}
    </div>
  </div>

  {%- comment -%} ===================== STATS (animated counters) ===================== {%- endcomment -%}
  <div class="wld-home-band wld-home-band--tint">
    <span class="wld-home-eyebrow wld-home-eyebrow--center">{{ section.settings.stats_eyebrow }}</span>
    <h2 class="wld-home-h2">{{ section.settings.stats_title }}</h2>
    <div class="wld-home-stats">
      <div class="wld-home-stat"><span class="wld-home-stat__num" data-count="{{ section.settings.stat1_num }}">0</span><span class="wld-home-stat__suf">{{ section.settings.stat1_suffix }}</span><p>{{ section.settings.stat1_text }}</p></div>
      <div class="wld-home-stat"><span class="wld-home-stat__num" data-count="{{ section.settings.stat2_num }}">0</span><span class="wld-home-stat__suf">{{ section.settings.stat2_suffix }}</span><p>{{ section.settings.stat2_text }}</p></div>
      <div class="wld-home-stat"><span class="wld-home-stat__num" data-count="{{ section.settings.stat3_num }}">0</span><span class="wld-home-stat__suf">{{ section.settings.stat3_suffix }}</span><p>{{ section.settings.stat3_text }}</p></div>
    </div>
    {%- if hp != blank -%}<a href="{{ hp.url }}" class="wld-home-btn wld-home-btn--center">{{ section.settings.stats_cta }}</a>{%- endif -%}
  </div>

  {%- comment -%} ===================== SEE IT IN ACTION (UGC grid) ===================== {%- endcomment -%}
  <div class="wld-home-band">
    <span class="wld-home-eyebrow wld-home-eyebrow--center">{{ section.settings.ugc_eyebrow }}</span>
    <h2 class="wld-home-h2">{{ section.settings.ugc_title }}</h2>
    <div class="wld-home-ugc">
      {%- for block in section.blocks -%}
        {%- if block.type == 'ugc' -%}
          <div class="wld-home-ugc__item" data-vid {{ block.shopify_attributes }}>
            {%- if block.settings.video != blank -%}
              <video class="wld-home-vid" {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 500 }}"{% endif %} preload="none" loop muted playsinline controls>
                {%- for s in block.settings.video.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}
              </video>
              <button type="button" class="wld-home-play" data-vid-play aria-label="Play">▶</button>
            {%- elsif block.settings.video_url != blank -%}
              <video class="wld-home-vid" {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 500 }}"{% endif %} preload="none" loop muted playsinline controls>
                <source src="{{ block.settings.video_url }}" type="video/mp4">
              </video>
              <button type="button" class="wld-home-play" data-vid-play aria-label="Play">▶</button>
            {%- elsif block.settings.poster != blank -%}
              <img src="{{ block.settings.poster | image_url: width: 500 }}" alt="" loading="lazy" width="300" height="530">
            {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'wld-home-ph' }}{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ===================== GUARANTEE ===================== {%- endcomment -%}
  <div class="wld-home-guarantee">
    <div class="wld-home-guarantee__inner">
      <div class="wld-home-guarantee__media">
        {%- if section.settings.guar_image != blank -%}
          <img src="{{ section.settings.guar_image | image_url: width: 900 }}" alt="" loading="lazy" width="600" height="500">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'wld-home-ph' }}
        {%- endif -%}
        <div class="wld-home-guarantee__badge" data-fs-badge>
          <span class="wld-home-guarantee__pct">{{ section.settings.guar_badge }}</span>
          <span class="wld-home-guarantee__word">{{ section.settings.guar_badge_word }}</span>
          {%- if section.settings.guar_badge_days != blank -%}<span class="wld-home-guarantee__days">{{ section.settings.guar_badge_days }}</span>{%- endif -%}
        </div>
      </div>
      <div class="wld-home-guarantee__body">
        <span class="wld-home-eyebrow">{{ section.settings.guar_eyebrow }}</span>
        <h2 class="wld-home-guarantee__title">{{ section.settings.guar_title }}</h2>
        <p>{{ section.settings.guar_text }}</p>
        {%- if hp != blank -%}<a href="{{ hp.url }}" class="wld-home-btn wld-home-btn--arrow">{{ section.settings.guar_cta }} <span aria-hidden="true">→</span></a>{%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} ===================== FAQ ===================== {%- endcomment -%}
  <div class="wld-home-band wld-home-band--faq">
    <h2 class="wld-home-h2">{{ section.settings.faq_title }}</h2>
    <div class="wld-home-faq" data-faq>
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
          <div class="wld-home-faq__item" {{ block.shopify_attributes }}>
            <button type="button" class="wld-home-faq__q" data-faq-q>{{ block.settings.question }}<span class="wld-home-faq__icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></span></button>
            <div class="wld-home-faq__a">{{ block.settings.answer }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #wld-home-{{ section.id }}.wld-home { font-family: 'Inter', sans-serif; color: #141414; line-height: 1.55; }
  #wld-home-{{ section.id }} * { box-sizing: border-box; }
  #wld-home-{{ section.id }} h1, #wld-home-{{ section.id }} h2, #wld-home-{{ section.id }} h3, #wld-home-{{ section.id }} h4 { font-family: 'Montserrat', sans-serif; font-weight: 800; margin: 0; }
  #wld-home-{{ section.id }} img, #wld-home-{{ section.id }} .wld-home-ph { max-width: 100%; height: auto; display: block; }
  #wld-home-{{ section.id }} a { text-decoration: none; color: inherit; }

  #wld-home-{{ section.id }} .wld-home-btn { display: inline-block; background: var(--g); color: #fff; font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 15px; letter-spacing: .3px; text-transform: uppercase; padding: 15px 34px; border-radius: 999px; transition: .18s; }
  #wld-home-{{ section.id }} .wld-home-btn:hover { filter: brightness(1.08); transform: translateY(-1px); }
  #wld-home-{{ section.id }} .wld-home-btn--center { display: block; width: max-content; margin: 34px auto 0; }
  #wld-home-{{ section.id }} .wld-home-btn--light { background: #fff; color: var(--g); }
  #wld-home-{{ section.id }} .wld-home-btn--sm { font-size: 12px; padding: 10px 20px; margin-top: 12px; }
  #wld-home-{{ section.id }} .wld-home-btn--hero { font-size: 17px; padding: 18px 44px; }

  #wld-home-{{ section.id }} .wld-home-band { padding: 72px 24px; max-width: 1280px; margin: 0 auto; }
  #wld-home-{{ section.id }} .wld-home-band--tint { background: var(--g-tint); max-width: none; }
  #wld-home-{{ section.id }} .wld-home-band--cream { background: var(--cream); max-width: none; }
  #wld-home-{{ section.id }} .wld-home-band--faq { background: #eae7df; max-width: none; }
  #wld-home-{{ section.id }} .wld-home-h2 { font-size: clamp(28px, 4vw, 46px); text-align: center; text-transform: uppercase; letter-spacing: -.5px; margin-bottom: 8px; }
  #wld-home-{{ section.id }} .wld-home-sub { text-align: center; color: #555; margin: 0 auto 36px; max-width: 640px; }
  #wld-home-{{ section.id }} .wld-home-eyebrow { display: inline-block; font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: var(--g); margin-bottom: 10px; }
  #wld-home-{{ section.id }} .wld-home-eyebrow--center { display: block; text-align: center; }

  /* TRUSTPILOT */
  #wld-home-{{ section.id }} .wld-home-tp { display: inline-flex; align-items: center; gap: 8px; font-family: 'Montserrat', sans-serif; font-weight: 800; }
  #wld-home-{{ section.id }} .wld-home-tp--center { display: flex; justify-content: center; margin: 0 0 30px; }
  #wld-home-{{ section.id }} .wld-home-tp__label { font-style: italic; }
  #wld-home-{{ section.id }} .wld-home-tp__stars { color: #00b67a; letter-spacing: 2px; }
  #wld-home-{{ section.id }} .wld-home-tp__brand { color: #141414; }

  /* HERO */
  #wld-home-{{ section.id }} .wld-home-hero { position: relative; min-height: 560px; display: flex; align-items: center; overflow: hidden; background: var(--g-soft); }
  #wld-home-{{ section.id }} .wld-home-hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  #wld-home-{{ section.id }} .wld-home-hero__inner { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: 60px 24px; width: 100%; }
  #wld-home-{{ section.id }} .wld-home-hero__tp { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 18px; font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 15px; }
  #wld-home-{{ section.id }} .wld-home-hero__title { font-size: clamp(40px, 7vw, 88px); line-height: .96; text-transform: uppercase; letter-spacing: -1px; max-width: 640px; }
  #wld-home-{{ section.id }} .wld-home-hero__sub { font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: clamp(18px, 2.2vw, 26px); margin: 10px 0 0; }
  #wld-home-{{ section.id }} .wld-home-hero__offer { display: inline-block; background: var(--g); color: #fff; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: clamp(28px, 4vw, 52px); padding: 10px 26px; border-radius: 14px; margin: 22px 0; text-transform: uppercase; }
  #wld-home-{{ section.id }} .wld-home-hero__inner .wld-home-btn--hero { display: block; width: max-content; }

  /* CARDS */
  #wld-home-{{ section.id }} .wld-home-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 36px; }
  #wld-home-{{ section.id }} .wld-home-card { background: #fff; border: 1px solid #eee; border-radius: 18px; padding: 16px; text-align: center; transition: .2s; }
  #wld-home-{{ section.id }} .wld-home-card:hover { box-shadow: 0 12px 30px rgba(0,0,0,.08); transform: translateY(-4px); }
  #wld-home-{{ section.id }} .wld-home-card__media { border-radius: 12px; overflow: hidden; aspect-ratio: 1/1; background: var(--cream); margin-bottom: 14px; }
  #wld-home-{{ section.id }} .wld-home-card__media img { width: 100%; height: 100%; object-fit: cover; }
  #wld-home-{{ section.id }} .wld-home-card__name { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 15px; }
  #wld-home-{{ section.id }} .wld-home-card__rating { color: var(--g); font-size: 13px; margin: 4px 0; }
  #wld-home-{{ section.id }} .wld-home-card__rating span { color: #999; }
  #wld-home-{{ section.id }} .wld-home-card__price { font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 18px; }

  /* TRANSFORMATION */
  #wld-home-{{ section.id }} .wld-home-tr { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; max-width: 1120px; margin: 0 auto; align-items: center; }
  #wld-home-{{ section.id }} .wld-home-tr__media { position: relative; border-radius: 18px; overflow: hidden; background: #000; aspect-ratio: 16/11; }
  #wld-home-{{ section.id }} .wld-home-tr__media img, #wld-home-{{ section.id }} .wld-home-vid { width: 100%; height: 100%; object-fit: cover; }
  #wld-home-{{ section.id }} .wld-home-brow { display: flex; gap: 16px; align-items: flex-start; background: #fff; border-radius: 14px; padding: 18px; margin-bottom: 14px; box-shadow: 0 4px 16px rgba(0,0,0,.04); }
  #wld-home-{{ section.id }} .wld-home-brow__ico { font-size: 26px; }
  #wld-home-{{ section.id }} .wld-home-brow h3 { font-size: 17px; text-transform: uppercase; margin-bottom: 3px; }
  #wld-home-{{ section.id }} .wld-home-brow p { margin: 0; font-size: 14px; color: #555; }

  /* VIDEO PLAY */
  #wld-home-{{ section.id }} .wld-home-play { position: absolute; inset: 0; margin: auto; width: 64px; height: 64px; border-radius: 50%; border: 0; background: rgba(255,255,255,.92); color: #141414; font-size: 22px; padding-left: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 16px rgba(0,0,0,.3); }
  #wld-home-{{ section.id }} [data-vid].is-playing .wld-home-play { display: none; }

  /* REVIEWS */
  #wld-home-{{ section.id }} .wld-home-reviews { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  #wld-home-{{ section.id }} .wld-home-review { background: #fff; border-radius: 16px; overflow: hidden; border: 1px solid #eee; }
  #wld-home-{{ section.id }} .wld-home-review__media { aspect-ratio: 5/6; background: var(--cream); }
  #wld-home-{{ section.id }} .wld-home-review__media img { width: 100%; height: 100%; object-fit: cover; }
  #wld-home-{{ section.id }} .wld-home-review__stars { color: var(--g); padding: 14px 16px 0; }
  #wld-home-{{ section.id }} .wld-home-review__title { padding: 6px 16px 0; font-size: 15px; text-transform: uppercase; color: var(--g); }
  #wld-home-{{ section.id }} .wld-home-review__text { padding: 6px 16px; font-size: 13px; color: #555; }
  #wld-home-{{ section.id }} .wld-home-review__author { display: block; padding: 0 16px 16px; font-size: 12px; font-weight: 700; }

  /* STORY */
  #wld-home-{{ section.id }} .wld-home-story { position: relative; min-height: 480px; display: flex; align-items: center; overflow: hidden; background: var(--dark); }
