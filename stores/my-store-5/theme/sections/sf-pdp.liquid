{%- comment -%}
  Zone produit : galerie a gauche, achat a droite (offre en lots, variantes, ajout au panier, reassurance,
  carte "avant / apres" et accordeons). Utilise le vrai produit du modele : variantes, prix, stock et images Shopify.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = product
  assign cur = p.selected_or_first_available_variant
  assign color_pos = 0
  for opt in p.options_with_values
    assign on = opt.name | downcase
    if on == 'color' or on == 'colour' or on == 'couleur' or on == 'colore' or on == 'farbe'
      assign color_pos = opt.position
    endif
  endfor
  assign rv = p.metafields.reviews.rating.value
  assign rating_num = 0
  assign rating_max = 5
  if rv != blank
    assign rating_num = rv.rating | times: 1.0
    assign rating_max = rv.scale_max | default: 5
    assign rating_cnt = p.metafields.reviews.rating_count.value
  elsif s.rating_manual != blank
    assign rating_num = s.rating_manual | times: 1.0
    assign rating_cnt = s.rating_count
  endif
  assign size_pos = 0
  assign opt_label = ''
  for opt in p.options_with_values
    assign on2 = opt.name | downcase
    if on2 == 'size' or on2 == 'taille' or on2 == 'taglia' or on2 == 'talla' or on2 == 'größe' or on2 == 'grösse'
      assign size_pos = opt.position
    endif
    if forloop.first
      assign opt_label = opt.name
    else
      assign opt_label = opt_label | append: ', ' | append: opt.name
    endif
  endfor
  assign fsizes = ''
  if size_pos == 0 and s.fallback_sizes != blank
    assign fsizes = s.fallback_sizes | split: ','
    assign opt_label = opt_label | append: ', ' | append: s.fallback_size_name
  endif
  assign gcolors = ''
  if s.gift_colors != blank
    assign gcolors = s.gift_colors | split: ','
  endif
  assign size_blocks = section.blocks | where: 'type', 'size'
  assign nrows_default = 1
  assign rating_pct = rating_num | times: 100.0 | divided_by: rating_max
  assign main_alt = p.title
  assign form_id = 'sf-pdp-form-' | append: section.id
  assign btn_txt = s.atc_label
  if cur.available == false
    assign btn_txt = s.sold_label
  endif
-%}
<section class="sf sf-pdp" id="sf-pdp-{{ section.id }}" data-sf-pdp>
  <span id="sf-pdp-top" class="sf-pdp__anchor"></span>
  <div class="sf-wrap sf-pdp__grid">

    {%- comment -%} ------------------------ GALERIE ------------------------ {%- endcomment -%}
    <div class="sf-pdp__gal">
      {%- assign fm = p.featured_media -%}
      <div class="sf-pdp__stage sf-media">
        {%- if fm != blank -%}
          {%- if fm.alt != blank -%}{%- assign main_alt = fm.alt -%}{%- endif -%}
          {{ fm | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 647px, 100vw', alt: main_alt, class: 'sf-pdp__img', loading: 'eager', fetchpriority: 'high' }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'sf-ph' }}
        {%- endif -%}
        {%- if p.media.size > 1 -%}
          <button type="button" class="sf-pdp__nav sf-pdp__nav--prev" data-sf-prev-img aria-label="Previous image">{%- render 'sf-icon', name: 'arrow-left' -%}</button>
          <button type="button" class="sf-pdp__nav sf-pdp__nav--next" data-sf-next-img aria-label="Next image">{%- render 'sf-icon', name: 'arrow-right' -%}</button>
        {%- endif -%}
      </div>
      {%- if p.media.size > 1 -%}
        <ul class="sf-pdp__thumbs" data-sf-thumbs>
          {%- for m in p.media -%}
            {%- if m.media_type == 'image' -%}
              {%- capture big -%}{{ m | image_url: width: 1400 }}{%- endcapture -%}
              <li>
                <button type="button" class="sf-pdp__thumb{% if m.id == fm.id %} is-active{% endif %}" data-sf-thumb data-media="{{ m.id }}" data-src="{{ big }}" data-alt="{{ m.alt | default: p.title | escape }}" aria-label="Image {{ forloop.index }}">
                  {{ m | image_url: width: 200 | image_tag: width: 76, height: 76, alt: '', loading: 'lazy' }}
                </button>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} ------------------------ ACHAT ------------------------ {%- endcomment -%}
    <div class="sf-pdp__buy">
      {%- if s.chip_1 != blank or s.chip_2 != blank -%}
        <div class="sf-pdp__chips">
          {%- if s.chip_1 != blank -%}<span class="sf-pdp__chip">{%- render 'sf-icon', name: 'heart' -%}{{ s.chip_1 }}</span>{%- endif -%}
          {%- if s.chip_2 != blank -%}<span class="sf-pdp__chip sf-pdp__chip--fill">{%- render 'sf-icon', name: 'tag' -%}{{ s.chip_2 }}</span>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if s.eyebrow != blank -%}<p class="sf-pdp__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h1 class="sf-pdp__title">{{ p.title }}</h1>
      {%- if s.badge_text != blank -%}
        <p class="sf-pdp__award"><span>{%- render 'sf-icon', name: 'laurel' -%}</span>{{ s.badge_text }}</p>
      {%- endif -%}
      {%- if s.highlight != blank -%}
        <p class="sf-pdp__hl"><span>{%- render 'sf-icon', name: 'check' -%}</span>{{ s.highlight }}</p>
      {%- endif -%}
      {%- if s.proof_text != blank -%}
        <p class="sf-pdp__gproof"><span class="sf-pdp__gstars" aria-hidden="true">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span>{{ s.proof_text }}</p>
      {%- endif -%}
      {%- if rating_num > 0 -%}
        <div class="sf-pdp__rate">
          <span class="sf-rate" aria-label="{{ rating_num | round: 1 }} / {{ rating_max }}">
            <span class="sf-rate__bg">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span>
            <span class="sf-rate__fg" style="width: {{ rating_pct }}%">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span>
          </span>
          <span>{{ rating_num | round: 1 }}/{{ rating_max }}{% if rating_cnt != blank %} · {{ rating_cnt }}{% endif %}</span>
        </div>
      {%- endif -%}

      {%- assign bens = section.blocks | where: 'type', 'benefit' -%}
      {%- if bens.size > 0 -%}
        <ul class="sf-pdp__ben">
          {%- for b in bens -%}
            <li {{ b.shopify_attributes }}><span class="sf-pdp__benico">{%- render 'sf-icon', name: b.settings.icon -%}</span><span>{{ b.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.help_title != blank -%}
        <div class="sf-pdp__help">
          <span class="sf-pdp__helpico">{%- render 'sf-icon', name: 'ruler' -%}</span>
          <div class="sf-pdp__helptxt">
            <b>{{ s.help_title }}</b>
            {%- if s.help_text != blank -%}<span>{{ s.help_text }}</span>{%- endif -%}
            {%- if s.help_chips != blank -%}
              {%- assign hc = s.help_chips | split: ',' -%}
              <span class="sf-pdp__helpchips">{%- for c in hc -%}<i>{{ c | strip }}</i>{%- endfor -%}</span>
            {%- endif -%}
          </div>
          {%- if s.help_btn_label != blank -%}<button type="button" class="sf-pdp__helpbtn" data-sf-size-open aria-haspopup="dialog">{{ s.help_btn_label }}</button>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if s.helper_left != blank or s.helper_link != blank -%}
        <div class="sf-pdp__helper"><span>{{ s.helper_left }}</span>{%- if s.helper_link != blank -%}<a href="{{ s.helper_link }}">{{ s.helper_link_label }} ›</a>{%- endif -%}</div>
      {%- endif -%}

      {%- form 'product', p, id: form_id, class: 'sf-pdp__form' -%}
        <input type="hidden" name="id" value="{{ cur.id }}" data-sf-id>

        {%- assign tiers = section.blocks | where: 'type', 'tier' -%}
        {%- comment -%} Sans lots : une rangee de pastilles par option. Avec lots : couleur / taille se choisissent dans le lot. {%- endcomment -%}
        {%- if tiers.size == 0 and p.has_only_default_variant == false -%}
          {%- for opt in p.options_with_values -%}
            <fieldset class="sf-pdp__opt" data-sf-opt="{{ opt.position }}">
              <legend>{{ opt.name }}: <b data-sf-optval>{{ cur.options[forloop.index0] }}</b></legend>
              <div class="sf-pdp__pills">
                {%- for ov in opt.values -%}
                  <button type="button" class="sf-pill{% if ov.selected %} is-active{% endif %}" data-val="{{ ov | escape }}" aria-pressed="{{ ov.selected }}">
                    {%- if opt.position == color_pos -%}<i class="sf-dot" style="background: {% render 'sf-swatch', value: ov, swatch: ov.swatch.color %}"></i>{%- endif -%}
                    <span>{{ ov }}</span>
                  </button>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%} Offre en lots {%- endcomment -%}
        {%- if tiers.size > 0 -%}
          <div class="sf-offer" data-sf-offer data-per-piece="{{ s.per_piece }}">
            <div class="sf-offer__head">
              <span class="sf-offer__ttl"><em>{{ s.offer_title_1 }}</em> <b>{{ s.offer_title_2 }}</b></span>
              {%- liquid
                assign tz = 'now' | date: '%z'
                assign tz_h = tz | slice: 0, 3
                assign tz_m = tz | slice: 3, 2
                assign end_iso = ''
                if s.timer_end != blank
                  assign end_iso = s.timer_end | strip | replace: ' ', 'T' | append: ':00' | append: tz_h | append: ':' | append: tz_m
                endif
              -%}
              {%- if end_iso != '' -%}
                <span class="sf-offer__timer" data-timer data-end="{{ end_iso }}" hidden>{%- render 'sf-icon', name: 'hourglass' -%}<span>{{ s.timer_label }}</span> <b data-t>00:00:00</b></span>
              {%- endif -%}
              {%- if s.offer_sub != blank -%}<span class="sf-offer__sub" data-sub>{{ s.offer_sub }}</span>{%- endif -%}
            </div>
            {%- for t in tiers -%}
              {%- assign ts = t.settings -%}
              {%- assign sel = false -%}
              {%- if forloop.index == s.default_tier -%}{%- assign sel = true -%}{%- endif -%}
              {%- if forloop.last and s.default_tier > tiers.size -%}{%- assign sel = true -%}{%- endif -%}
              {%- assign nrows = 1 -%}
              {%- if s.per_piece -%}{%- assign nrows = ts.quantity -%}{%- endif -%}
              <div class="sf-tier{% if sel %} is-selected{% endif %}" data-sf-tier data-q="{{ ts.quantity }}" {{ t.shopify_attributes }}>
                {%- if ts.badge != blank -%}<span class="sf-tier__badge">{{ ts.badge }}</span>{%- endif -%}
                <label class="sf-tier__top">
                  <input type="radio" name="sf-tier-{{ section.id }}" class="sf-tier__radio"{% if sel %} checked{% endif %}>
                  <span class="sf-tier__mark" aria-hidden="true"></span>
                  <span class="sf-tier__txt">
                    <b class="sf-tier__name"><span data-count>{{ ts.quantity }}</span>× {{ p.title }}</b>
                    <span class="sf-tier__save" data-save></span>
                    {%- if ts.note != blank -%}<span class="sf-tier__note">{{ ts.note }}</span>{%- endif -%}
                  </span>
                  <span class="sf-tier__pill" data-perpiece hidden></span>
                  <span class="sf-tier__price"><b data-price></b><s data-compare></s></span>
                </label>
                {%- unless p.has_only_default_variant -%}
                  <div class="sf-tier__opts">
                    <p class="sf-tier__optlabel">{{ opt_label }}</p>
                    {%- for i in (1..nrows) -%}
                      <div class="sf-row" data-row>
                        <span class="sf-row__img"><img alt="" data-row-img loading="lazy" width="44" height="44"{% if fm != blank %} src="{{ fm | image_url: width: 120 }}"{% endif %}></span>
                        {%- for opt in p.options_with_values -%}
                          <label class="sf-sel{% if opt.position == color_pos %} sf-sel--color{% endif %}">
                            {%- if opt.position == color_pos -%}<i class="sf-dot" data-dot></i>{%- endif -%}
                            <select data-opt="{{ opt.position }}" aria-label="{{ opt.name | escape }}">
                              {%- for ov in opt.values -%}<option value="{{ ov | escape }}"{% if ov.selected %} selected{% endif %}>{{ ov }}</option>{%- endfor -%}
                            </select>
                          </label>
                        {%- endfor -%}
                        {%- if fsizes != blank -%}
                          <label class="sf-sel sf-sel--size">
                            <select data-prop="{{ s.fallback_size_name | escape }}" aria-label="{{ s.fallback_size_name | escape }}">
                              {%- for z in fsizes -%}{%- assign zt = z | strip -%}{%- if zt != blank -%}<option value="{{ zt | escape }}">{{ zt }}</option>{%- endif -%}{%- endfor -%}
                            </select>
                          </label>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endunless -%}
                {%- assign show_gift = false -%}
                {%- if ts.gift and s.gift_text != blank -%}{%- assign show_gift = true -%}{%- endif -%}
                {%- assign show_ship = false -%}
                {%- if ts.ship and s.offer_ship != blank -%}{%- assign show_ship = true -%}{%- endif -%}
                {%- if show_gift or show_ship -%}
                  <div class="sf-tier__perks">
                    {%- if show_gift -%}
                      <div class="sf-perk sf-perk--gift" data-gift-name="{{ s.gift_text | escape }}">
                        <span class="sf-perk__img">
                          {%- if s.gift_image != blank -%}{{ s.gift_image | image_url: width: 160 | image_tag: width: 44, height: 44, alt: '', loading: 'lazy' }}{%- else -%}{%- render 'sf-icon', name: 'gift' -%}{%- endif -%}
                        </span>
                        <b class="sf-perk__txt">{{ s.gift_text }}</b>
                        {%- if gcolors != blank -%}
                          <label class="sf-sel sf-sel--color sf-sel--gift">
                            <i class="sf-dot" data-gift-dot></i>
                            <select data-gift aria-label="{{ s.gift_text | escape }}">
                              {%- for g in gcolors -%}{%- assign gt = g | strip -%}{%- if gt != blank -%}<option value="{{ gt | escape }}" data-color="{% render 'sf-swatch', value: gt, swatch: '' %}">{{ gt }}</option>{%- endif -%}{%- endfor -%}
                            </select>
                          </label>
                        {%- endif -%}
                        {%- if s.gift_value != blank -%}<s class="sf-perk__val">{{ s.gift_value }}</s>{%- endif -%}
                      </div>
                    {%- endif -%}
                    {%- if show_ship -%}
                      <div class="sf-perk sf-perk--ship"><span class="sf-perk__img sf-perk__img--ico">{%- render 'sf-icon', name: 'gift' -%}</span><b class="sf-perk__txt">{{ s.offer_ship }}</b></div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <button type="submit" name="add" class="sf-atc" data-sf-atc{% if cur.available == false %} disabled{% endif %}>
          <span class="sf-atc__lbl" data-atc-label>{{ btn_txt }}</span>
          <span class="sf-atc__sep" aria-hidden="true"></span>
          <span class="sf-atc__price"><b data-atc-price>{{ cur.price | money }}</b><s data-atc-compare>{% if cur.compare_at_price > cur.price %}{{ cur.compare_at_price | money }}{% endif %}</s></span>
        </button>
        <p class="sf-atc__err" role="alert" data-sf-err hidden></p>
      {%- endform -%}

      {%- if s.r1_title != blank or s.r2_title != blank -%}
        <ul class="sf-pdp__re">
          {%- if s.r1_title != blank -%}<li><span class="sf-pdp__reico">{%- render 'sf-icon', name: 'truck' -%}</span><span><b>{{ s.r1_title }}</b>{{ s.r1_text }}</span></li>{%- endif -%}
          {%- if s.r2_title != blank -%}<li><span class="sf-pdp__reico">{%- render 'sf-icon', name: 'lock' -%}</span><span><b>{{ s.r2_title }}</b>{{ s.r2_text }}</span></li>{%- endif -%}
        </ul>
      {%- endif -%}

      {%- comment -%} Carte avant / apres : squelette, a remplir avec de vrais temoignages {%- endcomment -%}
      {%- assign results = section.blocks | where: 'type', 'result' -%}
      {%- if results.size > 0 -%}
        <div class="sf-res" data-sf-res>
          <div class="sf-res__head"><b>{{ s.results_title }}</b><span aria-hidden="true">{%- render 'sf-icon', name: 'chevron' -%}</span></div>
          <div class="sf-res__tabs" role="tablist"{% if results.size < 2 %} hidden{% endif %}>
            {%- for r in results -%}
              <button type="button" role="tab" class="sf-res__tab{% if forloop.first %} is-active{% endif %}" data-tab="{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
                <i class="sf-res__av">{{ r.settings.name | slice: 0 }}</i>
                <span><b>{{ r.settings.name }}</b>{%- if r.settings.meta != blank -%}<small>{{ r.settings.meta }}</small>{%- endif -%}</span>
              </button>
            {%- endfor -%}
          </div>
          {%- for r in results -%}
            {%- assign rs = r.settings -%}
            <div class="sf-res__panel" data-panel="{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %} {{ r.shopify_attributes }}>
              {%- if rs.image != blank -%}
                <div class="sf-res__pics sf-res__pics--one"><div class="sf-res__pic sf-res__pic--one">{{ rs.image | image_url: width: 1000 | image_tag: widths: '400, 700, 1000', sizes: '500px', alt: rs.label | default: 'Customer result', loading: 'lazy' }}</div></div>
              {%- elsif rs.before == blank and rs.after == blank -%}
                <div class="sf-res__pics sf-res__pics--one"><div class="sf-res__pic sf-res__pic--one sf-res__pic--empty"><span class="sf-res__empty">{%- render 'sf-icon', name: 'camera' -%}<em>Customer photo</em></span></div></div>
              {%- else -%}
              <div class="sf-res__pics">
                <div class="sf-res__pic sf-media">
                  {%- if rs.before != blank -%}{{ rs.before | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '250px', alt: 'Before', loading: 'lazy' }}{%- else -%}<span class="sf-res__empty">{%- render 'sf-icon', name: 'camera' -%}<em>Before photo</em></span>{%- endif -%}
                </div>
                <div class="sf-res__pic sf-media">
                  {%- if rs.after != blank -%}{{ rs.after | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '250px', alt: 'After', loading: 'lazy' }}{%- else -%}<span class="sf-res__empty">{%- render 'sf-icon', name: 'camera' -%}<em>After photo</em></span>{%- endif -%}
                </div>
              </div>
              {%- endif -%}
              {%- if rs.label != blank -%}<div class="sf-res__label">{{ rs.label }}</div>{%- endif -%}
              <div class="sf-res__info">
                {%- assign rp = rs.rating | times: 20 -%}
                <div class="sf-res__top">
                  <span class="sf-rate sf-res__stars" aria-label="{{ rs.rating }} / 5"><span class="sf-rate__bg">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span><span class="sf-rate__fg" style="width: {{ rp }}%">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span></span>
                  {%- if rs.badge != blank -%}<span class="sf-res__badge">{%- render 'sf-icon', name: 'verified' -%}{{ rs.badge }}</span>{%- endif -%}
                </div>
                {%- if rs.title != blank -%}<p class="sf-res__ttl">{{ rs.title }}</p>{%- endif -%}
                {%- if rs.quote != blank -%}<p class="sf-res__quote">« {{ rs.quote }} »</p>{%- endif -%}
                {%- if rs.b1_label != blank -%}
                  <ul class="sf-res__bars">
                    {%- for n in (1..3) -%}
                      {%- assign kl = 'b' | append: n | append: '_label' -%}
                      {%- assign kv = 'b' | append: n | append: '_value' -%}
                      {%- if rs[kl] != blank -%}
                        {%- assign bp = rs[kv] | times: 20 -%}
                        <li><span>{{ rs[kl] }}</span><i><em style="width: {{ bp }}%"></em></i><b>{% if rs[kv] > 0 %}{{ rs[kv] }}/5{% else %}—{% endif %}</b></li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign accs = section.blocks | where: 'type', 'accordion' -%}
      {%- if accs.size > 0 -%}
        <div class="sf-acc">
          {%- for a in accs -%}
            <details class="sf-acc__item" {{ a.shopify_attributes }}>
              <summary><span>{{ a.settings.title }}</span>{%- render 'sf-icon', name: 'chevron' -%}</summary>
              <div class="sf-acc__body">
                {%- if a.settings.use_description and p.description != blank -%}{{ p.description }}{%- else -%}{{ a.settings.content }}{%- endif -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Fenetre "See in your size" {%- endcomment -%}
  <div class="sf-size" data-sf-size hidden>
    <div class="sf-size__overlay" data-sf-size-close></div>
    <div class="sf-size__modal" role="dialog" aria-modal="true" aria-labelledby="sf-size-t-{{ section.id }}" tabindex="-1">
      <div class="sf-size__head">
        <h2 class="sf-size__title" id="sf-size-t-{{ section.id }}">{{ s.size_title }}</h2>
        <button type="button" class="sf-size__x" data-sf-size-close aria-label="Close">{%- render 'sf-icon', name: 'close' -%}</button>
      </div>
      <div class="sf-size__body">
        <div class="sf-size__pic sf-media" data-size-pic>
          {%- if s.size_image != blank -%}
            {{ s.size_image | image_url: width: 900 | image_tag: widths: '450, 700, 900', sizes: '(min-width: 750px) 380px, 90vw', alt: s.size_title, loading: 'lazy' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'sf-ph' }}
          {%- endif -%}
        </div>
        <div class="sf-size__side">
          {%- if s.size_text != blank -%}<p class="sf-size__txt">{{ s.size_text }}</p>{%- endif -%}
          <p class="sf-size__lbl">{{ s.size_label }}</p>
          <div class="sf-size__circles" data-size-circles role="radiogroup" aria-label="{{ s.size_label | escape }}"></div>
          <p class="sf-size__empty" data-size-empty hidden>{{ s.size_empty }}</p>
          <div class="sf-size__meas" data-size-meas>
            <div class="sf-size__mhead">
              <b>{{ s.meas_title }}</b>
              <span class="sf-size__unit" role="group" aria-label="Unit"><button type="button" data-unit="cm" class="is-on">CM</button><button type="button" data-unit="in">IN</button></span>
            </div>
            <ul class="sf-size__list" data-size-list></ul>
          </div>
          <button type="button" class="sf-size__cta" data-size-cta>{{ s.size_cta }}</button>
          {%- if s.size_note != blank -%}<p class="sf-size__note">{{ s.size_note }}</p>{%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-sf-data>
  {
    "current": {{ cur.id }},
    "currency": {{ cart.currency.iso_code | json }},
    "locale": {{ request.locale.iso_code | json }},
    "cartAdd": {{ routes.cart_add_url | json }},
    "colorPos": {{ color_pos }},
    "sizePos": {{ size_pos }},
    "labels": { "add": {{ s.atc_label | json }}, "sold": {{ s.sold_label | json }}, "adding": {{ s.adding_label | json }}, "save": {{ s.save_label | json }}, "perPiece": {{ s.perpiece_label | json }}, "cta": {{ s.size_cta | json }}, "gift": "Free gift" },
    "meas": [ {{ s.m1_label | json }}, {{ s.m2_label | json }}, {{ s.m3_label | json }} ],
    "sizes": [
      {%- if size_pos > 0 -%}
        {%- assign first_s = true -%}
        {%- for opt in p.options_with_values -%}
          {%- if opt.position == size_pos -%}
            {%- for ov in opt.values -%}
              {%- assign ovs = ov | append: '' -%}
              {%- assign m = blank -%}
              {%- for sb in size_blocks -%}{%- if sb.settings.label == ovs -%}{%- assign m = sb.settings -%}{%- endif -%}{%- endfor -%}
              {%- unless forloop.first -%},{%- endunless -%}
              { "label": {{ ovs | json }}, "v": [ {{ m.v1 | default: '' | json }}, {{ m.v2 | default: '' | json }}, {{ m.v3 | default: '' | json }} ], "img": {% if m.model_image != blank %}{{ m.model_image | image_url: width: 900 | json }}{% else %}""{% endif %} }
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for sb in size_blocks -%}
          {%- assign m = sb.settings -%}
          {%- unless forloop.first -%},{%- endunless -%}
          { "label": {{ m.label | json }}, "v": [ {{ m.v1 | default: '' | json }}, {{ m.v2 | default: '' | json }}, {{ m.v3 | default: '' | json }} ], "img": {% if m.model_image != blank %}{{ m.model_image | image_url: width: 900 | json }}{% else %}""{% endif %} }
        {%- endfor -%}
      {%- endif -%}
    ],
    "variants": [
      {%- for v in p.variants -%}
        {%- assign dot = '#cbbfb8' -%}
        {%- if color_pos > 0 -%}
          {%- assign ci = color_pos | minus: 1 -%}
          {%- capture dot -%}{% render 'sf-swatch', value: v.options[ci] %}{%- endcapture -%}
        {%- endif -%}
        {
          "id": {{ v.id }}, "title": {{ v.title | json }}, "options": {{ v.options | json }},
          "price": {{ v.price }}, "compare": {{ v.compare_at_price | default: 0 }}, "available": {{ v.available }},
          "media": {{ v.featured_media.id | default: 0 }},
          "thumb": {% if v.featured_media != blank %}{{ v.featured_media | image_url: width: 120 | json }}{% else %}""{% endif %},
          "dot": {{ dot | strip | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
</section>

<script>
  (function () {
    var root = document.getElementById('sf-pdp-{{ section.id }}');
    if (!root || root.dataset.ready) return; root.dataset.ready = '1';
    var D = JSON.parse(root.querySelector('[data-sf-data]').textContent), V = D.variants;
    var $ = function (s, r) { return (r || root).querySelector(s); }, $$ = function (s, r) { return Array.prototype.slice.call((r || root).querySelectorAll(s)); };
    var byId = {}; V.forEach(function (v) { byId[v.id] = v; });
    var fmt; try { fmt = new Intl.NumberFormat(D.locale || undefined, { style: 'currency', currency: D.currency || 'EUR' }); } catch (e) { fmt = new Intl.NumberFormat(undefined, { style: 'currency', currency: 'EUR' }); }
    function money(c) { return fmt.format(c / 100); }
    var offer = $('[data-sf-offer]'), perPiece = !!offer && offer.dataset.perPiece === 'true';
    var SEL = (byId[D.current] || V[0]).options.slice(), cur = byId[D.current] || V[0];

    /* ---------- galerie ---------- */
    var main = $('.sf-pdp__stage img'), thumbs = $$('[data-sf-thumb]'), idx = 0;
    function showThumb(i) {
      if (!thumbs.length) return;
      idx = (i + thumbs.length) % thumbs.length;
      var t = thumbs[idx];
      thumbs.forEach(function (x) { x.classList.toggle('is-active', x === t); });
      if (main) { main.removeAttribute('srcset'); main.removeAttribute('sizes'); main.src = t.dataset.src; main.alt = t.dataset.alt || ''; }
      var wrap = t.parentNode.parentNode; if (wrap && wrap.scrollTo) wrap.scrollTo({ left: t.parentNode.offsetLeft - 8, behavior: 'smooth' });
    }
    thumbs.forEach(function (t, i) { t.addEventListener('click', function () { showThumb(i); }); });
    var pv = $('[data-sf-prev-img]'), nx = $('[data-sf-next-img]');
    if (pv) pv.addEventListener('click', function () { showThumb(idx - 1); });
    if (nx) nx.addEventListener('click', function () { showThumb(idx + 1); });

    /* ---------- variantes ---------- */
    var idInput = $('[data-sf-id]'), fieldsets = $$('[data-sf-opt]'), tiers = $$('[data-sf-tier]'), atc = $('[data-sf-atc]'), err = $('[data-sf-err]');
    function findVariant(opts) { return V.filter(function (v) { return opts.every(function (o, i) { return o === null || v.options[i] === o; }); })[0]; }
    function rowOpts(r) { var o = SEL.slice(); $$('select[data-opt]', r).forEach(function (s) { o[parseInt(s.dataset.opt, 10) - 1] = s.value; }); return o; }
    function rowVariant(r) { return findVariant(rowOpts(r)) || V[0]; }
    function rowsOf(t) { return $$('[data-row]', t); }
    function rowQty(t) { return perPiece ? 1 : (parseInt(t.dataset.q, 10) || 1); }
    function tierTotals(t) {
      var rs = rowsOf(t), price = 0, compare = 0, count = 0, ok = true;
      var items = rs.length ? rs.map(function (r) { return { v: rowVariant(r), q: rowQty(t) }; }) : [{ v: cur, q: parseInt(t.dataset.q, 10) || 1 }];
      items.forEach(function (it) {
        price += it.v.price * it.q; compare += (it.v.compare > it.v.price ? it.v.compare : it.v.price) * it.q; count += it.q; if (!it.v.available) ok = false;
      });
      return { price: price, compare: compare, count: count, ok: ok };
    }
    function recalc() {
      cur = findVariant(SEL) || cur; idInput.value = cur.id;
      fieldsets.forEach(function (f, fi) {
        $$('.sf-pill', f).forEach(function (b) {
          var test = SEL.slice(); test[fi] = b.dataset.val; var v = findVariant(test);
          b.classList.toggle('is-active', b.dataset.val === SEL[fi]); b.classList.toggle('is-soldout', !v || !v.available);
          b.setAttribute('aria-pressed', b.dataset.val === SEL[fi] ? 'true' : 'false');
        });
        var lab = $('[data-sf-optval]', f); if (lab) lab.textContent = SEL[fi];
      });
      tiers.forEach(function (t) {
        rowsOf(t).forEach(function (r) {
          var v = rowVariant(r), img = $('[data-row-img]', r), dot = $('[data-dot]', r), opts = rowOpts(r);
          if (dot) dot.style.background = v.dot;
          if (img && v.thumb) img.src = v.thumb;
          $$('select[data-opt]', r).forEach(function (s) {
            var pos = parseInt(s.dataset.opt, 10) - 1;
            $$('option', s).forEach(function (o) { var test = opts.slice(); test[pos] = o.value; var w = findVariant(test); o.disabled = !!(o.value !== s.value && (!w || !w.available)); });
          });
        });
        var T = tierTotals(t);
        $('[data-count]', t).textContent = T.count;
        $('[data-price]', t).textContent = money(T.price);
        var cmp = $('[data-compare]', t), sv = $('[data-save]', t), pp = $('[data-perpiece]', t);
        cmp.textContent = T.compare > T.price ? money(T.compare) : '';
        sv.textContent = T.compare > T.price ? D.labels.save.replace('{amount}', money(T.compare - T.price)) : '';
        var per = Math.round(T.price / T.count);
        if (pp) { var show = T.count > 1 && per < cur.price; pp.hidden = !show; pp.textContent = show ? D.labels.perPiece.replace('{amount}', money(per)) : ''; }
        t.classList.toggle('is-out', !T.ok);
      });
      var sel = tiers.filter(function (t) { return t.classList.contains('is-selected'); })[0], price, compare, ok;
      if (sel) { var S = tierTotals(sel); price = S.price; compare = S.compare; ok = S.ok; }
      else { price = cur.price; compare = cur.compare > cur.price ? cur.compare : 0; ok = cur.available; }
      $('[data-atc-price]').textContent = money(price);
      $('[data-atc-compare]').textContent = compare > price ? money(compare) : '';
      atc.disabled = !ok; $('[data-atc-label]').textContent = ok ? D.labels.add : D.labels.sold;
    }
    function applySel(fromUser) {
      cur = findVariant(SEL) || cur;
      if (!perPiece) $$('[data-row] select[data-opt]').forEach(function (s) { s.value = SEL[parseInt(s.dataset.opt, 10) - 1]; });
      if (fromUser && window.history && history.replaceState) { try { var u = new URL(location.href); u.searchParams.set('variant', cur.id); history.replaceState(null, '', u); } catch (e) {} }
      if (cur.media) { var k = thumbs.findIndex(function (t) { return t.dataset.media == cur.media; }); if (k > -1) showThumb(k); }
      recalc();
    }
    fieldsets.forEach(function (f, fi) {
      $$('.sf-pill', f).forEach(function (b) { b.addEventListener('click', function () { SEL[fi] = b.dataset.val; applySel(true); }); });
    });
    $$('[data-row] select[data-opt]').forEach(function (s) {
      s.addEventListener('change', function () { if (!perPiece) SEL[parseInt(s.dataset.opt, 10) - 1] = s.value; applySel(true); });
    });
    function giftDot(sl) { var o = sl.options[sl.selectedIndex], d = sl.parentNode.querySelector('[data-gift-dot]'); if (d && o) d.style.background = o.dataset.color || '#cbbfb8'; }
    $$('select[data-gift]').forEach(function (sl) { giftDot(sl); sl.addEventListener('change', function () { giftDot(sl); }); });
    tiers.forEach(function (t) {
      $('.sf-tier__radio', t).addEventListener('change', function () { tiers.forEach(function (x) { x.classList.toggle('is-selected', x === t); }); recalc(); });
    });

    /* ---------- compte a rebours (date de fin reelle fixee dans l'editeur) ---------- */
    var tm = $('[data-timer]'), subEl = $('[data-sub]');
    if (tm) {
      var endAt = Date.parse(tm.dataset.end), tEl = $('[data-t]', tm);
      function pad(n) { return (n < 10 ? '0' : '') + n; }
      function tick() {
        var left = Math.floor((endAt - Date.now()) / 1000);
        if (isNaN(endAt) || left <= 0) { tm.hidden = true; if (subEl) subEl.hidden = false; return false; }
        var d = Math.floor(left / 86400), h = Math.floor(left % 86400 / 3600), m = Math.floor(left % 3600 / 60), sec = left % 60;
        tEl.textContent = (d > 0 ? d + 'd ' : '') + pad(h) + ':' + pad(m) + ':' + pad(sec);
        tm.hidden = false; if (subEl) subEl.hidden = true; return true;
      }
      if (tick()) { var iv = setInterval(function () { if (!tick()) clearInterval(iv); }, 1000); }
    }

    /* ---------- carte avant / apres ---------- */
    var res = $('[data-sf-res]');
    if (res) $$('.sf-res__tab', res).forEach(function (b) {
      b.addEventListener('click', function () {
        $$('.sf-res__tab', res).forEach(function (x) { var on = x === b; x.classList.toggle('is-active', on); x.setAttribute('aria-selected', on); });
        $$('.sf-res__panel', res).forEach(function (p) { p.hidden = p.dataset.panel !== b.dataset.tab; });
      });
    });

    /* ---------- fenetre "See in your size" ---------- */
    var box = $('[data-sf-size]'), opener = $('[data-sf-size-open]');
    if (box && opener) {
      var modal = $('.sf-size__modal', box), circ = $('[data-size-circles]', box), list = $('[data-size-list]', box), cta = $('[data-size-cta]', box),
          pic = $('[data-size-pic]', box), emptyMsg = $('[data-size-empty]', box), measBox = $('[data-size-meas]', box), unit = 'cm', chosen = 0, lastFocus = null, defaultPic = pic.innerHTML;
      var Z = D.sizes || [];
      function fmtVal(v) { if (v === null || v === undefined || String(v).trim() === '') return '—'; var n = parseFloat(String(v).replace(',', '.')); if (isNaN(n)) return v; return unit === 'in' ? (Math.round(n / 2.54 * 10) / 10) + ' in' : n + ' cm'; }
      function drawSize() {
        var z = Z[chosen]; if (!z) return;
        $$('button', circ).forEach(function (b, i) { b.classList.toggle('is-on', i === chosen); b.setAttribute('aria-checked', i === chosen ? 'true' : 'false'); });
        list.innerHTML = ''; D.meas.forEach(function (name, i) { if (!name) return; var li = document.createElement('li'); var a = document.createElement('span'); a.textContent = name; var b = document.createElement('b'); b.textContent = fmtVal(z.v[i]); li.appendChild(a); li.appendChild(b); list.appendChild(li); });
        if (z.img) { pic.innerHTML = '<img alt="" src="' + z.img + '">'; } else { pic.innerHTML = defaultPic; }
        cta.textContent = D.labels.cta.replace('{size}', z.label);
      }
      function drawCircles() {
        circ.innerHTML = '';
        Z.forEach(function (z, i) { var b = document.createElement('button'); b.type = 'button'; b.setAttribute('role', 'radio'); b.textContent = z.label; b.addEventListener('click', function () { chosen = i; drawSize(); }); circ.appendChild(b); });
        var has = Z.length > 0; emptyMsg.hidden = has; measBox.hidden = !has; cta.hidden = !has; circ.hidden = !has;
        if (has) { var k = D.sizePos ? Z.findIndex(function (z) { return z.label === SEL[D.sizePos - 1]; }) : -1; chosen = k > -1 ? k : 0; drawSize(); }
      }
      $$('[data-unit]', box).forEach(function (b) { b.addEventListener('click', function () { unit = b.dataset.unit; $$('[data-unit]', box).forEach(function (x) { x.classList.toggle('is-on', x === b); }); drawSize(); }); });
      function openBox() { lastFocus = document.activeElement; drawCircles(); box.hidden = false; requestAnimationFrame(function () { box.classList.add('is-open'); }); document.documentElement.style.overflow = 'hidden'; modal.focus(); }
      function closeBox() { box.classList.remove('is-open'); document.documentElement.style.overflow = ''; setTimeout(function () { box.hidden = true; }, 200); if (lastFocus && lastFocus.focus) lastFocus.focus(); }
      opener.addEventListener('click', openBox);
      $$('[data-sf-size-close]', box).forEach(function (b) { b.addEventListener('click', closeBox); });
      document.addEventListener('keydown', function (e) {
        if (box.hidden) return;
        if (e.key === 'Escape') closeBox();
        if (e.key === 'Tab') { var f = $$('button', box).filter(function (b) { return !b.hidden && b.offsetParent !== null; }); if (!f.length) return; var a = f[0], z = f[f.length - 1]; if (e.shiftKey && document.activeElement === a) { e.preventDefault(); z.focus(); } else if (!e.shiftKey && document.activeElement === z) { e.preventDefault(); a.focus(); } }
      });
      cta.addEventListener('click', function () {
        var z = Z[chosen];
        if (z && D.sizePos) { SEL[D.sizePos - 1] = z.label; applySel(true); }
        closeBox();
        var b = $('.sf-atc'); if (b && b.scrollIntoView) setTimeout(function () { b.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 220);
      });
    }

    /* ---------- ajout au panier : meme mecanique que le formulaire du theme (evenement + sections) ---------- */
    var busy = false;
    function rowProps(r) { var o = {}, k = $('select[data-prop]', r); if (k && k.value) o[k.dataset.prop] = k.value; return o; }
    function giftProps(t) {
      var g = $('.sf-perk--gift', t); if (!g) return {};
      var sl = $('select[data-gift]', g), o = {}; o[D.labels.gift] = g.dataset.giftName + (sl && sl.value ? ' (' + sl.value + ')' : ''); return o;
    }
    function lines() {
      var sel = tiers.filter(function (t) { return t.classList.contains('is-selected'); })[0], map = {}, order = [], out;
      if (!sel) return [{ id: cur.id, quantity: 1 }];
      var rs = rowsOf(sel), gp = giftProps(sel), hasGift = Object.keys(gp).length > 0;
      if (!rs.length) { out = { id: cur.id, quantity: parseInt(sel.dataset.q, 10) || 1 }; if (hasGift) out.properties = gp; return [out]; }
      rs.forEach(function (r) {
        var v = rowVariant(r), pr = rowProps(r), key = v.id + '|' + JSON.stringify(pr);
        if (!map[key]) { map[key] = { id: v.id, quantity: 0, properties: pr }; order.push(key); }
        map[key].quantity += rowQty(sel);
      });
      out = order.map(function (k) { var l = map[k]; if (!Object.keys(l.properties).length) delete l.properties; return l; });
      if (hasGift) out[0].properties = Object.assign({}, out[0].properties || {}, gp);
      return out;
    }
    function showErr(m) { err.textContent = m; err.hidden = !m; }
    function add(e) {
      e.preventDefault(); if (busy || atc.disabled) return;
      busy = true; atc.classList.add('is-loading'); atc.setAttribute('aria-busy', 'true'); showErr('');
      var items = lines(), secIds = $$('cart-items-component', document).map(function (c) { return c.dataset.sectionId; }).filter(Boolean);
      var Evt = null, deferred = null;
      $('[data-atc-label]').textContent = D.labels.adding;
      var load = import('@shopify/events').then(function (m) { Evt = m.CartLinesUpdateEvent; }).catch(function () {});
      load.then(function () {
        if (Evt && Evt.createPromise) {
          deferred = Evt.createPromise();
          document.dispatchEvent(new Evt({ action: 'add', context: 'product', lines: items.map(function (i) { return { merchandiseId: String(i.id), quantity: i.quantity }; }), promise: deferred.promise }));
        }
        return fetch(D.cartAdd, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: items, sections: secIds.join(',') }) });
      }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok && !j.status, j: j }; }); })
        .then(function (res) {
          if (!res.ok) { var msg = res.j.description || res.j.message || 'Could not add to cart.'; showErr(msg); if (deferred) deferred.reject(new Error(msg)); return; }
          return fetch('/cart.js', { credentials: 'same-origin', headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (cart) {
            document.dispatchEvent(new CustomEvent('sf:cart', { detail: cart }));
            if (deferred) deferred.resolve({ cart: Evt.createCartFromAjaxResponse(cart), detail: { items: cart.items, source: 'sf-pdp', sourceId: root.id, itemCount: items.reduce(function (a, i) { return a + i.quantity; }, 0), productId: '{{ p.id }}', sections: res.j.sections, didError: false } });
            var d = document.getElementById('cart-drawer');
            if (d && typeof d.open === 'function') { if (!d.isOpen) d.open(); } else { location.href = '/cart'; }
          });
        })
        .catch(function (x) { showErr('Something went wrong. Please try again.'); if (deferred) deferred.reject(x); })
        .then(function () { busy = false; atc.classList.remove('is-loading'); atc.removeAttribute('aria-busy'); recalc(); });
    }
    root.querySelector('form').addEventListener('submit', add);

    applySel(false);
  })();
</script>

{% stylesheet %}
  .sf-pdp { background: #fff; padding: 24px 0 64px; }
  .sf-pdp__anchor { display: block; position: relative; top: -20px; height: 0; }
  .sf-pdp__grid { display: grid; grid-template-columns: minmax(0, 647fr) minmax(0, 528fr); column-gap: clamp(24px, 3.4vw, 49px); align-items: start; }
  /* galerie */
  .sf-pdp__gal { position: sticky; top: 20px; }
  .sf-pdp__stage { aspect-ratio: 647 / 652; border-radius: 12px; background: #EEF0F1; }
  .sf-pdp__stage img, .sf-pdp__stage > svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sf-pdp__nav { position: absolute; top: 50%; z-index: 2; width: 30px; height: 30px; margin-top: -15px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(255, 255, 255, .85); color: var(--sf-ink); box-shadow: 0 2px 8px rgba(0, 0, 0, .12); opacity: 0; transition: opacity .15s; }
  .sf-pdp__nav svg { width: 14px; height: 14px; }
  .sf-pdp__nav--prev { left: 10px; } .sf-pdp__nav--next { right: 10px; }
  .sf-pdp__stage:hover .sf-pdp__nav, .sf-pdp__nav:focus-visible { opacity: 1; }
  @media (hover: none) { .sf-pdp__nav { opacity: 1; } }
  .sf-pdp__thumbs { display: flex; gap: 7px; margin-top: 9px; overflow-x: auto; scrollbar-width: none; padding: 2px; }
  .sf-pdp__thumbs::-webkit-scrollbar { display: none; }
  .sf-pdp__thumbs li { flex: 0 0 auto; }
  .sf-pdp__thumb { display: block; width: clamp(60px, 5.3vw, 76px); aspect-ratio: 1; border-radius: 8px; overflow: hidden; border: 2px solid transparent; background: #EEF0F1; padding: 0; }
  .sf-pdp__thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .sf-pdp__thumb.is-active { border-color: var(--sf-plum); }
  /* colonne achat */
  .sf-pdp__chips { display: grid; grid-template-columns: 1fr 1fr; gap: 11px; }
  .sf-pdp__chips:has(> :only-child) { grid-template-columns: 1fr; }
  .sf-pdp__chip { display: flex; align-items: center; justify-content: center; gap: 6px; height: 28px; border-radius: 6px; border: 1px solid #DCD1CC; background: #fff;
    font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--sf-ink); }
  .sf-pdp__chip svg { width: 11px; height: 11px; color: var(--sf-plum); }
  .sf-pdp__chip--fill { background: var(--sf-plum); border-color: var(--sf-plum); color: #fff; }
  .sf-pdp__chip--fill svg { color: #fff; }
  .sf-pdp__eyebrow { margin-top: 14px; font-size: 10.5px; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; color: var(--sf-plum); }
  .sf-pdp__title { margin-top: 8px; font-family: var(--sf-serif); font-weight: 400; font-size: clamp(27px, 2.3vw, 33px); line-height: 1.1; letter-spacing: -.01em; color: var(--sf-ink); }
  .sf-pdp__award { display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; padding: 6px 14px 6px 10px; border-radius: 8px; background: linear-gradient(90deg, #FBF4DA, rgba(251, 244, 218, 0)); font-size: 13.5px; color: #6b5a1e; }
  .sf-pdp__award span { display: inline-flex; color: #B8902A; } .sf-pdp__award svg { width: 26px; height: 26px; }
  .sf-pdp__gproof { display: flex; align-items: center; gap: 10px; margin-top: 14px; font-size: 15px; color: var(--sf-ink); }
  .sf-pdp__gstars { display: inline-flex; gap: 2px; color: var(--sf-green); } .sf-pdp__gstars svg { width: 20px; height: 20px; }
