        { "type": "text", "id": "badge", "label": "Étiquette (coin haut droit)" },
        { "type": "text", "id": "note", "label": "Petit texte sous le titre" },
        { "type": "checkbox", "id": "ship", "label": "Afficher le bandeau livraison offerte", "default": true },
        { "type": "checkbox", "id": "gift", "label": "Afficher le cadeau offert", "default": false }
      ]
    }
  ],
  "presets": [ { "name": "SF · Fiche boutique" } ]
}
{% endschema %}
