        "q-7": {
          "type": "item",
          "settings": {
            "tag": "How it works",
            "icon": "sparkle",
            "question": "Why would a legging change anything about cellulite?",
            "answer": "<p>A legging cannot remove cellulite, and we would never say it can. What it does is change how your silhouette looks while you wear it: the 3D texture and the high-waist fit gently smooth and support the area, so your skin looks more even under your clothes.</p>",
            "open": false,
            "show_steps": false,
            "table_cols": "",
            "table_rows": "",
            "dont_title": "Don't",
            "dont_list": "",
            "do_title": "Do",
