  .sf-size__pic { aspect-ratio: 3 / 4; border-radius: 14px; background: var(--sf-card); overflow: hidden; }
  .sf-size__pic img, .sf-size__pic > svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sf-size__side { display: flex; flex-direction: column; min-width: 0; }
  .sf-size__txt { font-size: 14px; line-height: 1.5; color: #5f5654; }
  .sf-size__lbl { margin-top: 16px; font-size: 13px; font-weight: 700; color: var(--sf-ink); }
