{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

{%- comment -%} Reusable brand logo (uses your Shopify logo setting, text fallback) {%- endcomment -%}
{%- capture felispace_logo -%}
  <div class="felispace-cart-logo">
    {%- if settings.logo != blank -%}
      <img src="{{ settings.logo | image_url: width: 320 }}" alt="{{ shop.name | escape }}" class="felispace-cart-logo__img" width="160" loading="lazy">
    {%- else -%}
      <span class="felispace-cart-logo__text">{{ shop.name }}</span>
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- comment -%} Reusable free-shipping + offer timer {%- endcomment -%}
{%- capture felispace_timer -%}
  <div class="felispace-cart-timer">
    <div class="felispace-cart-timer__row">
      <span class="felispace-cart-timer__ico">🎁</span>
      <span class="felispace-cart-timer__txt">
        <strong>Votre panier est réservé</strong> pendant
        <span class="felispace-cart-timer__clock" data-felispace-cart-timer>15:00</span>
      </span>
    </div>
    <div class="felispace-cart-timer__bar"><span data-felispace-timer-bar></span></div>
  </div>
{%- endcapture -%}

<style>
  .drawer {
    visibility: hidden;
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&display=swap" rel="stylesheet">
<style>
  #CartDrawer { --fs-green: #12a3a0; --fs-green-dark: #0b7a78; --fs-cream: #f7f4ea; }
  #CartDrawer .drawer__inner { background: #fffdf8; position: relative; }
  #CartDrawer .felispace-empty__close { position: absolute; top: 16px; right: 16px; z-index: 5; background: none; border: 0; cursor: pointer; padding: 6px; color: #333; }
  #CartDrawer .felispace-empty__close .svg-wrapper { width: 22px; height: 22px; display: inline-flex; }
  #CartDrawer .drawer__heading { font-family: 'Montserrat', sans-serif; font-weight: 800; }

  /* Brand logo in the cart */
  #CartDrawer .felispace-cart-logo { text-align: center; padding: 12px 0 4px; }
  #CartDrawer .felispace-cart-logo__img { height: 30px; width: auto; display: inline-block; }
  #CartDrawer .felispace-cart-logo__text { font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 20px; letter-spacing: .5px; color: #1a1a1a; }
  #CartDrawer .felispace-empty .felispace-cart-logo { padding: 0 0 4px; }
  #CartDrawer .felispace-empty .felispace-cart-timer { margin: 8px 0 20px; width: 100%; max-width: 320px; }

  /* Free shipping + offer timer (compact) */
  #CartDrawer .felispace-cart-timer { margin: 0 1.5rem .85rem; padding: 9px 12px; border-radius: 12px; background: linear-gradient(135deg, var(--fs-green), var(--fs-green-dark)); color: #fff; box-shadow: 0 5px 14px rgba(31,111,67,.20); }
  #CartDrawer .felispace-cart-timer__row { display: flex; align-items: center; gap: 8px; font-size: 12.5px; line-height: 1.3; }
  #CartDrawer .felispace-cart-timer__ico { font-size: 16px; flex-shrink: 0; }
  #CartDrawer .felispace-cart-timer__txt strong { font-weight: 800; }
  #CartDrawer .felispace-cart-timer__clock { display: inline-block; background: rgba(255,255,255,.22); padding: 1px 7px; border-radius: 6px; font-weight: 800; font-variant-numeric: tabular-nums; }
  #CartDrawer .felispace-cart-timer__bar { margin-top: 7px; height: 5px; border-radius: 999px; background: rgba(255,255,255,.25); overflow: hidden; }
  #CartDrawer .felispace-cart-timer__bar span { display: block; height: 100%; width: 100%; background: #ffe08a; border-radius: 999px; transition: width 1s linear; }

  /* Checkout button — brand green, warm */
  #CartDrawer .cart__checkout-button { background: var(--fs-green); color: #fff; border-radius: 999px; font-family: 'Montserrat', sans-serif; font-weight: 800; letter-spacing: .3px; box-shadow: 0 8px 20px rgba(31,111,67,.30); border: 0; transition: .15s; }
  #CartDrawer .cart__checkout-button:hover:not([disabled]) { background: var(--fs-green-dark); transform: translateY(-1px); }

  /* Ebook reassurance under the button */
  #CartDrawer .felispace-cart-ebook { margin: 10px 0 0; text-align: center; font-size: 12px; color: #5a5a5a; line-height: 1.4; }
  #CartDrawer .felispace-cart-ebook strong { color: var(--fs-green); }

  /* Included free gifts (collapsible to keep it light) */
  #CartDrawer .felispace-cart-gifts { margin: 12px 0 0; padding: 10px 12px; border-radius: 12px; background: var(--fs-cream); }
  #CartDrawer .felispace-cart-gifts__title { display: flex; align-items: center; gap: 6px; cursor: pointer; list-style: none; font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 12.5px; color: #2a2a2a; }
  #CartDrawer .felispace-cart-gifts__title::-webkit-details-marker { display: none; }
  #CartDrawer .felispace-cart-gifts__title span { color: var(--fs-green); }
  #CartDrawer .felispace-cart-gifts__title::after { content: "⌄"; margin-left: auto; font-size: 15px; line-height: 1; transition: transform .2s; }
  #CartDrawer .felispace-cart-gifts[open] .felispace-cart-gifts__title::after { transform: rotate(180deg); }
  #CartDrawer .felispace-cart-gifts ul { list-style: none; margin: 9px 0 2px; padding: 0; }
  #CartDrawer .felispace-cart-gifts li { position: relative; padding-left: 22px; font-size: 12px; color: #444; margin-bottom: 4px; line-height: 1.4; }
  #CartDrawer .felispace-cart-gifts li::before { content: "✓"; position: absolute; left: 0; top: 1px; width: 15px; height: 15px; border-radius: 50%; background: var(--fs-green); color: #fff; font-size: 9px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  #CartDrawer .felispace-cart-gifts em { color: #8a8a8a; font-style: normal; }

  /* Trust line */
  #CartDrawer .felispace-cart-trust { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 7px; margin: 11px 0 0; font-size: 11px; color: #555; font-weight: 600; }
  #CartDrawer .felispace-cart-trust__dot { color: #ccc; }

  /* Payment icons */
  #CartDrawer .felispace-cart-pay { display: flex; flex-wrap: wrap; justify-content: center; gap: 5px; margin: 9px 0 2px; }
  #CartDrawer .felispace-cart-pay svg { width: 36px; height: 23px; border-radius: 4px; box-shadow: 0 1px 3px rgba(0,0,0,.1); }

  /* Empty cart — branded & warm */
  #CartDrawer .felispace-empty { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 10px 8px; }
  #CartDrawer .felispace-empty__icon { font-size: 52px; line-height: 1; margin-bottom: 8px; }
  #CartDrawer .felispace-empty__title { font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 22px; color: #1a1a1a; margin: 0 0 6px; }
  #CartDrawer .felispace-empty__text { font-size: 14px; color: #666; margin: 0 0 20px; max-width: 260px; line-height: 1.5; }
  #CartDrawer .felispace-empty__btn { display: inline-block; background: var(--fs-green); color: #fff; font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 15px; padding: 14px 34px; border-radius: 999px; text-decoration: none; box-shadow: 0 8px 20px rgba(31,111,67,.28); transition: .15s; }
  #CartDrawer .felispace-empty__btn:hover { background: var(--fs-green-dark); transform: translateY(-1px); }
  #CartDrawer .felispace-empty__trust { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 7px; margin-top: 16px; font-size: 11.5px; color: #666; font-weight: 600; }

  /* Mobile: lighter & tighter so the product stays the focus */
  @media (max-width: 749px) {
    #CartDrawer .felispace-cart-timer { margin: 0 1rem .7rem; padding: 8px 11px; }
    #CartDrawer .felispace-cart-timer__row { font-size: 11.5px; gap: 7px; }
    #CartDrawer .felispace-cart-timer__ico { font-size: 15px; }
    #CartDrawer .felispace-cart-ebook { font-size: 11.5px; margin-top: 9px; }
    #CartDrawer .felispace-cart-gifts { margin-top: 10px; padding: 9px 11px; }
    #CartDrawer .felispace-cart-trust { font-size: 10.5px; gap: 6px; margin-top: 9px; }
    #CartDrawer .felispace-cart-pay { gap: 4px; margin-top: 8px; }
    #CartDrawer .felispace-cart-pay svg { width: 32px; height: 21px; }
    #CartDrawer .felispace-empty__icon { font-size: 44px; }
    #CartDrawer .felispace-empty__title { font-size: 19px; }
  }
</style>

{%- comment -%} ===== Clinique Essabar — cart drawer restyle (own code, Veneera-style layout) ===== {%- endcomment -%}
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  #CartDrawer { --ce-acc: #12a3a0; --ce-acc-dark: #0b7a78; --ce-ink: #14201f; --ce-line: #eef1f1; }
  #CartDrawer .drawer__inner { background: #fff; font-family: 'Inter', sans-serif; }

  /* Header */
  #CartDrawer .drawer__header { padding: 20px 22px 15px; margin: 0; border-bottom: 1px solid var(--ce-line); }
  #CartDrawer .drawer__heading { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 20px; color: var(--ce-ink); letter-spacing: -.01em; margin: 0; }
  #CartDrawer .drawer__close { color: var(--ce-ink); }
  #CartDrawer .drawer__close:hover { color: var(--ce-acc); }

  /* Items list */
  #CartDrawer .cart__contents { padding: 0 22px; }
  #CartDrawer .cart-items { display: block; width: 100%; border: 0; margin: 0; }
  #CartDrawer .cart-items thead { display: none; }
  #CartDrawer .cart-items tbody { display: block; }
  #CartDrawer tr.cart-item {
    display: grid;
    grid-template-columns: 74px 1fr;
    grid-template-areas: "img details" "img controls";
    column-gap: 14px; row-gap: 12px;
    align-items: start;
    padding: 18px 0;
    border-bottom: 1px solid var(--ce-line);
  }
  #CartDrawer .cart-item > td, #CartDrawer .cart-item > th { display: block; padding: 0; border: 0; }
  #CartDrawer .cart-item__media { grid-area: img; }
  #CartDrawer .cart-item__image { border-radius: 12px; background: #f4f7f7; width: 74px; height: auto; }
  #CartDrawer .cart-item__details { grid-area: details; }
  #CartDrawer .cart-item__name { font-family: 'Manrope', sans-serif; font-weight: 700; font-size: 15.5px; line-height: 1.25; color: var(--ce-ink); text-decoration: none; display: block; margin: 0 0 6px; }
  #CartDrawer .cart-item__discounted-prices { display: flex; align-items: baseline; gap: 8px; margin: 0 0 6px; }
  #CartDrawer .cart-item__old-price { color: #9aa4a3; text-decoration: line-through; font-size: 13.5px; font-weight: 500; }
  #CartDrawer .cart-item__final-price { color: var(--ce-acc-dark); font-weight: 800; font-size: 15px; }
  #CartDrawer .cart-item__details .product-option { font-size: 12.5px; color: #6a747c; line-height: 1.4; }
  #CartDrawer .cart-item__totals { display: none; }

  /* Controls row: quantity stepper + remove */
  #CartDrawer .cart-item__quantity { grid-area: controls; border: 0 !important; padding: 0; }
  #CartDrawer .cart-item__quantity .cart-item__quantity-wrapper { width: 100%; }
  #CartDrawer .cart-item__quantity .quantity-popover-container { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  #CartDrawer .quantity.cart-quantity { display: inline-flex; align-items: center; border: 1px solid #d9e0df; border-radius: 10px; overflow: hidden; height: 38px; width: auto; }
  #CartDrawer .quantity.cart-quantity:after { display: none; }
  #CartDrawer .quantity__button { width: 36px; height: 38px; background: none; border: 0; color: var(--ce-ink); cursor: pointer; }
  #CartDrawer .quantity__button:hover { color: var(--ce-acc); }
  #CartDrawer .quantity__input { width: 34px; text-align: center; border: 0; font-weight: 700; color: var(--ce-ink); background: none; padding: 0; }
  #CartDrawer .cart-remove-button { margin: 0; }
  #CartDrawer .cart-remove-button.button, #CartDrawer .cart-remove-button.button--tertiary { min-height: 0; min-width: 0; padding: 0; border: 0; background: none; box-shadow: none; }
  #CartDrawer .ce-remove-label { color: #8a9593; text-decoration: underline; font-size: 13px; font-weight: 500; font-family: 'Inter', sans-serif; }
  #CartDrawer .cart-remove-button:hover .ce-remove-label { color: var(--ce-acc-dark); }

  /* Footer summary — soft gradient */
  #CartDrawer .drawer__footer { padding: 22px; border: 0; background: linear-gradient(120deg, #f6ecd6, #d7ede2 55%, #c3e6dc); }
  #CartDrawer .cart-drawer__footer { padding: 0; border: 0; }
  #CartDrawer .totals { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin: 2px 0 6px; padding: 0; }
  #CartDrawer .totals__total { font-family: 'Manrope', sans-serif; font-weight: 700; font-size: 19px; color: var(--ce-ink); margin: 0; }
  #CartDrawer .totals__total::after { content: ":"; }
  #CartDrawer .totals__total-value { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 19px; color: var(--ce-ink); margin: 0; }
  #CartDrawer .tax-note { display: block; text-align: center; color: #55606a; font-size: 12.5px; line-height: 1.45; max-width: 340px; margin: 0 auto 4px; }

  /* Checkout button — dark, full width */
  #CartDrawer .cart__ctas { padding: 14px 0 0; }
  #CartDrawer .cart__checkout-button { width: 100%; background: var(--ce-ink); color: #fff; border: 0; border-radius: 12px; font-family: 'Manrope', sans-serif; font-weight: 700; font-size: 16px; letter-spacing: 0; box-shadow: none; padding: 16px 20px; transition: .15s; }
  #CartDrawer .cart__checkout-button:hover:not([disabled]) { background: #0d1615; transform: translateY(-1px); }

  /* Payment icons */
  #CartDrawer .felispace-cart-pay { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin: 14px 0 0; }
  #CartDrawer .felispace-cart-pay svg { width: 38px; height: 24px; border-radius: 4px; box-shadow: 0 1px 3px rgba(0,0,0,.10); }

  /* Empty state */
  #CartDrawer .felispace-empty__btn { background: var(--ce-ink); box-shadow: none; border-radius: 12px; font-family: 'Manrope', sans-serif; }
  #CartDrawer .felispace-empty__btn:hover { background: #0d1615; }
  #CartDrawer .felispace-empty__title { font-family: 'Manrope', sans-serif; color: var(--ce-ink); }

  @media (max-width: 749px) {
    /* Full-screen cart on phone */
    cart-drawer .drawer__inner,
    #CartDrawer .drawer__inner { width: 100vw !important; max-width: 100vw !important; height: 100%; border-radius: 0 !important; }
    #CartDrawer .cart-drawer__overlay { display: none; }
    #CartDrawer .drawer__header { padding: 18px 16px 13px; position: sticky; top: 0; background: #fff; z-index: 3; }
    #CartDrawer .cart__contents { padding: 0 16px; }
    #CartDrawer .drawer__footer { padding: 18px 16px calc(18px + env(safe-area-inset-bottom)); }
    #CartDrawer .cart-item__image { width: 68px; }
    #CartDrawer tr.cart-item { grid-template-columns: 68px 1fr; }
  }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}">
            <div class="cart-drawer__empty-content felispace-empty">
              <button
                class="felispace-empty__close"
                type="button"
                onclick="this.closest('cart-drawer').close()"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                <span class="svg-wrapper">{{- 'icon-close.svg' | inline_asset_content -}}</span>
              </button>
              <div class="felispace-empty__icon">🛒</div>
              <h2 class="felispace-empty__title">Votre panier est vide</h2>
              <p class="felispace-empty__text">Ajoutez un produit pour commencer votre commande.</p>
              <a href="{{ routes.all_products_collection_url }}" class="felispace-empty__btn">
                Voir le produit
              </a>
              <div class="felispace-empty__trust">
                <span>🚚 Livraison offerte</span>
                <span class="felispace-cart-trust__dot">•</span>
                <span>🛡️ Garantie 30 jours</span>
              </div>
            </div>
          </div>
          {%- if settings.cart_drawer_collection != blank -%}
            <div class="cart-drawer__collection">
              {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="drawer__header">
        <h2 class="drawer__heading">{{ 'sections.cart.title' | t }}</h2>
        <button
          class="drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>

      <cart-drawer-items
        {% if cart == empty %}
          class=" is-empty"
        {% endif %}
      >
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div class="drawer__cart-items-wrapper">
                <table class="cart-items" role="table">
                  <thead role="rowgroup">
                    <tr role="row">
                      <th id="CartDrawer-ColumnProductImage" role="columnheader">
                        <span class="visually-hidden">{{ 'sections.cart.headings.image' | t }}</span>
                      </th>
                      <th
                        id="CartDrawer-ColumnProduct"
                        class="caption-with-letter-spacing"
                        scope="col"
                        role="columnheader"
                      >
                        {{ 'sections.cart.headings.product' | t }}
                      </th>
                      <th
                        id="CartDrawer-ColumnTotal"
                        class="right caption-with-letter-spacing"
                        scope="col"
                        role="columnheader"
                      >
                        {{ 'sections.cart.headings.total' | t }}
                      </th>
                      <th id="CartDrawer-ColumnQuantity" role="columnheader">
                        <span class="visually-hidden">{{ 'sections.cart.headings.quantity' | t }}</span>
                      </th>
                    </tr>
                  </thead>

                  <tbody role="rowgroup">
                    {%- for item in cart.items -%}
                      <tr
                        id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                        class="cart-item{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}"
                        role="row"
                        {% if item.parent_relationship.parent != null %}
                          aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                        {% endif %}
                      >
                        <td
                          class="cart-item__media"
                          role="cell"
                          headers="CartDrawer-ColumnProductImage"
                        >
                          {% if item.image %}
                            {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
                            <a href="{{ item.url }}" class="cart-item__link" tabindex="-1" aria-hidden="true"> </a>
                            <img
                              class="cart-item__image"
                              src="{{ item.image | image_url: width: 300 }}"
                              alt="{{ item.image.alt | escape }}"
                              loading="lazy"
                              width="150"
                              height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                            >
                          {% endif %}
                        </td>

                        <td class="cart-item__details" role="cell" headers="CartDrawer-ColumnProduct">
                          {%- if settings.show_vendor -%}
                            <p class="caption-with-letter-spacing light">{{ item.product.vendor }}</p>
                          {%- endif -%}

                          <a href="{{ item.url }}" class="cart-item__name h4 break">
                            {{- item.product.title | escape -}}
                          </a>

                          {%- if item.original_price != item.final_price -%}
                            <div class="cart-item__discounted-prices">
                              <span class="visually-hidden">
                                {{ 'products.product.price.regular_price' | t }}
                              </span>
                              <s class="cart-item__old-price product-option">
                                {{- item.original_price | money -}}
                              </s>
                              <span class="visually-hidden">
                                {{ 'products.product.price.sale_price' | t }}
                              </span>
                              <strong class="cart-item__final-price product-option">
                                {{ item.final_price | money }}
                              </strong>
                            </div>
                          {%- else -%}
                            <div class="product-option">
                              {{ item.original_price | money }}
                            </div>
                          {%- endif -%}

                          {%- if item.product.has_only_default_variant == false
                            or item.properties.size != 0
                            or item.selling_plan_allocation != null
                          -%}
                            <dl>
                              {%- if item.product.has_only_default_variant == false -%}
                                {%- for option in item.options_with_values -%}
                                  <div class="product-option">
                                    <dt>{{ option.name }}:</dt>
                                    <dd>
                                      {{ option.value -}}
                                      {%- unless forloop.last %}, {% endunless %}
                                    </dd>
                                  </div>
                                {%- endfor -%}
                              {%- endif -%}

                              {%- for property in item.properties -%}
                                {%- assign property_first_char = property.first | slice: 0 -%}
                                {%- if property.last != blank and property_first_char != '_' -%}
                                  <div class="product-option">
                                    <dt>{{ property.first }}:</dt>
                                    <dd>
                                      {%- if property.last contains '/uploads/' -%}
                                        <a
                                          href="{{ property.last }}"
                                          class="link"
                                          target="_blank"
                                          aria-describedby="a11y-new-window-message"
                                        >
                                          {{ property.last | split: '/' | last }}
                                        </a>
                                      {%- else -%}
                                        {{ property.last }}
                                      {%- endif -%}
                                    </dd>
                                  </div>
                                {%- endif -%}
                              {%- endfor -%}
                            </dl>

                            <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}

                          <ul
                            class="discounts list-unstyled"
                            role="list"
                            aria-label="{{ 'customer.order.discount' | t }}"
                          >
                            {%- for discount in item.line_level_discount_allocations -%}
                              <li class="discounts__discount">
                                {{- 'icon-discount.svg' | inline_asset_content -}}
                                {{ discount.discount_application.title }}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </td>

                        <td class="cart-item__totals right" role="cell" headers="CartDrawer-ColumnTotal">
                          {%- render 'loading-spinner' -%}
                          <div class="cart-item__price-wrapper">
                            {%- if item.original_line_price != item.final_line_price -%}
                              <div class="cart-item__discounted-prices">
                                <span class="visually-hidden">
                                  {{ 'products.product.price.regular_price' | t }}
                                </span>
                                <s class="cart-item__old-price price price--end">
                                  {{ item.original_line_price | money }}
                                </s>
                                <span class="visually-hidden">
                                  {{ 'products.product.price.sale_price' | t }}
                                </span>
                                <span class="price price--end">
                                  {{ item.final_line_price | money }}
                                </span>
                              </div>
                            {%- else -%}
                              <span class="price price--end">
                                {{ item.original_line_price | money }}
                              </span>
                            {%- endif -%}

                            {%- if item.variant.available and item.unit_price_measurement -%}
                              {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                            {%- endif -%}
                          </div>
                        </td>
                        {%- liquid
                          assign has_qty_rules = false
                          if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                            assign has_qty_rules = true
                          endif

                          assign has_vol_pricing = false
                          if item.variant.quantity_price_breaks.size > 0
                            assign has_vol_pricing = true
                          endif
                        -%}
                        <td
                          class="cart-item__quantity {% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}"
                          role="cell"
                          headers="CartDrawer-ColumnQuantity"
                        >
                          <quantity-popover>
                            <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                              <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                                <quantity-input class="quantity cart-quantity">
                                  <button
                                    class="quantity__button"
                                    name="minus"
                                    type="button"
                                    {% if item.instructions and item.instructions.can_update_quantity == false %}
                                      disabled
                                    {% endif %}
                                  >
                                    <span class="visually-hidden">
                                      {{-
                                        'products.product.quantity.decrease'
                                        | t: product: item.product.title
                                        | escape
                                      -}}
                                    </span>
                                    <span class="svg-wrapper">
                                      {{- 'icon-minus.svg' | inline_asset_content -}}
                                    </span>
                                  </button>
                                  <input
                                    class="quantity__input"
                                    type="number"
                                    data-quantity-variant-id="{{ item.variant.id }}"
                                    name="updates[]"
                                    value="{{ item.quantity }}"
                                    {% # theme-check-disable %}
                                    data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                    min="0"
                                    data-min="{{ item.variant.quantity_rule.min }}"
                                    {% if item.variant.quantity_rule.max != null %}
                                      max="{{ item.variant.quantity_rule.max }}"
                                    {% endif %}
                                    step="{{ item.variant.quantity_rule.increment }}"
                                    {% # theme-check-enable %}
                                    aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                    id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                    data-index="{{ item.index | plus: 1 }}"
                                    {% if item.instructions and item.instructions.can_update_quantity == false %}
                                      disabled
                                    {% endif %}
                                  >
                                  <button
                                    class="quantity__button"
                                    name="plus"
                                    type="button"
                                    {% if item.instructions and item.instructions.can_update_quantity == false %}
                                      disabled
                                    {% endif %}
                                  >
                                    <span class="visually-hidden">
                                      {{-
                                        'products.product.quantity.increase'
                                        | t: product: item.product.title
                                        | escape
                                      -}}
                                    </span>
                                    <span class="svg-wrapper">
                                      {{- 'icon-plus.svg' | inline_asset_content -}}
                                    </span>
                                  </button>
                                </quantity-input>
                              </div>
                              <cart-remove-button
                                id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                              >
                                <button
                                  type="button"
                                  class="button button--tertiary cart-remove-button"
                                  aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                                  data-variant-id="{{ item.variant.id }}"
                                  {% if item.instructions and item.instructions.can_remove == false %}
                                    class="hidden"
                                  {% endif %}
                                >
                                  <span class="ce-remove-label">Retirer</span>
                                </button>
                              </cart-remove-button>
                            </div>
                            {%- if has_qty_rules or has_vol_pricing -%}
                              <button
                                type="button"
                                class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary"
                                aria-expanded="false"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-info.svg' | inline_asset_content -}}
                                </span>
                                <span>
                                  {%- if has_vol_pricing -%}
                                    {{ 'products.product.volume_pricing.note' | t }}
                                  {%- elsif has_qty_rules -%}
                                    {{ 'products.product.quantity.note' | t }}
                                  {%- endif -%}
                                </span>
                              </button>
                            {%- endif -%}
                            {%- if has_vol_pricing or has_qty_rules -%}
                              <div
                                class="cart-items__info global-settings-popup quantity-popover__info"
                                tabindex="-1"
                                hidden
                              >
                                {%- if has_qty_rules == false -%}
                                  <span class="volume-pricing-label caption">
                                    {{- 'products.product.volume_pricing.title' | t -}}
                                  </span>
                                {%- endif -%}
                                <div class="quantity__rules caption">
                                  {%- if item.variant.quantity_rule.increment > 1 -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.multiples_of'
                                        | t: quantity: item.variant.quantity_rule.increment
                                      -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.min > 1 -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.min_of'
                                        | t: quantity: item.variant.quantity_rule.min
                                      -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.max != null -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.max_of'
                                        | t: quantity: item.variant.quantity_rule.max
                                      -}}
                                    </span>
                                  {%- endif -%}
                                </div>
                                <button
                                  class="button-close button button--tertiary"
                                  type="button"
                                  aria-label="{{ 'accessibility.close' | t }}"
                                >
                                  <span class="svg-wrapper">
                                    {{- 'icon-close.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                                {%- if item.variant.quantity_price_breaks.size > 0 -%}
                                  <volume-pricing class="parent-display">
                                    <ul class="list-unstyled">
                                      <li>
                                        <span>{{ item.variant.quantity_rule.min }}+</span>
                                        <span>{{ item.variant.price | money_with_currency }}/ea</span>
                                      </li>
                                      {%- for price_break in item.variant.quantity_price_breaks -%}
                                        <li>
                                          <span>
                                            {{- price_break.minimum_quantity -}}
                                            <span aria-hidden="true">+</span></span
                                          >
                                          <span>{{ price_break.price | money_with_currency }}/ea</span>
                                        </li>
                                      {%- endfor -%}
                                    </ul>
                                  </volume-pricing>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                            <div
                              id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}"
                              class="cart-item__error"
                              role="alert"
                            >
                              <small class="cart-item__error-text"></small>
                              <span class="svg-wrapper">
                                {{- 'icon-error.svg' | inline_asset_content -}}
                              </span>
                            </div>
                          </quantity-popover>
                        </td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
            {%- endif -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div id="CartDrawer-CartErrors" role="alert"></div>
        </form>
      </cart-drawer-items>
      <div class="drawer__footer">
        {%- if settings.show_cart_note -%}
          <details id="Details-CartDrawer">
            <summary>
              <span class="summary__title">
                {{ 'sections.cart.note' | t }}
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </summary>
            <cart-note class="cart__note field">
              <label class="visually-hidden" for="CartDrawer-Note">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartDrawer-Note"
                class="text-area text-area--resize-vertical field__input"
                name="note"
                placeholder="{{ 'sections.cart.note' | t }}"
              >{{ cart.note }}</textarea>
            </cart-note>
          </details>
        {%- endif -%}

        <!-- Start blocks -->
        <!-- Subtotals -->

        <div class="cart-drawer__footer" {{ block.shopify_attributes }}>
          <div>
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li class="discounts__discount discounts__discount--end">
                    {{- 'icon-discount.svg' | inline_asset_content -}}
                    {{ discount.title | escape }}
                    (-{{ discount.total_allocated_amount | money }})
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

          <div class="totals" role="status">
            <h2 class="totals__total">{{ 'sections.cart.estimated_total' | t }}</h2>
            <p class="totals__total-value">{{ cart.total_price | money_with_currency }}</p>
          </div>

          <small class="tax-note caption-large rte">
            {%- if cart.duties_included and cart.taxes_included -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included == false and cart.taxes_included -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included and cart.taxes_included == false -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- endif -%}
          </small>
        </div>

        <!-- CTAs -->

        <div class="cart__ctas" {{ block.shopify_attributes }}>
          <button
            type="submit"
            id="CartDrawer-Checkout"
            class="cart__checkout-button button"
            name="checkout"
            form="CartDrawer-Form"
            {% if cart == empty %}
              disabled
            {% endif %}
          >
            {{ 'sections.cart.checkout' | t }}
          </button>
        </div>

        {%- unless cart == empty -%}
        <div class="felispace-cart-pay" aria-label="Moyens de paiement acceptés">
          <svg viewBox="0 0 40 26" role="img" aria-label="Visa"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><text x="20" y="17.4" text-anchor="middle" font-family="Georgia,'Times New Roman',serif" font-size="11" font-style="italic" font-weight="700" fill="#1434CB" letter-spacing="-.4">VISA</text></svg>
          <svg viewBox="0 0 40 26" role="img" aria-label="Mastercard"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><circle cx="16.6" cy="13" r="6.4" fill="#EB001B"/><circle cx="23.4" cy="13" r="6.4" fill="#F79E1B"/><path d="M20 8.1a6.4 6.4 0 0 1 0 9.8 6.4 6.4 0 0 1 0-9.8z" fill="#FF5F00"/></svg>
          <svg viewBox="0 0 40 26" role="img" aria-label="American Express"><rect width="40" height="26" rx="4" fill="#1F72CD"/><text x="20" y="16.2" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="6.3" font-weight="800" fill="#fff" letter-spacing=".2">AMEX</text></svg>
          <svg viewBox="0 0 40 26" role="img" aria-label="PayPal"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><text x="20" y="17" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="9.5" font-style="italic" font-weight="800"><tspan fill="#003087">Pay</tspan><tspan fill="#0079C1">Pal</tspan></text></svg>
          <svg viewBox="0 0 40 26" role="img" aria-label="Apple Pay"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><path d="M14.7 9.9c-.28.33-.73.59-1.18.55-.06-.45.16-.93.42-1.23.28-.34.77-.58 1.17-.6.05.47-.13.94-.41 1.28zm.4.64c-.65-.04-1.2.37-1.51.37-.31 0-.79-.35-1.3-.34-.67.01-1.29.39-1.63 1-.7 1.2-.18 2.98.5 3.96.33.48.73 1.02 1.25 1 .5-.02.69-.32 1.29-.32.6 0 .78.32 1.3.31.54-.01.88-.49 1.21-.97.38-.55.54-1.09.55-1.12-.01-.01-1.05-.41-1.06-1.6-.01-1 .81-1.48.85-1.51-.47-.69-1.19-.77-1.45-.79z" fill="#000"/><text x="26.5" y="16.6" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="8.5" font-weight="600" fill="#000">Pay</text></svg>
          <svg viewBox="0 0 40 26" role="img" aria-label="Google Pay"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><text x="15.5" y="16.6" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="9" font-weight="700"><tspan fill="#4285F4">G</tspan></text><text x="26" y="16.6" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="8.5" font-weight="600" fill="#5F6368">Pay</text></svg>
          <svg viewBox="0 0 40 26" role="img" aria-label="Klarna"><rect width="40" height="26" rx="4" fill="#FFB3C7"/><text x="20" y="17" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="8.5" font-weight="800" fill="#0A0B09" letter-spacing=".2">Klarna.</text></svg>
          <svg viewBox="0 0 40 26" role="img" aria-label="Shop Pay"><rect width="40" height="26" rx="4" fill="#5A31F4"/><text x="20" y="16.8" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="9.5" font-weight="800" fill="#fff" letter-spacing=".3">shop</text></svg>
        </div>
        {%- endunless -%}
      </div>
    </div>
  </div>
</cart-drawer>

