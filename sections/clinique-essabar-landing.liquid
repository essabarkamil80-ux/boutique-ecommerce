{% comment %}theme-check-disable ImgWidthAndHeight,RemoteAsset,AssetUrlFilters,RemoteAssetUrl{% endcomment %}
{%- comment -%}
  Clinique Essabar — product landing reproducing the reference DTC structure (veneera-style).
  Layout & section order faithful to the reference; all copy is generic placeholder to be replaced.
  No filters are used inside if-conditions (Liquid forbids it).
{%- endcomment -%}

{%- assign prod = section.settings.product | default: product -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<section id="ce-{{ section.id }}" class="ce"
  style="--ce-acc: {{ section.settings.color_accent }}; --ce-acc-dark: {{ section.settings.color_accent_dark }}; --ce-ink: {{ section.settings.color_ink }}; --ce-bg: #ffffff; --ce-tint: #f2f5f4; --ce-line: #e4e9e8;">

  {%- comment -%} ============ 1. HERO / BUY BOX ============ {%- endcomment -%}
  <div class="ce-hero">
    <div class="ce-hero__media">
      {%- assign imgs = prod.images -%}
      <div class="ce-gallery" data-gallery>
        <div class="ce-gallery__thumbs">
          {%- if imgs.size > 0 -%}
            {%- for image in imgs limit: 7 -%}
              <button type="button" class="ce-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}">
                <img src="{{ image | image_url: width: 160 }}" alt="" width="70" height="70" loading="lazy">
              </button>
            {%- endfor -%}
          {%- else -%}
            <button type="button" class="ce-gallery__thumb is-active" data-thumb="0">{{ 'product-1' | placeholder_svg_tag: 'ce-ph' }}</button>
            <button type="button" class="ce-gallery__thumb" data-thumb="1">{{ 'product-2' | placeholder_svg_tag: 'ce-ph' }}</button>
            <button type="button" class="ce-gallery__thumb" data-thumb="2">{{ 'product-3' | placeholder_svg_tag: 'ce-ph' }}</button>
          {%- endif -%}
        </div>
        <div class="ce-gallery__main">
          {%- if imgs.size > 0 -%}
            {%- for image in imgs limit: 7 -%}
              <div class="ce-gallery__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}">
                <img src="{{ image | image_url: width: 1100 }}" alt="{{ image.alt | default: prod.title | escape }}" width="900" height="900" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="ce-gallery__slide is-active" data-slide="0">{{ 'product-1' | placeholder_svg_tag: 'ce-ph' }}</div>
            <div class="ce-gallery__slide" data-slide="1">{{ 'product-2' | placeholder_svg_tag: 'ce-ph' }}</div>
            <div class="ce-gallery__slide" data-slide="2">{{ 'product-3' | placeholder_svg_tag: 'ce-ph' }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="ce-hero__info">
      {%- if section.settings.hero_badge != blank -%}<span class="ce-badge">{{ section.settings.hero_badge }}</span>{%- endif -%}
      <h1 class="ce-title">{{ section.settings.hero_title }}</h1>
      <p class="ce-subtitle">{{ section.settings.hero_sub }}</p>

      <div class="ce-pricerow">
        {%- if prod != blank -%}
          {%- if prod.compare_at_price > prod.price -%}<span class="ce-price__was">{{ prod.compare_at_price | money }}</span>{%- endif -%}
          <span class="ce-price__now">{{ prod.price | money }}</span>
        {%- else -%}
          <span class="ce-price__now">{{ section.settings.fallback_price }}</span>
        {%- endif -%}
      </div>

      <div class="ce-rating">
        <span class="ce-stars">★★★★★</span>
        <span class="ce-rating__txt">{{ section.settings.rating }} · {{ section.settings.review_count }}</span>
      </div>

      {%- comment -%} Variant options {%- endcomment -%}
      <div class="ce-buy" data-buy>
        {%- if prod != blank and prod.has_only_default_variant == false -%}
          <div class="ce-opts" data-variants='{{ prod.variants | json | escape }}'>
            {%- for opt in prod.options_with_values -%}
              <div class="ce-opt" data-opt-pos="{{ opt.position }}">
                <span class="ce-opt__label">{{ opt.name }} : <b data-opt-selected="{{ opt.position }}">{{ opt.selected_value }}</b></span>
                <div class="ce-opt__values">
                  {%- for val in opt.values -%}
                    <button type="button" class="ce-opt__val{% if val == opt.selected_value %} is-active{% endif %}" data-opt-value data-value="{{ val | escape }}">{{ val }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
          <input type="hidden" data-variant-input value="{{ prod.selected_or_first_available_variant.id }}">
        {%- elsif prod != blank -%}
          <input type="hidden" data-variant-input value="{{ prod.selected_or_first_available_variant.id }}">
        {%- endif -%}

        {%- comment -%} 4 simple steps (inside the buy box, like the reference) {%- endcomment -%}
        {%- assign steps = section.blocks | where: 'type', 'step' -%}
        {%- if steps.size > 0 -%}
          <div class="ce-steps-mini">
            <span class="ce-steps-mini__title">{{ section.settings.steps_title }}</span>
            <ol>
              {%- for block in steps -%}<li {{ block.shopify_attributes }}><span>{{ forloop.index }}</span>{{ block.settings.title }}</li>{%- endfor -%}
            </ol>
          </div>
        {%- endif -%}

        <button type="button" class="ce-btn ce-btn--primary ce-btn--full" data-addcart>{{ section.settings.cta_add }}</button>

        <div class="ce-reassure">
          <span>🔒 Paiement sécurisé</span>
          <span>🚚 Livraison offerte</span>
          <span>🛡️ Garantie 30 jours</span>
        </div>
        <div class="ce-pay">
          <svg viewBox="0 0 40 26"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><text x="20" y="17.5" text-anchor="middle" font-family="Arial" font-size="11" font-style="italic" font-weight="800" fill="#1434CB">VISA</text></svg>
          <svg viewBox="0 0 40 26"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><circle cx="16.5" cy="13" r="7" fill="#eb001b"/><circle cx="23.5" cy="13" r="7" fill="#f79e1b"/></svg>
          <svg viewBox="0 0 40 26"><rect width="40" height="26" rx="4" fill="#1F72CD"/><rect x="4" y="9.5" width="32" height="7" rx="1" fill="#fff"/><text x="20" y="15" text-anchor="middle" font-family="Arial" font-size="6" font-weight="800" fill="#1F72CD">AMEX</text></svg>
          <svg viewBox="0 0 40 26"><rect width="40" height="26" rx="4" fill="#fff" stroke="#e7e7e7"/><text x="20" y="17" text-anchor="middle" font-family="Arial" font-size="10" font-style="italic" font-weight="800"><tspan fill="#003087">Pay</tspan><tspan fill="#009cde">Pal</tspan></text></svg>
          <svg viewBox="0 0 40 26"><rect width="40" height="26" rx="4" fill="#000"/><text x="20" y="17" text-anchor="middle" font-family="Arial" font-size="9" font-weight="600" fill="#fff">Pay</text></svg>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ============ 2. INNOVATION ============ {%- endcomment -%}
  {%- if section.settings.innov_enable -%}
  <div class="ce-band">
    <div class="ce-innov">
      <div class="ce-innov__media">
        {%- if section.settings.innov_image != blank -%}<img src="{{ section.settings.innov_image | image_url: width: 800 }}" alt="" loading="lazy">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}
      </div>
      <div class="ce-innov__body">
        <h2 class="ce-h2 ce-h2--left">{{ section.settings.innov_title }}</h2>
        <div class="ce-rte">{{ section.settings.innov_text }}</div>
        <button type="button" class="ce-btn ce-btn--primary" data-addcart>Commander</button>
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ 3. PRODUCTION EXPRESS (upsell) ============ {%- endcomment -%}
  {%- if section.settings.express_enable -%}
  <div class="ce-band ce-band--tight">
    <div class="ce-express">
      <div class="ce-express__txt">
        <span class="ce-express__title">{{ section.settings.express_title }}</span>
        <span class="ce-express__sub">{{ section.settings.express_sub }}</span>
      </div>
      <button type="button" class="ce-btn ce-btn--dark" data-addcart>Ajouter</button>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ 4. AVANT / PENDANT / APRÈS (tabs) ============ {%- endcomment -%}
  {%- if section.settings.tabs_enable -%}
  <div class="ce-band">
    <div class="ce-brandline">{{ section.settings.brand_name }}</div>
    <div class="ce-tabs" data-tabs>
      <div class="ce-tabs__nav">
        <button type="button" class="ce-tab is-active" data-tab="0">Avant</button>
        <button type="button" class="ce-tab" data-tab="1">Pendant</button>
        <button type="button" class="ce-tab" data-tab="2">Après</button>
      </div>
      <div class="ce-tabs__panes">
        <div class="ce-tabpane is-active" data-pane="0">{%- if section.settings.tab1_image != blank -%}<img src="{{ section.settings.tab1_image | image_url: width: 900 }}" alt="Avant" loading="lazy">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}</div>
        <div class="ce-tabpane" data-pane="1">{%- if section.settings.tab2_image != blank -%}<img src="{{ section.settings.tab2_image | image_url: width: 900 }}" alt="Pendant" loading="lazy">{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}</div>
        <div class="ce-tabpane" data-pane="2">{%- if section.settings.tab3_image != blank -%}<img src="{{ section.settings.tab3_image | image_url: width: 900 }}" alt="Après" loading="lazy">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}</div>
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ 5. UGC SELFIES ============ {%- endcomment -%}
  {%- assign ugcs = section.blocks | where: 'type', 'ugc' -%}
  {%- if ugcs.size > 0 -%}
  <div class="ce-band">
    <h2 class="ce-h2">{{ section.settings.ugc_title }}</h2>
    <p class="ce-sub">{{ section.settings.ugc_sub }}</p>
    <div class="ce-ugc">
      {%- for block in ugcs -%}
        <div class="ce-ugc__item" data-vid {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            <video class="ce-ugc__vid" {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 500 }}"{% endif %} preload="none" loop muted playsinline disablepictureinpicture>
              {%- for s in block.settings.video.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}
            </video>
            <button type="button" class="ce-ugc__play" data-vid-play aria-label="Lire">▶</button>
          {%- elsif block.settings.video_url != blank -%}
            <video class="ce-ugc__vid" {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 500 }}"{% endif %} preload="none" loop muted playsinline disablepictureinpicture>
              <source src="{{ block.settings.video_url }}" type="video/mp4">
            </video>
            <button type="button" class="ce-ugc__play" data-vid-play aria-label="Lire">▶</button>
          {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ 6. FAQ (Comande fréquent) ============ {%- endcomment -%}
  {%- assign faqs = section.blocks | where: 'type', 'faq' -%}
  {%- if faqs.size > 0 -%}
  <div class="ce-band ce-band--tint">
    <div class="ce-faqhead">{{ section.settings.faq_title }}</div>
    <div class="ce-faq">
      {%- for block in faqs -%}
        <details class="ce-faq__item"{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span class="ce-faq__ico">+</span></summary>
          <div class="ce-faq__ans">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ 7. COMPARAISON RÉELLE (shades) ============ {%- endcomment -%}
  {%- assign shades = section.blocks | where: 'type', 'shade' -%}
  {%- if shades.size > 0 -%}
  <div class="ce-band">
    <h2 class="ce-h2">{{ section.settings.shades_title }}</h2>
    <div class="ce-shades">
      {%- for block in shades -%}
        <figure class="ce-shade" {{ block.shopify_attributes }}>
          <div class="ce-shade__media">
            {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.name | escape }}" loading="lazy">{%- else -%}{{ 'product-2' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}
            <span class="ce-shade__idx">{{ forloop.index }}</span>
          </div>
          <figcaption><span class="ce-shade__name">{{ block.settings.name }}</span> <span class="ce-shade__code">({{ block.settings.code }})</span></figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ 8. AVANT / APRÈS (photo grid) ============ {%- endcomment -%}
  {%- assign bas = section.blocks | where: 'type', 'ba_photo' -%}
  {%- if bas.size > 0 -%}
  <div class="ce-band ce-band--tint">
    <span class="ce-tag">Résultats</span>
    <h2 class="ce-h2">{{ section.settings.ba_title }}</h2>
    <div class="ce-bagrid">
      {%- for block in bas -%}
        <div class="ce-bacell" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 400 }}" alt="" loading="lazy">{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ 9. REVIEWS WALL ============ {%- endcomment -%}
  {%- assign reviews = section.blocks | where: 'type', 'review' -%}
  {%- if reviews.size > 0 -%}
  <div class="ce-band">
    <h2 class="ce-h2">{{ section.settings.reviews_title }}</h2>
    <div class="ce-tp"><span class="ce-stars">★★★★★</span><span class="ce-tp__txt">Noté 4,9/5 par nos clients</span></div>
    <div class="ce-wall">
      {%- for block in reviews -%}
        <article class="ce-rev" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}<div class="ce-rev__img"><img src="{{ block.settings.image | image_url: width: 500 }}" alt="" loading="lazy"></div>{%- endif -%}
          <div class="ce-rev__body">
            <div class="ce-rev__top"><span class="ce-stars ce-stars--sm">★★★★★</span><span class="ce-rev__v">✓ Vérifié</span></div>
            {%- if block.settings.title != blank -%}<h3 class="ce-rev__title">{{ block.settings.title }}</h3>{%- endif -%}
            <p class="ce-rev__text">{{ block.settings.text }}</p>
            <div class="ce-rev__auth">— {{ block.settings.author }}</div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ 10. WHATSAPP / SUPPORT CTA ============ {%- endcomment -%}
  {%- if section.settings.wa_enable -%}
  <div class="ce-wa">
    <div class="ce-wa__inner">
      <div class="ce-wa__txt">
        <h2 class="ce-wa__title">{{ section.settings.wa_title }}</h2>
        <p class="ce-wa__sub">{{ section.settings.wa_sub }}</p>
        <div class="ce-wa__btns">
          <button type="button" class="ce-btn ce-btn--white" data-addcart>{{ section.settings.wa_cta1 }}</button>
        </div>
      </div>
      <div class="ce-wa__media">
        {%- if section.settings.wa_image != blank -%}<img src="{{ section.settings.wa_image | image_url: width: 700 }}" alt="" loading="lazy">{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'ce-ph' }}{%- endif -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ STICKY MOBILE BAR ============ {%- endcomment -%}
  <div class="ce-sticky" data-sticky hidden>
    <div class="ce-sticky__info">
      <span class="ce-sticky__name">{{ section.settings.sticky_name }}</span>
      <span class="ce-sticky__price">{% if prod != blank %}{{ prod.price | money }}{% else %}{{ section.settings.fallback_price }}{% endif %}</span>
    </div>
    <button type="button" class="ce-btn ce-btn--primary" data-addcart>{{ section.settings.cta_add }}</button>
  </div>
</section>

{%- style -%}
  #ce-{{ section.id }}.ce { --r: 14px; background: var(--ce-bg); color: var(--ce-ink); font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; overflow: hidden; }
  #ce-{{ section.id }} * { box-sizing: border-box; }
  #ce-{{ section.id }} h1, #ce-{{ section.id }} h2, #ce-{{ section.id }} h3 { font-family: 'Manrope', sans-serif; font-weight: 800; letter-spacing: -.02em; }
  #ce-{{ section.id }} img { max-width: 100%; display: block; }
  #ce-{{ section.id }} .ce-ph svg, #ce-{{ section.id }} .ce-ph { width: 100%; height: 100%; object-fit: cover; }

  /* Hero */
  #ce-{{ section.id }} .ce-hero { max-width: 1180px; margin: 0 auto; padding: 20px 18px 8px; display: grid; grid-template-columns: 1fr; gap: 22px; }
  #ce-{{ section.id }} .ce-gallery { display: flex; gap: 10px; }
  #ce-{{ section.id }} .ce-gallery__thumbs { display: flex; flex-direction: column; gap: 8px; flex: 0 0 66px; max-height: 520px; overflow-y: auto; scrollbar-width: none; }
  #ce-{{ section.id }} .ce-gallery__thumbs::-webkit-scrollbar { display: none; }
  #ce-{{ section.id }} .ce-gallery__thumb { width: 66px; height: 66px; border-radius: 10px; overflow: hidden; border: 1.5px solid var(--ce-line); background: var(--ce-tint); cursor: pointer; padding: 0; flex: 0 0 auto; }
  #ce-{{ section.id }} .ce-gallery__thumb.is-active { border-color: var(--ce-acc); }
  #ce-{{ section.id }} .ce-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
  #ce-{{ section.id }} .ce-gallery__main { position: relative; flex: 1; border-radius: var(--r); overflow: hidden; background: var(--ce-tint); aspect-ratio: 1/1; }
  #ce-{{ section.id }} .ce-gallery__slide { position: absolute; inset: 0; opacity: 0; transition: opacity .25s; }
  #ce-{{ section.id }} .ce-gallery__slide.is-active { opacity: 1; }
  #ce-{{ section.id }} .ce-gallery__slide img { width: 100%; height: 100%; object-fit: cover; }

  #ce-{{ section.id }} .ce-badge { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .8px; text-transform: uppercase; color: var(--ce-acc); background: color-mix(in srgb, var(--ce-acc) 10%, #fff); padding: 5px 11px; border-radius: 6px; }
  #ce-{{ section.id }} .ce-title { font-size: clamp(25px, 6vw, 34px); line-height: 1.1; margin: 10px 0 8px; }
  #ce-{{ section.id }} .ce-subtitle { font-size: 15px; color: #55606a; line-height: 1.5; margin: 0 0 16px; }
  #ce-{{ section.id }} .ce-pricerow { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
  #ce-{{ section.id }} .ce-price__now { font-size: 26px; font-weight: 800; font-family: 'Manrope', sans-serif; color: var(--ce-acc); }
  #ce-{{ section.id }} .ce-price__was { font-size: 17px; color: #9aa4ac; text-decoration: line-through; }
  #ce-{{ section.id }} .ce-price__save { font-size: 12px; font-weight: 700; color: #fff; background: #e0555a; padding: 3px 9px; border-radius: 5px; }
  #ce-{{ section.id }} .ce-rating { display: flex; align-items: center; gap: 8px; margin-bottom: 18px; }
  #ce-{{ section.id }} .ce-stars { color: #f5a623; letter-spacing: 1px; font-size: 15px; }
  #ce-{{ section.id }} .ce-stars--sm { font-size: 12px; }
  #ce-{{ section.id }} .ce-rating__txt { font-size: 12.5px; color: #6a747c; }

  /* Options */
  #ce-{{ section.id }} .ce-opt { margin-bottom: 16px; }
  #ce-{{ section.id }} .ce-opt__label { font-size: 13px; color: #55606a; }
  #ce-{{ section.id }} .ce-opt__label b { color: var(--ce-ink); }
  #ce-{{ section.id }} .ce-opt__values { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  #ce-{{ section.id }} .ce-opt__val { padding: 9px 15px; border: 1.5px solid var(--ce-line); background: #fff; border-radius: 9px; font-size: 13px; font-weight: 500; cursor: pointer; color: var(--ce-ink); transition: .12s; }
  #ce-{{ section.id }} .ce-opt__val.is-active { border-color: var(--ce-acc); background: color-mix(in srgb, var(--ce-acc) 8%, #fff); color: var(--ce-acc); font-weight: 700; }

  /* 4 steps mini */
  #ce-{{ section.id }} .ce-steps-mini { background: var(--ce-tint); border-radius: 12px; padding: 14px 16px; margin: 6px 0 16px; }
  #ce-{{ section.id }} .ce-steps-mini__title { display: block; font-weight: 800; font-family: 'Manrope', sans-serif; font-size: 14px; margin-bottom: 10px; }
  #ce-{{ section.id }} .ce-steps-mini ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  #ce-{{ section.id }} .ce-steps-mini li { display: flex; align-items: center; gap: 10px; font-size: 13px; color: #3d474f; line-height: 1.35; }
  #ce-{{ section.id }} .ce-steps-mini li span { flex: 0 0 22px; width: 22px; height: 22px; border-radius: 50%; background: var(--ce-acc); color: #fff; font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center; }

  /* Buttons */
  #ce-{{ section.id }} .ce-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 15px; border: 0; border-radius: 10px; cursor: pointer; transition: transform .12s, background .15s; text-decoration: none; padding: 15px 26px; }
  #ce-{{ section.id }} .ce-btn--primary { background: var(--ce-acc); color: #fff; box-shadow: 0 8px 20px color-mix(in srgb, var(--ce-acc) 30%, transparent); }
  #ce-{{ section.id }} .ce-btn--primary:hover { background: var(--ce-acc-dark); transform: translateY(-1px); }
  #ce-{{ section.id }} .ce-btn--full { width: 100%; padding: 17px; font-size: 16px; }
  #ce-{{ section.id }} .ce-btn--dark { background: var(--ce-ink); color: #fff; }
