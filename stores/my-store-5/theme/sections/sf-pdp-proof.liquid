{%- assign s = section.settings -%}
<section class="sf sf-proof" style="--proof-bg: {{ s.bg }};">
  <div class="sf-wrap">
    <div class="sf-proof__head">
      <div class="sf-proof__num">
        {%- assign av = 0 -%}
        {%- if s.avatar_1 != blank or s.avatar_2 != blank or s.avatar_3 != blank -%}
          <span class="sf-proof__avs">
            {%- for i in (1..3) -%}
              {%- assign k = 'avatar_' | append: i -%}
              {%- if s[k] != blank -%}{{ s[k] | image_url: width: 120 | image_tag: width: 48, height: 48, alt: '', loading: 'lazy' }}{%- endif -%}
            {%- endfor -%}
          </span>
        {%- endif -%}
        <span class="sf-proof__big">{{ s.number }}</span>
      </div>
      <h2 class="sf-proof__title">{{ s.head_1 }} <em>{{ s.head_hi }}</em> {{ s.head_2 }}</h2>
    </div>

    <div class="sf-proof__body">
      <div class="sf-proof__left">
        <ul class="sf-proof__cards">
          {%- for block in section.blocks -%}
            <li class="sf-proof__card" {{ block.shopify_attributes }}>
              <span class="sf-proof__ico">{%- render 'sf-icon', name: block.settings.icon -%}</span>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </li>
          {%- endfor -%}
        </ul>
        {%- if s.btn_label != blank -%}<a class="sf-proof__btn" href="{{ s.btn_link | default: '#sf-pdp-top' }}">{{ s.btn_label }}</a>{%- endif -%}
        {%- if s.note != blank -%}<p class="sf-proof__note"><i></i>{{ s.note }}</p>{%- endif -%}
      </div>
      <div class="sf-proof__media sf-media">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1100 | image_tag: widths: '500, 750, 1100', sizes: '(min-width: 990px) 500px, 92vw', alt: s.image.alt, loading: 'lazy' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'sf-ph' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .sf-proof { background: var(--proof-bg); padding: clamp(40px, 5vw, 73px) 0 clamp(36px, 4vw, 40px); }
  .sf-proof__head { text-align: center; }
  .sf-proof__num { display: inline-flex; align-items: center; gap: 14px; }
  .sf-proof__avs { display: inline-flex; }
  .sf-proof__avs img { width: clamp(30px, 3.3vw, 48px); height: clamp(30px, 3.3vw, 48px); border-radius: 50%; object-fit: cover; border: 2px solid var(--proof-bg); margin-left: -12px; }
  .sf-proof__avs img:first-child { margin-left: 0; }
  .sf-proof__big { font-size: clamp(46px, 5vw, 72px); line-height: 1; font-weight: 700; letter-spacing: -.01em;
    background: linear-gradient(180deg, #E5C55B 0%, #B8902A 100%); -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; }
  .sf-proof__title { margin-top: 10px; font-family: var(--sf-sans); font-weight: 700; font-size: clamp(21px, 2.75vw, 40px); line-height: 1.32; letter-spacing: -.005em; color: var(--sf-ink); text-wrap: balance; }
  .sf-proof__title em { font-style: normal; color: var(--sf-plum); }
  .sf-proof__body { display: grid; grid-template-columns: minmax(0, 572fr) minmax(0, 500fr); column-gap: clamp(24px, 6.7vw, 96px); align-items: center; margin-top: clamp(32px, 5.6vw, 80px); }
  .sf-proof__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .sf-proof__card { padding: 22px 20px 20px; border-radius: 12px; background: #fff; box-shadow: 0 1px 0 rgba(19, 7, 46, .04), 0 10px 24px -20px rgba(19, 7, 46, .35); min-height: clamp(120px, 10.3vw, 148px); }
  .sf-proof__ico { display: inline-flex; color: var(--sf-plum); } .sf-proof__ico svg { width: 24px; height: 24px; }
  .sf-proof__card h3 { margin-top: 12px; font-family: var(--sf-sans); font-size: 16px; font-weight: 700; line-height: 1.2; color: var(--sf-plum); }
  .sf-proof__card p { margin-top: 5px; font-size: 12.5px; line-height: 1.4; color: #6f6664; }
  .sf-proof__btn { display: flex; align-items: center; justify-content: center; min-height: 56px; margin-top: 16px; border-radius: 10px; background: var(--sf-plum); color: #fff !important;
    font-size: 14px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; transition: filter .15s, transform .15s; }
  .sf-proof__btn:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .sf-proof__note { display: flex; align-items: center; justify-content: center; gap: 7px; margin-top: 12px; font-size: 12px; color: #5f5654; }
  .sf-proof__note i { width: 7px; height: 7px; border-radius: 50%; background: var(--sf-green); }
  .sf-proof__media { aspect-ratio: 500 / 486; border-radius: 14px; overflow: hidden; }
  .sf-proof__media img, .sf-proof__media > svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center bottom; }
  @media (max-width: 749px) {
    .sf-proof__body { grid-template-columns: 1fr; row-gap: 24px; }
    .sf-proof__media { order: -1; aspect-ratio: 4 / 3.6; }
    .sf-proof__cards { gap: 8px; }
    .sf-proof__card { padding: 16px 14px; min-height: 0; }
    .sf-proof__card h3 { font-size: 14.5px; } .sf-proof__card p { font-size: 12px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SF · Preuve sociale",
  "tag": "section",
  "class": "sf-section-proof",
  "settings": [
    { "type": "paragraph", "content": "Le grand chiffre doit être un nombre réel et vérifiable (clientes, commandes…). « 00,000+ » est un repère à remplacer." },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#F9F3EE" },
    { "type": "image_picker", "id": "avatar_1", "label": "Avatar 1" },
    { "type": "image_picker", "id": "avatar_2", "label": "Avatar 2" },
    { "type": "image_picker", "id": "avatar_3", "label": "Avatar 3" },
    { "type": "text", "id": "number", "label": "Grand chiffre", "default": "00,000+" },
    { "type": "text", "id": "head_1", "label": "Titre : début", "default": "women wearing their" },
    { "type": "text", "id": "head_hi", "label": "Titre : partie en prune", "default": "3D leggings all day" },
    { "type": "text", "id": "head_2", "label": "Titre : fin", "default": "without thinking about it" },
    { "type": "image_picker", "id": "image", "label": "Image (à droite)" },
    { "type": "text", "id": "btn_label", "label": "Bouton", "default": "Shop the 3D leggings" },
    { "type": "url", "id": "btn_link", "label": "Lien du bouton (vide = haut de page)" },
    { "type": "text", "id": "note", "label": "Petite ligne sous le bouton", "default": "Free returns within 30 days" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Carte",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "sparkle", "options": [
          { "value": "sparkle", "label": "Étincelle" }, { "value": "feather", "label": "Plume" }, { "value": "heart", "label": "Cœur" },
          { "value": "check", "label": "Coche" }, { "value": "shield", "label": "Bouclier" }, { "value": "ruler", "label": "Mètre" },
          { "value": "trend", "label": "Courbe" }, { "value": "clock", "label": "Horloge" }
        ] },
        { "type": "text", "id": "title", "label": "Titre", "default": "Benefit" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Short description." }
      ]
    }
  ],
  "presets": [ { "name": "SF · Preuve sociale", "blocks": [
    { "type": "card", "settings": { "icon": "sparkle", "title": "3D sculpting texture", "text": "Designed to sculpt your silhouette." } },
    { "type": "card", "settings": { "icon": "heart", "title": "High-waist design", "text": "Gently wraps your waist and highlights your curves." } },
    { "type": "card", "settings": { "icon": "feather", "title": "Smoother look", "text": "The 3D texture helps create a more even-looking skin." } },
    { "type": "card", "settings": { "icon": "check", "title": "Comfort all day", "text": "A comfortable, flattering fit for everyday wear." } }
  ] } ]
}
{% endschema %}
