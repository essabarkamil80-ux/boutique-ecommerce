{%- assign s = section.settings -%}
{%- assign revs = section.blocks | where: 'type', 'review' -%}
<section class="sf sf-prev" id="sf-prev-{{ section.id }}" data-per="{{ s.per_page }}">
  <div class="sf-wrap">
    <div class="sf-prev__head">
      {%- if s.trust_number != blank -%}
        <p class="sf-prev__trust">
          <span class="sf-prev__trustico">{%- render 'sf-icon', name: 'star' -%}</span>{{ s.trust_before }}
          {%- if s.avatar_1 != blank or s.avatar_2 != blank or s.avatar_3 != blank -%}
            <span class="sf-prev__avs">
              {%- for n in (1..3) -%}
                {%- assign ak = 'avatar_' | append: n -%}
                {%- if s[ak] != blank -%}{{ s[ak] | image_url: width: 80 | image_tag: width: 24, height: 24, alt: '', loading: 'lazy' }}{%- endif -%}
              {%- endfor -%}
            </span>
          {%- endif -%}
          {{ s.trust_mid }} <b>{{ s.trust_number }}</b> {{ s.trust_after }}
        </p>
      {%- endif -%}
      {%- if s.badge != blank -%}<p class="sf-prev__badge"><i></i>{{ s.badge }}</p>{%- endif -%}
      <h2 class="sf-h2 sf-prev__title">{{ s.title_1 }} <em>{{ s.title_2 }}</em></h2>
    </div>

    {%- assign rv = product.metafields.reviews.rating.value -%}
    {%- assign ov_pct = 0 -%}
    {%- if rv != blank -%}{%- assign ov_pct = rv.rating | times: 100.0 | divided_by: rv.scale_max -%}{%- endif -%}
    {%- if s.g1_label != blank -%}
      <div class="sf-prev__gauges">
        {%- if rv != blank -%}
        <div class="sf-prev__overall">
          <span class="sf-rate sf-prev__stars"><span class="sf-rate__bg">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span><span class="sf-rate__fg" style="width: {{ ov_pct }}%">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span></span>
          <span>{{ rv.rating | round: 1 }}/{{ rv.scale_max | round }}{% assign rc = product.metafields.reviews.rating_count.value %}{% if rc != blank %} · {{ rc }}{% endif %}</span>
        </div>
        {%- endif -%}
        <ul>
          {%- for n in (1..4) -%}
            {%- assign kl = 'g' | append: n | append: '_label' -%}
            {%- assign kv = 'g' | append: n | append: '_value' -%}
            {%- if s[kl] != blank -%}
              {%- assign gp = s[kv] | times: 20 -%}
              {%- assign kt = 'g' | append: n | append: '_text' -%}
              <li><span>{{ s[kl] }}</span><i style="--fill: {{ gp }}%"><em style="left: {{ gp }}%"></em></i><b>{% if s[kt] != blank %}{{ s[kt] }}{% elsif s[kv] > 0 %}{{ s[kv] }}/5{% else %}—{% endif %}</b></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if s.gauge_count != blank or s.gauge_pill != blank -%}
          <p class="sf-prev__gfoot">
            {%- if s.gauge_count != blank -%}<span class="sf-prev__gcount">{%- render 'sf-icon', name: 'people' -%}<b>{{ s.gauge_count }}</b> {{ s.gauge_count_label }}</span>{%- endif -%}
            {%- if s.gauge_pill != blank -%}<span class="sf-prev__gpill">{%- render 'sf-icon', name: 'verified' -%}{{ s.gauge_pill }}</span>{%- endif -%}
          </p>
        {%- endif -%}
        {%- if s.gauge_note != blank -%}<p class="sf-prev__gnote">{{ s.gauge_note }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <ul class="sf-prev__list" data-list>
      {%- for r in revs -%}
        {%- assign rs = r.settings -%}
        <li class="sf-prev__item" {{ r.shopify_attributes }}>
          {%- assign rp = rs.rating | times: 20 -%}
          <span class="sf-rate sf-prev__stars" aria-label="{{ rs.rating }} / 5"><span class="sf-rate__bg">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span><span class="sf-rate__fg" style="width: {{ rp }}%">{%- for i in (1..5) -%}{%- render 'sf-icon', name: 'star' -%}{%- endfor -%}</span></span>
          <p class="sf-prev__who"><i>{{ rs.name | slice: 0 }}</i>{{ rs.name }}{%- if rs.verified -%}<span class="sf-prev__ver">{%- render 'sf-icon', name: 'verified' -%}Verified</span>{%- endif -%}</p>
          <h3 class="sf-prev__rt">{{ rs.title }}</h3>
          <p class="sf-prev__rx">{{ rs.text }}</p>
          {%- if rs.photo != blank -%}
            <span class="sf-prev__photo sf-media">{{ rs.photo | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '112px', alt: rs.title, loading: 'lazy' }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    <nav class="sf-prev__pager" data-pager aria-label="Reviews pages" hidden></nav>
  </div>
</section>
<script>
  (function () {
    var root = document.getElementById('sf-prev-{{ section.id }}'); if (!root || root.dataset.ready) return; root.dataset.ready = '1';
    var per = parseInt(root.dataset.per, 10) || 5, items = [].slice.call(root.querySelectorAll('[data-list] > li')), pager = root.querySelector('[data-pager]'), page = 1;
    var pages = Math.ceil(items.length / per); if (pages < 2) return;
    function render() {
      items.forEach(function (li, i) { li.hidden = Math.floor(i / per) + 1 !== page; });
      var h = '<button type="button" data-go="' + (page - 1) + '" aria-label="Previous"' + (page === 1 ? ' disabled' : '') + '>‹</button>';
      for (var p = 1; p <= pages; p++) h += '<button type="button" data-go="' + p + '"' + (p === page ? ' class="is-on" aria-current="page"' : '') + '>' + p + '</button>';
      h += '<button type="button" data-go="' + (page + 1) + '" aria-label="Next"' + (page === pages ? ' disabled' : '') + '>›</button>';
      pager.innerHTML = h; pager.hidden = false;
    }
    pager.addEventListener('click', function (e) {
      var b = e.target.closest('[data-go]'); if (!b || b.disabled) return; page = parseInt(b.dataset.go, 10); render();
      root.querySelector('[data-list]').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    render();
  })();
</script>

{% stylesheet %}
  .sf-prev { background: #fff; padding: clamp(40px, 4.4vw, 64px) 0 clamp(36px, 4vw, 56px); }
  .sf-prev__head { text-align: center; }
  .sf-prev__badge { display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; color: #5f5654; }
  .sf-prev__badge i { width: 8px; height: 8px; border-radius: 50%; background: var(--sf-green); }
  .sf-prev .sf-prev__title { margin-top: 14px; }
  .sf-prev__title em { font-style: normal; color: var(--sf-plum); }
  .sf-prev__trust { display: inline-flex; align-items: center; flex-wrap: wrap; justify-content: center; gap: 8px; padding: 8px 18px; border: 1px solid #EFE9E5; border-radius: 999px; font-size: clamp(13px, 1.1vw, 15.5px); color: var(--sf-ink); background: #fff; }
  .sf-prev__trustico { display: inline-flex; color: var(--sf-green); } .sf-prev__trustico svg { width: 18px; height: 18px; }
  .sf-prev__avs { display: inline-flex; } .sf-prev__avs img { width: 24px; height: 24px; border-radius: 50%; object-fit: cover; border: 2px solid #fff; margin-left: -6px; } .sf-prev__avs img:first-child { margin-left: 0; }
  .sf-prev__trust b { font-weight: 500; }
  .sf-prev__gauges { max-width: 640px; margin: clamp(20px, 2.4vw, 34px) auto 0; padding: 18px 28px 16px; border: 1px solid #F0E9E5; border-radius: 14px; background: #fff; box-shadow: 0 8px 26px -20px rgba(19, 7, 46, .25); }
  .sf-prev__gfoot { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 12px; padding-top: 12px; border-top: 1px solid #F2EBE7; font-size: 13px; color: var(--sf-ink); }
  .sf-prev__gcount { display: inline-flex; align-items: center; gap: 7px; } .sf-prev__gcount svg { width: 16px; height: 16px; color: var(--sf-plum); } .sf-prev__gcount b { font-weight: 600; }
  .sf-prev__gpill { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 999px; background: #F8EFF1; font-size: 12px; color: var(--sf-plum); } .sf-prev__gpill svg { width: 13px; height: 13px; }
  .sf-prev__overall { display: flex; align-items: center; justify-content: center; gap: 8px; padding-bottom: 8px; margin-bottom: 4px; border-bottom: 1px solid #F2EBE7; font-size: 12.5px; color: #5f5654; }
  .sf-prev__overall .sf-prev__stars { font-size: 15px; }
  .sf-prev__gauges li { display: grid; grid-template-columns: 130px 1fr 84px; gap: 16px; align-items: center; padding: 10px 0; border-bottom: 1px solid #F6F1EE; font-size: 14px; color: var(--sf-ink); }
  .sf-prev__gauges li:last-child { border-bottom: 0; }
  .sf-prev__gauges i { position: relative; height: 4px; border-radius: 4px; background: #F2DDE2; }
  .sf-prev__gauges em { position: absolute; top: 50%; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; background: var(--sf-green); }
  .sf-prev__gauges i::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: var(--fill, 0); background: var(--sf-green); border-radius: 4px; }
  .sf-prev__gauges b { font-size: 13px; font-weight: 400; text-align: right; color: #6f6664; }
  .sf-prev__gnote { margin-top: 8px; text-align: center; font-size: 11px; color: #8b8280; }
  .sf-prev__list { margin-top: clamp(28px, 3.6vw, 52px); }
  .sf-prev__item { padding: 26px 0; border-bottom: 1px solid #EFE9E5; }
  .sf-prev__item[hidden] { display: none; }
  .sf-prev .sf-prev__item .sf-prev__stars { font-size: clamp(22px, 2.2vw, 30px); }
  .sf-prev__stars .sf-rate__bg, .sf-prev__stars .sf-rate__fg { gap: 3px; }
  .sf-prev__stars .sf-rate__bg { color: #D9D4D0; }
  .sf-prev__who { display: flex; align-items: center; gap: 12px; margin-top: 14px; font-size: 16px; font-weight: 700; color: var(--sf-ink); }
  .sf-prev__who i { width: 42px; height: 42px; border-radius: 50%; background: #E7F3EE; display: grid; place-items: center; font-style: normal; font-size: 12px; color: #0d7a5b; text-transform: uppercase; }
  .sf-prev__ver { display: inline-flex; align-items: center; gap: 3px; font-size: 11px; font-weight: 600; color: var(--sf-green); }
  .sf-prev__ver svg { width: 11px; height: 11px; }
  .sf-prev__rt { margin-top: 16px; font-family: var(--sf-sans); font-size: clamp(17px, 1.6vw, 22px); font-weight: 700; line-height: 1.3; color: var(--sf-ink); }
  .sf-prev__rx { margin-top: 8px; font-size: clamp(14.5px, 1.25vw, 17px); line-height: 1.55; color: #3f3735; max-width: 900px; }
  .sf-prev__photo { display: block; width: 150px; height: 150px; margin-top: 14px; border-radius: 8px; }
  .sf-prev__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sf-prev__pager { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: 26px; }
  .sf-prev__pager[hidden] { display: none; }
  .sf-prev__pager button { min-width: 28px; height: 28px; padding: 0 6px; border-radius: 50%; font-size: 12px; color: #6f6664; }
  .sf-prev__pager button:disabled { opacity: .35; cursor: default; }
  .sf-prev__pager button.is-on { background: #12808A; color: #fff; font-weight: 700; }
  @media (max-width: 749px) { .sf-prev__gauges { padding: 14px 16px 12px; } .sf-prev__gauges li { grid-template-columns: 92px 1fr 64px; gap: 10px; font-size: 13px; } .sf-prev__photo { width: 120px; height: 120px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "SF · Liste d'avis",
  "tag": "section",
  "class": "sf-section-prev",
  "settings": [
    { "type": "paragraph", "content": "Squelette prêt à remplir. Étoiles à 0 = grises ; jauges à 0 = « — ». N'entrez que de vrais avis et de vraies notes." },
    { "type": "header", "content": "Pastille « Trusted by »" },
    { "type": "paragraph", "content": "La pastille est masquée tant que le chiffre est vide. Indiquez uniquement un chiffre réel et vérifiable, qui concerne vos clientes et ce produit." },
    { "type": "text", "id": "trust_before", "label": "Texte avant les photos", "default": "Trusted by" },
    { "type": "image_picker", "id": "avatar_1", "label": "Photo ronde 1" },
    { "type": "image_picker", "id": "avatar_2", "label": "Photo ronde 2" },
    { "type": "image_picker", "id": "avatar_3", "label": "Photo ronde 3" },
    { "type": "text", "id": "trust_mid", "label": "Texte après les photos", "default": "and" },
    { "type": "text", "id": "trust_number", "label": "Chiffre réel (ex. 1,200+)" },
    { "type": "text", "id": "trust_after", "label": "Texte après le chiffre", "default": "women" },
    { "type": "header", "content": "Titre et jauges" },
    { "type": "text", "id": "badge", "label": "Petite pastille verte au-dessus du titre (facultatif)" },
    { "type": "text", "id": "title_1", "label": "Titre : début", "default": "They love Essabar&Co., because we made" },
    { "type": "text", "id": "title_2", "label": "Titre : fin (prune)", "default": "cellulite care effortless" },
    { "type": "text", "id": "g1_label", "label": "Jauge 1 : nom (vide = pas de jauges)", "default": "Fit" },
    { "type": "range", "id": "g1_value", "min": 0, "max": 5, "step": 0.1, "label": "Jauge 1 : note réelle (position du point)", "default": 0 },
    { "type": "text", "id": "g1_text", "label": "Jauge 1 : texte à droite (ex. True to size)", "info": "Vide = la note x/5." },
    { "type": "text", "id": "g2_label", "label": "Jauge 2 : nom", "default": "Compression" },
    { "type": "range", "id": "g2_value", "min": 0, "max": 5, "step": 0.1, "label": "Jauge 2 : note réelle (position du point)", "default": 0 },
    { "type": "text", "id": "g2_text", "label": "Jauge 2 : texte à droite (ex. Just right)" },
    { "type": "text", "id": "g3_label", "label": "Jauge 3 : nom", "default": "Comfort" },
    { "type": "range", "id": "g3_value", "min": 0, "max": 5, "step": 0.1, "label": "Jauge 3 : note réelle (position du point)", "default": 0 },
    { "type": "text", "id": "g3_text", "label": "Jauge 3 : texte à droite" },
    { "type": "text", "id": "g4_label", "label": "Jauge 4 : nom", "default": "Results speed" },
    { "type": "range", "id": "g4_value", "min": 0, "max": 5, "step": 0.1, "label": "Jauge 4 : note réelle (position du point)", "default": 0 },
    { "type": "text", "id": "g4_text", "label": "Jauge 4 : texte à droite" },
    { "type": "text", "id": "gauge_count", "label": "Nombre de clientes ayant noté (réel, ex. 312)" },
    { "type": "text", "id": "gauge_count_label", "label": "Texte après ce nombre", "default": "women scored it" },
    { "type": "text", "id": "gauge_pill", "label": "Pastille (ex. No incentives) : seulement si c'est vrai" },
    { "type": "text", "id": "gauge_note", "label": "Petite ligne sous les jauges" },
    { "type": "range", "id": "per_page", "min": 3, "max": 10, "step": 1, "label": "Avis par page", "default": 5 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "label": "Étoiles", "default": 0 },
        { "type": "text", "id": "name", "label": "Prénom + initiale", "default": "Customer name" },
        { "type": "checkbox", "id": "verified", "label": "Achat vérifié (cocher seulement si c'est réel)", "default": false },
        { "type": "text", "id": "title", "label": "Titre de l'avis", "default": "Review title" },
        { "type": "textarea", "id": "text", "label": "Texte de l'avis", "default": "Paste a real customer review here." },
        { "type": "image_picker", "id": "photo", "label": "Photo de la cliente (optionnelle)" }
      ]
    }
  ],
  "presets": [ { "name": "SF · Liste d'avis", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] } ]
}
{% endschema %}
