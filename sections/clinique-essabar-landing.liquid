  /* FAQ */
  #ce-{{ section.id }} .ce-faqhead { background: var(--ce-acc); color: #fff; font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 17px; padding: 14px 20px; border-radius: 12px 12px 0 0; max-width: 760px; margin: 0 auto; }
  #ce-{{ section.id }} .ce-faq { max-width: 760px; margin: 0 auto; background: #fff; border-radius: 0 0 12px 12px; border: 1px solid var(--ce-line); border-top: 0; }
