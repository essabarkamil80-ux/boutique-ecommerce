{%- comment -%} Felispace — warm contact intro (logo + friendly message) {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<div id="fs-contact-{{ section.id }}" class="fs-contact-intro" style="--fs-green: {{ section.settings.color_primary }};">
  <div class="fs-contact-intro__inner">
    {%- if section.settings.show_logo -%}
      <div class="fs-contact-intro__logo">
        {%- if settings.logo != blank -%}
          <img src="{{ settings.logo | image_url: width: 360 }}" alt="{{ shop.name | escape }}" width="180" loading="eager">
        {%- else -%}
          <span class="fs-contact-intro__logotext">FéliSpace</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.eyebrow != blank -%}
      <span class="fs-contact-intro__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    <h1 class="fs-contact-intro__title">{{ section.settings.heading }}</h1>

    {%- if section.settings.subtext != blank -%}
      <p class="fs-contact-intro__text">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- if section.settings.badge_1 != blank or section.settings.badge_2 != blank or section.settings.badge_3 != blank -%}
      <div class="fs-contact-intro__badges">
        {%- if section.settings.badge_1 != blank -%}<span>{{ section.settings.badge_1 }}</span>{%- endif -%}
        {%- if section.settings.badge_2 != blank -%}<span>{{ section.settings.badge_2 }}</span>{%- endif -%}
        {%- if section.settings.badge_3 != blank -%}<span>{{ section.settings.badge_3 }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  #fs-contact-{{ section.id }}.fs-contact-intro { padding: 48px 20px 8px; text-align: center; font-family: 'Inter', sans-serif; }
  #fs-contact-{{ section.id }} .fs-contact-intro__inner { max-width: 680px; margin: 0 auto; }
  #fs-contact-{{ section.id }} .fs-contact-intro__logo { margin-bottom: 18px; }
  #fs-contact-{{ section.id }} .fs-contact-intro__logo img { height: 40px; width: auto; display: inline-block; }
  #fs-contact-{{ section.id }} .fs-contact-intro__logotext { font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 26px; letter-spacing: .5px; color: #1a1a1a; }
  #fs-contact-{{ section.id }} .fs-contact-intro__eyebrow { display: inline-block; font-weight: 700; font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--fs-green); background: rgba(31,111,67,.08); padding: 6px 14px; border-radius: 999px; margin-bottom: 14px; }
  #fs-contact-{{ section.id }} .fs-contact-intro__title { font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: clamp(26px, 4vw, 40px); line-height: 1.12; color: #141414; margin: 0 0 14px; }
  #fs-contact-{{ section.id }} .fs-contact-intro__text { font-size: 16px; line-height: 1.6; color: #555; margin: 0 auto; max-width: 560px; }
  #fs-contact-{{ section.id }} .fs-contact-intro__badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 22px; margin-top: 22px; }
  #fs-contact-{{ section.id }} .fs-contact-intro__badges span { font-size: 13.5px; font-weight: 600; color: #333; }
  @media (max-width: 600px) {
    #fs-contact-{{ section.id }}.fs-contact-intro { padding: 34px 16px 4px; }
    #fs-contact-{{ section.id }} .fs-contact-intro__text { font-size: 15px; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Contact intro",
  "settings": [
    { "type": "checkbox", "id": "show_logo", "label": "Show logo", "default": true },
    { "type": "color", "id": "color_primary", "label": "Brand green", "default": "#1f6f43" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "We're here for you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A question? Don't hesitate — we're here for you 💚" },
    { "type": "textarea", "id": "subtext", "label": "Message", "default": "Our friendly team is available 24/7. Whether it's about your order, sizing, or your cat's comfort — reach out anytime and we'll get back to you fast. Your cat's happiness is our mission." },
    { "type": "text", "id": "badge_1", "label": "Badge 1", "default": "💬 Replies within 24h" },
    { "type": "text", "id": "badge_2", "label": "Badge 2", "default": "🛡️ 30-day money-back" },
    { "type": "text", "id": "badge_3", "label": "Badge 3", "default": "🚚 Free shipping" }
  ],
  "presets": [{ "name": "Contact intro" }]
}
{% endschema %}
