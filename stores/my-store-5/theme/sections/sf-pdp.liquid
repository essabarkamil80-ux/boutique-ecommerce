  .sf-size__cta { margin-top: 20px; height: 54px; border-radius: 10px; background: var(--sf-plum); color: #fff; font-size: 14px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; transition: filter .15s; }
  .sf-size__cta:hover { filter: brightness(1.12); }
  .sf-size__note { margin-top: 10px; text-align: center; font-size: 12px; color: #8b8280; }
  /* accordeons */
  .sf-acc { margin-top: 10px; }
  .sf-acc__item { border-bottom: 1px solid #EFE7E3; }
