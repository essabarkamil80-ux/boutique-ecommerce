<section class="sf sf-col" style="--col-bg: {{ section.settings.bg }};">
  <div class="sf-wrap">
    {%- if section.settings.title != blank -%}<h2 class="sf-h2 sf-col__title">{{ section.settings.title }}</h2>{%- endif -%}
    <ul class="sf-col__grid" style="--col-n: {{ section.blocks.size | at_least: 1 }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li {{ block.shopify_attributes }}>
          <a class="sf-col__card" href="{{ b.link | default: routes.all_products_collection_url }}">
            <span class="sf-col__media sf-media">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 600 | image_tag: widths: '240, 360, 480, 600', sizes: '(min-width: 990px) 236px, 42vw', alt: b.label, loading: 'lazy' }}
              {%- else -%}
                {%- assign phn = forloop.index | modulo: 4 | plus: 1 -%}
                {%- assign phname = 'product-apparel-' | append: phn -%}
                {{ phname | placeholder_svg_tag: 'sf-ph' }}
              {%- endif -%}
            </span>
            <span class="sf-col__label">
              {%- if b.dots != blank -%}
                <span class="sf-col__dots">
                  {%- assign dots = b.dots | split: ',' -%}
                  {%- for d in dots limit: 5 -%}<i style="background: {{ d | strip }}"></i>{%- endfor -%}
                  {%- if dots.size > 5 -%}<i class="sf-col__plus">+</i>{%- endif -%}
                </span>
              {%- endif -%}
              {{ b.label }}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .sf-col { background: var(--col-bg); padding: clamp(40px, 4vw, 58px) 0 clamp(44px, 4.2vw, 60px); }
  .sf-col__title { text-align: center; margin-bottom: clamp(22px, 2.6vw, 38px); }
  .sf-col__grid { display: grid; grid-template-columns: repeat(var(--col-n), 1fr); gap: clamp(10px, .85vw, 13px); }
  .sf-col__card { display: flex; flex-direction: column; align-items: center; }
  .sf-col__media { display: block; width: 100%; aspect-ratio: 1 / 1; border-radius: 12px; }
  .sf-col__media img, .sf-col__media > svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .sf-col__card:hover .sf-col__media img { transform: scale(1.04); }
  .sf-col__label { display: inline-flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 15px; font-weight: 700; color: var(--sf-ink); }
  .sf-col__dots { display: inline-flex; }
  .sf-col__dots i { width: 13px; height: 13px; border-radius: 50%; border: 1.5px solid #fff; margin-left: -4px; box-shadow: 0 0 0 .5px rgba(0,0,0,.12); }
  .sf-col__dots i:first-child { margin-left: 0; }
  .sf-col__plus { background: #fff !important; color: var(--sf-plum); font-style: normal; font-size: 11px; line-height: 10px; text-align: center; }
  @media (max-width: 749px) {
    .sf-col__grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      margin: 0 calc(-1 * var(--sf-gutter)); padding: 0 var(--sf-gutter); scroll-padding-left: var(--sf-gutter); gap: 10px; }
    .sf-col__grid::-webkit-scrollbar { display: none; }
    .sf-col__grid > li { flex: 0 0 42vw; scroll-snap-align: start; }
    .sf-col__label { font-size: 14px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SF · Par couleur",
  "tag": "section",
  "class": "sf-section-col",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Shop by color" },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "color",
      "name": "Couleur",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Nom", "default": "Color" },
        { "type": "url", "id": "link", "label": "Lien (ex. collection filtrée)" },
        { "type": "text", "id": "dots", "label": "Pastilles avant le nom (codes couleur séparés par des virgules)", "info": "Pour la tuile « Browse all », ex. : #111111, #8b3a5b, #12808a, #d7c3a6, #f2b6c6, #999999" }
      ]
    }
  ],
  "presets": [ { "name": "SF · Par couleur", "blocks": [
    { "type": "color", "settings": { "label": "Black" } }, { "type": "color", "settings": { "label": "Beige" } },
    { "type": "color", "settings": { "label": "Grey" } }, { "type": "color", "settings": { "label": "Blue" } },
    { "type": "color", "settings": { "label": "Browse all", "dots": "#111111, #8b3a5b, #12808a, #d7c3a6, #f2b6c6, #999999" } }
  ] } ]
}
{% endschema %}
